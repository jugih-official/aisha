#!/usr/bin/env python3
"""ai — natural-language bash assistant powered by DeepSeek.

The model speaks a tiny line-prefixed protocol:

  CMD: <bash>      run on the user's terminal (visible, interactive)
  FETCH: <bash>    run silently, output is sent back to the model
  SAY: <text>      final natural-language reply
  REFUSE: <reason> refuse the request

This lets the assistant both *do* things ("list files in cwd") and
*answer* things ("search google for X and tell me the first result")
by chaining FETCH steps and finishing with SAY.
"""

import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error

API_URL = "https://api.deepseek.com/chat/completions"
MODEL = "deepseek-chat"
MAX_TURNS = 8
FETCH_OUTPUT_LIMIT = 8000  # chars of FETCH output sent back to the model

# Where to look for the API key if $DEEPSEEK_API_KEY is unset. First
# match wins. The user-scoped path is checked before the system one so
# personal keys override a shared one.
API_KEY_FILES = [
    os.path.expanduser("~/.config/ai-bash/api-key"),
    "/etc/ai-bash/api-key",
]

SYSTEM_PROMPT = r"""You are a senior GNU/Linux bash and sysadmin expert helping the user from their terminal. You can both *execute* shell commands on their machine and *answer* questions by gathering information (including from the web).

You MUST respond with exactly one of these line-prefixed forms, and nothing else:

  CMD: <bash command>
      Run on the user's terminal. The user sees both the command and its
      output. End of conversation. Use this when the user wants to *do*
      something (list files, eject a USB, show RAM usage, install a
      package, ...). Output should land in the user's terminal.

  FETCH: <bash command>
      Run silently. The exit code and captured stdout/stderr are sent
      back to you in the next turn. The user does NOT see this. Use this
      to gather data you need to answer (e.g. curl a web page, read a
      file, query `free`, etc.) before producing a final SAY.

  SAY: <natural-language reply>
      Your final answer to the user. Single line; \n inside the line is
      fine. Use the user's language. End of conversation.

  REFUSE: <short reason>
      Refuse the request (e.g. truly dangerous, illegal). End of
      conversation.

Rules:
- Output ONLY the prefix line. No markdown fences, no extra commentary.
- Pick the SIMPLEST flow:
    * Pure shell task → one CMD.
    * Question about local system that's better shown as raw output
      (e.g. "show RAM", "list USB devices") → one CMD.
    * Question that needs reasoning over fetched data
      (e.g. "search the web for X and summarize", "what's the latest
      version of Y") → one or more FETCH, then a SAY.
- Web access: use `curl -sSL -A 'Mozilla/5.0' <url>`. For web search
  prefer DuckDuckGo's HTML endpoint:
    curl -sSL -A 'Mozilla/5.0' 'https://html.duckduckgo.com/html/?q=QUERY'
  then grep/sed result links. Avoid Google scraping (it blocks bots).
- Sysadmin coverage you should fluently use when relevant:
    memory:        free -h, vmstat, /proc/meminfo
    disks:         df -h, du -sh, lsblk, blkid, mount, findmnt
    usb / eject:   lsusb, lsblk, udisksctl unmount/power-off, eject, umount
    processes:     ps aux, top -b -n1, pgrep, kill, nice, renice
    system info:   uname -a, lsb_release -a, hostnamectl, uptime, who
    network:       ip a, ip r, ss -tulpn, ping, curl, dig, nslookup
    services:      systemctl status/start/stop/restart, journalctl -u
    packages:      apt/dnf/pacman as appropriate (read /etc/os-release if unsure)
    files:         ls, find, stat, file, tree, cat, less, head, tail
    text:          grep, sed, awk, cut, sort, uniq, tr, jq, xargs
    archives:      tar, zip/unzip, gzip, xz, 7z
    git:           git status/log/diff/show/blame, git add/commit/restore,
                   git branch/switch/checkout, git merge/rebase, git stash,
                   git remote -v, git fetch/pull/push, git tag,
                   git ls-files, git grep, git rev-parse, git config.
                   For GitHub operations prefer the `gh` CLI when present
                   (gh repo, gh pr, gh issue, gh release).
- Quote variables and filenames properly. Use `--` where it helps.
- Never use truly destructive commands (`rm -rf /`, `mkfs` on a mounted
  root, fork bomb, etc.). For ordinary file deletion (`rm file.txt`)
  go ahead — the harness will confirm with the user before running it.
- If the request is ambiguous, pick the most reasonable interpretation;
  do not ask questions.
- Conversational input ("hi", "how are you") → reply with SAY.
"""


# ---- destructive command detection ----------------------------------------

# Match anything that meaningfully deletes / overwrites user data.
DESTRUCTIVE_RE = re.compile(
    r"""
    \b(
        rm        |  # remove files
        rmdir     |  # remove dirs
        shred     |  # overwrite + delete
        unlink    |  # delete a single file
        mkfs(\.[a-z0-9]+)? |  # filesystem creation
        wipefs    |  # wipe signatures
        fdisk     |  # partitioning
        parted    |  # partitioning
        sfdisk       # partitioning
    )\b
    |
    \bfind\b[^|;&]*\s-delete\b
    |
    \bdd\b[^|;&]*\bof=/dev/
    |
    >\s*/dev/(sd|nvme|hd|mmc|loop)
    """,
    re.VERBOSE,
)


def looks_destructive(cmd: str) -> bool:
    return bool(DESTRUCTIVE_RE.search(cmd))


def read_key_file() -> str | None:
    for path in API_KEY_FILES:
        try:
            with open(path, "r", encoding="utf-8") as f:
                key = f.read().strip()
            if key:
                return key
        except FileNotFoundError:
            continue
        except PermissionError:
            continue
    return None


# ---- io helpers ------------------------------------------------------------

def die(msg, code=1):
    print(f"ai: {msg}", file=sys.stderr)
    sys.exit(code)


def cyan(s: str) -> str:
    return f"\033[1;36m{s}\033[0m"


def yellow(s: str) -> str:
    return f"\033[1;33m{s}\033[0m"


def dim(s: str) -> str:
    return f"\033[2m{s}\033[0m"


# ---- DeepSeek call ---------------------------------------------------------

def call_deepseek(messages, api_key: str) -> str:
    payload = {
        "model": MODEL,
        "messages": messages,
        "temperature": 0.2,
        "stream": False,
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        die(f"DeepSeek HTTP {e.code}: {body}")
    except urllib.error.URLError as e:
        die(f"network error: {e.reason}")

    try:
        return data["choices"][0]["message"]["content"].strip()
    except (KeyError, IndexError):
        die(f"unexpected response: {data}")


def strip_fences(text: str) -> str:
    t = text.strip()
    if t.startswith("```"):
        lines = t.splitlines()
        lines = lines[1:]
        if lines and lines[-1].strip().startswith("```"):
            lines = lines[:-1]
        t = "\n".join(lines).strip()
    return t


PREFIXES = ("CMD:", "FETCH:", "SAY:", "REFUSE:")


def parse_action(text: str):
    t = strip_fences(text)
    for p in PREFIXES:
        if t.startswith(p):
            return p[:-1], t[len(p):].strip()
    # Fallback: treat as SAY so the user at least sees something.
    return "SAY", t


# ---- command execution -----------------------------------------------------

def confirm(prompt: str) -> bool:
    if not sys.stdin.isatty():
        return False
    try:
        ans = input(prompt).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return ans in ("y", "yes", "k", "kyllä")


def run_cmd_visible(cmd: str) -> int:
    print(cyan(f"$ {cmd}"), file=sys.stderr)
    if looks_destructive(cmd):
        print(yellow("! this command deletes or overwrites data"), file=sys.stderr)
        if not confirm("run? [y/N] "):
            print(dim("aborted."), file=sys.stderr)
            return 130
    return subprocess.run(["bash", "-c", cmd]).returncode


def run_cmd_capture(cmd: str):
    if looks_destructive(cmd):
        # The model tried to delete via FETCH (silently). Block it and tell
        # the model to use CMD instead so the user gets a confirmation.
        return 1, "", "blocked: destructive command must use CMD:, not FETCH:"
    proc = subprocess.run(
        ["bash", "-c", cmd],
        capture_output=True,
        text=True,
        timeout=60,
    )
    return proc.returncode, proc.stdout, proc.stderr


def truncate(s: str, limit: int) -> str:
    if len(s) <= limit:
        return s
    half = limit // 2
    return s[:half] + f"\n…[truncated {len(s) - limit} chars]…\n" + s[-half:]


# ---- usage -----------------------------------------------------------------

def usage():
    print(
        "usage: ai [-n] [-v] <natural language request>\n"
        "\n"
        "  -n    print the suggested command(s) only; do not run\n"
        "  -v    verbose: also show FETCH steps and outputs\n"
        "\n"
        "env:\n"
        "  DEEPSEEK_API_KEY   required\n"
        "\n"
        "examples:\n"
        "  ai list all the files in cwd\n"
        "  ai show how much RAM is free\n"
        "  ai safely eject the USB stick mounted at /media/jukka/USB\n"
        "  ai search the web for the latest python release and tell me the version\n",
        file=sys.stderr,
    )
    sys.exit(2)


# ---- main loop -------------------------------------------------------------

def main(argv):
    args = argv[1:]
    dry_run = False
    verbose = False

    while args and args[0].startswith("-") and args[0] != "-":
        flag = args.pop(0)
        if flag == "-n":
            dry_run = True
        elif flag == "-v":
            verbose = True
        elif flag in ("-h", "--help"):
            usage()
        else:
            die(f"unknown flag: {flag}", 2)

    if not args:
        usage()

    prompt = " ".join(args)

    api_key = os.environ.get("DEEPSEEK_API_KEY") or read_key_file()
    if not api_key:
        die(
            "no API key found. Set $DEEPSEEK_API_KEY or write the key to "
            "~/.config/ai-bash/api-key (or /etc/ai-bash/api-key)."
        )

    messages = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": prompt},
    ]

    for turn in range(MAX_TURNS):
        reply = call_deepseek(messages, api_key)
        kind, body = parse_action(reply)

        if kind == "REFUSE":
            print(f"refused: {body}", file=sys.stderr)
            return 3

        if kind == "SAY":
            print(body)
            return 0

        if kind == "CMD":
            if dry_run:
                print(cyan(f"$ {body}"), file=sys.stderr)
                return 0
            return run_cmd_visible(body)

        if kind == "FETCH":
            if dry_run:
                print(dim(f"[fetch] {body}"), file=sys.stderr)
                # Pretend it returned nothing so the model can finalize.
                obs = "exit=0\nstdout=(dry-run, no output)\nstderr="
            else:
                if verbose:
                    print(dim(f"[fetch] {body}"), file=sys.stderr)
                try:
                    rc, out, err = run_cmd_capture(body)
                except subprocess.TimeoutExpired:
                    rc, out, err = 124, "", "timeout after 60s"
                obs = (
                    f"exit={rc}\n"
                    f"stdout={truncate(out, FETCH_OUTPUT_LIMIT)}\n"
                    f"stderr={truncate(err, 1000)}"
                )
                if verbose:
                    print(dim(obs), file=sys.stderr)

            messages.append({"role": "assistant", "content": reply})
            messages.append({"role": "user", "content": obs})
            continue

    print("ai: gave up after too many turns", file=sys.stderr)
    return 4


if __name__ == "__main__":
    sys.exit(main(sys.argv))
