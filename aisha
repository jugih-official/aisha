def h_compare(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:compare|diff|(?:the\s+)?differences?\s+between|what\s+changed\s+between)\s+(\S+)\s+"
               r"(?:and|with|to|vs\.?|versus|against)\s+(\S+)\s*$")
    if not m:
        return None
    a, b = resolve(u.lit(u.o(m, 1)), u.cwd), resolve(u.lit(u.o(m, 2)), u.cwd)
    if not a or not b:
        return None
    u.text = " " * len(u.text)
    rec = os.path.isdir(os.path.join(u.cwd, os.path.expanduser(a)))
    return Plan(f"diff -u{'r' if rec else ''} -- {qpath(a)} {qpath(b)}", "compare", [f"{a} vs {b}"])


def sed_escape(text: str, replacement: bool = False) -> str:
    chars = "\\/&\n" if replacement else "\\/.*[]^$\n"
    return "".join("\\" + c if c in chars else c for c in text).replace("\\\n", "\\n")


def h_replace(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:replace|substitute|change|swap)\s+(?:all\s+|every\s+)?(?:the\s+(?:word|text|string)\s+)?(\S+)\s+"
               r"(?:with|by|to|into|for)\s+(\S+)\s+(?:in|inside|within|across|throughout)\s+(.+)$")
    if not m:
        return None
    old, new = u.lit(u.o(m, 1)), u.lit(u.o(m, 2))
    if not old:
        return None
    expr = shlex.quote(f"s/{sed_escape(old)}/{sed_escape(new, True)}/g")
    target = u.lit(u.o(m, 3).strip())
    u.text = " " * len(u.text)
    file = resolve(target, u.cwd, "file")
    why = [f'"{old}" → "{new}"', "every occurrence"]
    if file:
        return Plan(f"sed -i {expr} -- {qpath(file)}", "replace", why + [file], destructive=True,
                    preview=f"grep -nF -- {shlex.quote(old)} {qpath(file)}",
                    warning=f"! changes {file} in place")
    sub = Utterance(u.o(m, 3), u.cwd, u.literals)
    spec = FindSpec()
    parse_filters(sub, spec)
    if not spec.exts and not spec.names:
        return None   # never rewrite every file under here from a vague target
    spec.ftype = "f"
    spec.content.append(("content", old, f'"{old}"', old))
    cmd = render_find(spec, f"exec:sed -i {expr}")
    plan = Plan(cmd, "replace", why + [where_label(spec, True)] + spec.why, destructive=True,
                preview=render_find(spec), warning="! changes the files listed above in place")
    return finish(sub, plan, 0, spec)


def h_calc(u: Utterance) -> Plan | None:
    text = " ".join(u.lit(t) for t in u.orig.split())
    m = re.match(r"^\s*(?:what\s+is|what's|calculate|compute|how\s+much\s+is|evaluate|solve)?\s*"
                 r"([\d\s.+\-*/()%^x×÷]+?)\s*\??\s*$", text, re.I)
    if not m or not re.search(r"\d", m.group(1)) or not re.search(r"\d\s*[-+*/%^x×÷]\s*[\d(]", m.group(1)):
        return None
    if re.fullmatch(r"\s*[\d\s]+\s*", m.group(1)):
        return None
    expr = re.sub(r"\s+", "", m.group(1)).replace("^", "**").replace("×", "*").replace("x", "*").replace("÷", "/")
    try:
        compile(expr, "<calc>", "eval")
    except SyntaxError:
        return None
    u.text = " " * len(u.text)
    return Plan(f"python3 -c {shlex.quote(f'print({expr})')}", "calculate", [expr])


# ---- recipes: everyday requests with a fixed shape ---------------------------------
# One table instead of a handler each. A recipe has patterns (on the masked,
# lower-case text; named groups are slots), slot types, and a command: a
# template, a list of (tool, template) alternatives, or a function. Slot
# values are resolved and quoted before they reach the template.

WEB_DOMAIN = (r"[\w-]+(?:\.[\w-]+)*\.(?:com|org|net|io|fi|dev|ai|edu|gov|de|uk|eu|se|no|dk|co|me|info|app|tv|"
              r"xyz|ly|gg|so|to|sh|us|ca|au|nl|fr|it|es|ch|at|be|pl|ru|jp|in|br)(?:/\S*)?")
GUI = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
UNITS_S = {"s": 1, "sec": 1, "second": 1, "m": 60, "min": 60, "minute": 60, "h": 3600, "hr": 3600,
           "hour": 3600, "d": 86400, "day": 86400}
APPS = {  # what people call it -> command
    "firefox": "firefox", "browser": "x-www-browser", "chrome": "google-chrome", "chromium": "chromium",
    "vs code": "code", "vscode": "code", "code": "code", "text editor": "gnome-text-editor", "gedit": "gedit",
    "files": "nautilus", "file manager": "nautilus", "nautilus": "nautilus", "terminal": "x-terminal-emulator",
    "calculator": "gnome-calculator", "settings": "gnome-control-center", "system monitor": "gnome-system-monitor",
    "thunderbird": "thunderbird", "libreoffice": "libreoffice", "gimp": "gimp", "vlc": "vlc", "spotify": "spotify",
    "steam": "steam", "discord": "discord", "slack": "slack", "telegram": "telegram-desktop", "obs": "obs",
}


def _seconds(n: str, unit: str) -> int:
    u = re.sub(r"s$", "", unit.lower())
    return int(float(n) * UNITS_S.get(u, UNITS_S.get(u[:3], 60)))


def _tz(city: str) -> str | None:
    want = re.sub(r"\s+", "_", city.strip().lower()).split("/")[-1]
    for root, _, files in os.walk("/usr/share/zoneinfo"):
        if "/posix" in root or "/right" in root:
            continue
        for f in files:
            if f.lower() == want:
                return os.path.relpath(os.path.join(root, f), "/usr/share/zoneinfo")
    return None


def _archive_list(v, u):
    f, low = v["file"], v["file"].lower()
    if re.search(r"\.(zip|jar|whl|apk)'?$", low):
        return first_available([("unzip", f"unzip -l {f}"), (None, f"python3 -m zipfile -l {f}")])
    if re.search(r"\.(tar(\.(gz|bz2|xz|zst))?|tgz|tbz2|txz)'?$", low):
        return f"tar -tvf {f}"
    if low.rstrip("'").endswith(".deb"):
        return f"dpkg -c {f}"
    if low.rstrip("'").endswith(".7z"):
        return f"7z l {f}"
    return None


def _owner_pkg(v, u):
    p = u.lit(v["_raw_path"])
    if "/" in p:
        return f"dpkg -S -- {qpath(p)}"
    if shutil.which(p):
        return f'dpkg -S -- "$(readlink -f "$(command -v {shlex.quote(p)})")"'
    return None


def _date_math(v, u):
    n, unit = v["n"], re.sub(r"s$", "", v["unit"])
    sign = "-" if "ago" in v["when"] else "+"
    return f"date -d '{sign}{n} {unit}' '+%A %d %B %Y'"


def _websearch(v, u):
    q = urllib.parse.quote_plus(" ".join(u.lit(w) for w in v["_raw_text"].split()))
    url = shlex.quote(f"https://duckduckgo.com/?q={q}")
    return f"xdg-open {url}" if GUI and shutil.which("xdg-open") else f"echo {url}"


def _app(v, u):
    name = APPS.get(re.sub(r"\s+", " ", v["_raw_app"].lower()))
    if not name or not GUI or not shutil.which(name):
