class ExitShell(Exception):
    def __init__(self, code: int = 0):
        super().__init__(code)
        self.code = code


@dataclass
class Job:
    num: int
    pid: int
    cmd: str
    state: str = "running"          # running | stopped | done
    files: tuple = ()
    tmodes: list | None = None      # terminal settings to restore on fg


# Commands that take over the terminal and then hand it back as-is.
RISKY_RE = re.compile(
    r"""\bsudo\b | \bsu\s | \b(?:reboot|shutdown|poweroff|halt)\b | \bchmod\s+-R\b | \bchown\b
      | \b(?:curl|wget)\b[^|]*\|\s*(?:sudo\s+)?(?:ba|z|da)?sh\b | \bkill\s+-9\b | \bkillall\b
      | \bsystemctl\s+(?:stop|disable|mask|restart)\b | \bcrontab\s+-r\b | \bpasswd\b
      | \buser(?:del|mod)\b | \bapt(?:-get)?\s+(?:remove|purge|autoremove)\b
      | >\s*/etc/ | \bmv\b[^|;&]*\s/dev/null\b | :\(\)\s*\{
      | \bsed\b[^|;&]*\s(?:-[a-zA-Z]*i|--in-place) | \brsync\b[^|;&]*--(?:delete|remove-source-files)
      | \bgit\s+(?:checkout\s+(?:--\s|\.)|restore\b|push\b[^|;&]*(?:\s-f\b|--force)|branch\s+-D
                 |stash\s+(?:drop|clear)|clean\b|reset\b)
      | (?<![<>&\d])>(?![>&])\s*(?!/dev/null\b)[^\s|&;]   # > file truncates it
      | \bchmod\s+(?:-\w*R|--recursive) | \b(?:ba|z|da)?sh\s+<\(\s*(?:curl|wget)
      | \b(?:pkill|kill|killall)\s+-(?:9|KILL|SIGKILL)\b
      | \b(?:cp|cat|tee|dd|pv)\b[^|;&]*\s/dev/(?:sd|nvme|hd|mmc|loop|vd|xvd|md|dm-)
      | \bpython3?\b.*?(?:rmtree|os\.remove|os\.unlink|\.unlink\(|os\.rmdir|truncate)
      | \bapt(?:-get)?\s+install\b | \bdpkg\s+-[ir]\b | \buseradd\b | \bsystemctl\s+(?:start|enable)\b""",
    re.VERBOSE,
)


def needs_care(cmd: str) -> bool:
    return looks_destructive(cmd) or bool(RISKY_RE.search(cmd))


# Bash's own and per-run variables: never carried to the next line.
SPECIAL_VARS = re.compile(r"(?:BASH\w*|EUID|UID|PPID|SHELLOPTS|FUNCNAME|GROUPS|LINENO|RANDOM|SRANDOM|SECONDS|"
                          r"EPOCH\w*|PIPESTATUS|HISTCMD|_|__aisha_\w*|COMP_\w*|DIRSTACK|SHLVL|PWD|OLDPWD|"
                          r"OPTIND|IFS|PS4|COLUMNS|LINES)$")


def shell_vars(dump: str) -> str:
    """From `declare -p; umask -p; shopt -p`: plain (not exported, not readonly)
    variables, the umask and shell options, ready to source."""
    out = []
    for entry in re.split(r"\n(?=declare -|umask |shopt )", dump.strip()):
        m = re.match(r"declare -([-\w]*) ([A-Za-z_]\w*)", entry)
        if m:
            if "x" in m.group(1) or "r" in m.group(1) or SPECIAL_VARS.match(m.group(2)):
                continue
            if "=" not in entry.split("\n", 1)[0]:
                continue  # declared but unset
        elif not entry.startswith(("umask ", "shopt ")):
            continue
        out.append(entry)
    return "\n".join(out) + "\n"


def kill_tree(pid: int, sig: int) -> None:
    """Signal a process and everything it started (children first), via /proc."""
    kids: dict[int, list[int]] = {}
    for entry in os.listdir("/proc"):
        if entry.isdigit():
            try:
                with open(f"/proc/{entry}/stat") as f:
                    ppid = int(f.read().rsplit(")", 1)[1].split()[1])
            except (OSError, IndexError, ValueError):
                continue
            kids.setdefault(ppid, []).append(int(entry))
    order, todo = [], [pid]
    while todo:
        p = todo.pop()
        order.append(p)
        todo += kids.get(p, [])
    for p in reversed(order):
        try:
            os.kill(p, sig)
        except (ProcessLookupError, PermissionError):
            pass


def git_branch(cwd: str) -> str:
    """Current git branch (or short commit) by reading .git/HEAD; no git needed."""
    d = cwd
    while True:
        head = os.path.join(d, ".git", "HEAD")
        if os.path.isfile(head):
            try:
                with open(head) as f:
                    ref = f.read().strip()
            except OSError:
                return ""
            return ref[16:] if ref.startswith("ref: refs/heads/") else ref[:7]
        parent = os.path.dirname(d)
        if parent == d:
            return ""
        d = parent


class Shell:
    def __init__(self, cfg: dict, dry_run: bool = False, interactive: bool = False):
        self.cfg = cfg
        self.dry_run = dry_run
        try:
            self.cwd = os.getcwd()
        except OSError:
            self.cwd = os.path.expanduser("~")
        self.env = dict(os.environ)
        self.env["AISHA"] = VERSION
        self.rc = 0
        self.memory = Memory(LEARNED_FILE)
        self.llm = LLM(cfg)
        self.jobs: list[Job] = []
        self.names: set[str] = set()        # aliases and functions, for shell detection
        self.tty = sys.stdin.fileno() if interactive and sys.stdin.isatty() else None
        self.workdir = tempfile.mkdtemp(prefix="aisha-")
        self.defs_file = os.path.join(self.workdir, "defs.sh")
        self._seq = 0
        self._exit_warned = False
        self._cmd_cache: tuple | None = None
        self.child_stdin: int | None = None      # fd for commands' stdin (--lines)
        self.last_line = ""                       # for "again"
        atexit.register(shutil.rmtree, self.workdir, True)
        if self.tty is not None:
            for sig in (signal.SIGTSTP, signal.SIGTTOU, signal.SIGTTIN, signal.SIGQUIT):
                signal.signal(sig, signal.SIG_IGN)
        self.load_rc()

    def load_rc(self) -> None:
        """Aliases, functions and exports from ~/.bash_aliases and aisharc."""
        files = [os.path.expanduser(f) for f in RC_FILES if os.path.isfile(os.path.expanduser(f))]
        if files:
            self.run("\n".join(f". {shlex.quote(f)}" for f in files))

    # -- entry point for one line
    def handle(self, line: str) -> int:
        line = line.strip()
        if not line or line.startswith("#"):
            return self.rc
        try:
            toks = shlex.split(line)
        except ValueError:
            toks = line.split()
        word = toks[0] if toks else ""
        if word in ("exit", "quit", "logout", "bye") and len(toks) <= 2:
            if any(j.state == "stopped" for j in self.jobs) and not self._exit_warned:
                self._exit_warned = True
                say("There are stopped jobs. ('exit' again to leave anyway)")
                return 1
            raise ExitShell(int(toks[1]) if len(toks) == 2 and toks[1].isdigit() else self.rc)
        low = line.lower().strip(" ?!.")
        if line in ("help", "?") or low in (
                "what can you do", "what can i ask", "what can i say", "what can you help with", "what do you understand",
                "help me", "examples", "show examples", "show me examples", "commands", "what can i do"):
            say(HELP)
            return 0
        if CHATTER.fullmatch(low):          # "yes" would run yes(1), which prints y forever
            say(dim("you're welcome" if low.startswith("thank") else
                    "nothing is waiting for an answer: say what to do, or 'help'"))
            return 0
        if GREETING.fullmatch(low):
            if re.match(r"(?:who|what)\s+are\s+you", low):
                say(f"I'm {NAME} ({TAGLINE}), a shell you can talk to: type bash as usual, or say what you "
                    f"want done. Start me with: aisha")
            else:
                say(("Hi! " if not low.startswith("how") else "") + "All good here, ready when you are.")
            say(dim("  try: show the biggest files here · what's using my memory · find pdfs older than a month · help"))
            return 0
        if low in ("again", "repeat", "repeat that", "do it again", "do that again", "run it again",
                   "run that again", "same again", "once more") or line == "!!":
            if not self.last_line:
                say(dim("nothing to repeat yet"))
                return 1
            say(dim("↻ " + self.last_line))
            return self.handle(self.last_line)
        if line == "learned":
            for k, v in sorted(self.memory.data.items()):
                say(f"{cyan(v.get('pattern', k))}\n  $ {v['command']}  {dim('(used %d×)' % v.get('uses', 1))}")
            if not self.memory.data:
                say(dim("nothing learned yet"))
            return 0
        if word == "teach":
            m = re.match(r"teach\s+(.+?)\s+=\s+(.+)$", line)
            if not m:
                say("usage: teach <what you say> = <bash command>   e.g. teach backup {dir} = tar -czf {dir}.tgz {dir}")
                return 1
            pattern, template = self.memory.teach(m.group(1), m.group(2))
            say(f"learned: “{pattern}” → {template}")
            return 0
        if word == "forget":
            say("forgotten" if self.memory.forget(line[6:].strip()) else dim("not in memory"))
            return 0
        if line == "llm":
            return self.llm_status()
        if line == "history":
            return self.show_history()
        self.last_line = line
        if word in ("jobs", "fg", "bg") and len(toks) <= 2:
            return getattr(self, "job_" + word)(toks[1] if len(toks) == 2 else None)
        if word == "explain":
            saved, self.dry_run = self.dry_run, True
            try:
                return self.natural(line[7:].strip())
            finally:
                self.dry_run = saved
        if word == "kill" and any(t.startswith("%") for t in toks[1:]):
            return self.job_kill(toks[1:])
        if line.startswith("!"):
            return self.shell_line(line[1:].strip())
        if line.startswith("?"):
            self.rc = self.via_llm(line[1:].strip(), interpret(line[1:].strip(), self.cwd))
            return self.rc
        polite = strip_politeness(line)
        if polite != line and (POLITE_HEAD.match(line) or not looks_like_shell(line, self.env.get("PATH"))):
            line = polite                      # "go ahead and show README.md" -> "show README.md"
        if self.memory.match(line):           # what you taught wins over guessing (! still forces bash)
            return self.natural(line)
        if looks_like_shell(line, self.env.get("PATH"), self.cwd, self.cfg["threshold"], self.names):
            return self.shell_line(line)
        self.rc = self.natural(line)
        return self.rc

    def shell_line(self, line: str) -> int:
        if self.dry_run:
            say(bold("$ ") + line)
            say(dim("(bash line; dry run, not run)"))
            return 0
        self.rc = self.run_line(line)
        return self.rc

    def job_kill(self, args: list[str]) -> int:
        """kill [-SIG] %N: signal one of aisha's jobs (bash's %N means nothing to bash -c)."""
        sig, rc = signal.SIGTERM, 0
        targets = []
        it = iter(args)
        for a in it:
            if a == "-s":
                a = "-" + next(it, "TERM")
            if a == "--":
                continue
            if a.startswith("-") and not targets:   # -9, -KILL, -SIGTERM
                name = a[1:].upper()
                try:
                    sig = signal.Signals(int(name)) if name.isdigit() else signal.Signals[
                        name if name.startswith("SIG") else "SIG" + name]
                except (KeyError, ValueError):
                    say(f"kill: {a}: invalid signal")
                    return 1
            else:
                targets.append(a)
        for t in targets:
            job = self._pick_job(t, ("stopped", "running")) if t.startswith("%") else None
            try:
                if job:
                    os.killpg(job.pid, sig)
                    if sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT) and job.state == "stopped":
                        os.killpg(job.pid, signal.SIGCONT)
                elif t.lstrip("-").isdigit():
                    os.kill(int(t), sig)
                else:
                    rc = 1
            except (ProcessLookupError, PermissionError) as e:
                say(f"kill: {t}: {e.strerror}")
                rc = 1
        return rc

    def run_line(self, line: str) -> int:
        m = re.fullmatch(r"(.*?[^&])\s*&\s*", line)    # "cmd &" but not "a && b"
        if m and self.tty is not None:
            return self.run(m.group(1), background=True)
        return self.run(line)

    def natural(self, line: str) -> int:
        remembered = self.memory.match(line)
        if remembered:
            plan = Plan(remembered, "remembered", ["you taught or approved this"], source="learned",
                        destructive=needs_care(remembered))
            return self.execute(plan)
        plan = interpret(line, self.cwd)
        if plan and plan.confidence >= self.cfg["threshold"]:
            return self.execute(plan)
        return self.unsure(line, plan)

    def unsure(self, line: str, partial: Plan | None) -> int:
        """The rules are not sure: offer the built-in model's closest matches, the
        rules' guess, the language model (if set up), or teaching by example."""
        options = suggest(line, self.cwd, self.cfg["threshold"])
        choices = [(phrase, plan) for phrase, plan, _ in options]
        if partial and partial.command not in [p.command for _, p in choices] and partial.confidence >= 0.4:
            partial.source = "guess"
            choices.append(("(best guess) " + partial.rationale(), partial))
        best = max((s for _, _, s in options), default=0.0)
        if self.llm.enabled and not self.dry_run and (not choices or best < STRONG_SUGGESTION):
            # nothing close: the language model goes first; the list only if it can't help
            rc = self.via_llm(line, partial, fall_back=not choices)
            if rc is not None:
                return rc
        if choices:
            say(yellow("Not sure — closest things I know:"))
            for i, (phrase, plan) in enumerate(choices, 1):
                say(f"  {bold(str(i))}) {phrase}")
                say(dim(f"     $ {plan.command}"))
        else:
            say(yellow("I don't know that one yet."))
        if self.dry_run:
            return 1
        hint = ((f"1–{len(choices)} to run, " if len(choices) > 1 else "1 to run, ") if choices else "") + \
            "type the bash command to teach me"
        hint += ", ? to ask the language model" if self.llm.enabled else ""
        ans = ask(f"{hint}, or Enter to skip: ")
        if ans is None or not ans.strip():
            return 1
        ans = ans.strip()
        if ans == "?" and self.llm.enabled:
            return self.via_llm(line, partial)
        if ans.isdigit() and 1 <= int(ans) <= len(choices):
            plan = choices[int(ans) - 1][1]
            plan.source = "rules"
            rc = self.execute(plan)
            if rc == 0:
                self._learned(line, plan.command)
            return rc
        rc = self.run_line(ans)
        if rc == 0:
            self._learned(line, ans)
        else:
            say(dim("(not learned: the command failed)"))
        return rc

    def _learned(self, phrase: str, command: str) -> None:
        pattern, template = self.memory.learn(phrase, command)
        say(dim(f"learned: “{pattern}” → {template}"))

    def via_llm(self, line: str, partial: Plan | None, fall_back: bool = True) -> int | None:
        """Ask the language model. With fall_back=False, None if it could not help."""
        if not self.llm.enabled:
            say(red("the LLM is turned off (AISHA_LLM=off)"))
            return 1
        hints = ""
        if partial:
            hints = f"{partial.rationale()}; draft command: {partial.command}"
            if partial.unknown:
                hints += f"; words the rules could not place: {' '.join(partial.unknown)}"
        say(dim(f"… rules not sure, asking {self.cfg['llm_model']}"))
        t0 = time.time()
        try:
            cmd = self.llm.command_for(line, self.cwd, hints)
        except LLMError as e:
            say(red(f"LLM: {e}"))
            if not fall_back:
                return None
            if partial:
                say(yellow("falling back to the rules' best guess:"))
                partial.source = "guess"
                return self.execute(partial)
            say(yellow("The rules don't know this request yet either.") +
                dim(" Rephrase it, type the bash command, or paste it to the aisha project so it can be added."))
            return 1
        if not cmd:
            if not fall_back:
                return None
            say(yellow("that does not look like something a shell command can do."))
            return 1
        plan = Plan(cmd, "llm", [f"{self.cfg['llm_model']}, {time.time() - t0:.1f}s"], source="llm",
                    destructive=needs_care(cmd))
        if plan.destructive and not looks_destructive(cmd):
            plan.warning = "! this needs extra privileges or changes the system"
        return self.execute(plan, phrase=line)

    # -- showing and running a plan
    def execute(self, plan: Plan, phrase: str | None = None) -> int:
        say(dim("→ " + plan.rationale()))
        say(bold("$ ") + plan.command)
        if self.dry_run or plan.show_only:
            return 0
        need = plan.destructive or self.cfg["confirm"] == "always" or \
            (self.cfg["confirm"] == "llm" and plan.source in ("llm", "guess"))
        if plan.destructive and plan.preview:
            self.show_preview(plan.preview)
        if need:
            if plan.destructive:
                say(yellow(plan.warning or "! this deletes or changes things"))
                ans = ask("run? [y/N] ")
                ok = ans is not None and ans.strip().lower() in ("y", "yes")
            else:
                ans = ask("run? [Y/n] ")
                ok = ans is not None and ans.strip().lower() in ("", "y", "yes")
            if not ok:
                say(dim("skipped"))
                return 1
        rc = self.run(plan.command)
        if plan.source == "llm" and phrase and rc == 0:
            self.memory.remember(phrase, plan.command)
            say(dim("(remembered — next time this runs without the LLM)"))
        return rc

    def show_preview(self, cmd: str) -> None:
        r = subprocess.run(["bash", "-c", cmd], cwd=self.cwd, env=self.env,
                           capture_output=True, text=True)
        lines = r.stdout.splitlines()
        if not lines:
            say(dim("(nothing matches)"))
            return
        say(dim(f"{len(lines)} match{'es' if len(lines) != 1 else ''}:"))
        for l in lines[:10]:
            say(dim("  " + l))
        if len(lines) > 10:
            say(dim(f"  … and {len(lines) - 10} more"))

    # -- running bash, keeping cd/export/alias/function effects
    SCRIPT_HEAD = (
        '__aisha_state=$1 __aisha_defs=$2 __aisha_out=$3; set --\n'
        '__aisha_save() { __aisha_rc=$?; { printf "%s\\0" "$PWD"; env -0; } > "$__aisha_state" 2>/dev/null; '
        '{ alias -p; declare -f; echo "#__aisha_vars__"; declare -p; umask -p; shopt -p; } '
        '> "$__aisha_out" 2>/dev/null; exit $__aisha_rc; }\n'
        'trap __aisha_save EXIT\n'
        'shopt -s globstar extglob expand_aliases 2>/dev/null\n'
        '[ -r "$__aisha_defs" ] && . "$__aisha_defs"\n'
    )

    def run(self, cmd: str, background: bool = False, track: bool = True) -> int:
        self._seq += 1
        state = os.path.join(self.workdir, f"state-{self._seq}")
        defs_out = os.path.join(self.workdir, f"defs-{self._seq}")
        script = self.SCRIPT_HEAD + cmd + "\n"
        env = dict(self.env, PWD=self.cwd)
        job_control = self.tty is not None
        tmodes = self._tmodes()
        pid = os.fork()
        if pid == 0:  # child
            try:
                if job_control:
                    os.setpgid(0, 0)
                    if not background:
                        try:
                            os.tcsetpgrp(self.tty, os.getpid())   # SIGTTOU is still ignored here
                        except OSError:
                            pass
                for sig in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGTTIN,
                            signal.SIGTTOU, signal.SIGPIPE, signal.SIGXFSZ, signal.SIGCHLD):
                    signal.signal(sig, signal.SIG_DFL)
                if self.child_stdin is not None:
                    os.dup2(self.child_stdin, 0)
                try:
                    os.chdir(self.cwd)
                except OSError:
                    os.chdir("/")
                os.execvpe("bash", ["bash", "-c", script, "aisha", state, self.defs_file, defs_out], env)
            except BaseException:
                pass
            os._exit(127)
        job = Job(self._next_job_num(), pid, cmd, files=(state, defs_out))
        if job_control:
            try:
                os.setpgid(pid, pid)
            except OSError:
                pass
        if background:
            self.jobs.append(job)
            say(f"[{job.num}] {pid}")
            return 0
        if job_control:
            self._give_terminal(pid)
        rc = self._wait(job, tmodes)
        if job.state == "done":
            if track:
                self._apply_state(state, defs_out)
            self._cleanup(job)
        return rc

    def _wait(self, job: Job, tmodes) -> int:
        old = None if self.tty is not None else signal.signal(signal.SIGINT, signal.SIG_IGN)
        rc = 0
        try:
            while True:
                try:
                    _, status = os.waitpid(job.pid, os.WUNTRACED if self.tty is not None else 0)
                except InterruptedError:
                    continue
                except ExitShell as e:          # aisha is being hung up / terminated
                    if self.tty is not None:
                        try:
                            os.killpg(job.pid, e.code - 128)
                        except (ProcessLookupError, PermissionError, ValueError):
                            pass
                    else:
                        kill_tree(job.pid, e.code - 128)
                    raise
                except ChildProcessError:
                    job.state = "done"
                    break
                if os.WIFSTOPPED(status):
                    job.state = "stopped"
                    job.tmodes = self._tmodes()
                    if job not in self.jobs:
                        self.jobs.append(job)
                    rc = 128 + os.WSTOPSIG(status)
                    say(f"\n[{job.num}]+  Stopped                 {job.cmd}")
                    break
                rc = os.WEXITSTATUS(status) if os.WIFEXITED(status) else 128 + os.WTERMSIG(status)
                job.state = "done"
                break
        finally:
            if old is not None:
                signal.signal(signal.SIGINT, old)
            if self.tty is not None:
                self._give_terminal(os.getpgrp())
                self._restore_tmodes(tmodes)
        return rc

    def _tmodes(self):
        if self.tty is None:
            return None
        try:
            return termios.tcgetattr(self.tty)
        except termios.error:
            return None

    def _restore_tmodes(self, modes) -> None:
        if self.tty is not None and modes:
            try:
                termios.tcsetattr(self.tty, termios.TCSADRAIN, modes)
            except termios.error:
                pass

    def _give_terminal(self, pgid: int) -> None:
        try:
            os.tcsetpgrp(self.tty, pgid)
        except OSError:
            pass

    def _next_job_num(self) -> int:
        return max((j.num for j in self.jobs), default=0) + 1

    def _cleanup(self, job: Job) -> None:
        for f in job.files:
            try:
                os.unlink(f)
            except OSError:
                pass

    def _apply_state(self, state: str, defs_out: str) -> None:
        try:
            with open(state, "rb") as f:
                raw = f.read()
        except OSError:
            raw = b""
        if raw:
            parts = raw.split(b"\0")
            new_cwd = parts[0].decode(errors="replace")
            new_env = {}
            for item in parts[1:]:
                if b"=" in item:
                    k, v = item.split(b"=", 1)
                    new_env[k.decode(errors="replace")] = v.decode(errors="replace")
            for k in ("_", "SHLVL", "BASHOPTS", "SHELLOPTS"):
                new_env.pop(k, None)
            if new_env:
                self.env = new_env
            if new_cwd and os.path.isdir(new_cwd) and new_cwd != self.cwd:
                self.env["OLDPWD"] = self.cwd
                self.cwd = new_cwd
        try:
            with open(defs_out, encoding="utf-8", errors="replace") as f:
                defs = f.read()
        except OSError:
            return
        defs, _, rest = defs.partition("#__aisha_vars__\n")
        # keep everything but our own helper function
        defs = re.sub(r"(?ms)^__aisha_\w+ \(\) \n\{.*?^\}\n?", "", defs)
        with open(self.defs_file, "w") as f:
            f.write(defs + "\n" + shell_vars(rest))
        self.names = set(re.findall(r"(?m)^alias ([^=\s]+)=", defs)) | \
            {n for n in re.findall(r"(?m)^(\S+) \(\) $", defs) if not n.startswith("__aisha")}

    # -- jobs
    def _pick_job(self, spec: str | None, want: tuple = ("stopped", "running")) -> Job | None:
        self.reap(quiet=True)
        jobs = [j for j in self.jobs if j.state in want]
        if spec:
            n = spec.lstrip("%")
            jobs = [j for j in jobs if str(j.num) == n or j.cmd.split()[0] == n]
        if not jobs:
            say(f"{'fg' if 'running' in want else 'bg'}: no such job")
            return None
        return jobs[-1]

    def job_jobs(self, _arg=None) -> int:
        self.reap()
        for j in self.jobs:
            say(f"[{j.num}]{'+' if j is self.jobs[-1] else ' '}  {j.state.capitalize():<22}  {j.cmd}")
        return 0

    def job_fg(self, spec: str | None) -> int:
        if self.tty is None:
            say("fg: no job control in this shell")
            return 1
        job = self._pick_job(spec)
        if not job:
            return 1
        say(job.cmd)
        tmodes = self._tmodes()
        self._give_terminal(job.pid)
        self._restore_tmodes(job.tmodes)
        try:
            os.killpg(job.pid, signal.SIGCONT)
        except ProcessLookupError:
            pass
        job.state = "running"
        self.rc = self._wait(job, tmodes)
        if job.state == "done":
            self.jobs.remove(job)
            self._cleanup(job)
        return self.rc

    def job_bg(self, spec: str | None) -> int:
        job = self._pick_job(spec, ("stopped",))
        if not job:
            return 1
        try:
            os.killpg(job.pid, signal.SIGCONT)
        except ProcessLookupError:
            pass
        job.state = "running"
        say(f"[{job.num}]+ {job.cmd} &")
        return 0

    def reap(self, quiet: bool = False) -> None:
        for job in list(self.jobs):
            try:
                pid, status = os.waitpid(job.pid, os.WNOHANG | os.WUNTRACED | os.WCONTINUED)
            except ChildProcessError:
                pid, status = job.pid, 0
            if pid == 0:
                continue
            if os.WIFSTOPPED(status):
                job.state = "stopped"
            elif os.WIFCONTINUED(status):
                job.state = "running"
            else:
                self.jobs.remove(job)
                self._cleanup(job)
                if not quiet:
                    say(f"[{job.num}]+  Done                    {job.cmd}")

    def hangup_jobs(self) -> None:
        for job in self.jobs:
            for sig in (signal.SIGHUP, signal.SIGCONT):
                try:
                    os.killpg(job.pid, sig)
                except (ProcessLookupError, PermissionError):
                    pass

    # -- misc builtins
    def llm_status(self) -> int:
        if not self.llm.enabled:
            say("No language model set up; aisha uses its rules and built-in model. Add one with: aisha --setup")
            return 1
        say(f"LLM: {self.llm.label}")
        try:
            t0 = time.time()
            cmd = self.llm.command_for("list the files here", self.cwd, "")
            say(green(f"ok ({time.time() - t0:.1f}s): ") + str(cmd))
            return 0
        except LLMError as e:
            say(red(str(e)))
            return 1

    def show_history(self) -> int:
        try:
            import readline
            n = readline.get_current_history_length()
            for i in range(max(1, n - 50), n + 1):
                item = readline.get_history_item(i)
                if item:
                    print(f"{i:5}  {item}")
        except ImportError:
            pass
        return 0

    # -- interactive loop
    def prompt(self) -> str:
        home = os.path.expanduser("~")
        where = "~" + self.cwd[len(home):] if self.cwd == home or self.cwd.startswith(home + "/") else self.cwd
        if len(where) > 40:
            where = "…/" + "/".join(where.rstrip("/").split("/")[-2:])
        mark = "❯"                      # red when the last command failed (in colour)
        branch = git_branch(self.cwd) if self.cfg.get("prompt_git", False) else ""
        if not (sys.stdout.isatty() and not os.environ.get("NO_COLOR")):
            return f"{NAME} {where}{' git:' + branch if branch else ''} {mark} "
        # \001..\002 tell readline the escapes take no width
        c = lambda code, s: f"\001\033[{code}m\002{s}\001\033[0m\002"
        git = f" {c('2', 'git:')}{c('35', branch)}" if branch else ""
        return f"{c('36', NAME)} {c('34', where)}{git} {c('32' if self.rc == 0 else '31', mark)} "

    def repl(self) -> int:
        try:
            import readline
            os.makedirs(CFG_DIR, exist_ok=True)
            try:
                readline.read_history_file(HISTORY_FILE)
            except OSError:
                pass
            readline.set_history_length(5000)
            readline.set_completer_delims(" \t\n;|&><=")
            readline.set_completer(self.complete)
            if "libedit" in (readline.__doc__ or "") or getattr(readline, "backend", "") == "editline":
                readline.parse_and_bind("bind ^I rl_complete")
            else:
                readline.parse_and_bind("tab: complete")
        except ImportError:
            readline = None
        if self.cfg["banner"]:
            llm = f"; language model: {self.llm.label}" if self.llm.enabled else ""
            say(dim(f"{NAME} {VERSION} ({TAGLINE}) — type bash or plain words. 'help' for examples{llm}"))
        code = None
        while code is None:
            self.reap()
            try:
                line = input(self.prompt())
            except EOFError:
                say()
                break
            except KeyboardInterrupt:
                say("^C")
                continue
            except ExitShell as e:   # hangup or termination at the prompt
                code = e.code
                break
            try:
                self.handle(line)
            except ExitShell as e:
                code = e.code
            except KeyboardInterrupt:
                say("^C")
            except Exception as e:  # never lose the session to a bug
                say(red(f"aisha: internal error: {type(e).__name__}: {e}"))
                if os.environ.get("AISHA_DEBUG"):
                    import traceback
                    traceback.print_exc()
                self.rc = 1
        self.hangup_jobs()
        if readline:
            try:
                readline.write_history_file(HISTORY_FILE)
            except OSError:
                pass
        return self.rc if code is None else code

    def complete(self, text: str, state: int):
        if state == 0:
            self._matches = self._completions(text)
        return self._matches[state] if state < len(self._matches) else None

    def _completions(self, text: str) -> list[str]:
        try:
            import readline
            before = readline.get_line_buffer()[:readline.get_begidx()]
        except (ImportError, AttributeError):
            before = ""
        first_word = not before.strip() or re.search(r"(?:\|\||&&|[|;&!(])\s*$", before)
        if first_word and not text.startswith(("/", ".", "~")) and "/" not in text:
            return sorted(n for n in self._command_names() if n.startswith(text))[:300]
        base = os.path.expanduser(text)
        pattern = (base if os.path.isabs(base) else os.path.join(self.cwd, base)) + "*"
        out = []
        for m in sorted(globmod.glob(pattern)):
            shown = m if os.path.isabs(base) else os.path.relpath(m, self.cwd)
            if text.startswith("~"):
                shown = "~" + m[len(os.path.expanduser("~")):]
            if text.startswith("./") and not shown.startswith("./"):
                shown = "./" + shown
            out.append(shown + ("/" if os.path.isdir(m) else ""))
        return out

    def _command_names(self) -> set[str]:
        path = self.env.get("PATH", "")
        if not self._cmd_cache or self._cmd_cache[0] != path:
            names = set()
            for d in path.split(":"):
                try:
                    for e in os.scandir(d or "."):
                        if os.access(e.path, os.X_OK) and not e.is_dir():
                            names.add(e.name)
                except OSError:
                    pass
            self._cmd_cache = (path, names)
        return self._cmd_cache[1] | self.names | SHELL_BUILTINS | {
            "help", "learned", "forget", "llm", "explain", "jobs", "fg", "bg"}


