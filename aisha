def pkg_manager() -> str | None:
    for pm in ("apt", "dnf", "pacman", "zypper", "apk", "brew"):
        if shutil.which(pm):
            return pm
    return None


def sudo() -> str:
    """'sudo ' unless already root (Debian without sudo: run aisha as root)."""
    geteuid = getattr(os, "geteuid", None)
    return "" if geteuid and geteuid() == 0 else "sudo "


INSTALL = {"apt": "apt install", "dnf": "dnf install", "pacman": "pacman -S",
           "zypper": "zypper install", "apk": "apk add", "brew": "install"}
UNINSTALL = {"apt": "apt remove", "dnf": "dnf remove", "pacman": "pacman -R",
             "zypper": "zypper remove", "apk": "apk del", "brew": "uninstall"}


def install_cmd(pkgs: list[str], remove: bool = False) -> str | None:
    pm = pkg_manager()
    if not pm:
        return None
    verb = (UNINSTALL if remove else INSTALL)[pm]
    if pm == "brew":
        return f"brew {verb} {' '.join(pkgs)}"
    return f"{sudo()}{verb} {' '.join(pkgs)}"


def require(plan: Plan, reqs: list) -> Plan:
    """Prefix an install step when a tool the plan needs is missing."""
    missing = [(c, p) for c, p in reqs if not shutil.which(c)]
    if not missing:
        return plan
    names = ", ".join(c for c, _ in missing)
    pkgs = [p for _, p in missing if p]
    inst = install_cmd(pkgs) if len(pkgs) == len(missing) else None
    if inst:
        plan.command = f"{inst} && {plan.command}"
        plan.why.append(f"{names} is not installed — installs {' '.join(pkgs)} first")
        plan.destructive = True
        note = f"! installs {' '.join(pkgs)} first (needs your password)"
        plan.warning = f"{plan.warning}\n{note}" if plan.warning else note
    else:
        plan.why.append(f"{names} is not installed")
    return plan


def process_running(name: str) -> bool:
    """Is there a process with this command name (from /proc, no tools needed)?"""
    name = name.lower()
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return False
    for pid in pids:
        try:
            with open(f"/proc/{pid}/comm") as f:
                comm = f.read().strip().lower()
        except OSError:
            continue
        if comm == name or comm.startswith(name) and len(name) >= 4:
            return True
    return False


def h_process(u: Utterance) -> Plan | None:
    m = u.peek(r"\bis\s+(\S+)\s+(?:running|up|alive|active)(?:\s+(?:now|right\s+now))?\s*$")
    if m:
        u.text = " " * len(u.text)
        name = u.lit(u.o(m, 1))
        return Plan(f"pgrep -a -- {shlex.quote(name)}", "processes", [f"is {name} running"])
    m = u.peek(r"\b(start|stop|restart|reload|enable|disable|status\s+of|check)\s+(?:the\s+)?(\S+)\s+service\b")
    if m:
        u.text = " " * len(u.text)
        act = "status" if m.group(1).startswith(("status", "check")) else m.group(1)
        name = u.lit(u.o(m, 2))
        su = "" if act == "status" else sudo()
        return Plan(f"{su}systemctl {act} {shlex.quote(name)}", "service", [f"{act} {name}"],
                    destructive=act != "status")
    m2 = u.peek(r"^\s*(?:stop|end|close|quit|exit|shut\s+down)\s+(?:the\s+)?([\w.-]+)\s*$")
    if m2 and process_running(m2.group(1)):
        u.text = " " * len(u.text)
        return Plan(f"pkill -- {shlex.quote(m2.group(1))}", "stop process", [m2.group(1)], destructive=True)
    m = u.peek(r"\b(?:kill|stop|terminate|end|close|quit|force\s+quit)\s+(?:the\s+|all\s+(?:the\s+)?)?"
               r"(?:process(?:es)?\s+|programs?\s+)?(?:(?:named|called)\s+)?(\S+)(?:\s+(?:process(?:es)?|programs?))?$")
    if m and u.peek(r"\b(?:kill|process(?:es)?|terminate|force\s+quit)\b"):
        u.text = " " * len(u.text)
        target = u.lit(u.o(m, 1))
        cmd = f"kill {target}" if target.isdigit() else f"pkill -- {shlex.quote(target)}"
        return Plan(cmd, "stop process", [target], destructive=True)
    return None


def h_package(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(install|uninstall|remove|purge)\s+(?:the\s+)?(?:package\s+|program\s+|app\s+)?(\S+)(?:\s+(?:package|program|app))?$")
    if m and (m.group(1) in ("install", "uninstall", "purge") or u.peek(r"\b(?:package|program|app)\b")):
        name = u.lit(u.o(m, 2))
        if name.lower() in TIMEISH or name.lower() in FILLER or name.lower() in (
                "recently", "today", "lately", "yesterday", "history") or \
                name.lower() in ("folder", "file", "directory", "dir", "files", "folders") or \
                os.path.exists(os.path.join(u.cwd, name)):
            return None
        cmd = install_cmd([shlex.quote(name)], remove=m.group(1) != "install")
        if not cmd:
            return None
        u.text = " " * len(u.text)
        return Plan(cmd, "packages", [f"{m.group(1)} {name} with {pkg_manager()}"], destructive=True,
                    warning="! changes installed software")
    if u.peek(r"\b(?:update|upgrade)\s+(?:the\s+|my\s+|all\s+)?(?:system|packages|software|everything|computer)\b|^(?:update|upgrade)$"):
        pm = pkg_manager()
        if not pm:
            return None
        u.text = " " * len(u.text)
        su = sudo()
        cmd = {"apt": f"{su}apt update && {su}apt upgrade", "dnf": f"{su}dnf upgrade",
               "pacman": f"{su}pacman -Syu", "zypper": f"{su}zypper update", "apk": f"{su}apk upgrade",
               "brew": "brew update && brew upgrade"}[pm]
        return Plan(cmd, "packages", [f"upgrade everything with {pm}"], destructive=True,
                    warning="! changes installed software")
    return None


def h_download(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:download|fetch|get|grab|save)\s+(?:the\s+file\s+)?(qlit\d+)(?:\s+(?:to|into|as)\s+(\S+))?\s*$")
    if not m:
        return None
    url = u.lit(u.o(m, 1))
    if not re.match(r"(?:https?|ftp)://", url):
        return None
    u.text = " " * len(u.text)
    dest = u.lit(u.o(m, 2)) if m.group(2) else (
        os.path.basename(urllib.parse.urlsplit(url).path.rstrip("/")) or "index.html")
    q, d = shlex.quote(url), qpath(dest)
    cmd = first_available([
        ("curl", f"curl -fL -o {d} {q}"),
        ("wget", f"wget -O {d} {q}"),
        (None, f"python3 -c 'import sys, urllib.request as u; u.urlretrieve(sys.argv[1], sys.argv[2])' {q} {d}"),
    ])
    plan = Plan(cmd, "download", [f"{url} → {dest}"])
    if os.path.exists(os.path.join(u.cwd, os.path.expanduser(dest))):
        plan.destructive, plan.warning = True, f"! replaces the existing {dest}"
    return plan


def h_reext(u: Utterance) -> Plan | None:
    """'rename all .jpeg files to .jpg' -> change the extension in bulk."""
    m = u.peek(r"\b(?:rename|change)\s+(?:the\s+extension\s+of\s+)?(?:all\s+)?(?:the\s+|my\s+)?"
               r"(?:\*?\.([a-z0-9]{1,8})\s+files|([a-z0-9]{1,8})\s+files|files\s+(?:ending\s+(?:in|with)\s+)?\.([a-z0-9]{1,8}))"
               r"\s+(?:to|into|as)\s+\.?([a-z0-9]{1,8})(?:\s+files)?\s*$")
    if not m:
        return None
    old = next(g for g in m.groups()[:3] if g)
    new = m.group(4)
    if m.group(2):          # "python files": the type's one extension, or nothing
        t = type_word(old)
        if t and len(t[1]) == 1:
            old = t[1][0]
        elif not (old in CODE_EXTS or any(old in es for _, es in TYPE_WORDS.values())):
            return None
        elif t:
            return None
    if old == new:
        return None
    u.text = " " * len(u.text)
    cmd = f'for f in *.{old}; do mv -i -- "$f" "${{f%.{old}}}.{new}"; done'
    return Plan(cmd, "rename", [f"*.{old} → *.{new}", "this folder", "asks before overwriting"],
                destructive=True, preview=f"ls -1d -- *.{old}",
                warning=f"! renames the .{old} files listed above")


# ---- network interfaces, addresses and radios -----------------------------------------
# aisha reads the interfaces from /sys/class/net, so commands name the real one. With
# NetworkManager running (most desktops: Mint, Ubuntu, Debian with a desktop) changes go
# through nmcli and last; without it they use ip(8) and last until the next reboot.

def net_ifaces() -> list[dict]:
    """[{name, wireless}] for the network interfaces here, loopback left out."""
    out = []
    try:
        names = sorted(os.listdir("/sys/class/net"))
    except OSError:
        return out
    for n in names:
        if n == "lo":
            continue
        base = f"/sys/class/net/{n}"
        out.append({"name": n, "wireless": os.path.isdir(f"{base}/wireless") or os.path.exists(f"{base}/phy80211"),
                    "virtual": not os.path.exists(f"{base}/device")})
    return out


def nm_running() -> bool:
    return bool(shutil.which("nmcli")) and (os.path.isdir("/run/NetworkManager") or os.path.isdir("/var/run/NetworkManager"))


IPV4 = r"(?:\d{1,3}\.){3}\d{1,3}"
CIDR = rf"{IPV4}(?:/\d{{1,2}})?"
MAC = r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}"
WIFI_W = r"(?:wifi|wi-fi|wlan|wireless)"
WIRED_W = r"(?:ethernet|wired|cable|lan)"


def pick_iface(text: str, ifaces: list[dict]) -> tuple[str | None, str]:
    """The interface a sentence means: named, 'the wifi', 'the wired one', or the only one."""
    names = {i["name"].lower(): i["name"] for i in ifaces}
    for tok in re.findall(r"[\w.:@-]+", text):
        if tok.lower() in names:
            return names[tok.lower()], ""
    named = re.search(r"\b(?:eth\d+|en[ospx]\w+|wl[ospx]?\w+|wlan\d+|usb\d+|br\d+|docker\d+|virbr\d+|tun\d+|wg\d+)\b", text)
    if named:
        return None, f"there is no interface {named.group(0)} here (" + (", ".join(names.values()) or "none") + ")"
    real = [i for i in ifaces if not i["virtual"]] or ifaces
    if re.search(rf"\b{WIFI_W}\b", text):
        w = [i["name"] for i in real if i["wireless"]]
        return (w[0], "") if w else (None, "no Wi-Fi interface here")
    if re.search(rf"\b{WIRED_W}\b", text):
        w = [i["name"] for i in real if not i["wireless"]]
        return (w[0], "") if w else (None, "no wired interface here")
    if len(real) == 1:
        return real[0]["name"], ""
    return None, "which interface? " + (", ".join(i["name"] for i in real) or "none found")


def names_iface(text: str, ifaces: list[dict]) -> bool:
    """Does the text name an interface (eno1, the wifi, the wired card), not just any word?"""
    names = {i["name"].lower() for i in ifaces}
    return any(t in names for t in re.findall(r"[\w.:@-]+", text.lower())) or bool(
        re.search(rf"\b(?:{WIFI_W}|{WIRED_W})\b|\bnetwork\s+(?:interface|adapter|card)\b", text.lower()))


def _con(iface: str) -> str:
    """The NetworkManager connection on an interface, as a shell expression."""
    return f'"$(nmcli -g GENERAL.CONNECTION device show {shlex.quote(iface)})"'



NET_IFACE_W = r"(?:interface|iface|nic|adapter|card|port|device|dev|link|connection)"
SET_W = (r"(?:set(?:\s+up)?|setup|assign|give|configure|config|change|use|put|apply|make|attach|bind|define|"
         r"switch|move|update|fix|modify|edit|want|need|let)")
ADD_W = r"(?:add|another|extra|second|additional|also|more|plus|append)"
DEL_W = r"(?:remove|delete|drop|del|unset|unassign|take\s+(?:away|off)|get\s+rid\s+of|clear|flush)"
UP_W = r"(?:up|on|enable|enabled|activate|start|connect|bring\s+up|wake)"
DOWN_W = r"(?:down|off|disable|disabled|deactivate|stop|disconnect|shut(?:\s+down)?|kill)"


def net_slots(raw: str, ifaces: list[dict]) -> dict | None:
    """The pieces of a network request, wherever they are in the sentence:
    'set ip 192.168.20.1/24 to interface eno1', 'eno1 should have 10.0.0.2',
    'give the wired card the address 10.0.0.2/8 with gateway 10.0.0.1'."""
    text = " " + raw.lower().strip(" ?!.") + " "
    names = {i["name"].lower() for i in ifaces}
    toks = re.findall(r"[\w.:/@-]+", text)
    dev_named = next((t for t in toks if t in names), None) or next(
        (t for t in toks if re.fullmatch(r"eth\d+|en[ospx]\w+|wl[ospx]?\w+|wlan\d+", t)), None)
    dev_word = re.search(rf"\b(?:{WIFI_W}|{WIRED_W})\b(?:\s+{NET_IFACE_W})?|\b(?:network|net)\s+{NET_IFACE_W}\b", text)
    about_ip = re.search(rf"\b(?:ip|ipv4|address|addr|static|netmask|dhcp|dns|name\s*servers?|gateway|gw)\b", text) and \
        re.search(rf"\b(?:{SET_W}|{ADD_W}|{DEL_W}|turn|disable|enable|should)\b|^\s*(?:dhcp|static)\b", text)
    if not (dev_named or dev_word or about_ip):
        return None
    out = {"dev_text": dev_named or (dev_word.group(0) if dev_word else "")}
    # gateway and DNS first, so their addresses are not taken for the interface's
    gw = re.search(rf"\b(?:gateway|gw|router|default\s+route|via)\s+(?:(?:of|on|for)\s+(?:the\s+)?\S+(?:\s+{NET_IFACE_W})?\s+)?(?:is\s+|of\s+|to\s+|at\s+|=\s*|as\s+)?({IPV4})\b|\b({IPV4})\s+as\s+(?:the\s+)?(?:default\s+)?(?:gateway|router|gw)\b", text)
    rest = text
    if gw:
        out["gw"] = gw.group(1) or gw.group(2)
        rest = rest[:gw.start()] + " " * (gw.end() - gw.start()) + rest[gw.end():]
    dns = re.search(rf"\b(?:dns|name\s*servers?|resolvers?)(?:\s+servers?)?\s+(?:(?:of|on|for)\s+(?:the\s+)?\S+(?:\s+{NET_IFACE_W})?\s+)?(?:is\s+|are\s+|to\s+|=\s*|as\s+)?((?:{IPV4}(?:\s*,\s*|\s+and\s+|\s+)?)+)"
                    rf"|((?:{IPV4}(?:\s*,\s*|\s+and\s+|\s+)?)+)\s+(?:as|for)\s+(?:the\s+)?(?:dns|name\s*servers?)\b", rest)
    if dns:
        out["dns"] = re.findall(IPV4, dns.group(1) or dns.group(2))
        rest = rest[:dns.start()] + " " * (dns.end() - dns.start()) + rest[dns.end():]
    out["addrs"] = re.findall(rf"(?<![\w.]){CIDR}(?![\w.])", rest)
    out["mask"] = re.search(rf"\b(?:netmask|mask|subnet(?:\s+mask)?)\s+(?:is\s+|of\s+|=\s*)?({IPV4})\b", rest)
    if out["mask"]:
        mask = out["mask"].group(1)
        out["addrs"] = [a for a in out["addrs"] if a != mask]
        try:
            out["prefix"] = sum(bin(int(x)).count("1") for x in mask.split("."))
        except ValueError:
            pass
    dhcp_off = re.search(r"\b(?:dhcp|automatic|auto|dynamic)\s+(?:off|disabled?|no)\b|\b(?:disable|turn\s+off|switch\s+off|stop|"
                         r"no|without|not)\s+(?:using\s+)?(?:the\s+)?(?:dhcp|automatic)\b|\bstatic\b", text)
    if dhcp_off:
        out["action"] = "static"
    elif re.search(r"\b(?:dhcp|automatic(?:ally)?|auto\s*(?:ip|address|config)?|dynamic)\b", text):
        out["action"] = "dhcp"
    elif out["addrs"] and re.search(rf"\b{DEL_W}\b", text):
        out["action"] = "del"
    elif out["addrs"] and re.search(rf"\b{ADD_W}\b", text):
        out["action"] = "add"
    elif out["addrs"]:
        out["action"] = "set"
    elif out.get("gw") or out.get("dns"):
        out["action"] = "routes"
    elif re.search(rf"\b(?:restart|reset|reconnect|bounce|cycle|reload)\b", text):
        out["action"] = "restart"
    elif re.search(rf"\b(?:bring|take|set|turn|switch|put)\b.*\b{UP_W}\b|^\s*{UP_W}\b|\b{UP_W}\s*$", text) and \
            not re.search(rf"\b{DOWN_W}\b", text):
        out["action"] = "up"
    elif re.search(rf"\b(?:bring|take|set|turn|switch|put)\b.*\b{DOWN_W}\b|^\s*{DOWN_W}\b|\b{DOWN_W}\s*$", text):
        out["action"] = "down"
    else:
        return None
    if out["action"] == "static" and out["addrs"]:
        out["action"] = "set"
    if not out["dev_text"] and out["action"] in ("up", "down", "restart"):
        return None
    # without a verb or an address word, "eno1 10.0.0.2" is too thin to change the network on
    if out["action"] in ("set", "add", "del") and not re.search(
            rf"\b(?:{SET_W}|{ADD_W}|{DEL_W}|ip|ipv4|address|addr|static|should\s+(?:have|be|get|use))\b", text):
        return None
    if out["action"] in ("up", "down", "restart") and not (dev_named or re.search(NET_IFACE_W, out["dev_text"])):
        return None          # "turn the wifi off" is the radio, handled above; "bring the wired card up" is here
    return out


def iface_with_addr(addr: str) -> str | None:
    """The interface that has this IPv4 address now (via ip), if any."""
    if not shutil.which("ip"):
        return None
    try:
        r = subprocess.run(["ip", "-o", "-4", "address"], capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in r.stdout.splitlines():
        f = line.split()
        if len(f) > 3 and f[3].split("/")[0] == addr.split("/")[0]:
            return f[1]
    return None


def net_plan(sl: dict, ifaces: list[dict], nm: bool, su: str, done) -> Plan | None:
    dev_text = sl["dev_text"]
    if not dev_text:
        for a in sl.get("addrs", []):
            dev_text = iface_with_addr(a) or ""   # "set dhcp off on 192.168.20.1": the interface that has it
            if dev_text:
                break
    dev, problem = pick_iface(dev_text, ifaces)
    if not dev:
        return done("ip -br address" if shutil.which("ip") else "ls /sys/class/net", "network", [problem], conf=0.9,
                    show_only=True)
    q = shlex.quote(dev)
    wifi = any(i["name"] == dev and i["wireless"] for i in ifaces)
    act = sl["action"]
    if act in ("up", "down"):
        up = act == "up"
        cmd = f"nmcli device {'connect' if up else 'disconnect'} {q}" if nm else f"{su}ip link set dev {q} {'up' if up else 'down'}"
        return done(cmd, "network", [f"{dev} {'up' if up else 'down'}"], change=True,
                    warning=None if up else f"! takes {dev} down: you lose the network if it is how you are connected")
    if act == "restart":
        cmd = f"nmcli device disconnect {q} && nmcli device connect {q}" if nm else \
              f"{su}ip link set dev {q} down && {su}ip link set dev {q} up"
        return done(cmd, "network", [f"take {dev} down and up again"], change=True, warning=f"! {dev} drops for a moment")
    con = _con(dev)
    if act == "static":     # "dhcp off" with no address: keep the address it has now
        cur = f"$(ip -o -4 address show dev {q} | awk '{{print $4; exit}}')"
        gwnow = f"$(ip -4 route show default dev {q} | awk '{{print $3; exit}}')"
        cmd = (f"con={con} && a={cur} && g={gwnow} && [ -n \"$a\" ] && nmcli connection modify \"$con\" ipv4.method manual "
               f"ipv4.addresses \"$a\" ${{g:+ipv4.gateway \"$g\"}} && nmcli connection up \"$con\"" if nm else None)
        if not cmd:
            return done(f"ip address show dev {q}", "network", [f"{dev}: without NetworkManager, give the address to keep, "
                        f"e.g. 'set ip 192.168.1.10/24 on {dev}'"], conf=0.9, show_only=True)
        return done(cmd, "network", [f"{dev}: DHCP off, keeps its current address and gateway as static"], change=True,
                    warning=f"! {dev} stops asking for an address; it keeps the one it has now")
    if act == "dhcp":
        cmd = (f"con={con} && nmcli connection modify \"$con\" ipv4.method auto ipv4.addresses '' ipv4.gateway '' "
               f"&& nmcli connection up \"$con\"" if nm else
               first_available([("dhclient", f"{su}dhclient -v {q}"), ("networkctl", f"{su}networkctl renew {q}"),
                                (None, f"{su}dhcpcd {q}")]))
        return done(cmd, "network", [f"{dev} gets its address by DHCP"], change=True, warning=f"! {dev} may get a new address")
    why, addrs = [], []
    for a in sl["addrs"]:
        if "/" not in a:
            a += f"/{sl.get('prefix', 24)}"
            if "prefix" not in sl:
                why.append("netmask /24 (255.255.255.0) assumed: write a.b.c.d/NN for another")
        addrs.append(a)
    if any(int(x) > 255 for a in addrs + [sl.get("gw") or "0.0.0.0"] + sl.get("dns", []) for x in a.split("/")[0].split(".")) or \
            any(int(a.split("/")[1]) > 32 for a in addrs):
        return None
    gw, dns = sl.get("gw"), sl.get("dns") or []
    parts = []
    if act == "set":
        why.insert(0, f"{dev} → {', '.join(addrs)}")
    elif act == "add":
        why.insert(0, f"add {', '.join(addrs)} to {dev}")
    elif act == "del":
        why.insert(0, f"remove {', '.join(addrs)} from {dev}")
    if gw:
        why.append(f"gateway {gw}")
    if dns:
        why.append("DNS " + ", ".join(dns))
    if nm:
        mods = []
        if act == "set":
            mods.append(f"ipv4.method manual ipv4.addresses {','.join(addrs)}")
        elif act == "add":
            mods.append(f"+ipv4.addresses {','.join(addrs)}")
        elif act == "del":
            mods.append(f"-ipv4.addresses {','.join(addrs)}")
        if gw:
            mods.append(f"ipv4.gateway {gw}")
        if dns:
            mods.append(f"ipv4.dns \"{' '.join(dns)}\" ipv4.ignore-auto-dns yes")
        cmd = f"con={con} && nmcli connection modify \"$con\" {' '.join(mods)} && nmcli connection up \"$con\""
        why.append("saved in NetworkManager, stays after reboot")
    else:
        if act == "set":
            parts.append(f"{su}ip address flush dev {q}")
            parts += [f"{su}ip address add {a} dev {q}" for a in addrs]
        elif act == "add":
            parts += [f"{su}ip address add {a} dev {q}" for a in addrs]
        elif act == "del":
            parts += [f"{su}ip address del {a} dev {q}" for a in addrs]
        if gw:
            parts.append(f"{su}ip route replace default via {gw} dev {q}")
        if dns:
            parts.append(f"{su}resolvectl dns {q} {' '.join(dns)}" if shutil.which("resolvectl") else
                         "printf 'nameserver %s\\n' " + " ".join(dns) + f" | {su}tee /etc/resolv.conf >/dev/null")
        cmd = " && ".join(parts)
        why.append("until the next reboot (no NetworkManager here)")
    return done(cmd, "network", why, change=True,
                warning=f"! changes the network settings of {dev}: connections over it may drop")


def h_net(u: Utterance) -> Plan | None:
    raw = u.raw.strip()
    if re.match(r"(?:sudo\s+)?(?:ip|nmcli|ifconfig|iw|rfkill|ethtool|resolvectl|networkctl)\s+\S", raw) and \
            re.match(r"(?:sudo\s+)?\S+\s+(?:-\S+\s+)*(?:a|addr|address|link|l|route|r|neigh|n|dev|device|con|connection|radio|general|g|"
                     r"dns|domain|list|show|status|up|down|set|add|del|flush|monitor|scan|block|unblock|renew|reload)\b", raw):
        return None                       # "ip address add 10.0.0.1/24 dev eno1" is a command, not a request
    low = raw.lower().rstrip(" ?!.")
    nm = nm_running()
    su = sudo()

    def done(cmd, intent, why, change=False, warning=None, conf=1.0, **kw):
        u.text = " " * len(u.text)
        return Plan(cmd, intent, why, destructive=change, warning=warning, confidence=conf,
                    checked=not change, **kw)

    # -- radios: wifi, bluetooth, airplane mode
    m = re.fullmatch(r"(?:please\s+)?(?:turn|switch|set)\s+(on|off)\s+(?:the\s+|my\s+)?(wifi|wi-fi|wireless|bluetooth|bt)"
                     r"(?:\s+radio)?|(?:please\s+)?(?:turn|switch)\s+(?:the\s+|my\s+)?(wifi|wi-fi|wireless|bluetooth|bt)"
                     r"(?:\s+radio)?\s+(on|off)|(enable|disable|activate|deactivate|kill)\s+(?:the\s+|my\s+)?"
                     r"(wifi|wi-fi|wireless|bluetooth|bt)(?:\s+radio)?|(wifi|wi-fi|bluetooth|bt)\s+(on|off)", low)
    if m:
        g = [x for x in m.groups() if x]
        state = next(x for x in g if x in ("on", "off", "enable", "disable", "activate", "deactivate", "kill"))
        radio = next(x for x in g if x not in ("on", "off", "enable", "disable", "activate", "deactivate", "kill"))
        on = state in ("on", "enable", "activate")
        if radio in ("bluetooth", "bt"):
            cmd = f"rfkill {'unblock' if on else 'block'} bluetooth"
            if on and shutil.which("bluetoothctl"):
                cmd += " && bluetoothctl power on"
            return done(cmd, "radio", [f"Bluetooth {'on' if on else 'off'}"], change=True,
                        warning=None if on else "! turns Bluetooth off (headphones, mice and keyboards disconnect)")
        cmd = f"nmcli radio wifi {'on' if on else 'off'}" if nm else f"{su}rfkill {'unblock' if on else 'block'} wifi"
        return done(cmd, "radio", [f"Wi-Fi {'on' if on else 'off'}"], change=True,
                    warning=None if on else "! turns Wi-Fi off: you lose the network if Wi-Fi is how you are connected")
    m = re.fullmatch(r"(?:turn\s+|switch\s+|set\s+)?(?:on\s+|off\s+)?(?:the\s+)?(?:airplane|aeroplane|flight|plane)\s+mode"
                     r"(?:\s+(on|off))?|(?:enable|disable|turn\s+on|turn\s+off|enter|exit|leave)\s+(?:the\s+)?(?:airplane|aeroplane|flight|plane)\s+mode", low)
    if m:
        on = not re.search(r"\b(?:off|disable|exit|leave)\b", low)
        cmd = ("nmcli radio all off && rfkill block bluetooth" if nm else f"{su}rfkill block all") if on else \
              ("nmcli radio all on && rfkill unblock bluetooth" if nm else f"{su}rfkill unblock all")
        return done(cmd, "radio", ["airplane mode " + ("on: all radios off" if on else "off: radios back on")],
                    change=True, warning="! turns all radios off (Wi-Fi, Bluetooth, mobile)" if on else None)
    if re.fullmatch(r"(?:show|list|check)?\s*(?:the\s+|my\s+|all\s+)?(?:radios?|rfkill|wireless\s+devices|radio\s+status)"
                    r"|(?:is|are)\s+(?:the\s+|my\s+)?(?:wifi|wi-fi|bluetooth|radios?)\s+(?:on|off|enabled|disabled|blocked)"
                    r"|(?:wifi|wi-fi|bluetooth)\s+status|(?:is\s+)?airplane\s+mode\s+on", low):
        cmd = first_available([("rfkill", "rfkill list"), ("nmcli", "nmcli radio all"), (None, "ls /sys/class/rfkill")])
        return done(cmd, "radios", ["which radios are on or blocked"])
    if re.fullmatch(r"restart\s+(?:the\s+|my\s+)?(?:wifi|wi-fi|wireless)(?:\s+radio)?", low):
        cmd = "nmcli radio wifi off && sleep 2 && nmcli radio wifi on" if nm else \
              f"{su}rfkill block wifi && sleep 2 && {su}rfkill unblock wifi"
        return done(cmd, "radio", ["Wi-Fi off and on again"], change=True, warning="! drops Wi-Fi for a few seconds")

    # -- wifi networks
    m = re.fullmatch(r"(?:connect|join|log\s*in)\s+(?:me\s+)?(?:to\s+)?(?:the\s+)?(?:wifi|wi-fi|wireless|network)(?:\s+network)?\s+"
                     r"(?:called\s+|named\s+)?(?P<ssid>\"[^\"]+\"|'[^']+'|\S+?)(?:\s+(?:with|using)\s+(?:the\s+)?password\s+(?P<pw>\S+))?"
                     r"|(?:connect|join)\s+(?:to\s+)?(?P<ssid2>\"[^\"]+\"|'[^']+'|\S+?)\s+(?:wifi|wi-fi|network)"
                     r"(?:\s+(?:with|using)\s+(?:the\s+)?password\s+(?P<pw2>\S+))?", raw, re.I)
    if m and nm:
        ssid = (m.group("ssid") or m.group("ssid2")).strip("\"'")
        pw = m.group("pw") or m.group("pw2")
        if pw:
            cmd = f"nmcli device wifi connect {shlex.quote(ssid)} password {shlex.quote(pw)}"
            note = "the password is now in your shell history"
        else:
            cmd = f"nmcli --ask device wifi connect {shlex.quote(ssid)}"
            note = "asks for the password if it needs one"
        return done(cmd, "wifi", [f"connect to {ssid}", note], change=True, warning="! switches your Wi-Fi network")
    if nm and re.fullmatch(r"disconnect\s+(?:from\s+)?(?:the\s+|my\s+)?(?:wifi|wi-fi|wireless)(?:\s+network)?", low):
        dev, problem = pick_iface("wifi", net_ifaces())
        if dev:
            return done(f"nmcli device disconnect {shlex.quote(dev)}", "wifi", [f"disconnect {dev}"], change=True,
                        warning="! you lose the network if Wi-Fi is how you are connected")
    m = re.fullmatch(r"forget\s+(?:the\s+)?(?:wifi\s+|wi-fi\s+|network\s+)*(?P<ssid>\"[^\"]+\"|'[^']+'|\S+)(?:\s+(?:wifi|network))?", raw, re.I)
    if m and nm:
        ssid = m.group("ssid").strip("\"'")
        return done(f"nmcli connection delete {shlex.quote(ssid)}", "wifi", [f"forget the saved network {ssid}"],
                    change=True, warning=f"! deletes the saved connection {ssid} and its password")
    if nm and re.fullmatch(r"(?:show\s+|list\s+)?(?:the\s+|my\s+|all\s+)?(?:saved|known|remembered)\s+(?:wifi\s+|wi-fi\s+)?(?:networks|connections)", low):
        return done("nmcli connection show", "wifi", ["saved connections"])
    if re.fullmatch(r"(?:show|list|scan\s+for|scan|find|what\s+are\s+the|which|what)?\s*(?:the\s+|all\s+|available\s+|nearby\s+)?"
                    r"(?:available\s+|nearby\s+)?(?:wifi|wi-fi|wireless)\s+networks(?:\s+(?:nearby|around|here|available))?"
                    r"|scan\s+(?:for\s+)?(?:wifi|wi-fi)", low):
        cmd = "nmcli dev wifi list" if shutil.which("nmcli") else first_available(
            [("iw", f"{su}iw dev $(ls /sys/class/net | while read i; do [ -d /sys/class/net/$i/wireless ] && echo $i; done | head -n 1) scan | grep -E 'SSID|signal'"),
             (None, "echo 'install network-manager or iw to scan for Wi-Fi networks'")])
        return done(cmd, "wifi", ["Wi-Fi networks in range"])
    if shutil.which("nmcli") and re.fullmatch(r"(?:show|what\s+is|what's|tell\s+me|get)?\s*(?:the\s+|my\s+)?(?:wifi|wi-fi|wireless)\s+password"
                           r"|(?:show\s+)?(?:the\s+)?password\s+(?:of|for)\s+(?:the\s+|my\s+)?(?:wifi|wi-fi|this\s+network)", low):
        return done("nmcli device wifi show-password", "wifi", ["the current Wi-Fi network's password (and a QR code)"])
    if nm and re.fullmatch(r"(?:make|create|start|turn\s+on|set\s+up)\s+(?:a\s+|the\s+)?(?:wifi\s+|wi-fi\s+|mobile\s+)?hotspot", low):
        return done("nmcli device wifi hotspot", "wifi", ["share this computer's connection as a Wi-Fi hotspot",
                                                           "prints its name and password"], change=True,
                    warning="! the Wi-Fi card becomes a hotspot and leaves its current network")

    # -- interfaces: list, details, state, speed
    if re.fullmatch(r"(?:show|list|what\s+are|which\s+are|get)?\s*(?:me\s+)?(?:the\s+|my\s+|all\s+(?:the\s+)?)?"
                    r"(?:network\s+)?(?:interfaces|adapters|nics|network\s+cards|network\s+devices|links)(?:\s+(?:here|on\s+this\s+computer))?"
                    r"|(?:what|which)\s+(?:network\s+)?interfaces\s+(?:do\s+i\s+have|are\s+there)", low):
        cmd = first_available([("ip", "ip -br address"), ("nmcli", "nmcli device status"), (None, "ls /sys/class/net")])
        return done(cmd, "network", ["interfaces with their state and addresses"])
    ifaces = net_ifaces()
    m = re.fullmatch(r"(?:show\s+|list\s+)?(?:the\s+)?(?:details|info|information|config(?:uration)?|settings|status|state)\s+(?:of|for|about)\s+(?:the\s+|my\s+)?(?P<w>.+?)"
                     r"(?:\s+interface)?|(?:show|describe)\s+(?:the\s+|my\s+)?(?P<w2>\S+(?:\s+(?:card|adapter))?)(?:\s+interface)?", low)
    if m:
        dev, _ = pick_iface(m.group("w") or m.group("w2"), ifaces)
        if dev and names_iface(m.group("w") or m.group("w2"), ifaces):
            q = shlex.quote(dev)
            cmd = (f"nmcli device show {q}" if nm else
                   first_available([("ip", f"ip address show dev {q} && ip -s link show dev {q}"),
                                    (None, f"grep -H . /sys/class/net/{q}/{{operstate,address,mtu,speed}} 2>/dev/null")]))
            return done(cmd, "network", [f"details of {dev}"])
    m = re.fullmatch(r"is\s+(?:the\s+|my\s+)?(?P<w>\S+(?:\s+(?:card|adapter|interface|connection))?)\s+(?:up|down|connected|working|active|plugged\s+in)", low)
    if m and not re.search(r"\b(?:internet|network|computer)\b", m.group("w")) and names_iface(m.group("w"), ifaces):
        dev, _ = pick_iface(m.group("w"), ifaces)
        if dev:
            q = shlex.quote(dev)
            return done(f"echo \"{dev}: $(cat /sys/class/net/{q}/operstate), carrier $(cat /sys/class/net/{q}/carrier 2>/dev/null || echo ?)\"",
                        "network", [f"state of {dev}"])
    m = re.fullmatch(r"(?:what\s+is\s+|show\s+)?(?:the\s+)?(?:link\s+speed|speed|bandwidth|duplex)\s+(?:of|on|for)\s+(?:the\s+|my\s+)?(?P<w>.+?)"
                     r"|how\s+fast\s+is\s+(?:the\s+|my\s+)?(?P<w2>.+?)(?:\s+connection|\s+link)?", low)
    if m:
        dev, _ = pick_iface(m.group("w") or m.group("w2"), ifaces)
        if dev and not re.search(r"\binternet\b", low) and names_iface(m.group("w") or m.group("w2"), ifaces):
            q = shlex.quote(dev)
            wifi = any(i["name"] == dev and i["wireless"] for i in ifaces)
            cmd = (first_available([("iw", f"iw dev {q} link | grep -E 'SSID|signal|bitrate'"), ("nmcli", f"nmcli -f GENERAL.DEVICE,CAPABILITIES.SPEED device show {q}")])
                   if wifi else first_available([("ethtool", f"ethtool {q} 2>/dev/null | grep -E 'Speed|Duplex|Link detected'"),
                                                 (None, f"echo \"{dev}: $(cat /sys/class/net/{q}/speed 2>/dev/null || echo ?) Mb/s\"")]))
            return done(cmd, "network", [f"link speed of {dev}"])

    # -- interface up / down, addresses, gateway, DNS, DHCP: words in any order
    slots = net_slots(raw, ifaces)
    if slots:
        return net_plan(slots, ifaces, nm, su, done)

    m = re.fullmatch(r"(?:set|change)\s+(?:the\s+)?mtu\s+(?:of\s+|on\s+|for\s+)?(?:the\s+|my\s+)?(?P<w>.+?)\s+to\s+(?P<n>\d{3,5})", low)
    if m:
        dev, problem = pick_iface(m.group("w"), ifaces)
        if dev:
            n = m.group("n")
            cmd = (f"con={_con(dev)} && nmcli connection modify \"$con\" "
                   f"{'802-11-wireless' if any(i['name'] == dev and i['wireless'] for i in ifaces) else '802-3-ethernet'}.mtu {n} "
                   f"&& nmcli connection up \"$con\"" if nm else f"{su}ip link set dev {shlex.quote(dev)} mtu {n}")
            return done(cmd, "network", [f"MTU of {dev} → {n}"], change=True)
    m = re.fullmatch(rf"(?:set|change|spoof|randomi[sz]e)\s+(?:the\s+|my\s+)?mac(?:\s+address)?\s+(?:of\s+|on\s+|for\s+)?(?:the\s+|my\s+)?(?P<w>.+?)"
                     rf"(?:\s+to\s+(?P<mac>{MAC}|random|a\s+random\s+one))?", low)
    if m:
        dev, problem = pick_iface(m.group("w"), ifaces)
        if dev:
            mac = m.group("mac") or ("random" if "random" in low else None)
            q = shlex.quote(dev)
            if not mac:
                return done(f"cat /sys/class/net/{q}/address", "network", [f"{dev}'s MAC address now",
                            "to what? say 'change mac address of " + dev + " to 02:11:22:33:44:55' or 'to random'"],
                            conf=0.9, show_only=True)
            if mac.startswith(("random", "a random")):
                kind = "802-11-wireless" if any(i["name"] == dev and i["wireless"] for i in ifaces) else "802-3-ethernet"
                if not nm:
                    return None
                cmd = f"con={_con(dev)} && nmcli connection modify \"$con\" {kind}.cloned-mac-address random && nmcli connection up \"$con\""
            else:
                cmd = f"{su}ip link set dev {q} down && {su}ip link set dev {q} address {mac} && {su}ip link set dev {q} up"
            return done(cmd, "network", [f"MAC address of {dev} → {mac}"], change=True, warning=f"! {dev} drops for a moment")
    return None


UNIT_DIRS = ("/etc/systemd/system", "/run/systemd/system", "/lib/systemd/system", "/usr/lib/systemd/system")
KNOWN_SERVICES = set("""nginx apache2 ssh sshd docker containerd mariadb mysql postgresql redis-server cups bluetooth
NetworkManager networking ufw cron postfix exim4 smbd nmbd avahi-daemon gdm3 lightdm sddm php-fpm
memcached mongod elasticsearch jenkins grafana-server prometheus haproxy squid bind9 named
dnsmasq libvirtd nfs-server rsyslog systemd-resolved systemd-timesyncd tor transmission-daemon""".split())
SERVICE_WORDS = {  # everyday names for services
    "network": "network", "networking": "network", "internet": "network", "wifi": "network", "wi-fi": "network",
    "apache": "apache2", "sshd": "ssh", "openssh": "ssh", "printer": "cups", "printing": "cups",
    "firewall": "ufw", "dns": "systemd-resolved", "postgres": "postgresql", "redis": "redis-server",
    "samba": "smbd", "mysql": "mysql", "web server": "nginx" if any(
        os.path.exists(f"{d}/nginx.service") for d in UNIT_DIRS) else "apache2",
}
COMPUTER_WORDS = r"(?:computer|machine|system|pc|laptop|server|box|it)"


def unit_exists(name: str) -> bool:
    return any(os.path.exists(f"{d}/{name}.service") for d in UNIT_DIRS)


def service_name(word: str) -> str | None:
    """'nginx', 'the network', 'apache' -> the systemd unit, or None if it is not a service."""
    word = word.strip()
    if word.lower() in ("internet", "connection", "the internet"):
        return None                       # "is the internet working" is a connectivity check
    if word.lower() not in SERVICE_WORDS and re.search(r"\s+(?:server|service|daemon)$", word):
        word = re.sub(r"\s+(?:server|service|daemon)$", "", word)
    w = SERVICE_WORDS.get(word.lower(), word)
    if w == "network":
        return next((n for n in ("NetworkManager", "networking", "systemd-networkd") if unit_exists(n)),
                    "NetworkManager" if shutil.which("nmcli") else "networking")
    if w == "ssh" and not unit_exists("ssh") and unit_exists("sshd"):
        return "sshd"
    if unit_exists(w) or w in KNOWN_SERVICES or w.removesuffix(".service") in KNOWN_SERVICES:
        return w.removesuffix(".service")
    return None


def h_service(u: Utterance) -> Plan | None:
    """'reboot nginx', 'restart the network', 'nginx status', 'is ssh enabled at boot'."""
    m = u.peek(r"^\s*(reboot|restart|start|stop|reload|enable|disable|shut\s*down|turn\s+off|turn\s+on|kill|bounce|kick)\s+"
               r"(?:the\s+|my\s+)?([\w.@-]+(?:\s+server)?)(?:\s+(?:service|daemon|server|unit))?(?:\s+now)?\s*$")
    if m:
        verb, word = m.group(1), u.lit(u.o(m, 2))
        if re.fullmatch(COMPUTER_WORDS, word.lower()):
            return None
        unit = service_name(word)
        unsure = False
        if not unit and verb == "reboot" and not re.fullmatch(r"(?:now|later|tonight|soon|today)", word.lower()):
            unit, unsure = word, True    # "reboot X" never means the computer
        if not unit or verb == "kill" and not unit_exists(unit):
            return None
        act = {"reboot": "restart", "bounce": "restart", "kick": "restart", "shutdown": "stop", "turnoff": "stop", "turnon": "start",
               "kill": "kill"}.get(re.sub(r"\s+", "", verb), verb)
        u.text = " " * len(u.text)
        return Plan(f"{sudo()}systemctl {act} {shlex.quote(unit)}", "service", [f"{act} {unit}"],
                    confidence=0.65 if unsure else 1.0,
                    destructive=act in ("stop", "restart", "disable", "kill"),
                    warning=f"! {act}s the {unit} service" if act in ("stop", "restart", "disable", "kill") else None,
                    checked=act not in ("stop", "restart", "disable", "kill"))
    m = u.peek(r"^\s*(?:(?:show\s+|check\s+)?(?:the\s+)?([\w.@-]+)\s+(?:service\s+)?status|"
               r"(?:what\s+is\s+the\s+|show\s+(?:me\s+)?(?:the\s+)?)?status\s+of\s+(?:the\s+)?([\w.@-]+)(?:\s+service)?|"
               r"is\s+(?:the\s+)?([\w.@-]+)(?:\s+service)?\s+(?:active|running|up|ok|working))\s*$")
    if m:
        unit = service_name(u.lit(next(g for g in m.groups() if g)))
        if unit and (unit_exists(unit) or not m.group(3) or re.search(r"\b(?:ok|working)\s*$", u.low)):
            u.text = " " * len(u.text)
            return Plan(f"systemctl status {shlex.quote(unit)} --no-pager", "service", [f"status of {unit}"])
    m = u.peek(r"^\s*(?:is|does)\s+(?:the\s+)?([\w.@-]+)(?:\s+service)?\s+(?:enabled|start(?:s|ed)?)\s+(?:at|on|when)\s+(?:boot|startup|start\s*up)\s*$")
    if m:
        unit = service_name(u.lit(u.o(m, 1)))
        if unit:
            u.text = " " * len(u.text)
            return Plan(f"systemctl is-enabled {shlex.quote(unit)}", "service", [f"does {unit} start at boot"])
    m = u.peek(r"^\s*(?:(?:show|list|which|what)\s+)?(?:the\s+)?(?:services|programs)\s+(?:that\s+)?(?:start|run|are\s+enabled)\s+(?:at|on)\s+(?:boot|startup)\s*$|"
               r"^\s*(?:which|what)\s+services\s+are\s+enabled\s*$|^\s*what\s+(?:starts|runs)\s+(?:at|on)\s+(?:boot|startup)\s*$|"
               r"^\s*(?:list\s+|show\s+)?(?:the\s+)?enabled\s+services\s*$")
    if m:
        u.text = " " * len(u.text)
        return Plan("systemctl list-unit-files --type=service --state=enabled --no-pager", "service",
                    ["services that start at boot"])
    m = u.peek(r"^\s*(?:show\s+|follow\s+|tail\s+|watch\s+)?(?:the\s+)?([\w.@-]+)\s+(?:service\s+)?(?:logs?|journal)(?:\s+live)?\s*$|"
               r"^\s*(?:show\s+|follow\s+|tail\s+)?(?:the\s+)?(?:logs?|journal)\s+(?:of|for)\s+(?:the\s+)?([\w.@-]+)(?:\s+service)?\s*$")
    if m:
        unit = service_name(u.lit(next(g for g in m.groups() if g)))
        if unit:
            follow = bool(u.peek(r"\b(?:follow|tail|watch|live)\b"))
            u.text = " " * len(u.text)
            return Plan(f"journalctl -u {shlex.quote(unit)} " + ("-f" if follow else "-n 50 --no-pager"), "logs",
                        [f"{unit} service log" + (", live" if follow else ", last 50 lines")])
    return None


WHEN = (r"(?:\s+(?:in|after)\s+(?P<n>\d+|an?|one)\s*(?P<unit>minutes?|mins?|m|hours?|hrs?|h)\b"
        r"|\s+at\s+(?P<hh>\d{1,2})(?::(?P<mm>\d{2}))?\s*(?P<ampm>[ap]\.?m\.?)?"
        r"|\s+(?:later\s+)?(?P<word>tonight|at\s+midnight|later|soon|this\s+evening|tomorrow(?:\s+morning)?))")


def h_power_later(u: Utterance) -> Plan | None:
    """'reboot in 5 minutes', 'shut down at 22:30', 'reboot tonight'."""
    m = u.peek(r"^\s*(?:schedule\s+(?:a\s+)?|plan\s+a\s+)?(?P<verb>restart|reboot|shut\s*down|power\s*off|turn\s+off|switch\s+off)"
               rf"(?:\s+(?:the\s+|my\s+|this\s+)?{COMPUTER_WORDS})?{WHEN}\s*$")
    if not m:
        return None
    reboot = m.group("verb") in ("restart", "reboot")
    flag, what = ("-r ", "reboot") if reboot else ("", "shutdown")
    word = (m.group("word") or "").replace("at ", "")
    if m.group("n"):
        n = 1 if m.group("n") in ("a", "an", "one") else int(m.group("n"))
        n *= 60 if m.group("unit").startswith("h") else 1
        when, said = f"+{n}", f"in {n} minutes"
    elif m.group("hh"):
        hh, mm = int(m.group("hh")), int(m.group("mm") or 0)
        ampm = (m.group("ampm") or "").replace(".", "")
        hh = hh % 12 + (12 if ampm == "pm" else 0) if ampm else hh
        if hh > 23 or mm > 59:
            return None
        when, said = f"{hh:02d}:{mm:02d}", f"at {hh:02d}:{mm:02d}"
    elif word in ("tonight", "this evening", "midnight"):
        when, said = ("00:00", "at midnight") if word == "midnight" else ("23:00", "tonight at 23:00")
    else:
        u.text = " " * len(u.text)
        return Plan(f"sudo shutdown {flag}+30", "power", [f"{what} when? say 'in 30 minutes' or 'at 22:00'"],
                    show_only=True)
    u.text = " " * len(u.text)
    return Plan(f"sudo shutdown {flag}{when}", "power", [f"{what} {said}", "cancel with 'cancel the shutdown'"],
                destructive=True, warning=f"! schedules a {what} {said}")


def h_power(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(restart|reboot|shut\s*down|power\s*off|turn\s+off|switch\s+off|suspend|sleep|hibernate)\s+"
               r"(?:the\s+|my\s+|this\s+)?(?:computer|machine|system|pc|laptop|server|box)(?:\s+now)?\s*$")
    if not m:
        return None
    u.text = " " * len(u.text)
    word = m.group(1).replace(" ", "")
    action = {"restart": "reboot", "reboot": "reboot", "suspend": "suspend", "sleep": "suspend",
              "hibernate": "hibernate"}.get(word, "poweroff")
    return Plan(f"{sudo()}systemctl {action}", "power", [action], destructive=True,
                warning=f"! {action}s this computer")


def h_version(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:what|which)\s+version\s+of\s+([\w.+-]+)\b|\b([\w.+-]+)\s+version\b|"
               r"\bversion\s+of\s+([\w.+-]+)\b")
    if not m:
        return None
    prog = next(g for g in m.groups() if g)
    prog = {"python": "python3", "pip": "pip3", "node.js": "node", "nodejs": "node"}.get(prog, prog)
    if not shutil.which(prog) or prog in ("linux", "kernel", "os", "debian", "ubuntu"):
        return None
    u.text = " " * len(u.text)
    return Plan(f"{prog} --version", "version", [prog])


def h_installed(u: Utterance) -> Plan | None:
    m = u.peek(r"\bis\s+([\w.+-]+)\s+installed\b|\bdo\s+i\s+have\s+([\w.+-]+)(?:\s+installed)?\s*$|"
               r"\bwhere\s+is\s+([\w.+-]+)\s+installed\b|\bhave\s+i\s+got\s+([\w.+-]+)\s*$")
    if not m:
        return None
    prog = next(g for g in m.groups() if g)
    if prog in FILLER or prog in ("internet", "space", "memory", "ram", "files"):
        return None
    u.text = " " * len(u.text)
    q = shlex.quote(prog)
    return Plan(f"command -v {q} || echo {shlex.quote(prog + ' is not installed')}", "installed?", [prog])


def h_port(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:listening|using|on|bound\s+to|open\s+on|at)\s+port\s+(\d{1,5})\b|\bport\s+(\d{1,5})\b")
