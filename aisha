def type_word(w: str):
    if w in TYPE_WORDS:
        return TYPE_WORDS[w]
    if w.endswith("s") and w[:-1] in TYPE_WORDS:
        return TYPE_WORDS[w[:-1]]
    return None


SUFFIXES = ["ations", "ation", "ments", "ment", "ings", "ing", "ies", "ers",
            "er", "ed", "es", "s"]


def stem(w: str) -> str:
    """Tiny suffix stripper so "measurement" also finds "measured", "measure"."""
    if len(w) <= 4 or not w.isalpha():
        return w
    for suf in SUFFIXES:
        if w.endswith(suf) and len(w) - len(suf) >= 4:
            w = w[: -len(suf)] + ("y" if suf == "ies" else "")
            break
    if w.endswith("e") and len(w) > 4:
        w = w[:-1]
    return w


# ---- paths -------------------------------------------------------------------

def qpath(p: str) -> str:
    """Shell-quote a path but keep a leading ~ expandable."""
    if p in ("~", "~/"):
        return "~"
    if p.startswith("~/"):
        return "~/" + shlex.quote(p[2:])
    m = re.fullmatch(r"\$\{?([A-Za-z_]\w*)\}?(/.*)?", p)
    if m:                                   # "$PROJECT/src": let bash expand the variable
        return f'"${{{m.group(1)}}}"' + (shlex.quote(m.group(2)) if m.group(2) else "")
    return shlex.quote(p)


def is_pathlike(tok: str) -> bool:
    return (tok == ".." or bool(re.search(r"[/~*?]", tok))
            or bool(re.fullmatch(r"[\w.+-]*[A-Za-z_][\w-]*\.[A-Za-z0-9]{1,8}", tok)))


def resolve(tok: str, cwd: str, want: str | None = None) -> str | None:
    """Turn a word into a real path, as the user would type it.

    want: "dir", "file" or None. Tries the literal path, then a
    case-insensitive match in cwd ("readme" -> README.md), then the usual
    home folders ("downloads" -> ~/Downloads).
    """
    if not tok:
        return None
    full = os.path.expanduser(tok)
    if not os.path.isabs(full):
        full = os.path.join(cwd, full)

    def ok(path):
        if want == "dir":
            return os.path.isdir(path)
        if want == "file":
            return os.path.isfile(path)
        return os.path.exists(path)

    if ok(full):
        return tok
    if "/" not in tok:
        try:
            entries = os.listdir(cwd)
        except OSError:
            entries = []
        low = tok.lower()
        for match in ([e for e in entries if e.lower() == low],
                      [e for e in entries if os.path.splitext(e)[0].lower() == low]):
            match = [e for e in match if ok(os.path.join(cwd, e))]
            if len(match) == 1:
                return match[0]
        if want in ("dir", None) and low in XDG_DIRS:
            return "~/" + XDG_DIRS[low]
    return None


