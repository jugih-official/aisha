def _clean_phrase(phrase: str) -> str:
    return " ".join(phrase.strip().rstrip("?!.").split())


def _is_slot_value(v: str, quoted: bool) -> bool:
    if quoted or re.search(r"[./~@:\d]", v):
        return True
    low = v.lower()
    return v.isidentifier() and low not in FILLER and low not in VOCAB and low not in ACTION_WORDS and \
        low not in MODEL_STOP and len(v) > 1


def make_template(phrase: str, command: str) -> tuple[str, str]:
    """('frobnicate notes.md', 'touch notes.md') -> ('frobnicate {1}', 'touch {1}')."""
    ptoks = re.findall(r'"[^"]*"|\'[^\']*\'|\S+', _clean_phrase(phrase))
    try:
        ctoks = shlex.split(command)
    except ValueError:
        ctoks = command.split()
    slots: dict = {}
    out = []
    for t in ptoks:
        quoted = t[:1] in "\"'" and len(t) > 1
        v = t[1:-1] if quoted else t.rstrip(",;")
        if v and v in ctoks and _is_slot_value(v, quoted):
            out.append("{%d}" % slots.setdefault(v, len(slots) + 1))
        else:
            out.append(t.lower())
    template = command
    for v, n in sorted(slots.items(), key=lambda kv: -len(kv[0])):
        template = re.sub(r"""(['"]?)(?<![\w./-])""" + re.escape(v) + r"""(?![\w./-])\1""", "{%d}" % n, template)
    return " ".join(out), template


def template_regex(pattern: str):
    parts = [r"""("[^"]*"|'[^']*'|\S+)""" if re.fullmatch(r"\{\d+\}", t) else re.escape(t) for t in pattern.split()]
    return re.compile(r"\s+".join(parts), re.I)


def fill_command(template: str, pattern: str, values: tuple) -> str | None:
    order = [int(n) for n in re.findall(r"\{(\d+)\}", pattern)]
    got: dict = {}
    for n, v in zip(order, values):
        v = v[1:-1] if v[:1] in "\"'" and len(v) > 1 else v
        if got.setdefault(n, v) != v:
            return None
    try:
        return re.sub(r"\{(\d+)\}", lambda m: shlex.quote(got[int(m.group(1))]), template)
    except KeyError:
        return None


