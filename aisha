def num(s: str | None, default=None):
    if s is None:
        return default
    s = s.strip().lower().replace(" of", "")
    if re.fullmatch(r"\d+", s):
        return int(s)
    if re.fullmatch(r"\d*\.\d+", s):
        return float(s)
    return NUMWORDS.get(s, default)


