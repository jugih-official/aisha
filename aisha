def save_config(updates: dict) -> None:
    try:
        with open(CFG_FILE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    data.update(updates)
    data = {k: v for k, v in data.items() if v is not None}
    os.makedirs(CFG_DIR, exist_ok=True)
    tmp = CFG_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    os.replace(tmp, CFG_FILE)


def load_config() -> dict:
    cfg = dict(DEFAULTS)
    try:
        with open(CFG_FILE) as f:
            cfg.update(json.load(f))
    except (OSError, ValueError):
        pass
    for key, env in ENV_KEYS.items():
        if os.environ.get(env):
            cfg[key] = os.environ[env]
    cfg["llm_timeout"] = float(cfg["llm_timeout"])
    cfg["threshold"] = float(cfg["threshold"])
    cfg["banner"] = str(cfg["banner"]).lower() not in ("0", "false", "no", "off")
    cfg["prompt_git"] = str(cfg["prompt_git"]).lower() in ("1", "true", "yes", "on")
    cfg["fix_hint"] = str(cfg["fix_hint"]).lower() not in ("0", "false", "no", "off")
    # A language model is used only when it was set up (aisha --setup) or named.
    try:
        with open(CFG_FILE) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        saved = {}
    cfg["_configured"] = bool(any(k in saved for k in ("llm_url", "llm_server", "llm_model"))
                              or any(os.environ.get(e) for e in ("AISHA_LLM_URL", "AISHA_LLM_MODEL", "AISHA_LLM_SERVER")))
    return cfg


