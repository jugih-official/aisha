def looks_like_shell(line: str, path_env: str | None = None, cwd: str | None = None,
                     threshold: float = DEFAULTS["threshold"], known: set | None = None) -> bool:
    """known: alias and function names, which count as commands."""
    if not _looks_like_shell(line, path_env, known or set()):
        return False
    # A command word followed by plain words: let the rules have a go first.
    try:
        toks = shlex.split(line)
    except ValueError:
        return True
    rest = toks[1:]
    if (toks[0] in POWER_CMDS and rest and not re.search(r"[|&;<>`$]", line)
            and not all(SHUTDOWN_TIME.fullmatch(t) for t in rest)):
        return False
    if (toks[0] in ("kill", "pkill") and rest and all(t.startswith("-") or not re.fullmatch(r"[%+-]?\d+|%\S*", t)
                                                       for t in rest)
            and any(re.fullmatch(r"[a-z][\w.-]*", t) for t in rest) and toks[0] == "kill"
            and not re.search(r"[|&;<>`$]", line)):
        return False                     # "kill -9 firefox": kill takes numbers, the rules take names
    if toks[0] == "git" and cwd and rest and not any(t.startswith("-") for t in rest) \
            and not re.search(r"[|&;<>`$]", line):
        # "git switch to dev", "git undo the last commit": words, not git's own syntax.
        # A real subcommand with names only ("git merge dev", "git add app.py") stays git.
        words = {w.lower() for w in rest[1:]}
        quoted_msg = rest[0].lower() == "commit" and re.search(r"[\"'“]", line)    # git commit "new image"
        if rest[0].lower() not in GIT_SUBCOMMANDS or words & GIT_PLAIN_WORDS or quoted_msg:
            plan = interpret(line, cwd)
            if plan and plan.confidence >= threshold:
                return False
    if (cwd and toks[0] == "search" and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line)):
        # "search notes", "search run1 for pressure": aisha's search, also where a
        # search script is installed (Linux Mint has one); its -flags still reach it.
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    if (cwd and toks[0] == "grep" and rest and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line)
            and not any(os.path.exists(os.path.join(cwd, os.path.expanduser(t))) for t in rest[1:])
            and not any(re.search(r"[*?/]", t) for t in rest[1:])):
        # "grep pressure" would wait for input forever; "grep for todo in python files" is words
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    if (cwd and toks[0] == "sort" and len(rest) > 1 and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line)
            and any(os.path.isfile(os.path.join(cwd, os.path.expanduser(t))) for t in rest)
            and not all(os.path.exists(os.path.join(cwd, os.path.expanduser(t))) for t in rest)):
        plan = interpret(line, cwd)          # "sort nums.txt numerically", "sort names.txt in reverse"
        if plan and plan.confidence >= threshold:
            return False
    if (cwd and toks[0] in NET_FIRST and rest and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line) and re.search(HOST_RX, line.lower())
            and (len(rest) > 1 or re.search(r":\d{1,5}$", rest[0]))):
        plan = interpret(line, cwd)          # "ping 10.0.0.5 on port 50", "test connection to host:80"
        if plan and plan.confidence >= threshold:
            return False
    if toks[0] == "reset" and rest and not any(t.startswith("-") for t in rest):
        return False                     # reset(1) takes no words: "reset app.py" is git
    if toks[0] in ("sort", "cut", "order") and re.search(r"\bby\s+(?:the\s+)?(?:\w+\s+)?(?:column|field)\b", line):
        return False                     # "sort people.csv by column 2"
    if toks[0] == "watch" and re.search(r"\blogs?\b", line) and not any(t.startswith("-") for t in rest):
        return False                     # "watch nginx logs live"
    if toks[0] == "git" and len(toks) > 2 and toks[-1].lower() in ("please", "pls", "thanks") and not re.search(r"[|&;<>`$]", line):
        return False                     # "git status please": the rules drop the please
    if toks[0] == "yes" and not re.search(r"[|&;<>`$]", line):
        return False                     # "yes please": nobody wants y printed forever
    if (cwd and toks[0] in PREFER_RULES and rest and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line)):
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    # words, not numbers, %jobs or paths that exist here ("kill 1234" and "kill %1" stay bash)
    plain = [t for t in rest if not re.fullmatch(r"[%+-]?\d+|%\S*", t)
             and not os.path.exists(os.path.join(cwd or ".", os.path.expanduser(t)))]
    english = len(rest) > 1 and rest[0].lower() in ("a", "an", "the", "my", "me", "all", "every", "some", "how", "alias",
                                                    "folder", "file", "directory", "new", "copy", "backup", "link")
    if (cwd and toks[0] in AMBIGUOUS_FIRST and plain
            and (english or not any(t.startswith("-") for t in rest))
            and not re.search(r"[|&;<>`$]", line)
            and not all(os.path.exists(os.path.join(cwd, os.path.expanduser(t))) for t in rest)):
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    return True


