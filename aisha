def is_local_url(url: str) -> bool:
    host = urllib.parse.urlsplit(url).hostname or ""
    return host in ("localhost", "127.0.0.1", "::1") or host.startswith("127.")


def url_open(req, timeout: float):
    """urlopen that never sends local requests through an HTTP proxy."""
    import urllib.request  # only needed for the LLM and downloads; keeps startup fast
    url = req.full_url if isinstance(req, urllib.request.Request) else req
    if is_local_url(url):
        return urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=timeout)
    return urllib.request.urlopen(req, timeout=timeout)


def is_llamafile(server: str) -> bool:
    return "llamafile" in os.path.basename(server).lower()


def server_env(server: str) -> dict:
    env = dict(os.environ)
    libdir = os.path.dirname(os.path.realpath(server))
    env["LD_LIBRARY_PATH"] = libdir + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    return env


class Runtime:
    """llama-server, started on first use and stopped when aisha exits."""

    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.proc: subprocess.Popen | None = None

    @property
    def configured(self) -> bool:
        server, model = self.cfg.get("llm_server"), self.cfg.get("llm_model_file")
        return bool(server and model and os.path.isfile(server) and os.path.isfile(model)
                    and is_local_url(self.cfg["llm_url"]))

    @property
    def port(self) -> int:
        return urllib.parse.urlsplit(self.cfg["llm_url"]).port or MANAGED_PORT

    def running(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def start(self) -> None:
        if self.running() or server_answers(f"http://127.0.0.1:{self.port}/v1"):
            return                       # this window's, or one another aisha window started
        os.makedirs(DATA_DIR, exist_ok=True)
        log_path = os.path.join(DATA_DIR, "llama-server.log")
        server = self.cfg["llm_server"]
        base = ["-m", self.cfg["llm_model_file"], "--host", "127.0.0.1", "--port", str(self.port), "-c", "4096"]
        if is_llamafile(server):   # llamafile wants --server; older ones also open a browser unless told not to
            variants = [["--server", "--nobrowser"] + base, ["--server"] + base, base]
        else:
            variants = [base]
        launcher = ["sh", server] if self.cfg.get("llm_server_sh") else [server]
        err = ""
        for extra in variants:
            err = self._try_start(launcher + extra, server, log_path)
            if not err:
                return
            if "unknown" not in err.lower() and "unrecognized" not in err.lower() and "invalid" not in err.lower():
                break                  # a real failure, not an option this version lacks
        raise LLMError(err)

    def _try_start(self, args: list[str], server: str, log_path: str) -> str:
        """Start and wait until ready. '' on success, else what went wrong."""
        with open(log_path, "ab") as log:
            log.write(f"\n--- {time.strftime('%F %T')} {' '.join(args)}\n".encode())
            start_pos = log.tell()
            self.proc = subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                         env=server_env(server), start_new_session=True)
        atexit.register(self.stop)
        began = time.time()
        deadline = began + max(30.0, self.cfg["llm_timeout"])
        health = f"http://127.0.0.1:{self.port}/health"
        shown = 0
        tty = sys.stderr.isatty()

        def log_tail(n: int = 8) -> str:
            try:
                with open(log_path, "rb") as f:
                    f.seek(start_pos)
                    out = f.read().decode(errors="replace")
            except OSError:
                return ""
            return "\n".join(out.strip().splitlines()[-n:])

        def clear():
            if tty and shown:
                sys.stderr.write("\r\033[K")
                sys.stderr.flush()

        while time.time() < deadline:
            if self.proc.poll() is not None:
                clear()
                if server_answers(f"http://127.0.0.1:{self.port}/v1"):
                    self.proc = None             # another window started it at the same moment: use that one
                    return ""
                return f"the model server stopped (exit {self.proc.returncode}); its output:\n" + log_tail()
            try:
                with url_open(health, timeout=2) as r:
                    if r.status == 200:
                        clear()
                        return ""
            except urllib.error.HTTPError:
                pass  # 503 while the model loads
            except (urllib.error.URLError, OSError):
                pass
            waited = int(time.time() - began)
            if tty and waited >= 3 and waited != shown:   # a slow first start should not look frozen
                shown = waited
                sys.stderr.write(f"\r\033[K{dim(f'  loading the model… {waited}s (up to {int(deadline - began)}s)')}")
                sys.stderr.flush()
            time.sleep(0.3)
        clear()
        tail = log_tail()
        self.stop()
        return (f"the model server did not become ready in {int(deadline - began)}s. Its last output "
                f"(full log: {log_path}):\n{tail}" if tail else
                f"the model server did not become ready in time and printed nothing (see {log_path})")

    def stop(self) -> None:
        """At exit: the model server is shared by every aisha window, so the last one stops it."""
        if self.running():
            if other_aishas():
                self._write_pid(self.proc.pid)   # another window still uses it; the last one stops it
                self.proc = None
                return
            self.proc.terminate()
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self._write_pid(None)
        self.proc = None

    def stop_if_last(self) -> None:
        """At exit of a window that used a server another window started."""
        if self.running() or other_aishas():
            return
        pid = self._read_pid()
        if pid and _cmdline(pid).find(os.path.basename(self.cfg.get("llm_model_file") or "\0")) >= 0:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        self._write_pid(None)

    @property
    def pid_file(self) -> str:
        return os.path.join(DATA_DIR, "llama-server.pid")

    def _write_pid(self, pid: int | None) -> None:
        try:
            if pid:
                with open(self.pid_file, "w") as f:
                    f.write(str(pid))
            elif os.path.exists(self.pid_file):
                os.remove(self.pid_file)
        except OSError:
            pass

    def _read_pid(self) -> int | None:
        try:
            with open(self.pid_file) as f:
                return int(f.read().strip())
        except (OSError, ValueError):
            return None


def _cmdline(pid: int) -> str:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return f.read().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return ""


def other_aishas() -> list[int]:
    """Other aisha shells running as this user (interactive ones, not 'aisha -c' or -n)."""
    me, out = os.getpid(), []
    try:
        pids = [int(p) for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return out
    uid = os.getuid() if hasattr(os, "getuid") else None
    for pid in pids:
        if pid == me:
            continue
        try:
            if uid is not None and os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if not args:
            continue
        prog = next((a for a in args[:3] if os.path.basename(a) in ("aisha", "aisha.py")), None)
        if prog and not any(a in ("-c", "-n", "--setup", "--version", "--lines") for a in args[args.index(prog) + 1:]):
            out.append(pid)
    return out


def ollama_models(url: str) -> list[str]:
    """Models an Ollama server has, via its /api/tags (empty if it isn't Ollama)."""
    base = re.sub(r"/v1/?$", "", url.rstrip("/"))
    try:
        with url_open(base + "/api/tags", timeout=3) as r:
            return [m["name"] for m in json.load(r).get("models", [])]
    except (OSError, ValueError, KeyError, TypeError):
        return []


def tail_file(path: str, n: int = 8) -> str:
    try:
        with open(path, errors="replace") as f:
            return "".join(f.readlines()[-n:]).rstrip()
    except OSError:
        return ""




class LLM:
    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.runtime = Runtime(cfg)
        self._hinted = False

    @property
    def enabled(self) -> bool:
        mode = str(self.cfg["llm"]).lower()
        if mode in ("off", "0", "no", "false", "none"):
            return False
        if mode in ("on", "1", "yes", "true"):
            return True
        return bool(self.cfg.get("_configured"))      # auto: only once set up

    @property
    def label(self) -> str:
        if self.runtime.configured:
            return f"{self.cfg['llm_model']} (local llama.cpp, starts when needed)"
        return f"{self.cfg['llm_model']} at {self.cfg['llm_url']}"

    @property
    def brief(self) -> str:
        """The label for the start line: without the note on when the model starts."""
        return self.label.replace(", starts when needed", "")

    def _post(self, messages: list[dict]) -> str:
        import http.client
        try:
            return self._post_once(messages)
        except http.client.HTTPException as e:   # e.g. a truncated reply
            raise LLMError(f"the LLM server's reply broke off ({type(e).__name__})") from None

    def _post_once(self, messages: list[dict]) -> str:
        url = self.cfg["llm_url"].rstrip("/") + "/chat/completions"
        body = json.dumps({"model": self.cfg["llm_model"], "messages": messages,
                           "temperature": 0, "max_tokens": 256, "stream": False}).encode()
        headers = {"Content-Type": "application/json"}
        if self.cfg.get("llm_key"):
            headers["Authorization"] = f"Bearer {self.cfg['llm_key']}"
        import urllib.request
        req = urllib.request.Request(url, data=body, headers=headers, method="POST")
        try:
            try:
                with url_open(req, timeout=self.cfg["llm_timeout"]) as r:
                    data = json.load(r)
            except urllib.error.URLError as e:
                if isinstance(e, urllib.error.HTTPError) or not self.runtime.configured or self.runtime.running():
                    raise
                say(dim(f"… starting the local model ({os.path.basename(self.cfg['llm_model_file'])})"))
                self.runtime.start()
                with url_open(req, timeout=self.cfg["llm_timeout"]) as r:
                    data = json.load(r)
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            if e.code == 404 and "model" in detail.lower():
                have = ollama_models(self.cfg["llm_url"])
                hint = (f" Installed models: {', '.join(have)} (use one with AISHA_LLM_MODEL=<name>, "
                        f"or in {CFG_FILE})." if have else "")
                raise LLMError(f"the model {self.cfg['llm_model']} is not downloaded yet. Run: aisha --setup "
                               f"(or: ollama pull {self.cfg['llm_model']}).{hint}") from None
            raise LLMError(f"LLM server returned HTTP {e.code}: {detail}") from None
        except ValueError as e:              # 200 but not JSON
            raise LLMError(f"the LLM server sent something that is not JSON ({e})") from None
        except (urllib.error.URLError, ConnectionError, TimeoutError, OSError) as e:
            reason = getattr(e, "reason", e)
            hint = "" if self._hinted else " Run 'aisha --setup' to add a local model."
            self._hinted = True
            raise LLMError(f"no LLM reachable at {self.cfg['llm_url']} ({reason}).{hint}") from None
        if self.runtime.configured and not self.runtime.running() and not getattr(self, "_watch_last", False):
            self._watch_last = True          # a server started by another window: stopped when this is the last one
            atexit.register(self.runtime.stop_if_last)
        try:
            return data["choices"][0]["message"]["content"] or ""
        except (KeyError, IndexError, TypeError):
            raise LLMError(f"unexpected reply from LLM server: {str(data)[:200]}") from None

    def command_for(self, request: str, cwd: str, hints: str, failure: str = "",
                    examples: list | None = None, avoid: list | None = None) -> str | None:
        """examples: (request, command) pairs approved earlier; avoid: commands declined for this request."""
        avoid = [a.strip() for a in avoid or []]
        try:
            entries = sorted(os.listdir(cwd))
        except OSError:
            entries = []
        shown = [e + ("/" if os.path.isdir(os.path.join(cwd, e)) else "") for e in entries[:60]]
        more = f" (+{len(entries) - 60} more)" if len(entries) > 60 else ""
        context = (f"System: {os_name()}\n"
                   f"Installed extras: {', '.join(t for t in OPTIONAL_TOOLS if shutil.which(t)) or 'none'}\n"
                   f"Current directory: {cwd}\n"
                   f"Entries here: {', '.join(shown) or '(empty)'}{more}\n")
        if hints:
            context += f"Partial parse by the rule engine (may be wrong): {hints}\n"
        if failure:
            context += (f"This request was typed as a bash line and failed: {failure}. "
                        "Reply with the command that was meant.\n")
        if avoid:
            context += "Already declined for this request (never reply with these): " + " ; ".join(avoid) + "\n"
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        for q, a in FEWSHOT + [(f"Request: {q}", c) for q, c in examples or []]:
            messages += [{"role": "user", "content": q}, {"role": "assistant", "content": a}]
        messages.append({"role": "user", "content": f"{context}Request: {request}"})
        for attempt in range(2):
            raw = self._post(messages)
            cmd = clean_llm_command(raw)
            if cmd is None:
                return None
            problem = validate_command(cmd) or ("it was already declined" if cmd.strip() in avoid else None)
            if not problem:
                return cmd
            messages += [{"role": "assistant", "content": raw},
                         {"role": "user", "content": f"That is not a valid command ({problem}). "
                                                     "Reply with one bash command only."}]
        raise LLMError(f"the model did not produce a valid command (last try: {cmd})")


def clean_llm_command(text: str) -> str | None:
    text = text.strip()
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S).strip()
    m = re.search(r"```(?:bash|sh|shell|console)?\s*\n?(.*?)```", text, re.S)
    if m:
        text = m.group(1).strip()
    lines = [l.rstrip() for l in text.splitlines() if l.strip()]
    if not lines:
        return None
    if m and len(lines) > 1 and not any(l.lstrip().startswith(("$ ", "# ")) for l in lines):
        block = "\n".join(lines)          # a fenced multi-line script, kept whole if it parses
        if subprocess.run(["bash", "-n", "-c", block], capture_output=True).returncode == 0:
            return block
    joined, buf = [], ""
    for line in lines:
        if line.endswith("\\"):
            buf += line[:-1].strip() + " "
            continue
        joined.append((buf + line.strip()).strip())
        buf = ""
    cmd = joined[0]
    cmd = re.sub(r"^(?:\$|>|#)\s+", "", cmd)
    cmd = re.sub(r"^(?:command|bash)\s*:\s*", "", cmd, flags=re.I)
    cmd = cmd.strip("`").strip()
    if cmd.upper().rstrip(".") == "NONE" or not cmd:
        return None
    return cmd


def validate_command(cmd: str) -> str | None:
    r = subprocess.run(["bash", "-n", "-c", cmd], capture_output=True, text=True)
    if r.returncode != 0:
        return (r.stderr.strip().splitlines() or ["syntax error"])[-1]
    try:
        first = shlex.split(cmd)[0]
    except (ValueError, IndexError):
        return "cannot parse"
    if "=" in first or first in SHELL_BUILTINS or first.startswith(("./", "/", "~", "$")) \
            or first in ("for", "while", "if", "{", "(") or shutil.which(first):
        return None
    return f"'{first}' is not an installed command"


# ---- memory of approved LLM answers -----------------------------------------------

# Exit codes of a typed bash line after which "?" asks what was meant.
FIX_CODES = {2: "wrong usage or a missing file", 126: "not executable", 127: "command not found"}


LEARNED_MIN = 0.45        # how close a request must be to a learned one to be offered


class Memory:
    def __init__(self, path: str):
        self.path = path
        self.rej_path = os.path.splitext(path)[0] + "-rejected.json"
        self.data = self._load(path)
        self.rejected: dict = self._load(self.rej_path)     # phrase key -> commands declined for it
        self._index: tuple | None = None                    # (phrases, IntentModel, entries)

    @staticmethod
    def _load(path: str) -> dict:
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def similar(self, text: str, cwd: str, k: int = 3, min_score: float = LEARNED_MIN) -> list[tuple[float, str, str]]:
        """Learned requests close to this one, as (score, phrase, command). Taught
        templates get this request's values in their slots ("frobnicate {1}")."""
        if not self.data:
            return []
        phrases, entries = [], []
        for key, v in self.data.items():
            pat = v.get("pattern")
            phrases.append(" ".join(re.sub(r"\{\d+\}", " ", pat).split()) if pat else key)
            entries.append((key, v))
        if not self._index or self._index[0] != phrases:
            self._index = (phrases, IntentModel(phrases), dict(zip(phrases, entries)))
        _, model, by_phrase = self._index
        own = self.key(text)
        out, seen = [], set()
        for score, ph in model.rank(text, k=10):
            if score < min_score:
                break
            key, v = by_phrase[ph]
            if key == own:
                continue                        # the exact phrase is replayed elsewhere
            pat = v.get("pattern")
            if pat:
                n = len(re.findall(r"\{\d+\}", pat))
                vals = [val for _, val in request_values(text, cwd)[1]]
                if len(vals) < n:
                    continue
                cmd = fill_command(v["command"], pat, tuple(vals[:n]))
                shown = pat
                for i, val in enumerate(vals[:n], 1):
                    shown = shown.replace("{%d}" % i, val)
            else:
                cmd, shown = v["command"], key
            if cmd and cmd not in seen:
                seen.add(cmd)
                out.append((score, shown, cmd))
            if len(out) >= k:
                break
        return out

    def reject(self, phrase: str, command: str) -> None:
        lst = self.rejected.setdefault(self.key(phrase), [])
        if command not in lst:
            lst.append(command)
            self._write(self.rej_path, self.rejected)

    def rejected_for(self, phrase: str) -> list[str]:
        return list(self.rejected.get(self.key(phrase), []))

    @staticmethod
    def key(phrase: str) -> str:
        return " ".join(re.sub(r"[^\w\s./~*'\"-]", " ", phrase.lower()).split())

    def get(self, phrase: str) -> str | None:
        hit = self.data.get(self.key(phrase))
        return hit["command"] if hit else None

    def remember(self, phrase: str, command: str) -> None:
        k = self.key(phrase)
        entry = self.data.get(k, {"uses": 0})
        entry.update(command=command, saved=time.strftime("%Y-%m-%d %H:%M"))
        entry["uses"] = entry.get("uses", 0) + 1
        self.data[k] = entry
        self._save()

    def match(self, phrase: str) -> str | None:
        """An exact remembered phrase, or a taught template ('frobnicate {1}') it fits."""
        hit = self.get(phrase)
        if hit:
            return hit
        clean = _clean_phrase(phrase)
        for entry in self.data.values():
            pat = entry.get("pattern")
            if pat:
                m = template_regex(pat).fullmatch(clean)
                if m:
                    cmd = fill_command(entry["command"], pat, m.groups())
                    if cmd:
                        return cmd
        return None

    def learn(self, phrase: str, command: str) -> tuple[str, str]:
        """Remember phrase -> command, generalised: values in both become slots."""
        pattern, template = make_template(phrase, command)
        if re.search(r"\{\d+\}", template):
            return self._store_pattern(pattern, template)
        self.remember(phrase, command)
        return self.key(phrase), command

    def teach(self, phrase: str, command: str) -> tuple[str, str]:
        """'teach make thing {name} = mkdir -p {name}': explicit slots, or learn() from the example."""
        names = list(dict.fromkeys(re.findall(r"\{(\w+)\}", phrase)))
        if not names:
            return self.learn(phrase, command)
        num = {n: i + 1 for i, n in enumerate(names)}
        pattern = re.sub(r"\{(\w+)\}", lambda m: "{%d}" % num[m.group(1)], _clean_phrase(phrase).lower())
        template = re.sub(r"\{(\w+)\}", lambda m: "{%d}" % num[m.group(1)] if m.group(1) in num else m.group(0), command)
        return self._store_pattern(pattern, template)

    def _store_pattern(self, pattern: str, template: str) -> tuple[str, str]:
        k = "pattern: " + pattern
        entry = self.data.get(k, {"uses": 0})
        entry.update(pattern=pattern, command=template, saved=time.strftime("%Y-%m-%d %H:%M"))
        entry["uses"] = entry.get("uses", 0) + 1
        self.data[k] = entry
        self._save()
        return pattern, template

    def forget(self, phrase: str) -> bool:
        dropped = self.rejected.pop(self.key(phrase), None) is not None
        if dropped:
            self._write(self.rej_path, self.rejected)
        for k in (self.key(phrase), "pattern: " + _clean_phrase(phrase).lower()):
            if self.data.pop(k, None) is not None:
                self._save()
                return True
        return dropped

    def _save(self) -> None:
        self._write(self.path, self.data)

    @staticmethod
    def _write(path: str, data: dict) -> None:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
        os.replace(tmp, path)


