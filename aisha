def _replace_in_type(vals, u):
    test = _ext_glob(_lit(vals, "type", u))
    if not test:
        return None
    a = re.sub(r"([/&\\.*^$\[\]])", r"\\\1", _lit(vals, "a", u))
    b = re.sub(r"([/&\\])", r"\\\1", _lit(vals, "b", u))
    return (f"find . {NOT_GIT} -type f {test} -exec grep -qF -- {shlex.quote(_lit(vals, 'a', u))} {{}} \\; "
            f"-exec sed -i {shlex.quote('s/' + a + '/' + b + '/g')} -- {{}} +")


def _proc_names(word: str) -> str:
    w = word.lower()
    alias = {"firefox": "firefox,firefox-esr", "chrome": "chrome,chromium", "chromium": "chromium,chrome",
             "code": "code", "vscode": "code"}.get(w, word)
    return shlex.quote(alias)


def _ram_total(vals, u):
    return (f"ps -C {_proc_names(_lit(vals, 'word', u))} -o rss= | "
            "awk '{s+=$1} END {printf \"%.0f MiB\\n\", s/1024}'")


def _kill_except(vals, u):
    name, keep = _lit(vals, "word", u), _lit(vals, "keep", u)
    if name.lower() in ("all", "everything", "processes", "the"):
        return None
    q, k = shlex.quote(name), shlex.quote(keep)
    if keep.isdigit():
        return f"pgrep -- {q} | grep -vxF {keep} | xargs -r kill"
    return f"pgrep -a -- {q} | grep -v -- {k} | cut -d' ' -f1 | xargs -r kill"


def _kill_top(vals, u):
    res = "%mem" if vals["_raw_res"].lower() in ("memory", "ram") else "%cpu"
    return (f"pid=$(ps -eo pid --sort=-{res} --no-headers | head -n 1 | tr -d ' '); "
            f"ps -o pid,comm,{res} -p \"$pid\"; kill \"$pid\"")


def _pause(vals, u):
    word = _lit(vals, "word", u)
    if re.fullmatch(COMPUTER_WORDS + r"|downloads?|music|it|everything", word.lower()):
        return None
    sig = "STOP" if vals["_raw_verb"].lower() in ("pause", "freeze") else "CONT"
    return f"pkill -{sig} -- {shlex.quote(word)}"


def _uptime_of(vals, u):
    word = _lit(vals, "word", u)
    if re.fullmatch(COMPUTER_WORDS, word.lower()):
        return None
    unit = service_name(word)
    if unit and unit_exists(unit) or unit and not process_running(word):
        return f"systemctl show {shlex.quote(unit)} -p ActiveEnterTimestamp --value"
    return f"ps -C {_proc_names(word)} -o pid,etime,cmd"


def _threads(vals, u):
    return f"ps -o pid,nlwp,cmd -C {_proc_names(_lit(vals, 'word', u))}"


def _since(vals, u):
    when = vals["_raw_when"].strip().lower()
    when = re.sub(r"^the\s+", "", when)
    m = re.fullmatch(r"(?:the\s+)?(?:last|past)\s+(?:(\d+|an?|one)\s+)?(minute|min|hour|day|week)s?", when) or \
        re.fullmatch(r"(\d+|an?|one)\s+(minute|min|hour|day|week)s?\s+ago", when)
    if m:
        n = 1 if m.group(1) in (None, "a", "an", "one") else int(m.group(1))
        unit = {"minute": "min", "min": "min", "hour": "h", "day": "d", "week": "w"}[m.group(2)]
        return f"journalctl --since '-{n}{unit}' --no-pager"
    if when in ("boot", "last boot", "the last boot", "startup", "reboot", "the reboot"):
        return "journalctl -b --no-pager"

    def clock(t):
        mm = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\.?|(\d{1,2}):(\d{2})", t)
        if not mm:
            return None
        if mm.group(4):
            return f"{int(mm.group(4)):02d}:{mm.group(5)}"
        h = int(mm.group(1)) % 12 + (12 if mm.group(3) == "p" else 0)
        return f"{h:02d}:{mm.group(2) or '00'}"
    m = re.fullmatch(r"(today|yesterday)(?:\s+(?:at\s+)?(.+))?|(?:at\s+)?(.+?)(?:\s+(today|yesterday))?", when)
    day = m.group(1) or m.group(4) or "today"
    t = m.group(2) or m.group(3)
    if t:
        c = clock(t)
        if not c:
            return None
        return f"journalctl --since '{day} {c}' --no-pager"
    return f"journalctl --since {day} --no-pager"


def _date_of(vals, u):
    when = re.sub(r"^in\s+", "", vals["_raw_when"].strip().lower())
    when = re.sub(r"\bfrom\s+now\b", "", when).strip()
    return f"date -d {shlex.quote(when)} '+%A %d %B %Y'"


def _ms_date(vals, u):
    ts = int(vals["_raw_ts"])
    return f"date -d @{ts // 1000}" if ts > 10 ** 11 else f"date -d @{ts}"


def _install_many(vals, u):
    names = [n for n in re.split(r"\s*,\s*|\s+and\s+|\s+", re.sub(r"^both\s+", "", vals["_raw_pkgs"].strip())) if n]
    if len(names) < 2 or any(n.lower() in FILLER or os.path.exists(os.path.join(u.cwd, n)) for n in names):
        return None
    return install_cmd([shlex.quote(n) for n in names])


def _purge(vals, u):
    pm, name = pkg_manager(), _lit(vals, "word", u)
    if name.lower() in FILLER or os.path.exists(os.path.join(u.cwd, name)):
        return None
    plan = uninstall_plan(name, purge=True)
    if plan:
        return plan
    q = shlex.quote(name)
    if pm != "apt":
        return install_cmd([q], remove=True)
    return f"{sudo()}apt purge {q} && {sudo()}apt autoremove"


INTERPRETERS = {".sh": "bash", ".bash": "bash", ".py": "python3", ".js": "node", ".pl": "perl", ".rb": "ruby",
                ".php": "php", ".lua": "lua"}


def _run_args(vals, u) -> str:
    return "".join(" " + shlex.quote(u.lit(a)) for a in (vals.get("_raw_args") or "").split())


def _run_file(vals, u):
    """'run install.sh' -> ./install.sh (or bash install.sh when it is not executable)."""
    path = _lit(vals, "path", u)
    full = os.path.join(u.cwd, os.path.expanduser(path))
    if not os.path.isfile(full):
        return None
    shown = path if path.startswith(("/", "./", "../", "~")) else "./" + path
    ext = os.path.splitext(path)[1].lower()
    if os.access(full, os.X_OK):
        cmd = shlex.quote(shown) if shown != shown.replace(" ", "") else shown
    elif ext in INTERPRETERS:
        cmd = f"{INTERPRETERS[ext]} {qpath(path)}"
    else:
        try:
            with open(full, "rb") as f:
                first = f.readline(200)
        except OSError:
            return None
        m = re.match(rb"#!\s*(\S+)(?:\s+(\S+))?", first)
        if not m:
            return None                  # not a program: "run notes.txt" means nothing
        prog = (m.group(2) if m.group(1).endswith(b"/env") and m.group(2) else m.group(1)).decode(errors="replace")
        cmd = f"{os.path.basename(prog)} {qpath(path)}"
    root = "sudo " if vals.get("_raw_root") else ""
    return root + cmd + _run_args(vals, u)


def _run_program(vals, u):
    """'run htop', 'launch firefox': a program on PATH (a file here is run by 'run file')."""
    name = _lit(vals, "word", u)
    if os.path.exists(os.path.join(u.cwd, name)) or not shutil.which(name) or name in ("the", "it", "this"):
        return None
    verb = vals["_raw_verb"].lower()
    root = "sudo " if vals.get("_raw_root") else ""
    if verb in ("launch", "open", "start") and GUI and not root:
        return f"nohup {shlex.quote(name)}{_run_args(vals, u)} >/dev/null 2>&1 &"
    return root + shlex.quote(name) + _run_args(vals, u)


RUN_VERB = r"(?P<verb>run|execute|exec|start|launch|open)"
RUN_TAIL = r"(?P<args>(?:\s+(?:-\S+|qlit\d+|\d+))*)(?P<root>\s+(?:as\s+root|with\s+sudo|as\s+admin))?\s*$"


GAME_RECIPES = [
