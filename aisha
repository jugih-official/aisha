# ---- phrases found by the findings game (tests/findings.md) ------------------------

ORDINALS = {"first": 1, "second": 2, "third": 3, "fourth": 4, "fifth": 5, "sixth": 6, "seventh": 7, "eighth": 8,
            "ninth": 9, "tenth": 10}
ORD = r"(?:\d+(?:st|nd|rd|th)?|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth)"
NOT_GIT = "-path ./.git -prune -o"


def ord_num(w: str) -> int:
    w = w.lower()
    return ORDINALS.get(w) or int(re.sub(r"\D", "", w) or 1)


def _lit(vals: dict, key: str, u: Utterance) -> str:
    return u.lit(vals.get("_raw_" + key, "").strip())


def _ext_glob(word: str | None) -> str | None:
    """'txt', 'pdfs', '.sh', 'python' -> the -name test for that type."""
    if not word:
        return None
    w = word.lower().lstrip("*.")
    w = {"shell": "sh", "bash": "sh"}.get(w, w)
    t = type_word(w)
    exts = t[1] if t else ([w.rstrip("s")] if w.endswith("s") and len(w) > 3 else [w])
    if len(exts) == 1:
        return f"-iname '*.{exts[0]}'"
    return "\\( " + " -o ".join(f"-iname '*.{e}'" for e in exts) + " \\)"


def _column(vals, u):
    n = ord_num(_lit(vals, "n", u))
    f = vals["file"]
    if _lit(vals, "file", u).lower().endswith(".csv"):
        return f"cut -d, -f{n} -- {f}"
    if _lit(vals, "file", u).lower().endswith(".tsv"):
        return f"cut -f{n} -- {f}"
    return f"awk '{{print ${n}}}' {f}"


def _sort_column(vals, u):
    n, f, name = ord_num(_lit(vals, "n", u)), vals["file"], _lit(vals, "file", u).lower()
    rev = "r" if vals.get("_raw_rev") else ""
    num_ = "n" if re.search(r"\b(?:numeric|numerically|number)\b", u.low) else ""
    if name.endswith(".csv"):
        return f"(head -n 1 {f}; tail -n +2 {f} | sort -t, -k{n},{n}{num_}{rev})"
    return f"sort -k{n},{n}{num_}{rev} -- {f}"


def _check_file(vals, u):
    name, f = _lit(vals, "file", u).lower(), vals["file"]
    if name.endswith(".json"):
        return f"python3 -m json.tool {f} > /dev/null && echo 'valid JSON'"
    if name.endswith(".zip"):
        return f"python3 -m zipfile -t {f}"
    if re.search(r"\.(?:tar(?:\.\w+)?|tgz|tbz2|txz)$", name):
        return f"tar -tf {f} > /dev/null && echo 'archive is OK'"
    if name.endswith((".gz", ".bz2", ".xz")):
        return f"{ {'gz': 'gzip', 'bz2': 'bzip2', 'xz': 'xz'}[name.rsplit('.', 1)[1]] } -t {f} && echo 'archive is OK'"
    if name.endswith((".yaml", ".yml")):
        return None
    if name.endswith(".sh"):
        return f"bash -n {f} && echo 'syntax OK'"
    if name.endswith(".py"):
        return f"python3 -m py_compile {f} && echo 'syntax OK'"
    return None


def _case(vals, u):
    lower = "lower" in vals.get("_raw_case", "").lower()
    a, b = ("[:upper:]", "[:lower:]") if lower else ("[:lower:]", "[:upper:]")
    return f"tr '{a}' '{b}' < {vals['file']}"


def _tabs(vals, u):
    n = int(vals.get("n") or 4)
    if "spaces" in vals.get("_raw_from", "").lower():
        return f"sed -i 's/ \\{{{n}\\}}/\\t/g' -- {vals['file']}"
    return f"sed -i 's/\\t/{' ' * n}/g' -- {vals['file']}"


def _delete_line(vals, u):
    which = _lit(vals, "n", u).lower()
    which = "1" if which in ("header", "heading", "title") else which
    f = vals["file"]
    if vals.get("_raw_m"):
        return f"sed -i '{int(num(which))},{int(num(_lit(vals, 'm', u)))}d' -- {f}"
    addr = "$" if which == "last" else str(ord_num(which))
    return f"sed -i '{addr}d' -- {f}"


def _lines_each(vals, u):
    test = _ext_glob(_lit(vals, "type", u))
    return f"find . {NOT_GIT} -type f {test} -exec wc -l {{}} +" if test else None


def _zip_type(vals, u):
    word = _lit(vals, "type", u).lower()
    test = _ext_glob(word)
    t = type_word(word.rstrip("s")) or type_word(word)
    if not test or not t:
        return None
    name = re.sub(r"s$", "", word) + "s.zip"
    return f"find . {NOT_GIT} -type f {test} -print | zip -@ {name}"


def _except_delete(vals, u):
    if re.match(r"(?:the\s+)?(?:\d+\s+)?(?:newest|latest|oldest|most\s+recent|biggest|largest|smallest)\b", vals["_raw_keep"].strip()):
        return None
    keep = [k for k in re.split(r"\s*(?:,|\band\b|\bor\b)\s*", vals["_raw_keep"].strip()) if k]
    tests = []
    for k in keep:
        k = re.sub(r"^(?:the|my)\s+", "", re.sub(r"\s+(?:files?|folders?|ones)$", "", k.strip()))
        name = u.lit(k)
        if not name or name in ("the", "file", "files", "folder"):
            continue
        if os.path.lexists(os.path.join(u.cwd, name)):
            tests.append(f"! -name {shlex.quote(os.path.basename(name.rstrip('/')))}")
        elif _ext_glob(k) and (type_word(k.lower()) or re.fullmatch(r"\*?\.\w+", k)):
            tests.append("! " + _ext_glob(k).replace("-iname", "-iname", 1))
        else:
            return None                  # keep something that is not here? then nothing is safe to delete
    if not tests:
        return None
    files_only = bool(re.search(r"\b(?:all|every)\s+(?:the\s+)?files\b", u.low))
    tests = " ".join(tests)
    kind = " -type f" if files_only else ""
    return f"find . -mindepth 1 -maxdepth 1{kind} ! -name .git {tests} -exec rm -r -- {{}} +"


def _except_delete_preview(vals, u):
    cmd = _except_delete(vals, u)
    return cmd and cmd.replace(" -exec rm -r -- {} +", " -print")


def _nth(vals, u):
    n = ord_num(_lit(vals, "n", u))
    which = vals["_raw_which"].lower()
    which = "newest" if which.startswith("most recent") else which
    key, order = ("%s", "-nr") if which in ("biggest", "largest") else (
        ("%s", "-n") if which == "smallest" else ("%T@", "-n" if which == "oldest" else "-nr"))
    return f"find . {NOT_GIT} -type f -printf '{key}\\t%p\\n' | sort {order} | sed -n {n}p | cut -f2-"


PARTS_OF_DAY = {"morning": ("06:00", "12:00"), "afternoon": ("12:00", "18:00"), "evening": ("18:00", "23:59:59"),
                "night": ("00:00", "06:00"), "lunch": ("11:00", "14:00")}


def _part_of_day(vals, u):
    day = vals["_raw_day"].lower()
    a, b = PARTS_OF_DAY[vals["_raw_part"].lower()]
    return (f"d=$(date -d {day} +%F); find . {NOT_GIT} -type f -newermt \"$d {a}\" ! -newermt \"$d {b}\" -print")


def _keep_newest(vals, u):
    n = int(vals["n"])
    which = vals["_raw_which"].lower()
    order = "-n" if which == "oldest" else "-nr"
    return (f"find . -maxdepth 1 -mindepth 1 -type f -printf '%T@\\t%p\\n' | sort {order} | tail -n +{n + 1} | "
            f"cut -f2- | xargs -r -d '\\n' rm -v --")


def _keep_newest_preview(vals, u):
    return _keep_newest(vals, u).replace(" | xargs -r -d '\\n' rm -v --", "")


def one_log_file(cwd: str) -> str | None:
    hits = []
    for root, dirs, files in os.walk(cwd):
        dirs[:] = [d for d in dirs if d != ".git"]
        hits += [os.path.relpath(os.path.join(root, f), cwd) for f in files if f.endswith(".log")]
        if len(hits) > 1:
            return None
    return hits[0] if hits else None


def _empty_file(vals, u):
    if vals.get("file"):
        return f": > {vals['file']}"
    log = one_log_file(u.cwd)
    return f": > {qpath(log)}" if log else None


def _move_contents(vals, u):
    dest = _lit(vals, "dest", u)
    dest = "." if dest.lower() in ("here", ".", "this folder", "this directory") else qpath(dest)
    op = "mv -i" if vals["_raw_op"].lower() == "move" else "cp -ri"
    mk = "" if dest == "." else f"mkdir -p -- {dest} && "
    return f"{mk}find {vals['dir']} -mindepth 1 -maxdepth 1 -exec {op} -t {dest} -- {{}} +"


def _perm_find(vals, u):
    act = (vals.get("_raw_act") or "read").lower()
    flag = {"read": "-readable", "open": "-readable", "write": "-writable", "edit": "-writable",
            "modify": "-writable", "change": "-writable", "execute": "-executable", "run": "-executable"}[act]
    return f"find . {NOT_GIT} ! {flag} -print"


def _not_exec(vals, u):
    test = _ext_glob(_lit(vals, "type", u)) if vals.get("_raw_type") else ""
    if vals.get("_raw_type") and not test:
        return None
    return f"find . {NOT_GIT} -type f {test + ' ' if test else ''}! -executable -print"


def _year(vals, u):
    y, rel = int(vals["_raw_year"]), vals["_raw_rel"].lower()
    rel = {"older": "before", "newer": "after"}.get(rel, rel)
    if rel == "before":
        return f"find . {NOT_GIT} -type f ! -newermt {y}-01-01 -print"
    if rel == "after":
        return f"find . {NOT_GIT} -type f -newermt {y + 1}-01-01 -print"
    if rel == "since":
        return f"find . {NOT_GIT} -type f -newermt {y}-01-01 -print"
    return f"find . {NOT_GIT} -type f -newermt {y}-01-01 ! -newermt {y + 1}-01-01 -print"


def _chmod_perm(vals, u):
    p = vals["_raw_perm"].lower()
    bit = {"read": "r", "write": "w", "execute": "x", "executable": "x", "exec": "x", "run": "x"}[p]
    who = "a" if bit != "x" else ""
    return f"chmod {who}-{bit} -- {vals['path']}"


def _trash(vals, u):
    t = trash_tool()
    return (f"mkdir -p ~/.local/share/Trash/files && {t} {vals['path']}" if t.startswith("mv ")
            else f"{t} {vals['path']}")


def _extract_one(vals, u):
    arc, member = vals["file"], vals["member"]
    if _lit(vals, "file", u).lower().endswith(".zip"):
        return f"unzip -n {arc} {member}"
    return f"tar --keep-old-files -xf {arc} {member}"


def _extract_delete(vals, u):
    arc = vals["file"]
    if _lit(vals, "file", u).lower().endswith(".zip"):
        return f"unzip -n {arc} && rm -i -- {arc}"
    return f"tar --keep-old-files -xf {arc} && rm -i -- {arc}"


def _add_to_archive(vals, u):
    arc, name = vals["arc"], _lit(vals, "arc", u).lower()
    if name.endswith(".zip"):
        return f"zip -j {arc} {vals['path']}"
    if name.endswith(".tar"):
        return f"tar -rf {arc} {vals['path']}"
    return None


def _replace_in_type(vals, u):
    test = _ext_glob(_lit(vals, "type", u))
    if not test:
        return None
    a = re.sub(r"([/&\\.*^$\[\]])", r"\\\1", _lit(vals, "a", u))
    b = re.sub(r"([/&\\])", r"\\\1", _lit(vals, "b", u))
    return (f"find . {NOT_GIT} -type f {test} -exec grep -qF -- {shlex.quote(_lit(vals, 'a', u))} {{}} \\; "
            f"-exec sed -i {shlex.quote('s/' + a + '/' + b + '/g')} -- {{}} +")


def _proc_names(word: str) -> str:
    w = word.lower()
    alias = {"firefox": "firefox,firefox-esr", "chrome": "chrome,chromium", "chromium": "chromium,chrome",
             "code": "code", "vscode": "code"}.get(w, word)
    return shlex.quote(alias)


def _ram_total(vals, u):
    return (f"ps -C {_proc_names(_lit(vals, 'word', u))} -o rss= | "
            "awk '{s+=$1} END {printf \"%.0f MiB\\n\", s/1024}'")


def _kill_except(vals, u):
    name, keep = _lit(vals, "word", u), _lit(vals, "keep", u)
    if name.lower() in ("all", "everything", "processes", "the"):
        return None
    q, k = shlex.quote(name), shlex.quote(keep)
    if keep.isdigit():
        return f"pgrep -- {q} | grep -vxF {keep} | xargs -r kill"
    return f"pgrep -a -- {q} | grep -v -- {k} | cut -d' ' -f1 | xargs -r kill"


def _kill_top(vals, u):
    res = "%mem" if vals["_raw_res"].lower() in ("memory", "ram") else "%cpu"
    return (f"pid=$(ps -eo pid --sort=-{res} --no-headers | head -n 1 | tr -d ' '); "
            f"ps -o pid,comm,{res} -p \"$pid\"; kill \"$pid\"")


def _pause(vals, u):
    word = _lit(vals, "word", u)
    if re.fullmatch(COMPUTER_WORDS + r"|downloads?|music|it|everything", word.lower()):
        return None
    sig = "STOP" if vals["_raw_verb"].lower() in ("pause", "freeze") else "CONT"
    return f"pkill -{sig} -- {shlex.quote(word)}"


def _uptime_of(vals, u):
    word = _lit(vals, "word", u)
    if re.fullmatch(COMPUTER_WORDS, word.lower()):
        return None
    unit = service_name(word)
    if unit and unit_exists(unit) or unit and not process_running(word):
        return f"systemctl show {shlex.quote(unit)} -p ActiveEnterTimestamp --value"
    return f"ps -C {_proc_names(word)} -o pid,etime,cmd"


def _threads(vals, u):
    return f"ps -o pid,nlwp,cmd -C {_proc_names(_lit(vals, 'word', u))}"


def _since(vals, u):
    when = vals["_raw_when"].strip().lower()
    when = re.sub(r"^the\s+", "", when)
    m = re.fullmatch(r"(?:the\s+)?(?:last|past)\s+(?:(\d+|an?|one)\s+)?(minute|min|hour|day|week)s?", when) or \
        re.fullmatch(r"(\d+|an?|one)\s+(minute|min|hour|day|week)s?\s+ago", when)
    if m:
        n = 1 if m.group(1) in (None, "a", "an", "one") else int(m.group(1))
        unit = {"minute": "min", "min": "min", "hour": "h", "day": "d", "week": "w"}[m.group(2)]
        return f"journalctl --since '-{n}{unit}' --no-pager"
    if when in ("boot", "last boot", "the last boot", "startup", "reboot", "the reboot"):
        return "journalctl -b --no-pager"

    def clock(t):
        mm = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\.?|(\d{1,2}):(\d{2})", t)
        if not mm:
            return None
        if mm.group(4):
            return f"{int(mm.group(4)):02d}:{mm.group(5)}"
        h = int(mm.group(1)) % 12 + (12 if mm.group(3) == "p" else 0)
        return f"{h:02d}:{mm.group(2) or '00'}"
    m = re.fullmatch(r"(today|yesterday)(?:\s+(?:at\s+)?(.+))?|(?:at\s+)?(.+?)(?:\s+(today|yesterday))?", when)
    day = m.group(1) or m.group(4) or "today"
    t = m.group(2) or m.group(3)
    if t:
        c = clock(t)
        if not c:
            return None
        return f"journalctl --since '{day} {c}' --no-pager"
    return f"journalctl --since {day} --no-pager"


def _date_of(vals, u):
    when = re.sub(r"^in\s+", "", vals["_raw_when"].strip().lower())
    when = re.sub(r"\bfrom\s+now\b", "", when).strip()
    return f"date -d {shlex.quote(when)} '+%A %d %B %Y'"


def _ms_date(vals, u):
    ts = int(vals["_raw_ts"])
    return f"date -d @{ts // 1000}" if ts > 10 ** 11 else f"date -d @{ts}"


def _install_many(vals, u):
    names = [n for n in re.split(r"\s*,\s*|\s+and\s+|\s+", re.sub(r"^both\s+", "", vals["_raw_pkgs"].strip())) if n]
    if len(names) < 2 or any(n.lower() in FILLER or os.path.exists(os.path.join(u.cwd, n)) for n in names):
        return None
    return install_cmd([shlex.quote(n) for n in names])


def _purge(vals, u):
    pm, name = pkg_manager(), _lit(vals, "word", u)
    if name.lower() in FILLER or os.path.exists(os.path.join(u.cwd, name)):
        return None
    q = shlex.quote(name)
    if pm != "apt":
        return install_cmd([q], remove=True)
    return f"{sudo()}apt purge {q} && {sudo()}apt autoremove"


INTERPRETERS = {".sh": "bash", ".bash": "bash", ".py": "python3", ".js": "node", ".pl": "perl", ".rb": "ruby",
                ".php": "php", ".lua": "lua"}


def _run_args(vals, u) -> str:
    return "".join(" " + shlex.quote(u.lit(a)) for a in (vals.get("_raw_args") or "").split())


def _run_file(vals, u):
    """'run install.sh' -> ./install.sh (or bash install.sh when it is not executable)."""
    path = _lit(vals, "path", u)
    full = os.path.join(u.cwd, os.path.expanduser(path))
    if not os.path.isfile(full):
        return None
    shown = path if path.startswith(("/", "./", "../", "~")) else "./" + path
    ext = os.path.splitext(path)[1].lower()
    if os.access(full, os.X_OK):
        cmd = shlex.quote(shown) if shown != shown.replace(" ", "") else shown
    elif ext in INTERPRETERS:
        cmd = f"{INTERPRETERS[ext]} {qpath(path)}"
    else:
        try:
            with open(full, "rb") as f:
                first = f.readline(200)
        except OSError:
            return None
        m = re.match(rb"#!\s*(\S+)(?:\s+(\S+))?", first)
        if not m:
            return None                  # not a program: "run notes.txt" means nothing
        prog = (m.group(2) if m.group(1).endswith(b"/env") and m.group(2) else m.group(1)).decode(errors="replace")
        cmd = f"{os.path.basename(prog)} {qpath(path)}"
    root = "sudo " if vals.get("_raw_root") else ""
    return root + cmd + _run_args(vals, u)


def _run_program(vals, u):
    """'run htop', 'launch firefox': a program on PATH (a file here is run by 'run file')."""
    name = _lit(vals, "word", u)
    if os.path.exists(os.path.join(u.cwd, name)) or not shutil.which(name) or name in ("the", "it", "this"):
        return None
    verb = vals["_raw_verb"].lower()
    root = "sudo " if vals.get("_raw_root") else ""
    if verb in ("launch", "open", "start") and GUI and not root:
        return f"nohup {shlex.quote(name)}{_run_args(vals, u)} >/dev/null 2>&1 &"
