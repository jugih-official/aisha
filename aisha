def _config_dir() -> str:
    """~/.config/aisha; settings from before the rename (~/.config/ai-bash/aisha) move there once."""
    if os.environ.get("AISHA_HOME"):
        return os.path.expanduser(os.environ["AISHA_HOME"])
    base = os.path.expanduser(os.environ.get("XDG_CONFIG_HOME") or "~/.config")
    new, old = os.path.join(base, "aisha"), os.path.join(base, "ai-bash", "aisha")
    if os.path.isdir(old) and not os.path.exists(new):
        try:
            os.rename(old, new)
        except OSError:
            return old
    return new


