# "don't delete them", "without removing", "do not move anything": an action
# the user rules out is removed before any rule sees it. (Not "modified"/
# "changed": "not modified in 30 days" is an age filter.)
NEGATION = re.compile(
    r"\b(?:do\s+not|dont|never|without|not|no\s+need\s+to)\s+(?:\w+\s+){0,2}?"
    r"(delet\w*|remov\w*|eras\w*|mov(?:e|es|ing)\b|renam\w*|kill\w*|overwrit\w*|trash\w*|wip(?:e|ing)|get(?:ting)?\s+rid\s+of)"
    r"(?:\s+(?:them|it|anything|any\s+(?:of\s+)?(?:them|files?)|the\s+files|those|these))?\b")


class Utterance:
    """The request, with a mask that slot extractors blank out as they go.

    `low` is a lowercased copy of `orig` with identical character offsets, so
    a match found in the mask can be read back with its original case
    (file names keep their capitals). Quoted strings become qlitN tokens.
    """

    def __init__(self, text: str, cwd: str, literals: list[str] | None = None, auto: set | None = None):
        self.raw = text
        self.cwd = cwd
        self.literals: list[str] = list(literals or [])
        self.auto: set[int] = set(auto or ())   # literals typed bare (a file name), not "quoted"
        text = (text.replace("’", "'").replace("‘", "'")
                    .replace("“", '"').replace("”", '"'))

        def quoted(m):
            self.literals.append(m.group(1) if m.group(1) is not None else m.group(2))
            return f" qlit{len(self.literals) - 1} "

        text = re.sub(r'"([^"]*)"|(?<!\w)\'([^\']*)\'(?!\w)', quoted, text)
        for pat, rep in CONTRACTIONS:
            text = re.sub(pat, rep, text, flags=re.I)
        toks = [t.rstrip(",;!?") for t in text.split()]
        if toks and toks[-1].endswith(".") and toks[-1] not in (".", ".."):
            toks[-1] = toks[-1][:-1]
        # File names and paths become literals too, so word rules never read
        # inside them ("old.tmp" is a name, not the word "old").
        for i, t in enumerate(toks):
            if ((is_pathlike(t) and not re.fullmatch(r"\*?\.[A-Za-z0-9]{1,8}|qlit\d+", t, re.I))
                    or (t.startswith(".") and len(t) > 1 and os.path.lexists(os.path.join(cwd, t)))):
                self.literals.append(t)
                self.auto.add(len(self.literals) - 1)
                toks[i] = f"qlit{len(self.literals) - 1}"
        self.orig = " ".join(t for t in toks if t)
        self.low = "".join(c.lower() if len(c.lower()) == 1 else c for c in self.orig)
        self.text = self.low
        self.negated: set[str] = set()
        for m in NEGATION.finditer(self.low):
            self.negated.add(m.group(1))
            self.blank(m.start(), m.end())

    # -- masking
    def blank(self, start: int, end: int) -> None:
        self.text = self.text[:start] + " " * (end - start) + self.text[end:]

    def take(self, pattern: str):
        m = re.search(pattern, self.text)
        if m:
            self.blank(m.start(), m.end())
        return m

    def peek(self, pattern: str):
        return re.search(pattern, self.text)

    def o(self, m, g: int = 0) -> str:
        """Original-case text of a match group."""
        return self.orig[m.start(g):m.end(g)]

    def lit(self, tok: str) -> str:
        m = re.fullmatch(r"qlit(\d+)", tok.lower())
        return self.literals[int(m.group(1))] if m else tok

    def bare_name(self, tok: str) -> str | None:
        """The file name a bare (unquoted) token like notes.txt stands for, else None."""
        m = re.fullmatch(r"qlit(\d+)", tok.lower())
        if not m or int(m.group(1)) not in self.auto:
            return None
        lit = self.literals[int(m.group(1))]
        return lit if FILE_NAME.fullmatch(os.path.basename(lit.rstrip("/")) or "-") and "*" not in lit else None

    def remaining(self) -> list[tuple[str, str, int]]:
        """(low, orig, start) for each word still unmasked."""
        return [(m.group(0), self.orig[m.start():m.end()], m.start())
                for m in re.finditer(r"\S+", self.text)]

    def leftover(self) -> list[str]:
        return [w for w, _, _ in self.remaining() if w not in FILLER]


# ---- slots ---------------------------------------------------------------------

@dataclass
class FindSpec:
    root: str = "."
    rec: bool | None = None          # None = the intent's default
    ftype: str | None = None         # f d l
    exts: list = field(default_factory=list)
    names: list = field(default_factory=list)       # -iname globs
    hidden: bool = False
    empty: bool = False
    executable: bool = False
    size: list = field(default_factory=list)        # find args
    time: list = field(default_factory=list)
    daystart: bool = False
    content: list = field(default_factory=list)     # (mode, needle, shown)
    sort: tuple | None = None                       # (key, descending)
    limit: int | None = None
    why: list = field(default_factory=list)
    unparsed: list = field(default_factory=list)    # words seen but not understood
    exclude: list = field(default_factory=list)     # -not -path patterns
    owner: str | None = None
    broken: bool = False
    not_exts: list = field(default_factory=list)
    not_names: list = field(default_factory=list)
    not_empty: bool = False
    not_hidden: bool = False
    no_ext: bool = False
    case: bool = False               # names and text matched case-sensitively
    or_content: bool = False         # "pressure or temperature": any keyword, not all
    glob_here: bool = False          # a typed *.log made the search top-level only

    def narrowed(self) -> bool:
        return bool(self.exts or self.names or self.hidden or self.empty or self.executable
                    or self.size or self.time or self.content or self.owner or self.broken
                    or self.not_exts or self.not_names or self.not_empty or self.not_hidden or self.no_ext)


MOD = (r"(?:(?:modif(?:ied|y)|chang(?:ed|e)|edit(?:ed)?|creat(?:ed|e)|updat(?:ed|e)|touch(?:ed)?|"
       r"sav(?:ed|e)|made|make|writ(?:ten|e)|work(?:ed)?\s+on|taken|downloaded|added)\s+)?")
THAN = r"(?:than|then|that)"   # "older that 2 months" is a typo people make


def to_bytes(n: float, unit: str) -> int:
    u = unit.lower()
    if u.startswith(("t",)):
        mult = 1024 ** 4
    elif u.startswith(("g",)):
        mult = 1024 ** 3
    elif u.startswith(("m",)):
        mult = 1024 ** 2
    elif u.startswith(("k",)):
        mult = 1024
    else:
        mult = 1
    return int(n * mult)


def size_arg(sign: str, n: float, unit: str) -> str:
    u = unit.lower()
    letter = {"k": "k", "m": "M", "g": "G"}.get(u[0])
    if sign == "+" and letter and float(n).is_integer() and not u.startswith("b"):
        return f"+{int(n)}{letter}"
    return f"{sign}{to_bytes(n, unit)}c"   # exact bytes; -1M would mean "empty"


def take_size(u: Utterance, spec: FindSpec) -> None:
    m = u.take(rf"\bbetween\s+{NUM}\s*{SUNIT}?\s+and\s+{NUM}\s*{SUNIT}\b")
    if m:
        lo, lo_unit, hi, hi_unit = num(m.group(1), 0), m.group(2) or m.group(4), num(m.group(3), 0), m.group(4)
        spec.size += ["-size", size_arg("+", lo, lo_unit), "-size", size_arg("-", hi, hi_unit)]
        spec.why.append(f"size {m.group(1)}{lo_unit}–{m.group(3)}{hi_unit}")
        return
    m = u.take(rf"\b(?:no|not)\s+(bigger|larger|greater|heavier|more|smaller|less|lighter)\s+{THAN}\s+{NUM}\s*{SUNIT}\b")
    if m:
        n, unit = num(m.group(2), 1), m.group(3)
        if m.group(1) in ("smaller", "less", "lighter"):     # at least n
            spec.size += ["-size", f"+{max(0, to_bytes(n, unit) - 1)}c"]
            spec.why.append(f"size ≥ {m.group(2)}{unit}")
        else:                                               # at most n
            spec.size += ["-size", f"-{to_bytes(n, unit) + 1}c"]
            spec.why.append(f"size ≤ {m.group(2)}{unit}")
        return
    big = (r"(?:bigger|larger|greater|heavier|more|over|above|exceeding|at\s+least|>=?)")
    small = r"(?:smaller|less|lighter|under|below|at\s+most|<=?)"
    for word, sign, label in ((big, "+", ">"), (small, "-", "<")):
        m = u.take(rf"(?:\b|(?=[<>])){word}\s*(?:{THAN}\s+)?{NUM}\s*{SUNIT}\b")
        if m:
            n = num(m.group(1), 1)
            spec.size += ["-size", size_arg(sign, n, m.group(2))]
            spec.why.append(f"size {label} {m.group(1)}{m.group(2)}")


def time_args(n, unit: str, sign: str) -> list[str]:
    n = n or 1
    unit = unit.lower()
    if unit.startswith("min"):
        return ["-mmin", f"{sign}{max(1, round(n))}"]
    if unit.startswith(("hour", "hr")):
        return ["-mmin", f"{sign}{max(1, round(n * 60))}"]
    days = n * {"d": 1, "w": 7, "m": 30, "y": 365}[unit[0]]
    if float(days).is_integer():
        return ["-mtime", f"{sign}{int(days)}"]
    return ["-mmin", f"{sign}{round(days * 1440)}"]   # 2.5 months is not 2 months


WEEKDAYS = r"(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)"
ISO_DATE = r"(?:19|20)\d\d-[01]?\d-[0-3]?\d"


def take_since(u: Utterance, spec: FindSpec) -> bool:
    """'modified since monday', 'changed after 2026-11-01', 'created before last week'."""
    m = u.take(rf"\b{MOD}(since|after|before|until|till|prior\s+to)\s+(?:the\s+)?"
               rf"(yesterday|today|this\s+morning|(?:last\s+)?{WEEKDAYS}|last\s+(?:week|month|year)|"
               rf"(?:a|one|\d+)\s+(?:days?|weeks?|months?|years?)\s+ago|{ISO_DATE})\b")
    if not m:
        return False
    rel, when = m.group(1), re.sub(r"\s+", " ", m.group(2))
    date = {"yesterday": "yesterday 00:00", "today": "today 00:00", "this morning": "today 00:00",
            "last week": "1 week ago", "last month": "1 month ago", "last year": "1 year ago"}.get(when, when)
    if re.fullmatch(WEEKDAYS, when):
        date = f"last {when}"
    date = re.sub(r"^(?:a|one)\s", "1 ", date)
    newer = rel in ("since", "after")
    spec.time = (["-newermt"] if newer else ["!", "-newermt"]) + [shlex.quote(date)]
    spec.why.append(f"modified {'since' if newer else 'before'} {when}")
    return True


def take_time(u: Utterance, spec: FindSpec) -> None:
    if take_since(u, spec):
        return
    if u.take(rf"\b{MOD}today\b"):
        spec.daystart, spec.time = True, ["-mtime", "0"]
        spec.why.append("modified today")
        return
    if u.take(rf"\b{MOD}yesterday\b"):
        spec.daystart, spec.time = True, ["-mtime", "1"]
        spec.why.append("modified yesterday")
        return
    rules = [  # (pattern, sign); negated forms first so "not modified in the last week" is +7
        (rf"\b(?:not|never|have\s+not\s+been|has\s+not\s+been)\s+(?:been\s+)?(?:modified|changed|touched|used|accessed|opened|edited)\s+(?:in|for|during|since|within)\s+(?:the\s+)?(?:last|past)?\s*(?:{NUM}\s*)?{TUNIT}\b", "+"),
        (rf"\b(?:no|not)\s+(?:more|older)\s+{THAN}\s+{NUM}\s*{TUNIT}(?:\s+(?:old|ago))?\b", "-"),
        (rf"\b(?:no|not)\s+(?:newer|less|younger)\s+{THAN}\s+{NUM}\s*{TUNIT}(?:\s+(?:old|ago))?\b", "+"),
        (rf"\b{MOD}(?:(?:in|within|during|over|from)\s+)?(?:the\s+)?(?:last|past|previous)\s+(?:{NUM}\s*)?{TUNIT}\b", "-"),
        (rf"\b{MOD}(?:newer\s+{THAN}|less\s+{THAN}|under|within)\s+(?:{NUM}\s*)?{TUNIT}(?:\s+(?:old|ago))?\b", "-"),
        (rf"\b(?:not|never|have\s+not\s+been|has\s+not\s+been)\s+(?:been\s+)?(?:modified|changed|touched|used|accessed|opened|edited)\s+(?:in|for|during|since)\s+(?:the\s+)?(?:last|past)?\s*(?:{NUM}\s*)?{TUNIT}\b", "+"),
        (rf"\b{MOD}(?:older\s+{THAN}|more\s+{THAN}|over|at\s+least)\s+(?:{NUM}\s*)?{TUNIT}(?:\s+(?:old|ago))?\b", "+"),
        (rf"\b{NUM}\s*{TUNIT}\s+old\b", "+"),
    ]
    for pat, sign in rules:
        m = u.take(pat)
        if m:
            n, unit = num(m.group(1), 1), m.group(2)
            spec.time = time_args(n, unit, sign)
            what = "within the last" if sign == "-" else "older than"
            days = (f" ({spec.time[1].lstrip('+-')} days)" if spec.time[0] == "-mtime" and unit[0] in "wmy"
                    and not unit.startswith("min") else "")
            spec.why.append(f"modified {what} {m.group(1) or 1} {unit}{days}")
            return
    m = u.take(rf"\b{MOD}this\s+(week|month|year)\b")
    if m:
        spec.time = time_args(1, m.group(1), "-")
        spec.why.append(f"modified this {m.group(1)}")
        return
    if u.take(r"\bold\b"):
        spec.time = ["-mtime", "+30"]
        spec.why.append("old = not modified in 30+ days")


SORT_WORD = {
    "largest": ("size", True), "biggest": ("size", True), "heaviest": ("size", True),
    "huge": ("size", True), "big": ("size", True), "large": ("size", True),
    "hugest": ("size", True), "smallest": ("size", False), "tiniest": ("size", False), "tiny": ("size", False), "small": ("size", False),
    "newest": ("time", True), "latest": ("time", True), "recent": ("time", True),
    "oldest": ("time", False),
}
SORT_LABEL = {("size", True): "largest first", ("size", False): "smallest first",
              ("time", True): "newest first", ("time", False): "oldest first",
              ("name", False): "by name", ("name", True): "by name, reversed"}
RECENT = r"(?:most\s+)?recent(?:ly)?(?:\s+(?:modified|changed|edited|updated|created))?|(?:modified|changed|edited|updated)\s+recently"


def take_sort_limit(u: Utterance, spec: FindSpec) -> None:
    m = u.take(rf"\b(?:the\s+)?(?:top|first)\s+{NUM}\b(?!\s*(?:lines?|bytes?))")
    if m:
        spec.limit = int(num(m.group(1), 10))
    words = r"largest|biggest|heaviest|smallest|tiniest|newest|latest|oldest"
    m = u.take(rf"\b{NUM}\s+({words}|{RECENT})\b")
    m2 = None if m else u.take(rf"\b({words})\s+(\d+)\b")       # "the biggest 3 files"
    if m:
        spec.limit = int(num(m.group(1), 10))
        word = m.group(2)
    elif m2:
        spec.limit = int(m2.group(2))
        word = m2.group(1)
    else:
        m = u.take(rf"\b({words}|huge|big|large|tiny|small|{RECENT})\b")
        word = m.group(1) if m else None
    if word:
        key = "recent" if "recent" in word else word.split()[0]
        spec.sort = SORT_WORD.get(key, ("time", True))
    key_words = r"size|date|time|name|age|modification\s+(?:date|time)|(?:last\s+)?modified|modification"
    m = u.take(rf"\b(?:(?:sorted|sort(?:ed)?|ordered|order|arranged)?\s*by|(?:in\s+)?(?:the\s+)?order\s+of)\s+"
               rf"(?:their\s+|the\s+)?({key_words})"
               r"(?:\s+(desc(?:ending)?|asc(?:ending)?|reversed?|in\s+reverse))?\b")
    m = m or u.take(rf"\b(?:in\s+)?(?:the\s+|their\s+)?({key_words})\s+order"
                    r"(?:\s+(desc(?:ending)?|asc(?:ending)?|reversed?|in\s+reverse))?\b")
    if m:
        key = {"size": "size", "name": "name"}.get(m.group(1), "time")
        desc = key != "name"
        if m.group(2):
            desc = m.group(2).startswith("desc") or (key == "name" and "rev" in m.group(2))
            if key != "name" and ("asc" in m.group(2) or "rev" in m.group(2)):
                desc = False
        spec.sort = (key, desc)
    if u.take(r"\balphabetical(?:ly)?\b"):
        spec.sort = ("name", False)
    if spec.sort and not spec.limit and re.search(
            r"\b(?:the\s+)?(?:largest|biggest|heaviest|smallest|newest|latest|oldest|most\s+recent)\s+"
            r"(?:[\w.]+\s+){0,2}?(?:file|folder|directory|one|image|photo|picture|pdf|video|document|log|script|archive|zip|"
            r"song|mp3|csv|backup|download|spreadsheet|movie|text\s+file)\b(?!s)(?!\s+(?:files|folders|ones|entries))", u.low):
        spec.limit = 1
    if spec.sort:
        spec.why.append("sorted " + SORT_LABEL[spec.sort])
    if spec.limit:
        spec.why.append(f"top {spec.limit}")


LOC_PREP = r"(?:in|on|inside|within|under|from|at|across|throughout)"


def take_location(u: Utterance, spec: FindSpec) -> None:
    for m in re.finditer(r"\b(?:not\s+in|outside(?:\s+of)?|except\s+in)\s+(?:the\s+)?(\S+?)(?:\s+(?:folder|directory|dir))?\b",
                         u.text):
        d = resolve(u.lit(u.o(m, 1)), u.cwd, "dir")
        if d:
            u.blank(m.start(), m.end())
            spec.exclude.append(f"./{d.strip('./')}/*")
            spec.why.append(f"not in {d}")
            break
    _take_location(u, spec)
    if spec.root not in ("/", "") and spec.root.endswith("/"):
        spec.root = spec.root.rstrip("/") or "/"


def _take_location(u: Utterance, spec: FindSpec) -> None:
    if u.take(r"\b(?:recursively|recursive|(?:and|including|incl|with|in|plus)\s+(?:all\s+)?(?:the\s+|its\s+)?"
              r"(?:sub-?folders|sub-?directories|subdirs)|in\s+any\s+sub-?folder|all\s+the\s+way\s+down)\b"):
        spec.rec = True
    m = u.take(r"\b(?:non-?recursively|(?:only|just)\s+(?:in\s+)?(?:the\s+)?(?:top[- ]level|this\s+folder|"
               r"this\s+directory|here)|top[- ]level(?:\s+only)?|not\s+(?:in\s+)?sub-?folders|"
               r"without\s+sub-?folders|(?:this\s+folder|this\s+directory|here)\s+only)\b")
    if m:
        spec.rec = False
    if u.take(rf"\b(?:{LOC_PREP}\s+)?(?:this|the|my|current)\s+(?:project|repo|repository|codebase|source\s+tree)\b"):
        spec.root, spec.rec = ".", True if spec.rec is None else spec.rec
        return
    fixed = [
        (rf"\b{LOC_PREP}\s+(?:this|the\s+current|current|the\s+present|the\s+same)\s+(?:folder|directory|dir|location|place|path)\b", "."),
        (r"\b(?:this|current)\s+(?:folder|directory|dir)\b", "."),
        (r"\b(?:right\s+)?here\b", "."),
        (rf"\b(?:{LOC_PREP}\s+)?(?:my|the)\s+home(?:\s+(?:folder|directory|dir))?\b|\bhome\s+(?:folder|directory|dir)\b", "~"),
        (rf"\b(?:{LOC_PREP}\s+)?(?:the\s+)?(?:whole|entire)\s+(?:system|computer|disk|drive|machine|file\s*system)\b|\beverywhere\b|\bsystem[- ]wide\b", "/"),
        (rf"\b(?:{LOC_PREP}\s+)?(?:the\s+)?parent\s+(?:folder|directory|dir)\b|\bone\s+(?:level|folder|directory)\s+up\b", ".."),
        (r"\b(?:on|in|across|throughout)\s+(?:my|this|the)\s+(?:computer|machine|system|pc|laptop|disks?|drives?)\b", "/"),
    ]
    m = u.take(r"\b(?:(?:in|from|under|inside|within)\s+)?my\s+(downloads?|documents|desktop|pictures|music|videos)"
               r"(?:\s+(?:folder|directory|dir))?\b")
    if m:
        spec.root = "~/" + XDG_DIRS[m.group(1)]
        return
    for pat, root in fixed:
        if u.take(pat):
            spec.root = root
            return
    # "in Downloads", "under the src folder", "in ~/data", "in ~home", "in $PROJECT"
    pat = (rf"\b{LOC_PREP}\s+(?:the\s+|my\s+)?(?:(?:folder|directory|dir)\s+(?:called\s+|named\s+)?)?"
           r"(\S+)(?:\s+(?:folder|directory|dir)\b)?")
    for m in re.finditer(pat, u.text):
        tok = u.lit(u.o(m, 1))
        path = home_alias(tok, u.cwd) or resolve(tok, u.cwd, "dir")
        if path:
            u.blank(m.start(), m.end())
            spec.root = path
            return
        named_folder = bool(re.search(r"\b(?:folder|directory|dir)\b", m.group(0)))
        if named_folder or looks_like_place(tok, m.group(1)):
            # A folder that isn't there: keep it as the place, so the command says
            # "No such file or directory" instead of quietly searching for the word.
            u.blank(m.start(), m.end())
            spec.root = tok
            expanded = os.path.expanduser(os.path.expandvars(tok))
            if "$" not in expanded and not os.path.isdir(os.path.join(u.cwd, expanded)):
                near = close_folders(tok, u.cwd)
                spec.why.append(f"no folder {tok} here" + (f"; nearest: {' or '.join(near)}" if near else ""))
            return
    # a bare path: "find big files ~/videos"
    for low, orig, start in u.remaining():
        tok = u.lit(orig)
        if ("/" in tok or tok.startswith("~") or low.startswith("qlit")) and resolve(tok, u.cwd, "dir"):
            u.blank(start, start + len(orig))
            spec.root = tok
            return


def home_alias(tok: str, cwd: str) -> str | None:
    """'~home', '$HOME', 'home', 'homedir' -> '~' (unless a user or a folder here has that name)."""
    low = tok.lower().rstrip("/")
    if low in ("$home", "${home}", "homedir", "home-dir", "~/"):
        return "~"
    if low == "~home":
        try:
            import pwd
            pwd.getpwnam("home")
            return None              # there really is a user called home
        except (KeyError, ImportError):
            return "~"
    if low == "home" and not os.path.isdir(os.path.join(cwd, tok)):
        return "~"
    return None


# Words after "in" that are not folders ("in them", "in python files", "in total").
NOT_PLACES = {"them", "it", "its", "their", "there", "total", "order", "detail", "details", "general",
              "particular", "size", "use", "case", "full", "short", "summary", "bytes", "words", "lines",
              "name", "names", "filename", "filenames", "content", "contents", "text", "file"}


def looks_like_place(tok: str, low: str) -> bool:
    if os.path.isfile(tok):
        return False
    if re.search(r"[/~$]", tok) or low.startswith("qlit"):
        return True
    return bool(re.fullmatch(r"[\w.-]+", low)) and not (
        low in FILLER or low in GENERIC or low in NOT_PLACES or low in TIMEISH or low in NEG_WORDS
        or type_word(low) or low.isdigit())


def close_folders(name: str, cwd: str) -> list[str]:
    import difflib
    try:
        here = [e for e in os.listdir(cwd) if os.path.isdir(os.path.join(cwd, e))]
    except OSError:
        here = []
    home = os.path.expanduser("~")
    try:
        homes = ["~/" + e for e in os.listdir(home) if os.path.isdir(os.path.join(home, e)) and not e.startswith(".")]
    except OSError:
        homes = []
    base = os.path.basename(name.rstrip("/")) or name
    pool = {c: os.path.basename(c) for c in here + homes}
    hits = difflib.get_close_matches(base.lower(), [v.lower() for v in pool.values()], n=2, cutoff=0.75)
    return [c for c, v in pool.items() if v.lower() in hits][:2]


def add_exts(spec: FindSpec, exts, label: str | None = None) -> None:
    for e in exts:
        if e not in spec.exts:
            spec.exts.append(e)
    shown = label or " ".join("." + e for e in exts)
    spec.why.append(f"type: {shown}")


ITEM = r"(?:\*?\.[a-z0-9]{1,8}|[a-z][\w+-]*)"


def take_exclude(u: Utterance, spec: FindSpec) -> None:
    """'except python files', 'excluding .log', 'other than pdfs', 'not empty'."""
    if u.take(r"\b(?:not\s+empty|non-?empty)\b"):
        spec.not_empty = True
        spec.why.append("not empty")
    pat = (rf"\b(?:except(?:\s+for)?|excluding|exclude|but(?:\s+not)?|other\s+than|apart\s+from|besides|not)\s+"
           rf"(?:the\s+|any\s+|all\s+)?({ITEM}(?:\s*(?:,|and|or|nor)\s*{ITEM})*)(?:\s+(?:files?|ones))?\b")
    for m in re.finditer(pat, u.text):
        items = [i for i in re.split(r"\s*(?:,|\band\b|\bor\b|\bnor\b)\s*", m.group(1)) if i]
        exts, names = [], []
        for item in items:
            if re.fullmatch(r"qlit\d+", item):
                names.append(u.lit(item))       # a real name: "except backup.zip"
            elif item.startswith((".", "*.")):
                exts.append(item.lstrip("*."))
            elif type_word(item):
                exts += type_word(item)[1]
            elif not m.group(0).startswith("not") and item not in FILLER and item not in GENERIC:
                names.append(f"*{item}*")
            else:
                exts, names = [], []
                break
        if not exts and not names:
            continue
        u.blank(m.start(), m.end())
        spec.not_exts += [e for e in exts if e not in spec.not_exts]
        spec.not_names += names
        spec.why.append("except " + " ".join(["." + e for e in exts[:6]] + names))
        return


def take_ext(u: Utterance, spec: FindSpec) -> None:
    if u.take(r"\b(?:without\s+(?:an?\s+|any\s+)?(?:file\s+)?extensions?|with\s+no\s+(?:file\s+)?extensions?|"
              r"(?:that\s+have\s+|having\s+)?no\s+(?:file\s+)?extensions?|extensionless)\b"):
        spec.no_ext = True
        spec.why.append("no extension")
    for m in list(re.finditer(r"(?:\b(?:that\s+|which\s+)?(?:end|ends|ending)\s+(?:with|in)\s+)?"
                              r"(?<![\w/~.])(\*?)\.([a-z0-9]{1,8})\b(?![/\w.])", u.text)):
        u.blank(m.start(), m.end())
        add_exts(spec, [m.group(2)])
        if m.group(1) and spec.rec is None:
            spec.rec, spec.glob_here = False, True   # a typed *.log means this folder, as in bash
    for pat in (r"\b(?:with\s+|having\s+)?(?:the\s+|an?\s+)?(?:extension|suffix)\s+\.?([a-z0-9]{1,8})\b",
                r"\b\.?([a-z0-9]{1,8})\s+(?:extension|suffix)\b"):
        m = re.search(pat, u.text)
        if m and m.group(1) not in FILLER and m.group(1) not in NEG_WORDS:
            u.blank(m.start(), m.end())
            add_exts(spec, [m.group(1)])
            break


def take_name(u: Utterance, spec: FindSpec) -> None:
    if u.take(r"\bwith\s+(?:a\s+)?(?:spaces?|blanks?)\s+in\s+(?:the|their|its)\s+(?:file\s*)?names?\b"):
        spec.names.append("* *")
        spec.why.append("name has a space")
    rules = [
        (r"\bwhose\s+(?:file)?names?\s+(?:(contains?|includes?|has|have|is|are|matches|match)|(starts?\s+with|begins?\s+with)|(ends?\s+with))\s+(\S+)", None),
        (r"\bwith\s+(?:a\s+)?(?:file)?names?\s+(?:(containing|including|like|matching|that\s+contains?)|(starting\s+with|beginning\s+with)|(ending\s+with))\s+(\S+)", None),
        (r"\b(?:file)?names?\s+(?:(like|matching|containing)|(starting\s+with|beginning\s+with|that\s+starts?\s+with)|(ending\s+with|that\s+ends?\s+with))\s+(\S+)", None),
        (r"\b(?:that\s+are\s+|which\s+are\s+)?(?:named|called|titled)\s+(\S+)", "named"),
        (r"\b(?:(?:that|which)\s+)?(?:starting|beginning|starts?|begins?)\s+with\s+(\S+)", "start"),
        (r"\b(?:(?:that|which)\s+)?(?:ending|ends?)\s+(?:in|with)\s+(\S+)", "end"),
        (r"\bwith\s+(\S+)\s+in\s+(?:the|their|its)\s+(?:file)?names?\b", "contains"),
    ]
    for pat, kind in rules:
        m = re.search(pat, u.text)
        if not m:
            continue
        g = m.lastindex  # the name token is always the last group
        tok = u.lit(u.o(m, g))
        if kind is None:
            kind = "contains" if m.group(1) else ("start" if m.group(2) else "end")
        u.blank(m.start(), m.end())
        if kind == "end" and re.fullmatch(r"\.?[A-Za-z0-9]{1,8}", tok) and (tok.startswith(".") or type_word(tok.lower())):
            add_exts(spec, [tok.lstrip(".").lower()])
            continue
        if re.search(r"[*?\[]", tok):
            glob = tok
        elif kind == "start":
            glob = tok + "*"
        elif kind == "end":
            glob = "*" + tok
        elif kind == "named" and "." in tok:
            glob = tok
        else:
            glob = f"*{tok}*"
        spec.names.append(glob)
        spec.why.append(f"name ~ {glob}")


EXPLICIT = (r"\bwhose\s+(?:contents?|text)\s+(?:contains?|mentions?|includes?|has|have|says?)\b|"
            r"\b(?:(?:that|which)\s+)?(?:contains?|containing|mentions?|mentioning|"
            r"(?:includes?|including|with|matching)\s+the\s+(?:text|word|string|phrase))\b")
VAGUE_ANY = (r"\b(?:(?:that|which)\s+(?:has|have|had|holds?|stores?|keeps?)|having|holding|"
             r"with)\b")
VAGUE_TOPIC = r"\b(?:about|regarding|concerning|related\s+to|relating\s+to|on\s+the\s+topic\s+of)\b"


def add_keywords(u: Utterance, spec: FindSpec, words: list[str], mode: str) -> int:
    """Turn words into content/name needles. Returns how many were added."""
    added = 0
    for w in words:
        if w.startswith("qlit"):
            needle = u.lit(w)
            spec.content.append((mode, needle, f'"{needle}"', needle))
        else:
            s = stem(w)
            shown = f'"{s}"' + (f' (from "{w}")' if s != w else "")
            spec.content.append((mode, s, shown, w))
        added += 1
    return added


def take_content(u: Utterance, spec: FindSpec) -> None:
    for pat, mode in ((EXPLICIT, "content"), (VAGUE_TOPIC, "any"), (VAGUE_ANY, "any")):
        m = re.search(pat, u.text)
        if not m:
            continue
        tail = u.text[m.end():]
        name_only = re.search(r"\bin\s+(?:the|their|its)\s+(?:file\s*)?names?\b|\bin\s+(?:the\s+)?filenames?\b", tail)
        if name_only:
            mode = "name"
        u.blank(m.start(), len(u.text))
        tail = re.sub(r"\bin\s+(?:them|it|their\s+content|the\s+content|(?:the|their|its)\s+(?:file\s*)?names?|"
                      r"(?:the\s+)?filenames?)\b|\binside\b", " ", tail)
        words = [w for w in tail.split() if w not in FILLER]
        if not words:
            continue
        if mode == "any" and pat == VAGUE_ANY:
            types = [type_word(w) for w in words if w not in GENERIC or type_word(w)]
            if types and all(types):          # "with python code" -> a type
                exts = set(types[0][1])
                for t in types[1:]:
                    exts &= set(t[1])
                add_exts(spec, sorted(exts) if exts else types[0][1], types[0][0])
                return
        spec.unparsed += [w for w in words if w in TIMEISH or w in NEG_WORDS]
        words = [w for w in words if w not in TIMEISH and w not in NEG_WORDS]
        keys = [w for w in words if w not in GENERIC or w.startswith("qlit")]
        dropped = [w for w in words if w not in keys]
        if not keys:
            continue
        add_keywords(u, spec, keys, mode)
        if len(keys) > 1 and re.search(r"\bor\b", tail):
            spec.or_content = True
        label = {"content": "content", "any": "name or content", "name": "name"}[mode]
        shown = ", ".join(c[2] for c in spec.content[-len(keys):])
        note = f'; "{" ".join(dropped)}" is generic' if dropped else ""
        spec.why.append(f"{label} ~ {shown}{note}")
        return


def take_owner(u: Utterance, spec: FindSpec) -> None:
    m = u.take(r"\b(?:owned|created|made)\s+by\s+(\S+)|\b(?:that|which)\s+belongs?\s+to\s+(\S+)|"
               r"\bwhose\s+owner\s+is\s+(\S+)")
    if m:
        who = next(g for g in m.groups() if g)
        if who in ("me", "myself", "i"):
            import getpass
            who = getpass.getuser()
        spec.owner = u.lit(who)
        spec.why.append(f"owner {spec.owner}")


def take_types(u: Utterance, spec: FindSpec) -> None:
    found = []
    if u.take(r"\b(?:broken|dangling|dead)\s+(?:sym(?:bolic\s+)?)?links?\b"):
        spec.broken = True
        spec.why.append("broken symlinks")
    for pat, (label, exts) in TYPE_PHRASES:
        if u.take(pat):
            found.append((label, exts))
    for low, orig, start in u.remaining():
        t = type_word(low)
        if t and low not in ("files", "file"):
            u.blank(start, start + len(orig))
            found.append(t)
    if found:
        exts = set(found[0][1])
        for _, e in found[1:]:
            exts &= set(e)
        if not exts:  # "images and videos" -> union
            exts = {e for _, es in found for e in es}
            label = " and ".join(dict.fromkeys(l for l, _ in found))
        else:
            label = found[-1][0] if len(found) > 1 else found[0][0]
        add_exts(spec, sorted(exts, key=lambda e: [x for _, es in found for x in es].index(e)),
                 f"{label} ({' '.join('.' + e for e in sorted(exts)[:6])}{' …' if len(exts) > 6 else ''})")
    if u.take(r"\bempty\b"):
        spec.empty = True
        spec.why.append("empty")
    if u.take(r"\bnot\s+hidden\b|\bnon-?hidden\b|\bvisible\b"):
        spec.not_hidden = True
        spec.why.append("not hidden")
    elif u.take(r"\bhidden\b|\bdot\s*files\b"):
        spec.hidden = True
        spec.why.append("hidden")
    if u.take(r"\bexecutables?\b|\bexecutable\s+files?\b"):
        spec.executable, spec.ftype = True, "f"
        spec.why.append("executable")
    if u.take(r"\b(?:sub-?)?(?:folders?|director(?:y|ies)|dirs?)\b"):
        spec.ftype = "d"
        spec.why.append("folders")
    elif u.take(r"\bsym(?:bolic\s+)?links?\b|\blinks\b"):
        spec.ftype = "l"
        spec.why.append("symlinks")
    elif u.take(r"\bfiles?\b"):
        spec.ftype = spec.ftype or "f"


def parse_filters(u: Utterance, spec: FindSpec) -> None:
    # "apart from X" is an exclusion, not a starting folder (same length keeps offsets)
    u.text = re.sub(r"\bapart\s+from\b", lambda m: "except".ljust(len(m.group(0))), u.text)
    take_size(u, spec)
    take_time(u, spec)
    take_sort_limit(u, spec)
    take_location(u, spec)
    take_exclude(u, spec)
    take_ext(u, spec)
    take_owner(u, spec)
    take_name(u, spec)
    take_content(u, spec)
    take_types(u, spec)


# Verbs that ask for an action. In a find they mean "and then do X", never a
# search keyword; left unplaced they lower confidence instead.
ACTION_WORDS = set("""
delete remove erase trash move copy rename compress zip archive edit open show list count
kill run execute install send upload download print sort
""".split())


def absorb_keywords(u: Utterance, spec: FindSpec, mode: str, limit: int = 2) -> int:
    """Leftover nouns become name/content keywords ("find the budget pdf")."""
    words = [w for w in u.leftover() if w not in TIMEISH and w not in ACTION_WORDS
             and w not in NEG_WORDS and w not in OPTION_WORDS
             and not re.fullmatch(r"\d+", w)]   # a bare number is no search term
    texty = {"word", "words", "text", "string", "phrase", "term", "keyword"}
    if len([w for w in words if w not in texty]) >= 1 and any(w in texty for w in words):
        for low, orig, start in u.remaining():            # "files that have the word eggs": eggs, not "word"
            if low in texty:
                u.blank(start, start + len(orig))
        words = [w for w in words if w not in texty]
    words = words[:limit]
    if not words:
        return 0
    for w in words:
        for low, orig, start in u.remaining():
            if low == w:
                u.blank(start, start + len(orig))
                break
    # A file name typed bare ("look for notes.txt") is that file's name, never text to grep for.
    names = [w for w in words if u.bare_name(w)]
    for w in names:
        glob = os.path.basename(u.bare_name(w).rstrip("/"))
        spec.names.append(glob)
        spec.why.append(f"name = {glob}")
    words = [w for w in words if w not in names]
    if not words:
        return 0
    if mode == "any" and spec.ftype == "d":
        mode = "name"
    if len(words) > 1 and re.search(r"\b(?:or|either)\b", u.low):
        spec.or_content = True
    if mode == "name":
        for w in words:
            lit = u.lit(w)
            if w.startswith("qlit"):
                glob = os.path.basename(lit) if is_pathlike(lit) else f"*{lit}*"
            else:
                glob = f"*{stem(w)}*"
            spec.names.append(glob)
            spec.why.append(f"name ~ {glob}")
    else:
        add_keywords(u, spec, words, mode)
        spec.why.append("name or content ~ " + ", ".join(c[2] for c in spec.content[-len(words):])
                        + (" (any of them)" if spec.or_content else ""))
    return len(words)


# ---- rendering -------------------------------------------------------------------

def find_tests(spec: FindSpec) -> list[str]:
    t: list[str] = []
    if spec.content and not spec.ftype:
        spec.ftype = "f"
    if spec.ftype:
        t += ["-type", spec.ftype]
    if spec.exts:
        if len(spec.exts) == 1:
            t += ["-iname", shlex.quote("*." + spec.exts[0])]
        else:
            grp = []
            for e in spec.exts:
                grp += (["-o"] if grp else []) + ["-iname", shlex.quote("*." + e)]
            t += ["\\("] + grp + ["\\)"]
    if spec.broken:
        t += ["-xtype", "l"]
    if spec.owner:
        t += ["-user", shlex.quote(spec.owner)]
    if spec.hidden:
        t += ["-name", "'.*'"]
    if spec.empty:
        t += ["-empty"]
    if spec.not_empty:
        t += ["-not", "-empty"]
    if spec.not_hidden:
        t += ["-not", "-name", "'.*'"]
    if spec.no_ext:
        t += ["-not", "-name", "'*.*'"]
    if spec.not_exts:
        globs = [shlex.quote("*." + e) for e in spec.not_exts]
        if len(globs) == 1:
            t += ["-not", "-iname", globs[0]]
        else:
            grp = []
            for g in globs:
                grp += (["-o"] if grp else []) + ["-iname", g]
            t += ["-not", "\\("] + grp + ["\\)"]
    for g in spec.not_names:
        t += ["-not", "-iname", shlex.quote(g)]
    if spec.executable:
        t += ["-executable"]
    t += spec.size
    if spec.time:
        t += (["-daystart"] if spec.daystart else []) + spec.time
    name_test = "-name" if spec.case else "-iname"
    whole = [g for g in spec.names if not re.search(r"[*?\[]", g)]
    if len(whole) > 1:                       # "main.py or notes.txt": a file has one name
        grp = []
        for g in whole:
            grp += (["-o"] if grp else []) + [name_test, shlex.quote(g)]
        t += ["\\("] + grp + ["\\)"]
    for g in spec.names:
        if len(whole) > 1 and g in whole:
            continue
        t += [name_test, shlex.quote(g)]
    for pat in spec.exclude:
        t += ["-not", "-path", shlex.quote(pat)]
    tests = []
    for mode, needle, *_ in spec.content:
        if spec.ftype == "d" and mode == "any":
            mode = "name"                    # a folder has a name, not text to grep
        grep = ["-exec", "grep", "-IqF" if spec.case else "-IqiF", "-e", shlex.quote(needle), "{}", "\\;"]
        if mode == "content":
            tests.append(grep)
        elif mode == "name":
            tests.append([name_test, shlex.quote(f"*{needle}*")])
        else:
            tests.append(["\\(", name_test, shlex.quote(f"*{needle}*"), "-o"] + grep + ["\\)"])
    if spec.or_content and len(tests) > 1:
        grp = []
        for x in tests:
            grp += (["-o"] if grp else []) + x
        t += ["\\("] + grp + ["\\)"]
    else:
        for x in tests:
            t += x
    return t


def render_find(spec: FindSpec, action: str = "list", default_rec: bool = True) -> str:
    """action: list | delete | count | total"""
    rec = default_rec if spec.rec is None else spec.rec
    parts = ["find", qpath(spec.root)]
    if not rec:
        parts += ["-maxdepth", "1", "-mindepth", "1"]
    if rec and (action == "delete" or action.startswith(("exec:", "top"))):
        parts += ["-mindepth", "1"]          # never the starting folder itself
    if action == "delete":   # -delete implies -depth, which makes -prune a no-op error
        parts += find_tests(spec) + ["-not", "-path", "'*/.git/*'"]
    else:
        parts += ["-path", "'*/.git'", "-prune", "-o"] + find_tests(spec)
    tail = ""
    limit = spec.limit or (10 if spec.sort and spec.sort[0] != "name" else None)
    if action.startswith("exec:"):
        parts += ["-exec"] + action[5:].split() + ["{}", "+"]
    elif action == "top0":   # the N first by the sort, NUL-separated paths
        key = "%s" if spec.sort[0] == "size" else "%T@"
        parts += ["-printf", f"'{key}\\t%p\\0'"]
        tail = (f" | sort -z -k1,1n{'r' if spec.sort[1] else ''} | head -z -n {spec.limit}"
                " | cut -z -f2-")
    elif action == "delete":
        if spec.ftype == "d" and not spec.empty:
            parts += ["-prune", "-exec", "rm", "-r", "--", "{}", "+"]
        else:
            parts += ["-delete"]
    elif action == "count":
        parts += ["-print"]
        tail = " | wc -l"
    elif action == "total":
        parts += ["-print0"]
        tail = " | du -ch --files0-from=- | tail -n 1"
    elif spec.sort and spec.sort[0] == "size":
        parts += ["-printf", "'%s\\t%p\\n'"]
        tail = (f" | sort -n{'r' if spec.sort[1] else ''} | head -n {limit}"
                " | numfmt --to=iec --field=1")
    elif spec.sort and spec.sort[0] == "time":
        parts += ["-printf", "'%TY-%Tm-%Td %TH:%TM  %p\\n'"]
        tail = f" | sort{' -r' if spec.sort[1] else ''} | head -n {limit}"
    else:
        parts += ["-print"]
        if spec.sort:
            tail = " | sort" + (" -r" if spec.sort[1] else "")
        if limit:
            tail += f" | head -n {limit}"
    cmd = " ".join(parts) + tail
    if spec.root == "/":
        cmd = cmd.replace("find / ", "find / -xdev ", 1)
        cmd = cmd.replace(" -print", " -print 2>/dev/null", 1) if "-print " in cmd + " " else cmd
    return cmd


def where_label(spec: FindSpec, default_rec: bool) -> str:
    rec = default_rec if spec.rec is None else spec.rec
    place = {".": "here", "~": "home", "/": "whole system", "..": "parent folder"}.get(spec.root, spec.root)
    return place + (" and subfolders" if rec else " (top level only)")


# ---- plans ---------------------------------------------------------------------

@dataclass
class Plan:
    command: str
    intent: str
    why: list = field(default_factory=list)
    confidence: float = 1.0
    destructive: bool = False
    preview: str | None = None      # shown before a destructive run
    warning: str | None = None      # replaces the generic "deletes or changes" line
    unknown: list = field(default_factory=list)
    keywords: list = field(default_factory=list)    # words used as search terms
    show_only: bool = False                         # "how do I ...": print, don't run
    runs_on_question: bool = False                  # "how do I use tar": the answer is to run it
    checked: bool = False                           # the rule already decided whether to ask
    source: str = "rules"           # rules | learned | llm

    def rationale(self) -> str:
        return " · ".join([self.intent] + [w for w in self.why if w])


UNKNOWN_PENALTY = 0.75   # per word the parser could not place
GUESS_PENALTY = 0.92     # per leftover word it turned into a keyword


def finish(u: Utterance, plan: Plan, guessed: int = 0, spec: FindSpec | None = None) -> Plan:
    left = u.leftover() + (spec.unparsed if spec else [])
    plan.unknown = left
    if spec:
        plan.keywords = [c[1] for c in spec.content] + [g.strip("*") for g in spec.names]
    plan.confidence *= (UNKNOWN_PENALTY ** len(left)) * (GUESS_PENALTY ** guessed)
    if NEG_WORDS & set(left):
        plan.confidence *= 0.5    # an unplaced "not" may flip the meaning
    if OPTION_WORDS & set(left):
        plan.confidence *= 0.5    # an option the rules did not read: not this command
    if left:
        plan.why.append("ignored: " + " ".join(left))
    if looks_destructive(plan.command):
        plan.destructive = True
    return plan


def first_target(u: Utterance, want: str | None = None) -> tuple[str | None, int]:
    """First remaining word that names an existing path. Blanks it."""
    for low, orig, start in u.remaining():
        tok = u.lit(orig)
        if low in FILLER and not os.path.exists(os.path.join(u.cwd, tok)):
            continue
        path = resolve(tok, u.cwd, want)
        if path:
            u.blank(start, start + len(orig))
            return path, start
    return None, -1


def split_items(text: str) -> list[str]:
    return [p for p in re.split(r"\s*(?:,|\band\b|&)\s*", text.strip()) if p]


# ---- intent handlers -------------------------------------------------------------
# Each takes a fresh Utterance and returns a Plan or None. interpret() runs
# them all and keeps the most confident plan.

FIND_VERB = (r"\b(?:find|search(?:\s+for)?|look(?:ing)?\s+for|locate|show\s+me\s+where|"
             r"where\s+(?:is|are|did\s+i\s+(?:put|save))|hunt\s+for|track\s+down|seek|"
             r"(?:which|what)(?=\s+(?:\S+\s+){0,2}?(?:files?|folders?|directories|pdfs?|images?|photos?|videos?|scripts?|documents?|docs)\b))\b")


def h_find(u: Utterance) -> Plan | None:
    m = u.take(FIND_VERB)
    verbless = False
    if not m:
        # "files bigger than 5 megabytes", "latest files": a description of files is a search
        if not u.peek(r"\b(?:files?|stuff|things|items|folders?|pdfs?|images?|photos?|videos?|logs?|documents?)\b"):
            return None
        m, verbless = True, True
        u.take(r"\b(?:stuff|things|items)\b")
    by_name = False if verbless else m.group(0).startswith(("where", "locate", "show me where"))
    spec = FindSpec()
    dupes = u.take(r"\b(?:duplicates?|duplicated|identical|same)(?:\s+(?:content|contents))?\b")
    parse_filters(u, spec)
    if dupes:
        spec.ftype = "f"
        cmd = (render_find(spec).replace(" -print", " -print0", 1)
               + " | xargs -0 -r md5sum | sort | uniq -w32 --all-repeated=separate")
        plan = Plan(cmd, "find duplicates", [where_label(spec, True)] + spec.why
                    + ["same content (md5), grouped"])
        return finish(u, plan, 0, spec)
    if verbless and (not (spec.narrowed() or spec.sort) or u.leftover() or spec.unparsed):
        return None          # only a pure description of files: "delete…", "convert…" are not searches
    if spec.glob_here and spec.rec is False:
        spec.rec = None                      # "search for *.csv": find looks in every subfolder
    guessed = absorb_keywords(u, spec, "name" if by_name else "any")
    cmd = render_find(spec)
    plan = Plan(cmd, "find", [where_label(spec, True)] + spec.why)
    if verbless:
        plan.confidence *= 0.95
    return finish(u, plan, guessed, spec)


LIST_V = (r"\b(?:list|ls|show(?:\s+me)?|display|view|see|sort|order|arrange|organi[sz]e|rank|enumerate|print|"
          r"tell\s+me(?:\s+about)?|give\s+me|get\s+me\s+a\s+list\s+of|"
          r"what\s+do\s+(?:i|we)\s+have|what\s+(?:is|are)(?=\s+(?:in|inside|here|there)\b)|contents?\s+of)\b")

# ls sort keys: wording -> (key, short flags, extra long option)
LS_KEYS = [
    (r"creat(?:ion|ed)(?:\s+(?:time|date))?|birth(?:\s*(?:time|date))?|when\s+(?:they\s+were\s+)?created", "birth", "t", "--time=birth"),
    (r"access(?:ed)?(?:\s+(?:time|date))?|last\s+(?:accessed|opened|used|read)|atime|when\s+(?:they\s+were\s+)?(?:last\s+)?(?:opened|used|accessed)", "atime", "tu", ""),
    (r"ctime|status\s+change(?:\s+time)?|inode\s+change(?:\s+time)?", "ctime", "tc", ""),
    (r"(?:last\s+)?modif(?:ied|ication)(?:\s+(?:time|date))?|mtime|(?:change|edit|update)[ds]?\s+(?:time|date)|time(?:stamps?)?|dates?|"
     r"age|recency|when\s+(?:they\s+were\s+)?(?:last\s+)?(?:modified|changed|edited|updated|saved)", "time", "t", ""),
    (r"(?:file\s+)?sizes?|bytes|how\s+big(?:\s+they\s+are)?|weight", "size", "S", ""),
    (r"(?:file\s*)?extensions?|ext|suffix(?:es)?|(?:file\s*)?types?|kind|format", "ext", "X", ""),
    (r"versions?(?:\s+numbers?)?|natural(?:\s+order)?|numbers?\s+in\s+(?:the\s+)?names?", "version", "v", ""),
    (r"(?:file\s*)?names?|filenames?|alphabet|letters?|titles?", "name", "", ""),
    (r"directory\s+order|disk\s+order|no\s+(?:particular\s+)?order|unsorted|as\s+they\s+are", "none", "U", ""),
]
LS_DEFAULT_DESC = {"time": True, "size": True, "birth": True, "atime": True, "ctime": True}   # ls's own default


def take_ls_options(u: Utterance) -> dict:
    """Listing parameters in any wording: sort key and direction, format, what to include."""
    o = {"key": None, "rev": None, "fmt": None, "all": False, "only": None, "dirs_first": False,
         "classify": False, "full_time": False, "bytes": False, "block": None, "why": []}
    if u.take(r"\bunsorted\b|\bnot\s+sorted\b|\b(?:without|with\s+no|no)\s+sorting\b|"
              r"\bin\s+(?:the\s+)?(?:directory|disk|no(?:\s+particular)?)\s+order\b"):
        o["key"] = "none"
    if u.take(r"\b(?:folders|directories|dirs|subfolders)\s+(?:first|on\s+top|at\s+the\s+top|before\s+files)\b|"
              r"\bgroup(?:ed)?\s+(?:the\s+)?(?:folders|directories|dirs)(?:\s+(?:first|together))?\b"):
        o["dirs_first"] = True
        o["why"].append("folders first")
    if u.take(r"\b(?:and\s+|plus\s+)?(?:the\s+)?(?:hidden|dot)\s*(?:ones|files|items|folders|stuff)?\s+(?:too|as\s+well|included|also)\b|"
              r"\b(?:including|incl|with|plus|and|also|show(?:ing)?|even|together\s+with)\s+(?:the\s+)?(?:hidden|dot)(?:\s*(?:ones|files|items|folders|stuff))?\b"):
        o["all"] = True
    if u.take(r"\b(?:only|just)\s+(?:the\s+)?files\b|\bfiles\s+only\b(?!\s+(?:the\s+)?(?:file\s*)?names)|\b(?:no|without(?:\s+the)?|exclud(?:e|ing))\s+(?:folders|directories|dirs)\b"):
        o["only"] = "files"
        o["why"].append("files only")
    elif u.take(r"\b(?:only|just)\s+(?:the\s+)?(?:folders|directories|dirs|subfolders|subdirectories)\b|"
                r"\b(?:folders|directories|dirs)\s+only\b|\bno\s+files\b"):
        o["only"] = "dirs"
        o["why"].append("folders only")
    # format
    if u.take(r"\bone\s+(?:file\s+|item\s+|entry\s+|name\s+)?(?:per|a|each)\s+line\b|\beach\s+on\s+(?:its\s+own|a\s+separate|a\s+new)\s+line\b|"
              r"\bin\s+a\s+(?:single\s+)?column\b|\bvertically\b|\bline\s+by\s+line\b"):
        o["fmt"] = "one"
    elif u.take(r"\b(?:just|only)\s+(?:the\s+)?(?:file\s*)?names\b|\b(?:file\s*)?names\s+only\b|\bnothing\s+but\s+(?:the\s+)?names\b"):
        o["fmt"] = "one"
        o["why"].append("names only")
    elif u.take(r"\bwithout\s+(?:any\s+)?(?:the\s+)?details\b|\bno\s+details\b|\bshort\s+(?:format|list(?:ing)?|form|view)\b|\bbrief(?:ly)?\b|"
                r"\bsimple\s+(?:list|view)\b|\bplain(?:ly)?\b|\bcompact(?:ly)?\b"):
        o["fmt"] = "short"
    elif u.take(r"\bin\s+columns\b|\bas\s+(?:a\s+)?grid\b|\bacross\b"):
        o["fmt"] = "columns"
    elif u.take(r"\bcomma[- ]separated\b|\bseparated\s+by\s+commas\b|\bwith\s+commas\b"):
        o["fmt"] = "commas"
    u.take(r"\bwith\s+(?:all\s+)?(?:the\s+|their\s+)?(?:details|sizes?|dates?|times?|permissions|owners?|info|information)\b|"
           r"\bin\s+(?:long|detailed|full)\s+(?:format|form|view|listing)\b|\blong\s+(?:format|listing|form|view)\b|\bdetailed(?:ly)?\b|\bin\s+detail\b|"
           r"\bhuman[- ]readable(?:\s+sizes?)?\b|\breadable\s+sizes?\b")
    if u.take(r"\b(?:full|exact|precise|complete|iso)\s+(?:time(?:stamps?)?|dates?)\b|\bwith\s+seconds\b"):
        o["full_time"] = True
        o["why"].append("full timestamps")
    m = u.take(r"\b(?:sizes?\s+)?in\s+(kb|kilobytes?|mb|megabytes?|gb|gigabytes?)\b")
    if m:
        o["block"] = m.group(1)[0].upper()
        o["why"].append(f"sizes in {o['block']}")
    elif u.take(r"\b(?:sizes?\s+)?(?:in|as)\s+bytes\b|\bexact\s+sizes?\b|\braw\s+sizes?\b|\bnot\s+human[- ]readable\b"):
        o["bytes"] = True
        o["why"].append("sizes in bytes")
    if u.take(r"\b(?:with\s+)?(?:file\s*)?type\s+(?:indicators|markers|symbols)\b|\bclassif(?:y|ied)\b|\bmark\s+(?:the\s+)?(?:folders|directories|types)\b"):
        o["classify"] = True
        o["why"].append("type markers")
    # "largest to smallest", "from oldest to newest"
    m = u.take(r"\b(?:from\s+)?(?:the\s+)?(largest|biggest|smallest|tiniest|newest|latest|oldest|most\s+recent)\s+"
               r"(?:to|-|→)\s+(?:the\s+)?(?:largest|biggest|smallest|tiniest|newest|latest|oldest|least\s+recent)\b")
    if m:
        word = m.group(1)
        o["key"] = o["key"] or ("size" if word in ("biggest", "largest", "smallest", "tiniest") else "time")
        o["rev"] = word not in ("newest", "latest", "most recent", "biggest", "largest")
    # direction words that also name a key
    m = u.take(r"\b(newest|latest|most\s+recent|recent|biggest|largest|oldest|smallest|least\s+recent|tiniest)\s+"
               r"(first|last|on\s+top|at\s+the\s+(?:top|bottom)|at\s+the\s+end)\b")
    if m:
        word, where = m.group(1), m.group(2)
        o["key"] = o["key"] or ("size" if word in ("biggest", "largest", "smallest", "tiniest") else "time")
        big_first = word in ("newest", "latest", "most recent", "recent", "biggest", "largest")
        first = where in ("first", "on top", "at the top")
        o["rev"] = not (big_first == first)
    if u.take(r"\b(?:from\s+)?z\s*(?:to|-|→)\s*a\b|"
              r"\b(?:(?:sorted|ordered|arranged|sort)\s+)?(?:in\s+)?(?:reversed?|backwards?|inverse)\s+(?:alphabetical(?:ly)?|alphabetic|abc)(?:\s+order)?\b|"
              r"\b(?:(?:sorted|ordered|arranged|sort)\s+)?alphabetical(?:ly)?\s+(?:in\s+)?(?:reversed?|backwards|descending)(?:\s+order)?\b"):
        o["key"], o["rev"] = "name", True
    elif u.take(r"\b(?:from\s+)?a\s*(?:to|-|→)\s*z\b|\bby\s+abc\b|"
                r"\b(?:(?:sorted|ordered|arranged|sort)\s+)?(?:in\s+)?(?:an?\s+)?(?:alphabetical(?:ly)?|alphabetic|abc)(?:\s+order)?\b"):
        o["key"] = o["key"] or "name"
    if u.take(r"\bchronological(?:ly)?(?:\s+order)?\b|\bin\s+(?:the\s+)?order\s+(?:they\s+were\s+)?(?:made|created|modified)\b"):
        o["key"], o["rev"] = o["key"] or "time", True
    # "sorted by X", "by X", "ordered by X"
    keys = "|".join(f"(?P<k{i}>{pat})" for i, (pat, *_r) in enumerate(LS_KEYS))
    m = u.take(r"\b(?:sort(?:ed)?|order(?:ed)?|arrang(?:e|ed)|organi[sz]ed?|rank(?:ed)?|group(?:ed)?)?\s*(?:them\s+|it\s+)?"
               rf"(?:by|on|according\s+to)\s+(?:their\s+|the\s+|its\s+)?(?:{keys})\b")
    # "in the order of time", "in order of their size", "in time order", "date order"
    m = m or u.take(rf"\b(?:in\s+)?(?:the\s+)?order\s+of\s+(?:their\s+|the\s+|its\s+)?(?:{keys})\b")
    m = m or u.take(rf"\b(?:in\s+)?(?:the\s+|their\s+|its\s+)?(?:{keys})\s+order\b")
    if m:
        i = next(int(k[1:]) for k, v in m.groupdict().items() if v)
        o["key"] = LS_KEYS[i][1]
    elif u.take(r"\b(?:sort(?:ed)?|order(?:ed)?)\s+(?:them\s+)?(?:alphabetically|by\s+name)?\b"):
        o["key"] = o["key"] or "name"
    m = u.take(r"\b(?:in\s+)?(?:revers(?:e|ed)|backwards?|inverted?|upside\s+down)(?:\s+order)?\b|\b(ascending|descending)(?:\s+order)?\b|"
               r"\b(asc|desc)\b")
    if m:
        word = (m.group(1) or m.group(2) or "").lower()
        if word:
            desc = word.startswith("desc")
            o["rev"] = desc != LS_DEFAULT_DESC.get(o["key"] or "name", False)
        else:
            o["rev"] = not o["rev"] if o["rev"] is not None else True
    return o


def h_list(u: Utterance) -> Plan | None:
    if not u.take(LIST_V):
        return None
    opts = take_ls_options(u)
    spec = FindSpec()
    parse_filters(u, spec)
    u.take(r"\b(?:contents?|everything|entries|stuff|things|items)\b")
    path, _ = first_target(u)
    if path:
        if not os.path.isdir(os.path.join(u.cwd, os.path.expanduser(path))):
            return None  # an existing file: that's a read, not a list
        spec.root = path
    guessed = absorb_keywords(u, spec, "name")
    show_all = opts["all"] or bool(re.search(r"\ball\b", u.low))
    if spec.ftype == "d" and not opts["only"]:
        opts["only"] = "dirs"
    key, rev = opts["key"], opts["rev"]
    if key is None and spec.sort:                      # "5 biggest", "newest", "sorted by size"
        key, desc = spec.sort
        if rev is None:
            rev = desc != LS_DEFAULT_DESC.get(key, False)
    if key in ("size", "time", "name") and opts["rev"] is not None:
        spec.sort = (key, not opts["rev"]) if key in ("size", "time") else (key, opts["rev"])
    elif key in ("size", "time", "name"):
        spec.sort = spec.sort or (key, LS_DEFAULT_DESC.get(key, False))
    rich = (spec.size or spec.time or spec.content or spec.names or spec.hidden
            or spec.empty or spec.executable or spec.rec or len(spec.exts) > 1
            or spec.not_exts or spec.not_names or spec.not_empty or spec.owner or spec.broken
            or (opts["only"] == "files" and spec.limit) or (spec.ftype == "f" and spec.limit))
    why = [where_label(spec, False)] + spec.why + opts["why"] + (["including hidden"] if show_all else [])
    if rich:
        if opts["only"] == "files":
            spec.ftype = "f"
        cmd = render_find(spec, default_rec=False)
        return finish(u, Plan(cmd, "list", why), guessed, spec)
    # build the ls flags
    long_fmt = opts["fmt"] is None or opts["full_time"]
    short = ("l" if long_fmt else "") + ("h" if long_fmt and not opts["bytes"] and not opts["block"] else "")
    short += "A" if show_all else ""
    extra = []
    if key:
        k = next(x for x in LS_KEYS if x[1] == key)
        short += k[2]
        if k[3]:
            extra.append(k[3])
        if key != "name" or rev:
            why.append(f"sorted by {key}" + (", reversed" if rev else ""))
    elif rev:
        why.append("reversed")
    short += "r" if rev else ""
    short += {"one": "1", "columns": "C", "commas": "m"}.get(opts["fmt"], "")
    short += "F" if opts["classify"] else ""
    if opts["dirs_first"]:
        extra.append("--group-directories-first")
    if opts["full_time"]:
        extra.append("--full-time")
    if opts["block"]:
        extra.append(f"--block-size={opts['block']}")
    root = "" if spec.root == "." else spec.root.rstrip("/") + "/"
    has_total = long_fmt
    if opts["only"] == "files":
        hide = [] if show_all else ["-not", "-name", "'.*'"]
        short += "t" if key is None else ""        # find runs ls itself, past the alias: newest first
        flags = " ".join(x for x in ["-" + short, *extra, "--color=auto"] if x)
        cmd = " ".join(["find", qpath(spec.root), "-maxdepth", "1", "-mindepth", "1", "-type", "f", *hide,
                        "-exec", "ls", flags + (" " if flags else "") + "--", "{}", "+"])
        cmd = re.sub(r"\s+", " ", cmd)
        has_total = False
    else:
        if opts["only"] == "dirs":
            target, has_total = (qpath(root) if root else "") + "*/", False
            short += "d"
        elif spec.exts:
            target, has_total = (qpath(root) if root else "") + f"*.{spec.exts[0]}", False
        else:
            target = qpath(spec.root) if root else ""
        flags = " ".join(x for x in ["-" + short if short else "", *extra] if x)
        # by name: past the ls alias, which sorts newest first (ls has no flag back to names)
        by_name = key == "name"
        ls = "command ls" if by_name else "ls"
        style = LS_STYLE.replace(" -t", "") if by_name else ""
        cmd = " ".join(x for x in (ls, flags, style, "--" if target else "", target) if x)
    if spec.limit:
        cmd += f" | head -n {spec.limit + 1 if has_total else spec.limit}"
    return finish(u, Plan(cmd, "list", why), guessed, spec)


def h_grep(u: Utterance) -> Plan | None:
    """Show matching *lines*: "search notes.txt for TODO", "find TODO in python files"."""
    term = target = None
    m = u.peek(r"\b(?:search|grep|look)\s+(?:in\s+|through\s+|inside\s+)?(.+?)\s+for\s+(\S+(?:\s+\S+)?)\s*$")
    if m and not re.match(r"(?:files?|folders?)\b", m.group(2)):
        target, term = u.o(m, 1), u.o(m, 2)
    if not term:
        m = u.peek(r"\b(?:find|search(?:\s+for)?|look\s+for|locate|grep(?:\s+for)?|show(?:\s+me)?|"
                   r"where\s+(?:is|are|do\s+i\s+use|did\s+i\s+use))\s+(?:the\s+(?:word|text|string)\s+)?"
                   r"(\S+)\s+(?:in|inside|within|across|throughout)\s+(.+)$")
        if m:
            term, target = u.o(m, 1), u.o(m, 2)
    if not term:
        m = u.peek(r"\b(?:lines?|occurrences?|matches|mentions?)\s+(?:that\s+)?(?:contain(?:s|ing)?|with|of|"
                   r"matching|mentioning)\s+(?:the\s+(?:word|text|string)\s+)?(\S+)(?:\s+(?:in|inside)\s+(.+))?$")
        if m:
            term, target = u.o(m, 1), (u.o(m, 2) if m.group(2) else None)
    if not term:
        m = u.peek(r"^(?:search|grep)\s+(?:for\s+)?(qlit\d+)$")
        if m:
            term = u.o(m, 1)
    if not term:
        return None
    if u.bare_name(term.strip()) and not (target and (resolve(u.lit(target.strip()), u.cwd, "file")
                                                      or is_pathlike(u.lit(target.strip())))):
        return None       # "search my home for report.pdf" finds the file (h_find), it does not grep for its name
    low_term = term.lower()
    if low_term in FILLER or low_term in GENERIC or type_word(low_term) or low_term in FILE_KINDS:
        return None
    u.text = " " * len(u.text)  # the whole sentence is consumed by the pattern
    needle = u.lit(term)
    why = [f'text "{needle}"', "case-insensitive"]
    if target:
        tname = u.lit(target.strip())
        file = resolve(tname, u.cwd, "file") or unique_stem_below(tname, u.cwd)
        if file:
            return Plan(f"grep -niF -- {shlex.quote(needle)} {qpath(file)}", "search text",
                        why + [f"in {file}"])
        if is_pathlike(tname) and "/" not in tname:   # a file name that lives deeper down
            return Plan(f"grep -rniF --include={shlex.quote(tname)} --exclude-dir=.git -- "
                        f"{shlex.quote(needle)} .", "search text",
                        why + [f"in every {tname} here and below"])
        sub = Utterance(target, u.cwd, u.literals)
        spec = FindSpec()
        parse_filters(sub, spec)
        path, _ = first_target(sub, "dir")
        if path:
            spec.root = path
        left = sub.leftover()
        includes = " ".join(f"--include={shlex.quote('*.' + e)}" for e in spec.exts)
        cmd = " ".join(p for p in ("grep -rniIF", includes, "--exclude-dir=.git", "--",
                                   shlex.quote(needle), qpath(spec.root)) if p)
        plan = Plan(cmd, "search text", why + [where_label(spec, True)] + spec.why)
        plan.confidence *= UNKNOWN_PENALTY ** len(left)
        plan.unknown = left
        return plan
    return Plan(f"grep -rniIF --exclude-dir=.git -- {shlex.quote(needle)} .", "search text",
                why + ["here and subfolders"])


# ---- search: the words people use for searching ------------------------------------
# "search" in all its wordings: where to look, what for, and how (by name, by
# content, case, whole words). Only answers what it is sure of; everything else
# falls through to h_grep and h_find.

SEARCH_HELP = [
    "search for notes                 files whose name or text has 'notes'",
    "search for report.pdf            a file by its name (anywhere below here)",
    "search run1 for pressure         lines with 'pressure' in the files in run1",
    "search the word error in logs    lines, in the .log files",
    "search file names for budget     names only",
    "search file contents for todo    text only",
    "search for pdfs in my downloads  by type, in ~/Downloads",
    "search the whole computer for x  everywhere (/)",
    "which folder is notes.txt in     the folder, not the file",
    "does notes.txt exist             finds it or says it is not there",
    "add: case sensitive, whole word, only file names, exactly, or, modified since monday",
]

SEARCH_VERB = (r"^\s*(?P<v>search(?:ing)?|grep(?:ping)?|look(?:ing)?|hunt(?:ing)?|seek(?:ing)?|scan(?:ning)?|"
               r"brows(?:e|ing)|dig(?:ging)?|track(?:ing)?|comb(?:ing)?|check(?:ing)?|find(?:ing)?|locate)\b"
               r"(?P<p>(?:\s+(?:for|up|down|out|me|around)\b)*)\s*")
# "look"/"dig"/"track" mean searching only with a particle: look for, dig up, track down
NEEDS_PARTICLE = ("look", "looking", "dig", "digging", "track", "tracking", "hunt", "hunting", "comb", "combing")
SEARCH_CASE = (r"\b(?:case[- ]?sensitive(?:ly)?|match(?:ing)?\s+(?:the\s+)?case|with\s+(?:the\s+)?(?:exact|same|matching)\s+case|"
               r"exact\s+case|respect(?:ing)?\s+(?:the\s+)?case|(?:upper|lower)\s*case\s+matters)\b")
SEARCH_NOCASE = (r"\b(?:not\s+case[- ]?sensitive|case[- ]?insensitive(?:ly)?|ignor(?:e|ing)\s+(?:the\s+)?case|in\s+any\s+case|"
                 r"regardless\s+of\s+(?:the\s+)?case|whatever\s+the\s+case|(?:upper\s+or\s+lower|any)\s*case)\b")
SEARCH_WORD = (r"\b(?:as\s+an?\s+)?(?:whole|entire|full|complete|exact|separate)\s+words?(?:\s+only)?\b|\bonly\s+whole\s+words?\b|"
               r"\bword\s+match(?:es|ing)?\b|\bnot\s+(?:as\s+)?part\s+of\s+(?:another|other|a\s+longer)\s+words?\b")
SEARCH_FILES_ONLY = (r"(?:,\s*|\b)(?:and\s+)?(?:(?:show|list|give|print|return|tell)(?:\s+me)?\s+)?(?:only|just)\s+(?:the\s+)?"
                     r"(?:(?:matching\s+)?file\s*names?|names\s+of\s+(?:the\s+)?files|(?:matching\s+)?files|paths)\b|"
                     r"\b(?:file\s*names?|files|paths)\s+only\b|\band\s+(?:list|show)\s+(?:me\s+)?(?:the\s+)?(?:matching\s+)?files\b|"
                     r"\bwithout\s+(?:the\s+)?(?:matching\s+)?lines\b")
SEARCH_EXACT = (r"\b(?:with\s+)?(?:the\s+)?exact\s+(?:file\s*)?name\b|\b(?:named|called)\s+exactly\b|\bexact\s+match\b|"
                r"\bexactly(?:\s+(?:that|this)(?:\s+name)?)?\b")
# what the search is about, said in so many words
BY_NAME = (r"\b(?:by|in|on|from|using)\s+(?:the\s+|their\s+|its\s+|file\s*)?(?:file\s*)?names?\b|\bnames?\s+only\b|"
           r"\bin\s+(?:the\s+)?filenames?\b")
BY_TEXT = (r"\b(?:by|in|from|using)\s+(?:the\s+|their\s+|its\s+)?(?:file\s+)?(?:contents?|text)\b|"
           r"\b(?:inside|within|in)\s+(?:the\s+)?(?:files|documents)\b|\binside\s+(?:of\s+)?(?:them|it)\b")
TEXT_LEAD = (r"^(?:the\s+|a\s+|an\s+)?(?:words?|text|strings?|phrases?|terms?|keywords?|expressions?|sentences?|"
             r"lines?\s+(?:that\s+)?(?:contain(?:s|ing)?|with|mentioning|matching|saying|having)|"
             r"(?:occurrences?|instances?|mentions?|uses?|usages?)\s+of)\s+")
# "search <place> for <what>": the place, said in words
SYSTEM_PLACE = (r"(?:the\s+)?(?:whole\s+|entire\s+|full\s+)?(?:system|computer|machine|pc|laptop|disks?|drives?|hard\s*drive|"
                r"file\s*system|filesystem|root)|everywhere|everything\s+on\s+(?:my|this|the)\s+(?:computer|machine|disk|pc)")


def _search_place(text: str, orig: str, u: Utterance):
    """('name'|'text'|'dir'|'file', root) for the words between the verb and 'for', or None."""
    t = re.sub(r"^(?:in|inside|into|through|thru|within|across|throughout|under|on|over|all\s+over)\s+", "", text.strip())
    off = len(text.strip()) - len(t)
    o = orig.strip()[off:]
    m = re.match(r"^(?:all\s+(?:of\s+)?(?:the\s+|my\s+)?|every\s+|each\s+|the\s+|my\s+|our\s+|this\s+|these\s+)", t)
    if m and not re.match(r"(?:this|the)\s+(?:folder|directory|dir|project|repo|place)\b", t):
        t, o = t[m.end():], o[m.end():]
    if re.fullmatch(r"(?:file\s*)?names?|filenames?|names?\s+of\s+(?:the\s+|all\s+|my\s+)?files|(?:file\s+)?titles?", t):
        return "name", []
    m = re.fullmatch(r"(\S+)\s+(?:file\s*)?(?:names?|titles?)|names?\s+of\s+(?:the\s+|all\s+|my\s+)?(\S+?)(?:\s+files)?", t)
    if m and type_word(m.group(1) or m.group(2)):
        return "name", type_word(m.group(1) or m.group(2))[1]      # "search pdf names for report"
    if re.fullmatch(r"(?:(?:file|the)\s+)?(?:contents?|texts?)(?:\s+of\s+(?:the\s+|all\s+|my\s+|every\s+)?files)?|"
                    r"files?|everything|all|it|them|insides?\s+of\s+(?:the\s+)?files|"
                    r"(?:the\s+)?files?\s+(?:here|in\s+here)", t):
        return "text", "."
    if re.fullmatch(SYSTEM_PLACE, t):
        return "dir", "/"
    if re.fullmatch(r"home(?:\s+(?:folder|directory|dir))?|~|\$home|homedir", t):
        return "dir", "~"
    if re.fullmatch(r"(?:this|the|current|present)\s+(?:folder|directory|dir|place|location)|here|"
                    r"(?:this|the)\s+(?:project|repo|repository|codebase|source\s+tree)|folder|directory|dir|cwd|"
                    r"(?:sub-?folders|sub-?directories)", t):
        return "dir", "."
    if re.fullmatch(r"(?:the\s+)?parent(?:\s+(?:folder|directory|dir))?|\.\.", t):
        return "dir", ".."
    m = re.fullmatch(r"(downloads?|documents|desktop|pictures|music|videos|templates)(?:\s+(?:folder|directory|dir))?", t)
    if m and not os.path.isdir(os.path.join(u.cwd, o[:m.end(1)])):
        return "dir", "~/" + XDG_DIRS[m.group(1)]
    m = (re.fullmatch(r"(?:(?:folder|directory|dir|sub-?folder)\s+(?:called\s+|named\s+)?)?(\S+)", t)
         or re.fullmatch(r"(\S+)\s+(?:folder|directory|dir|sub-?folder)", t))
    if not m or type_word(t.split()[0]) or re.search(r"\bfiles?\b", t):
        # "the code", "python files", "all text files in run1": a kind of file, maybe somewhere
        sub = Utterance(orig, u.cwd, u.literals, u.auto)
        sub.text = text
        spec = FindSpec()
        parse_filters(sub, spec)
        if sub.leftover() or not spec.exts or resolve(o.strip(), u.cwd, "file"):
            return None
        return "filter", spec
    tok = u.lit(o[m.start(1):m.end(1)])
    named_folder = m.group(0) != m.group(1)
    path = home_alias(tok, u.cwd) or resolve(tok, u.cwd, "dir")
    if path:
        return "dir", path
    f = resolve(tok, u.cwd, "file")
    if f:
        return "file", f
    if named_folder or re.search(r"[/~$]", tok):
        return "dir", tok                    # a folder that is not there: the command says so
    return None


def _grep_plan(needles: list[str], root: str, *, file: str | None = None, exts=(), case=False, word=False,
               files_only=False, rec=True, why=()) -> Plan:
    flags = ("" if file else "-r" if rec else "") + ("l" if files_only else "n") + ("" if case else "i") \
        + ("" if file else "I") + "F" + ("w" if word else "")
    flags = "-" + flags.lstrip("-")
    pats = (["--", shlex.quote(needles[0])] if len(needles) == 1
            else [x for n in needles for x in ("-e", shlex.quote(n))])
    if file:
        cmd = " ".join(["grep", flags, *pats, qpath(file)])
        where = f"in {file}"
    else:
        includes = [f"--include={shlex.quote('*.' + e)}" for e in exts]
        target = qpath(root) if rec else (qpath(root).rstrip("/") + "/*" if root != "." else "*")
        cmd = " ".join(["grep", flags, *includes, "--exclude-dir=.git", *pats, target])
        place = {".": "here", "~": "home", "/": "whole system", "..": "parent folder"}.get(root, root)
        where = place + (" and subfolders" if rec else " (top level only)")
        if root == "/":
            cmd += " 2>/dev/null"
    shown = " or ".join(f'"{n}"' for n in needles)
    return Plan(cmd, "search text", [f"text {shown}", "case-sensitive" if case else "case-insensitive"]
                + (["whole words"] if word else []) + (["file names only"] if files_only else [])
                + [where] + list(why))


SEARCH_STOP = set("""
the a an for me in of with and or any all some every my our to that which is are here there it them this these those
""".split())


def _search_find(u: Utterance, root: str | None, mode: str, case: bool, exact: bool, intent: str = "find",
                 exts=()) -> Plan:
    spec = FindSpec()
    parse_filters(u, spec)
    if exts:
        add_exts(spec, [e for e in exts if e not in spec.exts])
    # what follows "search ... for" is the search term even when it is a common word ("report", "show")
    common = [(low, orig, start) for low, orig, start in u.remaining()
              if low in FILLER and low not in SEARCH_STOP and not exact]
    if common and not [w for w in u.leftover()]:
        for low, orig, start in common:
            u.blank(start, start + len(orig))
        add_keywords(u, spec, [low for low, _, _ in common], "name" if mode == "name" else "any")
        spec.why.append(("name ~ " if mode == "name" else "name or content ~ ") + ", ".join(c[2] for c in spec.content[-len(common):]))
    if root is not None and spec.root == ".":
        spec.root = root
    if spec.glob_here:
        spec.rec = None
    if exact:
        for low, orig, start in u.remaining():
            if low not in FILLER:
                spec.names.append(u.lit(orig))     # as typed: "Notes exactly" is Notes, not *note*
                u.blank(start, start + len(orig))
        spec.names = [g[1:-1] if g.startswith("*") and g.endswith("*") and len(g) > 2 else g for g in spec.names]
        spec.case = True
        spec.why.append("exact name")
    if mode == "name":                          # "by name", "file names": never the text inside
        for c in [c for c in spec.content]:
            spec.names.append(f"*{c[1]}*")
            spec.content.remove(c)
        spec.why = [w.replace("name or content ~", "name ~").replace("content ~", "name ~") for w in spec.why]
    guessed = absorb_keywords(u, spec, mode)
    if case:
        spec.case = True
        spec.why.append("case-sensitive")
    if not (spec.narrowed() or spec.ftype or spec.sort):
        return None
    plan = Plan(render_find(spec), intent, [where_label(spec, True)] + spec.why)
    return finish(u, plan, guessed, spec)


def h_search(u: Utterance) -> Plan | None:
    low = u.text.strip()
    if re.fullmatch(r"(?:search|searching)(?:\s+(?:help|for|commands?|how))?", low):
        lines = " ".join(shlex.quote(x) for x in ["examples:", *SEARCH_HELP])
        plan = Plan(f"printf '%s\\n' {lines}", "search help", ["what search understands"])
        plan.runs_on_question = True
        return plan
    m = re.match(r"\s*(?:show|tell)\s+me\s+where\s+(?:is\s+|are\s+)?(?:the\s+|my\s+)?(?:file\s+)?(?P<x>\S+)(?:\s+(?:is|are|lives|went))?\s*$", u.text)
    if m and _subject(u, m):
        u.text = u.text[:m.start()] + "find".ljust(m.start("x") - m.start()) + u.text[m.start("x"):m.end("x")] \
            + " " * (len(u.text) - m.end("x"))
    u.text = re.sub(r"[()\[\]]", " ", u.text)        # "search for pressure (case sensitive)"
    p = _folder_of(u) or _path_of(u) or _exists(u) or _where_text(u)
    if p:
        return p
    m = re.match(SEARCH_VERB, u.text)
    if not m:
        return None
    verb, particle = m.group("v"), m.group("p").split()
    if verb in NEEDS_PARTICLE and not particle and not re.match(r"(?:in|inside|into|through|thru|within|everywhere|all\s+over|around)\b", u.text[m.end():]):
        return None
    if verb.startswith("check") and not re.search(r"\bfor\b", u.text[m.end():]):
        return None                                   # "check disk space" is not a search
    if re.match(r"(?:the\s+)?(?:web|internet|net|online|google|wikipedia|youtube)\b", u.text[m.end():]):
        return None                                   # the web search recipe
    grep_verb = verb.startswith("grep")
    find_verb = verb.startswith(("find", "locate"))
    lookup = verb.startswith("look") and "up" in particle
    u.blank(m.start(), m.end())
    # how to search
    nocase = bool(u.take(SEARCH_NOCASE))
    case = bool(u.take(SEARCH_CASE))
    word = bool(u.take(SEARCH_WORD))
    files_only = bool(u.take(SEARCH_FILES_ONLY))
    exact = bool(u.take(SEARCH_EXACT))
    # "with spaces in their names", "with note in the name": take_name reads those itself
    by_name = (not u.peek(r"\bwith\s+(?:an?\s+)?\S+\s+in\s+(?:(?:the|their|its)\s+)?(?:file\s*)?names?\b")
               and bool(u.take(BY_NAME)))
    by_text = bool(u.take(BY_TEXT))
    mode = "name" if by_name else "text" if (by_text or word or grep_verb) else None
    # "search <place> for <what>" (not "find X for Y": find takes what first)
    rest = u.text[m.end():]
    root, file, exts = None, None, []
    pm = None if find_verb or lookup else re.match(r"^\s*(?P<place>\S.*?)\s+for\s+(?P<what>\S.*)$", rest)
    if pm:
        place = _search_place(pm.group("place"), u.orig[m.end() + pm.start("place"):m.end() + pm.end("place")], u)
        if not place:
            return None                                       # "search apt for htop", "search the logs for": others know
        kind, where = place
        u.blank(m.end() + pm.start("place"), m.end() + pm.start("what"))
        if kind == "filter":
            kind, exts, where = "dir", where.exts, where.root
        if kind == "name":
            mode, exts = "name", where
        elif kind == "text":
            mode = mode or "text"
        elif kind == "file":
            if verb.startswith("check"):
                return None                                   # "check backup.zip for errors" tests the archive
            file = where
            mode = "text"
        else:
            root = where
    # the words of the search itself
    lead = len(u.text) - len(u.text.lstrip())
    tl = re.match(TEXT_LEAD, u.text[lead:])
    if tl:
        u.blank(lead, lead + tl.end())
        if mode != "name":
            mode = "text"
    # FILLER is not used here: "print", "show" or "list" can be what is searched for
    words = [w for w, _, _ in u.remaining() if w not in ("the", "a", "an", "for", "me", "please", "some", "any")]
    if not words:
        return None
    bare = [w for w in words if u.bare_name(w)]
    if mode is None and exact:
        im = re.search(r"\s(?:in|inside)\s+(\S+)\s*$", u.text)
        in_file = im and resolve(u.lit(u.o(im, 1)), u.cwd, "file")
        mode = "text" if in_file else "name"            # "error exactly in logs.txt" vs "Notes exactly"
    if mode is None and (case or nocase or files_only) and not (bare and len(words) == len(bare)):
        mode = "text"                                   # case and "only file names" are about text
    if mode is None:
        if bare and len(words) == len(bare) and (not lookup or _file_ext(u.bare_name(bare[0]))):
            mode = "file"                                     # "search for main.py", "look up notes.txt"
        elif root is not None and not lookup:
            mode = "place"
        elif lookup:
            return None                                       # "look up example.com" is dns
        elif verb.startswith(("dig", "brows", "scan", "comb", "seek", "hunt", "track")):
            mode = "any"                                      # words only this handler knows as "search"
        elif not u.leftover() and not find_verb:
            mode = "any"                                      # "search for report": the word is the search
        elif not (case or exact or files_only or u.peek(r"\bor\b") and len(words) > 1):
            return None                                       # plain wording: h_find and h_grep do it
    if exact and mode in (None, "file", "place"):
        mode = "name"
    if mode == "text":
        return _search_text(u, root, file, case, word, files_only, exact, exts)
    if mode == "place":
        # "search run1 for pressure": text, unless the words describe files ("search run1 for csv files")
        probe = Utterance(u.text, u.cwd, u.literals, u.auto)
        spec = FindSpec()
        parse_filters(probe, spec)
        if spec.narrowed() or spec.ftype or spec.sort or [w for w in probe.leftover() if probe.bare_name(w)]:
            if exts:
                return None                                   # "search python files for csv files": unclear
            return _search_find(u, root, "any", case, exact, "search")
        return _search_text(u, root, None, case, word, files_only, exact, exts)
    plan = _search_find(u, root, "name" if mode in ("name", "file") else "any", case, exact, "search", exts)
    if plan and lookup:
        plan.why.append("look up = find the file")
    return plan


def _file_ext(name: str) -> bool:
    """A real file extension, not a web domain: notes.txt yes, example.com no."""
    ext = name.rsplit(".", 1)[-1].lower()
    known = {e for _, exts in TYPE_WORDS.values() for e in exts} | {"txt", "conf", "cfg", "ini", "md", "doc", "docx"}
    return ext in known


def _search_text(u: Utterance, root, file, case, word, files_only, exact, exts=()) -> Plan | None:
    """grep: the needles are what is left; 'in <where>' after them says where."""
    text = u.text
    exts, rec = list(exts), True
    wm = re.search(r"\s(?:in|inside|within|across|throughout|under|through)\s+(?P<w>\S.*)$", text)
    if wm and file is None:
        sub = Utterance(u.orig[wm.start("w"):wm.end("w")], u.cwd, u.literals, u.auto)
        sub.text = text[wm.start("w"):wm.end("w")]
        tname = u.lit(u.orig[wm.start("w"):wm.end("w")].strip())
        f = resolve(tname, u.cwd, "file") or (unique_stem_below(tname, u.cwd) if " " not in tname else None)
        if f:
            file = f
        else:
            spec = FindSpec()
            parse_filters(sub, spec)
            path, _ = first_target(sub, "dir")
            if path:
                spec.root = path
            if sub.leftover():
                return None
            exts = exts or spec.exts
            root = spec.root if spec.root != "." or root is None else root
            rec = spec.rec is not False
        u.blank(wm.start(), wm.end())
    if file is None and root is None:
        root = "."
    origs = [u.orig[mm.start():mm.end()] for mm in re.finditer(r"\S+", u.text)]
    joined = " ".join(u.lit(o) for o in origs)
    # the user's own words are the needle ("print" too); only a leading article goes
    parts = [p.strip() for p in re.split(r"\s*(?:,|\bor\b|\beither\b)\s*", joined) if p.strip()]
    parts = [re.sub(r"(?i)^(?:(?:the|a|an|for|me)\s+)+", "", p) for p in parts]
    parts = [p for p in parts if p and p.lower() not in ("the", "a", "an", "for", "me", "it", "them", "please")]
    if not parts:
        return None
    if exact:
        case = True
    return _grep_plan(parts, root, file=file, exts=exts, case=case, word=word, files_only=files_only, rec=rec,
                      why=[f"type: {' '.join('.' + e for e in exts)}"] if exts else [])


FOLDER_W = r"(?:folder|directory|dir|sub-?folder|sub-?directory)"


def _subject(u: Utterance, m) -> str | None:
    """The thing searched for; not a word like "largest" ("which folder is the largest" is about sizes)."""
    tok = u.lit(u.o(m, "x"))
    low = tok.lower()
    if low in FILLER or low in GENERIC or low in SORT_WORD or low in TIMEISH or low in NEG_WORDS:
        return None
    if not (FILE_NAME.fullmatch(os.path.basename(tok)) or "/" in tok or re.fullmatch(r"qlit\d+", u.o(m, "x").lower())) \
            and (re.search(r"(?:est|ier|er)$", low) and not os.path.exists(os.path.join(u.cwd, tok))
                 or low in ("empty", "full", "hidden", "open", "used", "mounted", "shared", "free", "here")
                 or difflib.get_close_matches(low, list(SORT_WORD), n=1, cutoff=0.8)):   # "largset"
        return None
    return tok


def _name_glob(tok: str) -> str:
    return tok if "." in tok or re.search(r"[*?\[]", tok) else f"*{tok}*"


def _folder_of(u: Utterance) -> Plan | None:
    """'which folder is notes.txt in', 'find the folder where main.py is': the folder, not the file."""
    pats = [
        rf"^(?:in\s+)?(?:which|what)\s+{FOLDER_W}\s+(?:is|are|has|have|contains?|holds?|keeps?)\s+(?:the\s+|my\s+)?(?:file\s+)?(?P<x>\S+)"
        rf"(?:\s+(?:in|located\s+in|stored\s+in|saved\s+in|kept\s+in|located|stored|saved|kept))?\s*$",
        rf"^(?:in\s+)?(?:which|what)\s+{FOLDER_W}\s+(?:did\s+i\s+(?:put|save|leave)|do\s+i\s+have)\s+(?:the\s+|my\s+)?(?:file\s+)?(?P<x>\S+)(?:\s+in)?\s*$",
        rf"^(?:find|show(?:\s+me)?|tell\s+me|get|give\s+me|search\s+for|look\s+for|locate|what\s+is|which\s+is)\s+(?:the\s+)?"
        rf"(?:{FOLDER_W}|parent\s+{FOLDER_W}|location)\s+(?:where|that\s+(?:has|contains|holds)|containing|holding|with|of|for)\s+"
        rf"(?:the\s+|my\s+)?(?:file\s+)?(?P<x>\S+)(?:\s+(?:is|lives|sits|was\s+saved))?\s*$",
        rf"^where\s+(?:is|are)\s+(?:the\s+)?{FOLDER_W}\s+(?:with|containing|that\s+(?:has|contains|holds))\s+(?:the\s+)?(?:file\s+)?(?P<x>\S+)\s*$",
    ]
    for pat in pats:
        m = re.match(r"\s*" + pat[1:], u.text)
        if m:
            x = _subject(u, m)
            if not x:
                return None
            glob = _name_glob(os.path.basename(x))
            cmd = f"find . -path '*/.git' -prune -o -iname {shlex.quote(glob)} -printf '%h\\n' | sort -u"
            return Plan(cmd, "find folder", ["here and subfolders", f"name ~ {glob}", "shows the folder it is in"])
    return None


USED_W = (r"(?:appears?|occurs?|(?:is|are)\s+(?:used|mentioned|written|referenced|defined|called|found)|used|mentioned|written|"
          r"referenced|defined|called|found|shows?\s+up|comes?\s+up)")
TEXT_NOUN = r"(?:the\s+)?(?:words?|text|strings?|phrases?|terms?|keywords?|names?)\s+"


def _where_text(u: Utterance) -> Plan | None:
    """'where does the word pressure appear', 'in which file is TODO used', 'which files have the word eggs'."""
    t = u.text
    m = (re.match(rf"\s*(?:find|show(?:\s+me)?|tell\s+me)?\s*where\s+(?:does|do|is|are|did)?\s*(?:{TEXT_NOUN})?(?P<t>\S+(?:\s+\S+)?)\s+"
                  rf"{USED_W}(?:\s+(?P<w>(?:in|inside|under|within|across)\s+.+))?\s*$", t)
         or re.match(rf"\s*find\s+where\s+(?:{TEXT_NOUN})?(?P<t>\S+(?:\s+\S+)?)\s+{USED_W}(?:\s+(?P<w>(?:in|inside|under)\s+.+))?\s*$", t))
    files_only = False
    if not m:
        m = (re.match(rf"\s*(?:in\s+)?(?:which|what)\s+files?\s+(?:is|are|does|do|did)\s+(?:{TEXT_NOUN})?(?P<t>\S+(?:\s+\S+)?)\s+"
                      rf"(?:{USED_W}|appear|occur)(?:\s+(?P<w>(?:in|inside|under)\s+.+))?\s*$", t)
             or re.match(rf"\s*(?:which|what)\s+files?\s+(?:have|has|mentions?|includes?|uses?)\s+(?:{TEXT_NOUN})(?P<t>\S+(?:\s+\S+)?)"
                         rf"(?:\s+in\s+(?:them|it))?(?:\s+(?P<w>(?:in|inside|under)\s+.+))?\s*$", t))
        files_only = bool(m)
    if not m:
        return None
    needle = u.lit(u.o(m, "t"))
    if needle.lower() in FILLER or needle.lower() in GENERIC or u.bare_name(u.o(m, "t")):
        return None
    root, exts, file = ".", [], None
    if m.group("w"):
        where = re.sub(r"^(?:in|inside|under|within|across)\s+", "", u.o(m, "w"))
        file = resolve(u.lit(where.strip()), u.cwd, "file")
        if not file:
            sub = Utterance(where, u.cwd, u.literals, u.auto)
            spec = FindSpec()
            parse_filters(sub, spec)
            path, _ = first_target(sub, "dir")
            if sub.leftover():
                return None
            root, exts = path or spec.root, spec.exts
    return _grep_plan([needle], root, file=file, exts=exts, files_only=files_only,
                      why=[f"type: {' '.join('.' + e for e in exts[:6])}"] if exts else [])


def _path_of(u: Utterance) -> Plan | None:
    """'get me the path of notes.txt', 'full path to main.py'."""
    m = re.match(r"\s*(?:(?:get|give|show|tell|find)(?:\s+me)?\s+|what\s+is\s+|print\s+|copy\s+)?(?:the\s+)?(?:full\s+|absolute\s+|whole\s+|complete\s+)?"
                 r"(?:path|location)\s+(?:of|to|for)\s+(?:the\s+|my\s+)?(?:file\s+|folder\s+|directory\s+)?(?P<x>\S+)\s*$", u.text)
    if not m:
        return None
    x = _subject(u, m)
    if not x:
        return None
    if os.path.exists(os.path.join(u.cwd, os.path.expanduser(x))):
        return Plan(f"realpath -- {qpath(x)}", "path", [f"full path of {x}"])
    glob = _name_glob(os.path.basename(x))
    return Plan(f"find \"$PWD\" -path '*/.git' -prune -o -iname {shlex.quote(glob)} -print", "path",
                ["here and subfolders", f"name ~ {glob}", "full paths"])


def _exists(u: Utterance) -> Plan | None:
    """'does main.py exist', 'check if there is a pdf here', 'is there a folder called src'."""
    t = u.text
    m = (re.match(r"^\s*(?:does|do)\s+(?P<s>.+?)\s+exists?(?P<w>\s+.+)?\s*$", t)
         or re.match(r"^\s*(?:check|see|test|find\s+out|tell\s+me)\s+(?:if|whether)\s+(?:there\s+(?:is|are)\s+)?(?P<s>.+?)"
                     r"(?:\s+(?:exists?|is\s+(?:there|here|present)|are\s+(?:there|here)))(?P<w>\s+.+)?\s*$", t)
         or re.match(r"^\s*(?:check|see|test|find\s+out|tell\s+me)\s+(?:if|whether)\s+there\s+(?:is|are)\s+(?P<s>.+?)(?P<w>)\s*$", t))
    if not m:
        return None
    s, off = m.group("s"), m.start("s")
    sm = re.match(rf"(?:(?:a|an|the|any|some|my)\s+)?(?:(?P<k>file|{FOLDER_W})s?\s+(?:called\s+|named\s+)?)?(?P<x>\S+)", s)
    if not sm:
        return None
    x = u.lit(u.orig[off + sm.start("x"):off + sm.end("x")])
    where = (u.orig[off + sm.end():off + len(s)] + " " + u.orig[m.start("w"):m.end("w")]).strip()
    if where and not re.match(r"(?:here|in|inside|under|on|anywhere|somewhere|below)\b", where.lower()):
        return None
    spec = FindSpec()
    if where:
        sub = Utterance(re.sub(r"(?i)^(?:anywhere|somewhere|below)\b", "", where), u.cwd, u.literals, u.auto)
        parse_filters(sub, spec)
        if sub.leftover():
            return None
    k = sm.group("k")
    t_ = type_word(x.lower())
    if not (k or t_ or FILE_NAME.fullmatch(os.path.basename(x)) or os.path.exists(os.path.join(u.cwd, os.path.expanduser(x)))):
        return None                                   # "does docker exist": a program, not a file
    if t_ and not os.path.exists(os.path.join(u.cwd, x)):
        add_exts(spec, t_[1], t_[0])
    elif x.lower() in FILLER or x.lower() in GENERIC or x.lower() in TIMEISH:
        return None
    else:
        spec.names.append(_name_glob(os.path.basename(x)))
        spec.why.append(f"name ~ {spec.names[-1]}")
    if k:
        spec.ftype = "f" if k == "file" else "d"
    cmd = render_find(spec) + f" | grep . || echo {shlex.quote('not found: ' + x)}"
    return Plan(cmd, "exists?", [where_label(spec, True)] + spec.why + ["says so when there is none"])


def h_count(u: Utterance) -> Plan | None:
    if not u.take(r"\b(?:how\s+many|count(?:\s+the)?|number\s+of|total\s+number\s+of)\b"):
        return None
    m = u.take(r"\b(lines?|words?|characters?|chars|bytes)\b(?:\s+of\s+code)?")
    unit = m.group(1) if m else None
    if unit:
        flag = {"l": "-l", "w": "-w", "c": "-m", "b": "-c"}[unit[0]]
        spec = FindSpec()
        file, _ = first_target(u, "file")
        if file:
            plan = Plan(f"wc {flag} < {qpath(file)}", "count", [f"{unit} in {file}"])
            return finish(u, plan)
        if m.group(0).endswith("code"):
            add_exts(spec, CODE_EXTS, "code")
        parse_filters(u, spec)
        if not spec.exts:
            return None
        spec.ftype = "f"
        cmd = render_find(spec).replace(" -print", " -print0") + f" | xargs -0 cat | wc {flag}"
        return finish(u, Plan(cmd, "count", [f"{unit} in", where_label(spec, True)] + spec.why))
    if u.peek(r"\b(?:processes|cores|cpus|users)\b"):
        return None
    spec = FindSpec()
    parse_filters(u, spec)
    if spec.rec is None and spec.root == ".":
        spec.why.append("say 'recursively' to include subfolders")
    cmd = render_find(spec, "count", default_rec=False)
    return finish(u, Plan(cmd, "count", [where_label(spec, False)] + spec.why))


def h_size(u: Utterance) -> Plan | None:
    # "what's eating my disk", "biggest folders"
    hog = u.take(r"\b(?:taking|takes|take|using|uses|eating|eats|hogging|hogs|consuming|consumes|filling|occupies|occupying)\s+(?:up\s+)?(?:(?:the\s+)?most\s+|all\s+(?:the\s+|my\s+)?|so\s+much\s+|my\s+|the\s+)?"
                 r"(?:disk\s+)?(?:space|room|storage|disk)\b")
    big_dirs = u.take(r"\b(?:largest|biggest|heaviest)\s+(?:sub-?)?(?:folders|directories|dirs)\b")
    if hog or big_dirs:
        spec = FindSpec()
        take_sort_limit(u, spec)
        take_location(u, spec)
        n = spec.limit or 10
        root = qpath(spec.root)
        cmd = f"du -h --max-depth=1 {root} 2>/dev/null | sort -hr | head -n {n + 1}"
        return finish(u, Plan(cmd, "disk usage", [f"biggest folders in {spec.root}", f"top {n}"]))
    free_rx = (r"\bhow\s+much\s+(?:free\s+)?(?:disk\s+|drive\s+)?(?:space|room|disk|storage)\s+(?:is\s+|do\s+i\s+have\s+|have\s+i\s+got\s+)?"
               r"(?:free|left|available|remaining)\b|\bdisk\s+usage\s+of\s+(?:the\s+|all\s+(?:the\s+)?|my\s+)?"
               r"(?:drives|disks|partitions|file\s*systems|mounts)\b")
    if u.peek(free_rx):
        u.take(free_rx)
        return finish(u, Plan("df -h -x tmpfs -x devtmpfs -x squashfs", "disk space", ["free space on all drives"]))
    m = u.take(r"\b(?:how\s+(?:big|large|heavy)|how\s+much\s+(?:space|room|disk)|size\s+of|total\s+size|"
               r"disk\s+usage\s+of|space\s+used\s+by|du)\b|(?<!\bby\s)(?<!file\s)(?<!sort\s)\bsize\b(?=\s*$)")
    if not m:
        m = u.take(r"\b(?:how\s+much\s+)?(?:free|available|remaining|used)?\s*(?:disk|storage|drive)\s*(?:space|usage|capacity)?"
                   r"(?:\s+(?:is\s+|do\s+i\s+have\s+)?(?:left|free|available|remaining))?\b|"
                   r"\bfree\s+space\b|\bhow\s+full\b|\bspace\s+left\b")
        if not m:
            return None
        u.take(r"\b(?:on|of)\s+(?:my\s+|the\s+)?(?:computer|machine|system|disks?|drives?)\b")
        spec = FindSpec()
        take_location(u, spec)
        if spec.root == ".":
            target = ""
        else:
            target = " " + qpath(spec.root)
        if spec.root not in (".", "/") or u.peek(r"\b(?:folder|directory)\b"):
            return finish(u, Plan(f"du -sh {qpath(spec.root)}", "size", [spec.root]))
        cmd = "df -h -x tmpfs -x devtmpfs -x squashfs" + target
        return finish(u, Plan(cmd, "disk space", ["all mounted drives"]))
    spec = FindSpec()
    parse_filters(u, spec)
    path, _ = first_target(u)
    if spec.narrowed() or spec.ftype == "f":
        cmd = render_find(spec, "total")
        return finish(u, Plan(cmd, "total size", [where_label(spec, True)] + spec.why))
    target = path or spec.root
    u.take(r"\b(?:it|is|are|take|takes|use|uses|of)\b")
    return finish(u, Plan(f"du -sh {qpath(target)}", "size", [target]))


# Editors people name ("edit logs.txt with micro"): word -> (command, Debian package)
EDITORS = {
    "micro": ("micro", "micro"), "nano": ("nano", "nano"), "vim": ("vim", "vim"),
    "vi": ("vi", "vim"), "nvim": ("nvim", "neovim"), "neovim": ("nvim", "neovim"),
    "emacs": ("emacs", "emacs"), "helix": ("hx", None), "hx": ("hx", None),
    "kakoune": ("kak", "kakoune"), "kak": ("kak", "kakoune"), "joe": ("joe", "joe"),
    "ne": ("ne", "ne"), "jed": ("jed", "jed"), "mcedit": ("mcedit", "mc"),
    "gedit": ("gedit", "gedit"), "kate": ("kate", "kate"), "mousepad": ("mousepad", "mousepad"),
    "geany": ("geany", "geany"), "xed": ("xed", "xed"), "pluma": ("pluma", "pluma"),
    "code": ("code", None), "vscode": ("code", None), "vs": ("code", None),
}


# Programs "open X in/with Y" may name besides editors: things that show files.
VIEWERS = set("""
less more most cat bat batcat view evince okular atril mupdf zathura eog feh sxiv imv ristretto gwenview
geeqie shotwell mpv vlc totem rhythmbox audacious firefox chromium chromium-browser google-chrome
libreoffice soffice gimp inkscape krita nautilus thunar dolphin glow mdcat w3m lynx hexdump xxd od strings
""".split())


def take_program(u: Utterance):
    """'with micro', 'using vim', 'in nano' -> (command, package). Blanks it."""
    pat = (r"\b(?:with|using|in|via|through)\s+(?:the\s+|my\s+)?(?:editor\s+|program\s+|app\s+)?"
           r"([a-z][\w.+-]*)(?:\s+code)?(?:\s+(?:editor|program|app))?\b")
    for m in re.finditer(pat, u.text):
        word = m.group(1)
        if word in EDITORS:
            u.blank(m.start(), m.end())
            return EDITORS[word]
        if (word in VIEWERS and shutil.which(word)
                and not os.path.isdir(os.path.join(u.cwd, word))):
            u.blank(m.start(), m.end())
            return (word, None)
    return None


SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv", ".cache", ".tox"}


def find_below(name: str, cwd: str, max_depth: int = 4, max_entries: int = 20000) -> list[str]:
    """Relative paths of files called `name` under cwd (shallow first)."""
    hits, seen = [], 0
    base_depth = cwd.rstrip(os.sep).count(os.sep)
    for root, dirs, files in os.walk(cwd):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith("."))
        if root.count(os.sep) - base_depth >= max_depth:
            dirs[:] = []
        seen += len(files)
        for f in files:
            if f.lower() == name.lower():
                hits.append(os.path.relpath(os.path.join(root, f), cwd))
        if seen > max_entries:
            break
    return sorted(hits, key=lambda p: (p.count(os.sep), p))


def unique_stem_below(name: str, cwd: str) -> str | None:
    """'notes' -> 'run1/notes.txt' when exactly one file below here has that stem."""
    if not re.fullmatch(r"[\w-]+", name):
        return None
    hits, low = [], name.lower()
    base_depth = cwd.rstrip(os.sep).count(os.sep)
    for root, dirs, files in os.walk(cwd):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
        if root.count(os.sep) - base_depth >= 3:
            dirs[:] = []
        hits += [os.path.relpath(os.path.join(root, f), cwd) for f in files if os.path.splitext(f)[0].lower() == low]
        if len(hits) > 1:
            return None
    return hits[0] if len(hits) == 1 else None


def default_editor() -> tuple[str, str]:
    # Debian's sensible-editor honours $VISUAL/$EDITOR, then the `editor` alternative.
    if shutil.which("sensible-editor"):
        return "sensible-editor", "the default editor ($VISUAL/$EDITOR, else Debian's 'editor')"
    return "${VISUAL:-${EDITOR:-nano}}", "the default editor ($VISUAL/$EDITOR, else nano)"


def h_read(u: Utterance) -> Plan | None:
    m = u.take(r"\b(?:show|print|display|cat|read|view|open|launch|output|dump|see|look\s+at|check|edit|modify|"
               r"head|tail|follow|watch|what\s+is\s+in|contents?\s+of)\b")
    verb = m.group(0) if m else ""
    if not m and not u.peek(r"\b(?:first|top|last|bottom)\s+(?:\S+\s+)?lines?\b|\b(?:beginning|start|end)\s+of\b"):
        return None
    u.take(r"\b(?:the\s+)?contents?\s+of\b|\bcontents?\b|\bfor\s+editing\b")
    program = take_program(u)
    n = None
    mode = "cat"
    mh = u.take(rf"\b(?:first|top)\s+(?:{NUM}\s+)?lines?\b|\b(?:beginning|start|head)\s+of\b")
    mt = u.take(rf"\b(?:last|bottom)\s+(?:{NUM}\s+)?lines?\b|\b(?:end|tail)\s+of\b")
    if mh:
        mode, n = "head", num(mh.group(1), 10)
    elif mt:
        mode, n = "tail", num(mt.group(1), 10)
    if u.take(r"\b(?:follow|live|keep\s+watching|as\s+it\s+grows|in\s+real\s*time)\b") or verb in ("follow", "watch"):
        mode = "follow"
    if verb == "head":
        mode, n = "head", n or 10
    if verb == "tail" and mode != "follow":
        mode, n = "tail", n or 10
    if verb in ("edit", "modify") or (program and program[0] in {c for c, _ in EDITORS.values()}):
        mode = "edit"
    elif program:
        mode = "program"

    why: list[str] = []
    conf = 1.0
    path, _ = first_target(u, "file")
    if not path:
        # a file name that is not here: look further down, or create it when editing
        for low, orig, start in u.remaining():
            name = u.lit(orig)
            if not low.startswith("qlit"):   # quoted text or a file-like word
                continue
            hits = find_below(os.path.basename(name), u.cwd) if "/" not in name else []
            u.blank(start, start + len(orig))
            if len(hits) == 1:
                path = hits[0]
                why.append(f"found at {path}")
            elif len(hits) > 1:
                path = hits[0]
                why.append(f"{len(hits)} files named {name}; using the nearest")
                why.append("others: " + ", ".join(hits[1:4]) + (" …" if len(hits) > 4 else ""))
                conf = 0.8
            elif mode == "edit":
                path = name
                why.append("new file")
            break
    if not path:
        return None
    u.take(r"\b(?:log|file|text|document)\b")
    q = qpath(path)
    reqs = []
    if mode == "head":
        cmd, intent = f"head -n {int(n)} {q}", "show file"
        why.append(f"first {int(n)} lines")
    elif mode == "tail":
        cmd, intent = f"tail -n {int(n)} {q}", "show file"
        why.append(f"last {int(n)} lines")
    elif mode == "follow":
        cmd, intent = f"tail -f {q}", "show file"
        why.append("follow new lines (Ctrl-C stops)")
    elif mode == "edit":
        intent = "edit"
        if program:
            cmd = f"{program[0]} {q}"
            reqs.append(program)
            why.append(f"with {program[0]}")
        else:
            editor, label = default_editor()
            cmd = f"{editor} {q}"
            why.append(label)
    elif mode == "program":
        cmd, intent = f"{program[0]} {q}", "open"
        why.append(f"with {program[0]}")
    elif verb == "open" and (not is_text(os.path.join(u.cwd, os.path.expanduser(path)))
                             or re.search(BINARY_EXT, path.lower())):
        intent = "open"
        if shutil.which("xdg-open") and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            cmd = f"xdg-open {q}"
            why.append("with the default app")
        else:
            cmd = f"ls -l -- {q}"
            why.append("no desktop session to open it in; showing the file instead")
    else:
        long = line_count(os.path.join(u.cwd, os.path.expanduser(path))) > 200
        cmd, intent = (f"less -FRX {q}", "show file") if long else (f"cat {q}", "show file")
        if long:
            why.append("long file, paged")
    plan = finish(u, Plan(cmd, intent, [path] + why, confidence=conf))
    return require(plan, reqs)


def is_text(path: str) -> bool:
    try:
        with open(path, "rb") as f:
            return b"\0" not in f.read(4096)
    except OSError:
        return False


def line_count(path: str) -> int:
    try:
        with open(path, "rb") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0


def quote_glob(pattern: str) -> str:
    """Quote everything in a glob except * and ?: 'old report*' -> 'old report'*."""
    return "".join(p if p in ("*", "?") else shlex.quote(p) for p in re.split(r"([*?])", pattern) if p)


def resolve_sources(u: Utterance, text: str) -> list[str] | None:
    """Words like "a.txt and b.txt" or "all the pdfs" -> paths/globs."""
    out = []
    for item in split_items(text):
        sub = Utterance(item, u.cwd, u.literals)
        item_lit = u.lit(item.strip())
        direct = resolve(item_lit, u.cwd)
        if direct:
            out.append(qpath(direct))
            continue
        if re.search(r"[*?]", item_lit) and globmod.glob(os.path.join(u.cwd, os.path.expanduser(item_lit))):
            out.append(quote_glob(item_lit))
            continue
        spec = FindSpec()
        take_ext(sub, spec)
        take_types(sub, spec)
        if spec.exts and not sub.leftover():
            globs = [f"*.{e}" for e in spec.exts if globmod.glob(os.path.join(u.cwd, f"*.{e}"))]
            if not globs:
                return None
            out += globs
            continue
        return None
    return out or None


def clean_dest(u: Utterance, text: str) -> tuple[str, float]:
    """'src and then list src' -> ('src', 0.5); 'qlit0 please' -> ('qlit0', 1.0)."""
    conf = 1.0
    parts = re.split(r"\s+(?:and|then)\s+|\s*[,;]\s*", text.strip(), maxsplit=1)
    if len(parts) > 1:
        text, conf = parts[0], 0.5           # a second instruction: the rules can't do both
    text = re.sub(r"\s+(?:please|now|thanks|thank\s+you|pls)\s*$", "", text.strip())
    words = text.split()
    if len(words) > 1 and not re.fullmatch(r"(?:the|my|a|an)\s+\S+(?:\s+(?:folder|directory|dir))?", text):
        conf = min(conf, 0.5)                # "old logs.txt": a name with a space, or two things?
    return text, conf


def resolve_dest(u: Utterance, text: str) -> str:
    text = text.strip()
    sub = Utterance(text, u.cwd, u.literals)
    spec = FindSpec()
    spec.root = ""
    take_location(sub, spec)
    if spec.root:
        return spec.root
    t = " ".join(u.lit(w) for w in text.split())
    t = re.sub(r"^(?:the|my|a|an)\s+", "", t)
    t = re.sub(r"\s+(?:folder|directory|dir)$", "", t)
    path = resolve(t, u.cwd, "dir")
    return path or t


def is_trash(dest_text: str, cwd: str) -> bool:
    """'the trash', 'the recycle bin' (unless a folder of that name is right here)."""
    word = re.sub(r"^(?:the|my)\s+", "", dest_text.strip().lower())
    return bool(re.fullmatch(r"trash(?:\s+can)?|recycle\s*bin|bin|wastebasket|rubbish(?:\s+bin)?", word)) and \
        not os.path.isdir(os.path.join(cwd, word))


def trash_tool() -> str:
    return first_available([("gio", "gio trash --"), ("trash-put", "trash-put --"),
                            (None, "mv -i -t ~/.local/share/Trash/files --")])


def bulk_transfer(u: Utterance, spec: FindSpec, tool: str, dest_text: str, left: Utterance,
                  guessed: int = 0) -> Plan:
    """find the matching files and mv/cp them into a folder, after a preview."""
    if tool == "mv" and is_trash(dest_text, u.cwd):
        u.text = " " * len(u.text)
        spec.ftype = spec.ftype or "f"
        tool_ = trash_tool()
        mk = "mkdir -p ~/.local/share/Trash/files && " if tool_.startswith("mv ") else ""
        plan = Plan(mk + render_find(spec, "exec:" + tool_), "trash", [where_label(spec, True)] + spec.why,
                    destructive=True, preview=render_find(spec, "list"),
                    warning="! moves the files listed above to the trash")
        return finish(left, plan, guessed, spec)
    dest = resolve_dest(u, dest_text)
    u.text = " " * len(u.text)
    spec.ftype = spec.ftype or "f"
    if not dest.startswith(("/", "~")):
        spec.exclude.append(f"./{dest.strip('./')}/*" if spec.root == "." else f"*/{dest.strip('./')}/*")
    if spec.sort and spec.limit:         # "move the oldest log": only that one
        cmd = render_find(spec, "top0") + f" | xargs -0 -r {tool} -i -t {qpath(dest)} --"
    else:
        cmd = render_find(spec, f"exec:{tool} -i -t {qpath(dest)} --")
    if not os.path.isdir(os.path.join(u.cwd, os.path.expanduser(dest))):
        cmd = f"mkdir -p -- {qpath(dest)} && {cmd}"
    plan = Plan(cmd, "move" if tool == "mv" else "copy",
                [where_label(spec, True)] + spec.why + [f"→ {dest}", "asks before overwriting"],
                destructive=True, preview=render_find(spec, "list"),
                warning=f"! {'moves' if tool == 'mv' else 'copies'} the files listed above into {dest}")
    return finish(left, plan, guessed, spec)


def h_find_then(u: Utterance) -> Plan | None:
    """'find logs older than 2 months and move them to old/'"""
    m = u.peek(r"^(.*?)\s+(?:and|then)\s+(?:also\s+)?(move|copy)\s+(?:them|those|these|it|all\s+of\s+them|"
               r"the\s+results?)\s+(?:to|into|in|inside)\s+(.+)$")
    if not m:
        return None
    left = Utterance(u.o(m, 1), u.cwd, u.literals)
    if not left.take(FIND_VERB) and not left.take(r"\b(?:list|show|get)\b"):
        return None
    spec = FindSpec()
    parse_filters(left, spec)
    guessed = absorb_keywords(left, spec, "any")
    if not spec.narrowed():
        return None   # "find files and move them" would move everything
    dest_text, dconf = clean_dest(u, u.o(m, 3))
    plan = bulk_transfer(u, spec, "mv" if m.group(2) == "move" else "cp", dest_text, left, guessed)
    plan.confidence *= dconf
    return plan


def h_copy_move(u: Utterance) -> Plan | None:
    if u.peek(r"^\s*(?:copy|move|duplicate|rename)\s+(?:the\s+)?(?:folder|directory|dir|file)\s+\S+\s+(?:to|into|as)\b"):
        u.take(r"\b(?:the\s+)?(?:folder|directory|dir|file)\b")       # "copy the folder run1 to backup"
    m = u.peek(r"\b(copy|cp|duplicate|move|mv|rename|put|throw|stick|chuck|toss)\s+(.+?)\s+(?:to|into|in|as|inside|over\s+to)\s+(.+)$")
    mc = u.peek(r"\b(?:(?:make|create)\s+a\s+copy\s+of|^\s*duplicate)\s+(\S+)(?:\s+(?:called|named|as)\s+(\S+))?\s*$")
    if mc:
        srcs = resolve_sources(u, u.o(mc, 1))
        if not srcs or len(srcs) != 1:
            return None
        u.text = " " * len(u.text)
        src = u.lit(u.o(mc, 1)) if not srcs[0].startswith("'") else srcs[0].strip("'")
        stem_, ext = os.path.splitext(src.rstrip("/"))
        dest = u.lit(u.o(mc, 2)) if mc.group(2) else f"{stem_}-copy{ext}"
        return Plan(f"cp -ai -- {qpath(src)} {qpath(dest)}", "copy", [f"{src} → {dest}"])
    mb = u.peek(r"\b(?:back\s*up|make\s+a\s+backup\s+of|create\s+a\s+backup\s+of)\s+(.+)$")
    if mb:
        srcs = resolve_sources(u, u.o(mb, 1))
        if not srcs or len(srcs) != 1 or re.search(r"[*?]", srcs[0]):
            return None
        u.text = " " * len(u.text)
        src = srcs[0]
        return Plan(f"cp -ai -- {src} {src}.bak", "backup", [f"copy {src} to {src}.bak"])
    if not m:
        return None
    verb = {"put": "move", "throw": "move", "stick": "move", "chuck": "move", "toss": "move"}.get(m.group(1), m.group(1))
    srcs = resolve_sources(u, u.o(m, 2))
    if not srcs and verb in ("copy", "cp", "move", "mv"):
        # "move all csv files older than a week to archive"
        left = Utterance(u.o(m, 2), u.cwd, u.literals)
        spec = FindSpec()
        parse_filters(left, spec)
        if spec.narrowed() and not left.leftover():
            dest_text, dconf = clean_dest(u, u.o(m, 3))
            plan = bulk_transfer(u, spec, "mv" if verb in ("move", "mv") else "cp", dest_text, left)
            plan.confidence *= dconf
            return plan
    dest_text, dconf = clean_dest(u, u.o(m, 3))
    dest = resolve_dest(u, dest_text)
    u.text = " " * len(u.text)
    conf = (1.0 if srcs else 0.4) * dconf
    srcs = srcs or [shlex.quote(u.lit(u.o(m, 2)))]
    if verb == "rename":
        cmd = f"mv -i -- {srcs[0]} {qpath(dest)}"
        return Plan(cmd, "rename", [f"{srcs[0]} → {dest}"], confidence=conf)
    dest_full = os.path.join(u.cwd, os.path.expanduser(dest))
    pre = ""
    if len(srcs) > 1 and not os.path.isdir(dest_full):
        pre = f"mkdir -p -- {qpath(dest)} && "
    if verb in ("copy", "cp", "duplicate"):
        rec = any(os.path.isdir(os.path.join(u.cwd, os.path.expanduser(s.strip("'")))) for s in srcs)
        cmd = f"{pre}cp -i{'r' if rec else ''} -- {' '.join(srcs)} {qpath(dest)}"
        intent = "copy"
    else:
        cmd = f"{pre}mv -i -- {' '.join(srcs)} {qpath(dest)}"
        intent = "move"
    return Plan(cmd, intent, [f"{', '.join(srcs)} → {dest}", "asks before overwriting"], confidence=conf)


SENSITIVE_ROOTS = {"/", "/home", "/usr", "/etc", "/var", "/boot", "/bin", "/sbin", "/lib", "/opt", "/srv", "/root"}


DESCRIPTORS = {"empty", "old", "hidden", "big", "large", "huge", "small", "tiny", "new", "tmp", "temp",
               "temporary", "unused", "broken", "duplicate", "useless", "extra", "last", "first", "other"}


def explicit_targets(u: Utterance) -> list | None:
    """Names the user gave: quoted or file-like words, dot files, or a word right
    before a singular 'file'/'folder'. [] if none; None if one cannot be found."""
    found, missing = [], False
    words = u.remaining()
    for i, (low, orig, start) in enumerate(words):
        nxt = words[i + 1][0] if i + 1 < len(words) else ""
        prev = words[i - 1][0] if i else ""
        lit = u.lit(orig)
        if prev in ("in", "from", "under", "inside", "within", "at", "on", "across"):
            continue                 # "... in ~/": a place to look, not a thing to delete
        named = (low.startswith("qlit") or re.fullmatch(r"\.[\w.-]+", lit)
                 or nxt in ("file", "folder", "directory", "dir"))
        if not named or low in FILLER or low in ("file", "folder", "directory", "dir"):
            continue
        want = {"folder": "dir", "directory": "dir", "dir": "dir", "file": "file"}.get(nxt)
        if not low.startswith("qlit") and low in DESCRIPTORS and not resolve(lit, u.cwd, want):
            continue                 # "the hidden file .env": describes it, is not its name
        if re.fullmatch(r"\.[a-z0-9]{1,8}", lit) and nxt == "files":
            continue                 # ".log files" is a type, not a name
        path = resolve(lit, u.cwd, want)
        if not path and "/" not in lit and (low.startswith("qlit") or lit.startswith(".")):
            hits = find_below(lit, u.cwd)
            path = hits[0] if len(hits) == 1 else None
        if path:
            found.append(path)
            u.blank(start, start + len(orig))
            if nxt in ("file", "folder", "directory", "dir"):
                u.take(rf"\b{nxt}\b")
        elif low.startswith("qlit") or nxt in ("file", "folder", "directory", "dir") or lit.startswith("."):
            missing = True
    if missing:
        return None
    return found


def h_delete(u: Utterance) -> Plan | None:
    to_trash = bool(u.take(r"\b(?:(?:in|into|to)\s+(?:the\s+)?(?:trash(?:\s+can)?|recycle\s*bin|wastebasket|rubbish\s+bin))\b")
                    or u.peek(r"^\s*trash\b"))
    if to_trash:
        u.take(r"\b(?:put|move|send|throw)\b")
    if not u.take(r"\b(?:delete|remove|rm|erase|trash|get\s+rid\s+of|clean\s+(?:up|out)|wipe|destroy|throw\s+(?:away|out))\b"):
        return None
    # "find X and delete them" / "delete all X you can find"
    u.take(r"\b(?:find|search\s+for|look\s+for|locate|track\s+down|hunt\s+for|list|show(?:\s+me)?|get)\b")
    u.take(r"\b(?:and|then)\s+(?:also\s+)?(?=\s*$)|\b(?:them|those|these|all\s+of\s+them|the\s+results?)\b")
    if u.peek(r"\b(?:packages?|programs?|software|kernels?|dependencies)\b"):
        return None
    singular = u.peek(r"\bthe\s+(?:\S+\s+){0,2}?(?:file|folder|directory|dir)\b(?!s)") and not u.peek(r"\b(?:all|every|each)\b")
    if u.peek(r"\b(?:except(?:\s+for)?|but(?:\s+not)?|other\s+than|apart\s+from|besides|save\s+for|keep(?:ing)?)\s+"
              r"(?:the\s+)?qlit\d+"):
        return None                    # "delete everything but report.pdf": report.pdf is the one to keep
    targets = explicit_targets(u)
    if targets is None:
        return None                    # a name that is not there: never guess
    home = os.path.expanduser("~")
    for t in targets or []:
        real = os.path.realpath(os.path.join(u.cwd, os.path.expanduser(t)))
        if real in SENSITIVE_ROOTS or real == home or real == os.path.realpath(u.cwd):
            return None                # never rm a home, system or the current folder from words
    if targets and to_trash:
        tool_ = trash_tool()
        mk = "mkdir -p ~/.local/share/Trash/files && " if tool_.startswith("mv ") else ""
        plan = finish(u, Plan(f"{mk}{tool_} " + " ".join(qpath(t) for t in targets), "trash", targets))
        plan.destructive = True
        return plan
    if targets:
        for _ in range(3):   # words describing what was named, not filters
            u.take(r"\b(?:" + "|".join(sorted(DESCRIPTORS)) + r"|files?|folders?|director(?:y|ies)|dirs?)\b")
        dirs = [t for t in targets if os.path.isdir(os.path.join(u.cwd, os.path.expanduser(t)))]
        cmd = f"rm{' -r' if dirs else ''} -- " + " ".join(qpath(t) for t in targets)
        plan = finish(u, Plan(cmd, "delete", targets))
        plan.destructive = True
        return plan
    if singular:
        return None                    # "delete the empty file": which one?
    spec = FindSpec()
    parse_filters(u, spec)
    if not spec.narrowed():
        return None  # never "delete everything under here" from a vague sentence
    root = os.path.realpath(os.path.join(u.cwd, os.path.expanduser(spec.root)))
    if (root in SENSITIVE_ROOTS or root == os.path.expanduser("~")) and not (spec.exts or spec.names or spec.content):
        return None
    # delete the exact words the user wrote, not their stems
    spec.content = [(c[0], c[3], f'"{c[3]}"', c[3]) if len(c) > 3 else c for c in spec.content]
    if spec.sort:
        if not spec.limit:
            return None                # "delete the largest files": how many?
        spec.ftype = spec.ftype or "f"
        top = render_find(spec, "top0")
        rm = "rm -r --" if spec.ftype == "d" else "rm --"
        plan = Plan(f"{top} | xargs -0 -r {rm}", "delete", [where_label(spec, True)] + spec.why,
                    preview=f"{top} | tr '\\0' '\\n'")
    elif to_trash:
        spec.ftype = spec.ftype or "f"
        tool_ = trash_tool()
        mk = "mkdir -p ~/.local/share/Trash/files && " if tool_.startswith("mv ") else ""
        plan = Plan(mk + render_find(spec, "exec:" + tool_), "trash", [where_label(spec, True)] + spec.why,
                    preview=render_find(spec, "list"), warning="! moves the files listed above to the trash")
    else:
        plan = Plan(render_find(spec, "delete"), "delete", [where_label(spec, True)] + spec.why,
                    preview=render_find(spec, "list"))
    plan = finish(u, plan, 0, spec)
    plan.destructive = True
    return plan


# "a markdown file called notes" -> notes.md
FILE_KIND_EXT = {"markdown": "md", "md": "md", "text": "txt", "txt": "txt", "python": "py", "shell": "sh",
                 "bash": "sh", "json": "json", "yaml": "yaml", "csv": "csv", "html": "html", "css": "css",
                 "javascript": "js", "js": "js", "typescript": "ts", "c": "c", "rust": "rs", "go": "go",
                 "java": "java", "ruby": "rb", "php": "php", "sql": "sql", "toml": "toml", "ini": "ini", "xml": "xml"}
CREATE_V = r"\b(?:create|make|new|add|touch|mk|generate|start)\s+(?:me\s+)?(?:a\s+|an\s+|the\s+|some\s+|two\s+|three\s+)?(?:new\s+)?(?:empty\s+|blank\s+)?"
CREATE_TAIL = (r"(?P<tail>\s+and\s+(?:go|cd|move|step|switch)\s+(?:in|into|to)\s+it|\s+and\s+enter\s+it|"
               r"\s+and\s+(?:open|edit)\s+it(?:\s+(?:in|with)\s+\S+)?|"
               r"\s+(?:with|containing|that\s+contains|that\s+says|saying)\s+(?:the\s+(?:text|line|words?)\s+)?(?P<content>.+?)(?:\s+in\s+it)?)?\s*$")


def h_create(u: Utterance) -> Plan | None:
    kinds = r"(?P<kind>folder|director(?:y|ie)|dir|file|doc|document)s?"
    ftype = r"(?:(?P<ftype>" + "|".join(FILE_KIND_EXT) + r")\s+)?"
    m = (u.peek(CREATE_V + ftype + kinds + r"\s+(?:called\s+|named\s+|with\s+the\s+name\s+)?(?P<names>.+?)" + CREATE_TAIL)
         or u.peek(CREATE_V + r"(?P<names>\S+(?:\s*(?:,|\band\b)\s*\S+)*)\s+" + ftype + kinds + CREATE_TAIL)
         or u.peek(r"\b(?:create|make|new|touch|mkdir|mk)\s+(?:a\s+|an\s+)?(?:new\s+)?(?:empty\s+)?(?P<names>qlit\d+)" + CREATE_TAIL))
    if not m:
        return None
    kind = (m.groupdict().get("kind") or "").replace("document", "file").replace("doc", "file")
    raw_names = []
    for item in split_items(u.o(m, "names")):          # names with spaces need quotes, as in bash
        words = item.split()
        if len(words) > 1 and words[0].lower() == "the":
            words = words[1:]
        raw_names += words
    names = [u.lit(w) for w in raw_names]
    if not names or len(names) > 8 or any(w.lower() in ("it", "them", "this", "that", "these", "those", "something", "one")
                                          for w in raw_names):
        return None
    if not kind:                         # "create testi.md": a name with an extension is a file
        if all(n.endswith("/") for n in names):
            kind = "folder"
        elif all(re.search(r"\.[A-Za-z0-9]{1,8}$", n) for n in names):
            kind = "file"
        else:
            return None
    ext = FILE_KIND_EXT.get((m.groupdict().get("ftype") or "").lower())
    if kind.startswith("file") and ext:
        names = [n if re.search(r"\.[A-Za-z0-9]{1,8}$", n) else f"{n}.{ext}" for n in names]
    tail = (m.groupdict().get("tail") or "").strip().lower()
    content = m.groupdict().get("content")
    u.text = " " * len(u.text)
    q = " ".join(qpath(n.rstrip("/") if kind != "file" else n) for n in names)
    if kind.startswith("file"):
        why = list(names)
        if content and len(names) == 1:
            text = " ".join(u.lit(w) for w in u.o(m, "content").split())
            plan = Plan(f"printf '%s\\n' {shlex.quote(text)} > {q}", "create file", why + [f'with "{text}"'], checked=True)
            if os.path.exists(os.path.join(u.cwd, os.path.expanduser(names[0]))):
                plan.destructive, plan.warning = True, f"! {names[0]} exists; this replaces its contents"
            return plan
        cmd = f"touch -- {q}"
        if re.match(r"and\s+(?:open|edit)\s+it", tail) and len(names) == 1:
            prog = re.search(r"(?:in|with)\s+(\S+)$", tail)
            editor = EDITORS.get(prog.group(1))[0] if prog and prog.group(1) in EDITORS else default_editor()[0]
            cmd += f" && {editor} {q}"
            why.append(f"and open it in {editor}")
        existing = [n for n in names if os.path.exists(os.path.join(u.cwd, os.path.expanduser(n)))]
        if existing:
            why.append(f"already exists: {', '.join(existing)} (touch only updates its time)")
        return Plan(cmd, "create file", why)
    if content:
        return None
    cmd = f"mkdir -p -- {q}"
    if tail and re.match(r"and\s+(?:go|cd|move|step|switch|enter)", tail) and len(names) == 1:
        cmd += f" && cd -- {qpath(names[0].rstrip('/'))}"
        return Plan(cmd, "create folder", names + ["and go into it"])
    return Plan(cmd, "create folder", names)


def h_chmod(u: Utterance) -> Plan | None:
    m = u.peek(r"\bmake\s+(.+?)\s+(executable|runnable|read[- ]?only|writable|writeable|private)\b")
    if not m:
        m = u.peek(r"\bgive\s+(.+?)\s+(execute|exec)\s+permissions?\b")
    if not m:
        return None
    srcs = resolve_sources(u, re.sub(r"^(?:all\s+)?(?:the\s+|my\s+)?", "", u.o(m, 1)))
    if not srcs:
        return None
    u.text = " " * len(u.text)
    mode = {"e": "+x", "r": "a-w", "w": "u+w", "p": "go-rwx"}[m.group(2)[0]]
    if m.group(2).startswith("run"):
        mode = "+x"
    return Plan(f"chmod {mode} -- {' '.join(srcs)}", "permissions", [f"{m.group(2)}: {mode}"])


def h_archive(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:make|create)\s+an?\s+(zip|tarball|archive|tar(?:\.gz)?)\s+(?:file\s+)?(?:of|from)\s+(.+?)"
               r"(?:\s+(?:called|named)\s+(\S+))?$")
    if not m:
        m = u.peek(r"\b(zip(?:\s+up)?|compress|archive|pack(?:\s+up)?|tar(?:\s+up)?)\s+(.+?)(?:\s+(?:into|as|to)\s+(\S+))?$")
    if m:
        what = re.sub(r"^(?:(?:of|up|the|my)\s+)+", "", u.o(m, 2))
        what = re.sub(r"\s+(?:folder|directory|dir)$", "", what)
        sub = Utterance(what, u.cwd, u.literals)
        spec = FindSpec()
        spec.root = ""
        take_location(sub, spec)
        src = spec.root or resolve(u.lit(what), u.cwd)
        if not src:
            return None
        u.text = " " * len(u.text)
        dest_given = (m.group(3) or "").lower()
        use_zip = (m.group(1).startswith("zip") and not re.search(r"\.(?:tar|tgz|gz|xz|bz2)", dest_given)) \
            or dest_given.endswith(".zip")
        zipper = "zip -r" if shutil.which("zip") else "python3 -m zipfile -c"
        if src in (".", "./"):
            base = os.path.basename(u.cwd.rstrip("/")) or "archive"
            dest = m.group(3) and u.lit(u.o(m, 3)) or f"../{base}" + (".zip" if use_zip else ".tar.gz")
            cmd = (f"{zipper} {qpath(dest)} ." if use_zip else
                   f"tar -czf {qpath(dest)} -C .. {shlex.quote(base)}")
        else:
            stemname = src.rstrip("/")
            dest = m.group(3) and u.lit(u.o(m, 3)) or stemname + (".zip" if use_zip else ".tar.gz")
            cmd = (f"{zipper} {qpath(dest)} {qpath(src)}" if use_zip else
                   f"tar -czf {qpath(dest)} {qpath(src)}")
        plan = Plan(cmd, "compress", [f"{src} → {dest}"])
        if os.path.exists(os.path.join(u.cwd, os.path.expanduser(dest))):
            plan.destructive, plan.warning = True, f"! replaces the existing {dest}"
        return plan
    m = u.peek(r"\b(?:extract|unzip|unpack|decompress|uncompress|untar|open\s+up)\s+(?:the\s+)?(\S+)"
               r"(?:\s+(?:archive|file|zip|tarball))?(?:\s+(?:to|into|in)\s+(\S+))?")
    if not m:
        return None
    src = resolve(u.lit(u.o(m, 1)), u.cwd, "file")
    if not src:
        return None
    u.text = " " * len(u.text)
    dest = resolve_dest(u, u.o(m, 2)) if m.group(2) else None
    low = src.lower()
    reqs = []
    if low.endswith(".zip"):
        if shutil.which("unzip"):
            cmd = f"unzip -n {qpath(src)}" + (f" -d {qpath(dest)}" if dest else "")   # -n: never overwrite
        else:
            cmd = f"python3 -m zipfile -e {qpath(src)} {qpath(dest or '.')}"
            clash = zip_clashes(os.path.join(u.cwd, os.path.expanduser(src)),
                                os.path.join(u.cwd, os.path.expanduser(dest or ".")))
            if clash:
                plan = Plan(cmd, "extract", [src, f"overwrites {len(clash)} existing file(s): {', '.join(clash[:3])}"],
                            destructive=True, warning="! overwrites existing files")
                return plan
    elif re.search(r"\.(tar(\.(gz|bz2|xz|zst))?|tgz|tbz2|txz)$", low):
        cmd = ((f"mkdir -p -- {qpath(dest)} && " if dest else "") + f"tar --keep-old-files -xf {qpath(src)}"
               + (f" -C {qpath(dest)}" if dest else ""))
    elif low.endswith(".gz"):
        cmd = f"gunzip -k {qpath(src)}"
    elif low.endswith(".7z"):
        cmd = f"7z x {qpath(src)}" + (f" -o{qpath(dest)}" if dest else "")
        reqs = [("7z", "p7zip-full")]
    elif low.endswith(".rar"):
        cmd = f"unrar x {qpath(src)}" + (f" {qpath(dest)}/" if dest else "")
        reqs = [("unrar", "unrar-free")]
    else:
        return None
    return require(Plan(cmd, "extract", [src] + ([f"into {dest}"] if dest else [])), reqs)


def zip_clashes(archive: str, dest: str) -> list[str]:
    import zipfile
    try:
        with zipfile.ZipFile(archive) as z:
            return [n for n in z.namelist() if not n.endswith("/") and os.path.exists(os.path.join(dest, n))]
    except (OSError, zipfile.BadZipFile):
        return []


def h_cd(u: Utterance) -> Plan | None:
    m = u.take(r"\b(?:go|cd|change\s+(?:directory|folder|dir)|move|switch|navigate|jump|take\s+me|step|enter|"
               r"open\s+(?:the\s+)?(?:folder|directory)|open(?=\s+(?:the\s+|my\s+)?\S+\s+(?:folder|directory|dir)\b))\b")
    if not m:
        return None
    if m.group(0) == "move" and not u.peek(r"^\s*(?:back|up|to|into|in)\b"):
        return None
    if u.take(r"\bback\b|\bprevious\s+(?:folder|directory|dir)\b"):
        return finish(u, Plan("cd -", "go", ["previous folder"]))
    if u.take(r"\bup(?:\s+one\s+level|\s+a\s+level|\s+one)?\b|\bparent(?:\s+(?:folder|directory|dir))?\b|\bone\s+level\s+up\b"):
        return finish(u, Plan("cd ..", "go", ["parent folder"]))
    if u.take(r"\bhome\b"):
        return finish(u, Plan("cd ~", "go", ["home"]))
    u.take(r"\b(?:to|into|in)\b")
    u.take(r"\b(?:folder|directory|dir)\b")
    path, _ = first_target(u, "dir")
    if not path:
        return None
    return finish(u, Plan(f"cd -- {qpath(path)}", "go", [path]))


def h_pwd(u: Utterance) -> Plan | None:
    if u.take(r"\b(?:where\s+am\s+i|current\s+(?:directory|folder|path|location)|which\s+(?:folder|directory)\s+am\s+i\s+in|"
              r"present\s+working\s+directory|what\s+(?:folder|directory)\s+is\s+this|pwd)\b"):
        return finish(u, Plan("pwd", "where am I"))
    return None


