def is_pathlike(tok: str) -> bool:
    return (tok == ".." or bool(re.search(r"[/~*?]", tok))
            or bool(re.fullmatch(r"[\w.+-]*[A-Za-z_][\w-]*\.[A-Za-z0-9]{1,8}", tok)))


def resolve(tok: str, cwd: str, want: str | None = None) -> str | None:
    """Turn a word into a real path, as the user would type it.

    want: "dir", "file" or None. Tries the literal path, then a
    case-insensitive match in cwd ("readme" -> README.md), then the usual
    home folders ("downloads" -> ~/Downloads).
    """
    if not tok:
        return None
    full = os.path.expanduser(tok)
    if not os.path.isabs(full):
        full = os.path.join(cwd, full)

    def ok(path):
        if want == "dir":
            return os.path.isdir(path)
        if want == "file":
            return os.path.isfile(path)
        return os.path.exists(path)

    if ok(full):
        return tok
    if "/" not in tok:
        try:
            entries = os.listdir(cwd)
        except OSError:
            entries = []
        low = tok.lower()
        for match in ([e for e in entries if e.lower() == low],
                      [e for e in entries if os.path.splitext(e)[0].lower() == low]):
            match = [e for e in match if ok(os.path.join(cwd, e))]
            if len(match) == 1:
                return match[0]
        if want in ("dir", None) and low in XDG_DIRS:
            return "~/" + XDG_DIRS[low]
    return None


