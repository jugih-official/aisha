def _one_file(u: Utterance) -> str | None:
    """The first remaining word that is an existing regular file here. Blanks it."""
    for low, orig, start in u.remaining():
        tok = u.lit(orig)
        if os.path.isfile(os.path.join(u.cwd, os.path.expanduser(tok))):
            u.blank(start, start + len(orig))
            return tok
    return None


GREP_FILE_V = re.compile(r"\b(?:search(?:es|ing)?|find|look(?:ing)?\s+for|grep|seek|which\s+lines|lines?\s+(?:with|containing|that|without|not|of|in)|without|"
                         r"contain(?:s|ing)?|mention(?:s|ing)?|count|how\s+many|number\s+of|occurrences?|appear(?:s)?|excluding)\b")
GREP_FILE_NOT = re.compile(r"\b(?:replace|delete|remove|sort|edit|open|copy|move|rename|first|last|top|bottom|follow|watch|"
                           r"line\s+\d+|lines\s+\d+|duplicates?|columns?|fields?|json|csv)\b")


def h_grep_file(u: Utterance) -> Plan | None:
    """Search inside ONE file, with any mix of options in any order: case sensitive
    or not, whole word, count, lines without, context."""
    if not GREP_FILE_V.search(u.low) or GREP_FILE_NOT.search(u.low):
        return None
    for low, orig, start in u.remaining():
        if os.path.isfile(os.path.join(u.cwd, os.path.expanduser(u.lit(orig)))):
            if re.search(r"\b(?:for|named|called|file)\s+$", u.low[:start]):
                return None                      # "search my home for report.pdf": looking for the file
            break
    path = _one_file(u)
    if not path:
        return None
    inv = bool(u.take(r"\b(?:that\s+)?(?:do(?:es)?\s*n[o']t|does\s+not|do\s+not)\s+(?:contain|have|mention|include)\b|"
                      r"\bnot\s+(?:containing|including|mentioning|matching|having)\b|\bwithout\b|\bexcluding\b|\bexcept\b|\bexclude\b"))
    case = bool(u.take(r"\bcase[- ]?sensitive(?:ly)?\b|\b(?:matching|exact|same|respecting)\s+(?:the\s+)?case\b|\bexactly\b"))
    u.take(r"\b(?:ignoring|ignore|regardless\s+of)\s+(?:the\s+)?case\b|\bcase[- ]?insensitive(?:ly)?\b|\bany\s+case\b")
    word = bool(u.take(r"\b(?:as\s+a\s+)?whole\s+words?(?:\s+only)?\b|\b(?:the\s+)?exact\s+word\b|\bwords?\s+only\b"))
    u.take(r"\bwith\s+(?:the\s+)?line\s+numbers\b|\bline\s+numbers\b")
    cm = re.search(rf"\b{NUM}\s+lines?\s+(?:of\s+)?(?:context|around|before\s+and\s+after)\b", u.low)
    ctx = int(num(cm.group(1), 2)) if cm else 0
    if cm:
        u.take(rf"\b(?:with\s+)?{NUM}\s+lines?\s+(?:of\s+)?(?:context|around(?:\s+(?:it|them))?|before\s+and\s+after)\b")
    times = bool(u.take(r"\bhow\s+many\s+times\b|\boccurrences?\b|\binstances?\b|\bhow\s+often\b|\btimes\b"))
    count = times or bool(u.take(r"\bcount(?:s|ing)?\b|\bhow\s+many\b|\bnumber\s+of\b|\bmatches\b"))
    for rx in (r"\b(?:search(?:es|ing)?|find|look(?:ing)?\s+for|grep|seek|show|display|print|list|give|get|which|what)\b",
               r"\b(?:the\s+)?(?:lines?|rows?|text|word|string|phrase|term)\b",
               r"\b(?:contain(?:s|ing)?|mention(?:s|ing)?|appear(?:s)?|occur(?:s)?|with|having|have|has|that|does|do|is|are|"
               r"in|of|for|inside|within|from)\b"):
        while u.take(rx):
            pass
    left = [w for w in u.leftover() if w not in FILLER]
    if len(left) != 1 or left[0] in ("line", "lines", "word", "words", "character", "characters", "char", "chars",
                                     "byte", "bytes", "size", "count", "length", "unique", "distinct", "duplicate",
                                     "duplicates", "different", "empty", "blank", "here", "everywhere", "home", "computer"):
        return None
    for low, orig, start in u.remaining():
        if low == left[0]:
            u.blank(start, start + len(orig))
            term = u.lit(orig)
            break
    if count and not times and re.fullmatch(r"[a-z]{4,}s", term) and not term.endswith("ss"):
        term = term[:-1]                          # "number of errors": lines with "error"
    flags = ("v" if inv else "c" if count and not times else "o" if times else "n") + ("" if case else "i") + "F" + ("w" if word else "")
    ctxf = f" -C {ctx}" if ctx and not count else ""
    cmd = f"grep -{flags}{ctxf} -- {shlex.quote(term)} {qpath(path)}" + (" | wc -l" if times else "")
    why = [path, ("lines without " if inv else "") + f'"{term}"', "case sensitive" if case else "any case"]
    why += (["whole word"] if word else []) + (["count"] if count else []) + ([f"{ctx} lines of context"] if ctxf else [])
    return finish(u, Plan(cmd, "search in file", why))


def h_head_tail(u: Utterance) -> Plan | None:
    """The first or last N lines of a file, or following it, in any wording."""
    t = u.low
    if re.search(r"\b(?:common|frequen\w*|most|repeat\w*|longest|shortest|sorted|sort|unique|duplicates?|contain\w*|with|without|"
                 r"delete|remove|drop|insert|add|replace|change|edit|modified|changed|keys?|columns?|fields?)\b", t):
        return None
    follow = re.search(r"\bfollow(?:ing)?\b|\bwatch(?:ing)?\b|\bstream\b|\blive\b|\bkeep\s+(?:showing|printing|following)\b|"
                       r"\bas\s+it\s+grows\b|\bnew\s+lines\b|\breal[- ]?time\b", t)
    head = re.search(r"\b(?:first|top|beginning|start|opening|head|begin)\b", t)
    tail = re.search(r"\b(?:last|final|bottom|end|tail|latest|ending)\b", t)
    if not (follow or ((head or tail) and re.search(r"\blines\b|\b\d+\s+line\b|\bhead\b|\btail\b", t))):
        return None
    path = _one_file(u)
    if not path:
        return None
    nm = re.search(rf"\b{NUM}\s+(?:first\s+|last\s+|final\s+|top\s+|bottom\s+)?lines?\b|\b(?:first|last|top|bottom|final)\s+{NUM}\b", t)
    n = int(num(next((g for g in nm.groups() if g), None), 10)) if nm else 10
    if follow:
        cmd, why = f"tail -f {qpath(path)}", ["follow new lines (Ctrl-C to stop)"]
    elif head and not tail:
        cmd, why = f"head -n {n} {qpath(path)}", [f"first {n} lines"]
    elif tail and not head:
        cmd, why = f"tail -n {n} {qpath(path)}", [f"last {n} lines"]
    else:
        return None
    u.text = " " * len(u.text)
    return Plan(cmd, "lines", [path] + why)


def h_exec_bit(u: Utterance) -> Plan | None:
    """Make a file executable, in any wording."""
    t = u.low
    if not re.search(r"\bexecutable\b|\bexecut(?:e|ion)\s+(?:permissions?|rights?|bit|flag)\b|\bexec\s+bit\b|\brunnable\b|"
                     r"\ballow\s+(?:running|to\s+run|execution)\b|\bpermission\s+to\s+(?:run|execute)\b", t):
        return None
    if re.search(r"\b(?:not|non|remove|take\s+away|without|un|drop|revoke|no\s+longer)\b|\bwhich\b|\bfind\b|\blist\b|\bis\b", t):
        return None
    path = _one_file(u)
    if not path:
        return None
    u.text = " " * len(u.text)
    return Plan(f"chmod +x -- {qpath(path)}", "permissions", [path, "add execute permission"], destructive=False)


def h_procs(u: Utterance) -> Plan | None:
    """Process lists in any wording: whose (mine, a user's), sorted by memory or CPU,
    how many. Kill, count, tree, threads, swap and ports have their own rules."""
    t = u.low
    if not re.search(r"\b(?:process(?:es)?|programs|tasks)\b", t) or re.search(
            r"\b(?:kill|stop|end|terminate|quit|close|signal|pause|resume|freeze|count|how\s+many|number\s+of|threads?|swap|tree|zombies?|ports?|"
            r"forest|parent|children|limit|nice|priority)\b", t):
        return None
    mine = re.search(r"\bmy\b|\bmine\b|\bi\s+(?:own|run|started|am\s+running)\b|\bcurrent\s+user\b|\bof\s+(?:me|myself)\b", t)
    um = re.search(r"\b(?:of|owned\s+by|by|for|from)\s+(?:the\s+)?user\s+([a-z_][\w.-]*)\b|\buser\s+([a-z_][\w.-]*)'s\b", t)
    key = "mem" if re.search(r"\b(?:memory|ram|mem)\b", t) else "cpu" if re.search(r"\b(?:cpu|processor)\b", t) else None
    if not (mine or um or key or re.search(r"\b(?:top|sort(?:ed)?|order(?:ed)?|list|show|running|all)\b", t)):
        return None
    nm = re.search(r"\btop\s+(\d+)\b|\b(\d+)\s+(?:top|biggest|heaviest)\b", t)
    n = int(nm.group(1) or nm.group(2)) if nm else 10
    sort = f"--sort=-%{key or 'cpu'}"
    if mine or um:
        who = '"$USER"' if mine else shlex.quote(um.group(1) or um.group(2))
        cmd = f"ps -u {who} -o pid,%cpu,%mem,etime,cmd {sort}"
        why = ["current user" if mine else f"user {who}", f"by {key or 'cpu'}"]
    else:
        cmd = f"ps aux {sort} | head -n {n + 1}"
        why = [f"top {n} by {'memory' if key == 'mem' else 'CPU'}"]
    u.text = " " * len(u.text)
    return Plan(cmd, "processes", why)


def h_reach(u: Utterance) -> Plan | None:
    """A remote host, in any wording: ping it (N times), check a TCP port, scan its
    ports, trace the route, look up its address. ping has no ports, so "ping X on
    port 50" is a TCP connect test."""
    t0 = u.raw.strip().rstrip("?!. ")
    t = t0.lower()
    m = re.search(rf"(?<![\w./@-]){HOST_RX}(?::(?P<hp>\d{{1,5}}))?(?![\w/@-])", t)
    if not m or re.search(r"\b(?:ssh|scp|log\s*in|login|sftp)\b|@|^\s*connect\s+to\b", t):
        return None
    host = m.group("host")
    orig = t0[m.start("host"):m.end("host")]
    if (os.path.exists(os.path.join(u.cwd, orig)) or os.path.exists(os.path.join(u.cwd, host))
            or host.rsplit(".", 1)[-1] in FILE_LIKE_TLDS):
        return None                              # README.md, notes.txt: files, not hosts
    rest = (t[:m.start()] + " " + t[m.end():]).strip()
    words = set(re.findall(r"[a-z]+", rest))
    pm = re.search(r"\bports?\s+(?:number\s+)?(\d{1,5})\b|\b(\d{1,5})\s+port\b", rest)
    port = m.group("hp") or (pm.group(1) or pm.group(2) if pm else None)
    qh = shlex.quote(host)
    if re.search(r"\bport\s*scan\b|\bscan\b.*\bports?\b|\bscan\b|\b(?:which|what|open|all)\s+ports\b|\bports\s+(?:are\s+)?open\b", rest) and not port:
        cmd = first_available([("nmap", f"nmap {qh}"),
                               (None, f"for p in {COMMON_PORTS}; do timeout 1 bash -c \"</dev/tcp/{host}/$p\" 2>/dev/null "
                                      f"&& echo \"$p open\"; done")])
        plan = Plan(cmd, "port scan", [host, "nmap" if cmd.startswith("nmap") else "common ports, TCP connect"])
    elif port and (words & {"ping", "reach", "reachable", "open", "check", "test", "connect", "connection", "listening",
                            "available", "is", "can", "telnet", "nc", "port", "up", "accessible", "respond", "responding"}):
        cmd = (f"timeout 3 bash -c '</dev/tcp/{host}/{port}' 2>/dev/null && echo '{host}:{port} is open' "
               f"|| echo '{host}:{port} is closed or filtered'")
        why = [f"{host}:{port}", "TCP connect test"] + (["ping has no ports"] if "ping" in words else [])
        plan = Plan(cmd, "port check", why)
    elif re.search(r"\btrace(?:route|path)?\b|\broute\s+to\b|\bpath\s+to\b|\bhops?\b", rest):
        cmd = first_available([("tracepath", f"tracepath {qh}"), ("traceroute", f"traceroute {qh}"),
                               ("mtr", f"mtr -r -c 3 {qh}"), (None, f"tracepath {qh}")])
        plan = Plan(cmd, "trace route", [host])
    elif re.search(r"\bdns\b|\blook\s*up\b|\bresolve\b|\bip(?:\s+address)?\b|\baddress\s+of\b", rest) and not re.search(r"\d", host[-1:]):
        plan = Plan(f"getent ahosts {qh} | awk '{{print $1}}' | sort -u", "dns", [host])
    elif re.search(r"\bping(?:s|ed)?\b|\bpackets?\b|\balive\b|\b(?:up|down|online|offline|reachable|responding)\b|"
                   r"\bansw(?:er|ers|ering)\b|\brespond(?:s|ing)?\b|\breach\b", rest):
        if re.fullmatch(r"ping", rest):
            return None                          # "ping HOST" as typed: bash's ping, until Ctrl-C
        nm = re.search(rf"\b{NUM}\s+(?:times|pings|packets|tries|echo(?:es)?)\b|\bwith\s+{NUM}\s+packets\b|\bsend\s+{NUM}\s+pings?\b|"
                       r"\b(once|one\s+time)\b", rest)
        n = 3
        if nm:
            g = next((x for x in nm.groups() if x), None)
            n = 1 if g in ("once", "one time") else int(num(g, 3))
        plan = Plan(f"ping -c {n} {qh}", "ping", [host, f"{n} packet{'s' if n != 1 else ''}"])
    else:
        return None
    u.text = " " * len(u.text)
    return plan


def h_recipe(u: Utterance) -> Plan | None:
    best = None
    text = Utterance(u.raw, u.cwd).text
    for r in RECIPES:
        if not any(p.search(text) for p in r.patterns):
            continue                     # cheap pre-check; most recipes stop here
        uu = Utterance(u.raw, u.cwd)
        try:
            plan = _apply_recipe(r, uu)
        except (ValueError, KeyError, IndexError, re.error, OSError):
            continue
        if plan:
            plan = finish(uu, plan)
            if best is None or plan.confidence > best.confidence:
                best = plan
    return best


# ---- USB drives --------------------------------------------------------------------
# aisha looks at the drives itself (lsblk) so commands name the real device.
# Only drives whose transport is USB are touched, never the boot disk.

def usb_drives() -> list[dict]:
    """[{dev, size, model, label, parts: [{dev, fstype, label, mount, size}]}] for USB disks."""
    try:
        r = subprocess.run(["lsblk", "-J", "-o", "NAME,PATH,SIZE,TRAN,TYPE,MOUNTPOINT,FSTYPE,LABEL,MODEL"],
                           capture_output=True, text=True, timeout=10)
        data = json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []
    for d in data.get("blockdevices", []):
        if d.get("type") != "disk" or (d.get("tran") or "").lower() != "usb":
            continue
        parts = [{"dev": c.get("path") or "/dev/" + c["name"], "fstype": c.get("fstype") or "",
                  "label": c.get("label") or "", "mount": c.get("mountpoint") or "", "size": c.get("size") or ""}
                 for c in d.get("children") or [] if c.get("type") == "part"]
        if any(p["mount"] in ("/", "/boot", "/boot/efi", "/usr", "/home") for p in parts) or \
                d.get("mountpoint") in ("/", "/boot", "/usr", "/home"):
            continue                     # the system lives here: never offer it
        out.append({"dev": d.get("path") or "/dev/" + d["name"], "size": d.get("size") or "",
                    "model": (d.get("model") or "USB drive").strip(), "label": d.get("label") or "",
                    "parts": parts, "mount": d.get("mountpoint") or "", "fstype": d.get("fstype") or ""})
    return out


USB_LIST = ("lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,MODEL $(lsblk -dno PATH,TRAN | awk '$2==\"usb\"{print $1}') "
            "2>/dev/null | grep . || echo 'no USB drives connected'")
USB_WORD = (r"(?:usb|thumb\s*drive|flash\s*drive|pen\s*drive|memory\s+stick|usb\s+(?:stick|drive|disk|key)|"
            r"external\s+(?:drive|disk)|stick)")
FS_TYPES = {  # wording -> (mkfs command, Debian package, label option)
    "ntfs": ("mkfs.ntfs -f", "ntfs-3g", "-L"), "fat32": ("mkfs.vfat -F 32", "dosfstools", "-n"),
    "vfat": ("mkfs.vfat -F 32", "dosfstools", "-n"), "fat": ("mkfs.vfat -F 32", "dosfstools", "-n"),
    "exfat": ("mkfs.exfat", "exfatprogs", "-n"), "ext4": ("mkfs.ext4 -F", "e2fsprogs", "-L"),
    "linux": ("mkfs.ext4 -F", "e2fsprogs", "-L"), "windows": ("mkfs.ntfs -f", "ntfs-3g", "-L"),
}


def pick_usb(u: Utterance, drives: list[dict]) -> tuple[dict | None, str]:
    """The drive the user means: named by device or label, or the only one."""
    for d in drives:
        names = {os.path.basename(d["dev"]).lower(), d["dev"].lower(), d["label"].lower()}
        names |= {os.path.basename(p["dev"]).lower() for p in d["parts"]}
        names |= {p["label"].lower() for p in d["parts"] if p["label"]}
        names.discard("")
        for low, orig, _ in u.remaining():
            if u.lit(orig).lower() in names:
                return d, ""
    if len(drives) == 1:
        return drives[0], ""
    if not drives:
        return None, "no USB drive is connected"
    return None, "several USB drives: say which (" + ", ".join(
        f"{os.path.basename(d['dev'])} {d['model']} {d['size']}" for d in drives) + ")"


def h_usb(u: Utterance) -> Plan | None:
    if not shutil.which("lsblk"):
        return None
    if not u.peek(rf"\b{USB_WORD}s?\b"):
        # "eject KINGSTON", "format sdb1 to ntfs": a USB drive named by label or device
        if not u.peek(r"\b(?:eject|unmount|umount|unmoun|dismount|mount|format|reformat|safely\s+remove)\b"):
            return None
        drives = usb_drives()
        if not drives or pick_usb(u, drives)[0] is None or (len(drives) == 1 and not any(
                u.lit(o).lower() in ({os.path.basename(drives[0]["dev"]), drives[0]["label"].lower()}
                                     | {os.path.basename(x["dev"]) for x in drives[0]["parts"]}
                                     | {x["label"].lower() for x in drives[0]["parts"]}) for _, o, _ in u.remaining())):
            return None
    text = u.text
    action = None
    if re.search(r"\b(?:format|reformat|initiali[sz]e|wipe|erase)\b", text):
        action = "format"
    elif re.search(r"\b(?:eject|safely\s+remove|remove\s+safely|unplug|power\s+off|disconnect)\b", text):
        action = "eject"
    elif re.search(r"\b(?:unmount|umount|unmoun|dismount)\b", text):
        action = "unmount"
    elif re.search(r"\bmount\b", text):
        action = "mount"
    elif re.search(r"\b(?:free|space|left|full|usage|capacity|room)\b", text):
        action = "space"
    elif re.search(r"\b(?:list|show|connected|plugged|attached|which|what|all|any|detect|see|devices?|drives?|sticks?|info)\b", text):
        action = "list"
    if not action:
        return None
    if action == "list":
        u.text = " " * len(u.text)
        cmd = USB_LIST + "; echo; " + first_available([("lsusb", "lsusb"),
                                                       (None, "cat /sys/bus/usb/devices/*/product 2>/dev/null")])
        return Plan(cmd, "usb", ["USB drives, then all USB devices"])
    drives = usb_drives()
    d, problem = pick_usb(u, drives)
    u.text = " " * len(u.text)
    if not d:
        return Plan(USB_LIST, "usb", [problem])
    name = f"{os.path.basename(d['dev'])} ({d['model']}, {d['size']})"
    parts = d["parts"] or [{"dev": d["dev"], "fstype": d["fstype"], "label": d["label"], "mount": d["mount"],
                            "size": d["size"]}]
    mounted = [p for p in parts if p["mount"]]
    udisks = shutil.which("udisksctl")
    show = f"lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT {d['dev']}"
    if action == "space":
        if not mounted:
            return Plan(show, "usb", [name, "not mounted: say 'mount the usb' first"])
        return Plan("df -h " + " ".join(shlex.quote(p["mount"]) for p in mounted), "usb", [f"free space on {name}"])
    if action == "mount":
        todo = [p for p in parts if not p["mount"] and p["fstype"]]
        if not todo:
            return Plan(show, "usb", [name, "already mounted"])
        cmd = " && ".join((f"udisksctl mount -b {p['dev']}" if udisks else
                           f"sudo mkdir -p /media/$USER/{os.path.basename(p['dev'])} && "
                           f"sudo mount {p['dev']} /media/$USER/{os.path.basename(p['dev'])}") for p in todo)
        return Plan(cmd, "usb", [f"mount {name}"])
    unmount = [(f"udisksctl unmount -b {p['dev']}" if udisks else f"sudo umount {p['dev']}") for p in mounted]
    if action == "unmount":
        if not unmount:
            return Plan(show, "usb", [name, "nothing is mounted"])
        return Plan(" && ".join(unmount), "usb", [f"unmount {name}"])
    if action == "eject":
        power = f"udisksctl power-off -b {d['dev']}" if udisks else f"echo '{name} can be unplugged now'"
        return Plan(" && ".join(unmount + ["sync", power]), "usb", [f"unmount and power off {name}"],
                    destructive=True, warning=f"! ejects {name}; close files on it first")
    fs = next(((w, spec) for w, spec in FS_TYPES.items() if re.search(rf"\b{w}\b", u.low)), None)
    if not fs:
        return Plan(show, "usb", [name, "format to what? say ntfs, fat32, exfat or ext4"], confidence=0.9)
    word, (mkfs, pkg, label_opt) = fs
    if len(parts) != 1:
        return Plan(show, "usb", [name, f"has {len(parts)} partitions; aisha only formats a drive with one"],
                    confidence=0.9)
    target = parts[0]["dev"]
    label = ""
    lab = re.search(r"\b(?:called|named|label(?:led)?|with\s+(?:the\s+)?(?:name|label))\s+(\S+)", u.low)
    if lab:
        raw = u.lit(u.orig[lab.start(1):lab.end(1)])
        label = f" {label_opt} {shlex.quote(raw[:11] if 'vfat' in mkfs else raw[:32])}"
    steps = [(f"udisksctl unmount -b {p['dev']}" if udisks else f"sudo umount {p['dev']}") for p in mounted]
    steps.append(f"sudo {mkfs}{label} {target}")
    plan = Plan(" && ".join(steps), "format usb", [f"{target} on {name}", f"as {word.upper()}"], destructive=True,
                warning=f"! ERASES EVERYTHING on {target} ({d['model']}, {d['size']}) and makes it {word.upper()}")
    return require(plan, [(mkfs.split()[0], pkg)])



# ---- git, in plain words ----------------------------------------------------------------
# One handler for the whole of everyday git. It reads the repository's own branches,
# remotes and tags, so "merge dev" knows dev is a branch, and it picks the pieces out of
# the sentence (refs, files, a message, a count) instead of matching fixed phrases.
# Anything that throws work away or rewrites history asks [y/N].

def git_dir(cwd: str) -> str | None:
    d = cwd
    while True:
        g = os.path.join(d, ".git")
        if os.path.isdir(g):
            return g
        if os.path.isfile(g):                      # worktrees and submodules: "gitdir: path"
            try:
                with open(g) as f:
                    line = f.read().strip()
                if line.startswith("gitdir:"):
                    p = line[7:].strip()
                    return p if os.path.isabs(p) else os.path.normpath(os.path.join(d, p))
            except OSError:
                return None
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


_GIT_REFS_CACHE: dict = {}


def git_refs(cwd: str) -> dict:
    """{'branches', 'remote_branches', 'remotes', 'tags'} of the repository at cwd (cached for 2 s)."""
    key = git_dir(cwd) or cwd
    hit = _GIT_REFS_CACHE.get(key)
    if hit and time.time() - hit[0] < 2:
        return hit[1]
    out = _git_refs(cwd)
    _GIT_REFS_CACHE[key] = (time.time(), out)
    return out


def _git_refs(cwd: str) -> dict:
    out = {"branches": set(), "remote_branches": set(), "remotes": set(), "tags": set()}
    if not shutil.which("git"):
        return out
    try:
        r = subprocess.run(["git", "for-each-ref", "--format=%(refname)"], cwd=cwd, capture_output=True,
                           text=True, timeout=3)
        rr = subprocess.run(["git", "remote"], cwd=cwd, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return out
    for ref in r.stdout.split():
        if ref.startswith("refs/heads/"):
            out["branches"].add(ref[11:])
        elif ref.startswith("refs/remotes/") and not ref.endswith("/HEAD"):
            out["remote_branches"].add(ref[13:])
        elif ref.startswith("refs/tags/"):
            out["tags"].add(ref[10:])
    out["remotes"] = set(rr.stdout.split())
    return out


GIT_NUM = {"a": 1, "an": 1, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7,
           "eight": 8, "nine": 9, "ten": 10}
GIT_HASH = r"[0-9a-f]{7,40}"


def _gnum(s: str | None, default: int = 1) -> int:
    if not s:
        return default
    return int(s) if s.isdigit() else GIT_NUM.get(s, default)


def _git_since(when: str) -> str | None:
    w = when.strip().lower()
    w = re.sub(r"^(?:the\s+)?", "", w)
    m = re.fullmatch(r"(?:last|past)\s+(?:(\d+|a|an|one|two|three|four|five|six|seven)\s+)?(day|week|month|year|hour)s?", w)
    if m:
        return f"{_gnum(m.group(1))} {m.group(2)}{'s' if _gnum(m.group(1)) > 1 else ''} ago"
    m = re.fullmatch(r"(\d+|a|an|one|two|three)\s+(day|week|month|year|hour)s?(?:\s+ago)?", w)
    if m:
        return f"{_gnum(m.group(1))} {m.group(2)}{'s' if _gnum(m.group(1)) > 1 else ''} ago"
    if w in ("yesterday", "today", "midnight"):
        return "midnight" if w == "today" else w
    if w in ("this week",):
        return "1 week ago"
    if w in ("this month",):
        return "1 month ago"
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", w):
        return w
    m = re.fullmatch(r"(monday|tuesday|wednesday|thursday|friday|saturday|sunday)", w)
    if m:
        return f"last {w}"
    return None


def h_git(u: Utterance) -> Plan | None:
    raw = u.raw.strip().rstrip(" ?!.")
    if not raw or not shutil.which("git") or not git_dir(u.cwd):
        return None
    # typed git commands run as they are; "git undo the last commit" is words
    if re.match(r"git\s+(?:-\S+\s+)*[a-z-]+(?:\s+-|\s*$)", raw) and not re.match(
            r"git\s+(?:undo|uncommit|rollback|roll|go|show\s+me|what|which|how)\b", raw):
        return None
    low = " ".join(raw.lower().split())
    t = re.sub(r"^(?:git\s+|in\s+git\s*,?\s*|on\s+git\s*,?\s*)", "", low)
    t = re.sub(r"\s+(?:please|pls|for\s+me|now|thanks)$", "", t)
    traw = raw[len(raw) - len(t):] if raw.lower().endswith(t) else raw   # same text, original case
    refs = git_refs(u.cwd)
    branches, rbranches, remotes, tags = refs["branches"], refs["remote_branches"], refs["remotes"], refs["tags"]
    rawtok = {tok.lower(): tok for tok in re.findall(r"[\w./~@+^-]+", raw)}

    def orig(x):            # names keep the case they were typed in (README.md, Feature-X)
        return rawtok.get(x, x) if x else x
    current = git_branch(u.cwd)
    remote = "origin" if "origin" in remotes or not remotes else sorted(remotes)[0]
    gd = git_dir(u.cwd)

    def is_branch(b):
        b = orig(b)
        return bool(b) and (b in branches or b in rbranches or any(rb.endswith("/" + b) for rb in rbranches))

    def is_ref(x):
        x = orig(x)
        return bool(x) and (is_branch(x) or x in tags or re.fullmatch(GIT_HASH, x) or
                            re.fullmatch(r"head(?:~\d+|\^+)?", x.lower()) or x.upper() == "HEAD")

    def ref(x):
        x = orig(x)
        return "HEAD" + x[4:] if x.lower().startswith("head") else x

    def files_in(text):
        out = []
        for tok in re.findall(r"[\w./~@+-]+", text):
            if tok.lower() in ("git", "the", "a", "all", "file", "files", "changes", "my", "it", "this", "commit", "and"):
                continue
            tok = orig(tok)
            if os.path.exists(os.path.join(u.cwd, os.path.expanduser(tok))):
                out.append(tok)
        return out

    def message():
        m = re.search(r"\"([^\"]*)\"|'([^']*)'|“([^”]*)”", traw)
        if m:
            return next(g for g in m.groups() if g is not None)
        m = re.search(r"\b(?:message|msg|saying|that\s+says|described\s+as|with\s+the\s+text|titled|called|named)\s+(.+)$", traw, re.I)
        if m:
            return m.group(1).strip()
        m = re.search(r"\b(?:as|with)\s+(.+)$", traw, re.I)
        return m.group(1).strip() if m and not re.search(r"\b(?:all|everything|changes|files?)\s*$", m.group(1), re.I) else None

    def plan(cmd, why, change=False, warning=None, preview=None, conf=1.0):
        u.text = " " * len(u.text)
        p = Plan(cmd, "git", why if isinstance(why, list) else [why], destructive=change, warning=warning,
                 preview=preview, confidence=conf)
        if not change:
            p.checked = True
        return p

    q = shlex.quote
    in_merge = os.path.exists(os.path.join(gd, "MERGE_HEAD"))
    in_rebase = os.path.isdir(os.path.join(gd, "rebase-merge")) or os.path.isdir(os.path.join(gd, "rebase-apply"))
    in_pick = os.path.exists(os.path.join(gd, "CHERRY_PICK_HEAD"))

    # -- abort / continue whatever is in progress
    m = re.fullmatch(r"(?:abort|cancel|stop|quit|give\s+up(?:\s+on)?|undo|back\s+out\s+of|get\s+out\s+of)\s+(?:the\s+|this\s+|my\s+)?"
                     r"(merge|merging|rebase|rebasing|cherry[- ]?pick(?:ing)?)", t)
    if m:
        what = "merge" if m.group(1).startswith("merg") else "rebase" if m.group(1).startswith("rebas") else "cherry-pick"
        if what == "merge" and not in_merge:
            if t.startswith("undo"):
                return plan("git reset --keep ORIG_HEAD", ["no merge in progress: undo the last merge",
                            "back to before it, local changes kept"], change=True,
                            warning="! moves the branch back to before the last merge or pull")
            return plan("git status", "no merge is in progress, nothing to abort", conf=1.0)
        if what == "rebase" and not in_rebase:
            return plan("git status", "no rebase is in progress, nothing to abort", conf=1.0)
        return plan(f"git {what} --abort", f"abort the {what}: back to how it was before", change=True,
                    warning=f"! drops what the {what} has done so far")
    m = re.fullmatch(r"(?:continue|resume|finish|complete|conclude|go\s+on\s+with)\s+(?:the\s+|this\s+|my\s+)?(merge|rebase|cherry[- ]?pick)", t)
    if m:
        what = "merge" if m.group(1) == "merge" else "rebase" if m.group(1) == "rebase" else "cherry-pick"
        return plan(f"git {what} --continue", [f"continue the {what}", "after fixing the conflicts and staging the files"])
    if re.fullmatch(r"skip\s+(?:this|the\s+current)\s+commit", t) and in_rebase:
        return plan("git rebase --skip", "skip this commit in the rebase", change=True)

    # -- conflicts
    if re.search(r"\b(?:which|what|show|list|any|are\s+there)\b.*\bconflict", t) or re.fullmatch(r"(?:the\s+)?conflicts", t):
        return plan("git diff --name-only --diff-filter=U", "files with merge conflicts")
    m = re.fullmatch(r"(?:keep|use|take|choose|accept|pick)\s+(?:my|mine|our|ours|local|the\s+local|my\s+own)\s*(?:version|side|changes?|copy)?"
                     r"(?:\s+(?:of|for|in|on)\s+(?P<f>.+))?|(?:keep|use|take|choose|accept|pick)\s+(?:their|theirs|the\s+other|incoming|remote|the\s+incoming|the\s+remote)"
                     r"\s*(?:version|side|changes?|copy)?(?:\s+(?:of|for|in|on)\s+(?P<f2>.+))?", t)
    if m:
        side = "--ours" if m.group(0).split()[1] in ("my", "mine", "our", "ours", "local", "the") and "other" not in t \
            and "incoming" not in t and "remote" not in t and "their" not in t else "--theirs"
        fs = files_in(m.group("f") or m.group("f2") or "")
        target = " ".join(q(f) for f in fs) if fs else "$(git diff --name-only --diff-filter=U)"
        return plan(f"git checkout {side} -- {target}", [f"resolve with the {'local (ours)' if side == '--ours' else 'incoming (theirs)'} version",
                    "then stage the file and continue"], change=True, warning="! replaces the file with one side of the conflict")
    m = re.fullmatch(r"mark\s+(?P<f>.+?)\s+as\s+(?:resolved|fixed|done)", t)
    if m and files_in(m.group("f")):
        return plan("git add -- " + " ".join(q(f) for f in files_in(m.group("f"))), "mark as resolved (stage it)")

    # -- stash
    if re.search(r"\b(?:list|show|see|view|what\s+(?:are|is))\b.*\bstash(?:es)?\b|^stash(?:es|\s+list)$|^my\s+stashes$", t) and \
            not re.search(r"\bwhat\s+is\s+in\b|\bcontents?\b|\binside\b", t):
        return plan("git stash list", "stashed changes")
    if re.search(r"\b(?:what(?:'s|\s+is)\s+in|contents?\s+of|inside)\s+(?:the\s+|my\s+)?(?:last\s+|latest\s+)?stash\b", t):
        return plan("git stash show -p", "what the latest stash holds")
    if re.search(r"\b(?:clear|drop|delete|remove|empty|throw\s+away)\s+(?:all\s+(?:the\s+|my\s+)?|every\s+)stash(?:es)?\b|\bclear\s+(?:the\s+)?stash(?:es)?\b", t):
        return plan("git stash clear", "delete every stash", change=True, warning="! deletes all stashed changes for good",
                    preview="git stash list")
    if re.search(r"\b(?:drop|delete|remove|discard|throw\s+away)\s+(?:the\s+|my\s+|that\s+)?(?:last\s+|latest\s+)?stash\b", t):
        return plan("git stash drop", "delete the latest stash", change=True, warning="! deletes the latest stash")
    m = re.search(r"\b(pop|unstash|bring\s+back|restore|get\s+back|reapply|re-apply|apply|recover)\b.*\b(?:stash|stashed)\b|^unstash\b|"
                  r"\b(?:get|bring)\s+(?:my\s+|the\s+)?stash(?:ed\s+changes)?\s+back\b", t)
    if m:
        keep = (m.group(1) or "") in ("apply", "reapply", "re-apply") or re.search(r"\bkeep(?:ing)?\s+(?:the\s+|it|a\s+copy)", t)
        return plan("git stash apply" if keep else "git stash pop",
                    "put the stashed changes back" + (", keeping the stash" if keep else " and drop the stash"))
    if re.match(r"(?:stash|shelve)\b|(?:put|set|move)\s+(?:my\s+|the\s+|these\s+|all\s+)?(?:changes|work|edits)\s+aside\b|"
                r"save\s+(?:my\s+)?(?:changes|work)\s+for\s+later\b|(?:hide|park)\s+(?:my\s+)?(?:changes|work)\b", t):
        untracked = " -u" if re.search(r"\b(?:untracked|new\s+files|including\s+new|everything)\b", t) else ""
        msg = None
        mm = re.search(r"\"([^\"]+)\"|'([^']+)'", traw) or re.search(r"\b(?:as|called|named|with\s+(?:the\s+)?(?:message|name))\s+(.+)$", traw, re.I)
        if mm:
            msg = next(g for g in mm.groups() if g)
            if re.search(r"\buntracked|new\s+files", msg, re.I):
                msg = None
        cmd = f"git stash push{untracked} -m {q(msg)}" if msg else f"git stash push{untracked}"
        return plan(cmd, "put the changes aside" + (f" as “{msg}”" if msg else "") +
                    (" (untracked files too)" if untracked else ""))

    # -- undo, roll back, revert, reset, restore
    n_pat = r"(?P<n>\d+|a|an|one|two|three|four|five|six|seven|eight|nine|ten)"
    m = re.search(rf"\b(?:undo|roll\s*back|rollback|uncommit|take\s+back|cancel|reset|remove|delete|drop|get\s+rid\s+of)\s+(?:the\s+|my\s+)?"
                  rf"(?:last|latest|previous|recent)\s+(?:{n_pat}\s+)?commits?\b", t)
    if m and not t.startswith("revert"):
        n = _gnum(m.group("n"))
        lose = re.search(r"\b(?:throw(?:ing)?\s+away|discard(?:ing)?|delete|lose|losing|drop(?:ping)?|remove|wipe|without\s+keeping|"
                         r"get\s+rid\s+of|completely|entirely|hard|permanently|for\s+good)\b", t[m.end():]) or \
            re.match(r"(?:delete|remove|drop|get\s+rid\s+of)\b", t)
        if lose:
            return plan(f"git reset --hard HEAD~{n}", [f"remove the last {n} commit{'s' if n > 1 else ''}", "and throw away their changes"],
                        change=True, preview=f"git log --oneline -n {n}",
                        warning=f"! deletes the commit{'s' if n > 1 else ''} above and every uncommitted change")
        return plan(f"git reset --soft HEAD~{n}", [f"undo the last {n} commit{'s' if n > 1 else ''}",
                    "the changes stay staged, nothing is lost"], change=True, preview=f"git log --oneline -n {n}",
                    warning="! rewrites history: not for commits already pushed ('revert the last commit' is the safe form)")
    if re.fullmatch(r"uncommit", t):
        return plan("git reset --soft HEAD~1", ["undo the last commit", "the changes stay staged"], change=True)
    m = re.fullmatch(rf"revert\s+(?:the\s+)?(?:last|latest|previous)\s+{n_pat}\s+commits", t)
    if m:
        n = _gnum(m.group("n"))
        return plan(f"git revert --no-edit HEAD~{n}..HEAD", f"new commits that undo the last {n}", change=True)
    m = re.fullmatch(rf"(?:revert|undo)\s+(?:the\s+)?(?:commit\s+)?(?P<r>{GIT_HASH})", t)
    if m:
        return plan(f"git revert --no-edit {m.group('r')}", f"a new commit that undoes {m.group('r')}", change=True)
    m = re.fullmatch(rf"(?:look\s+at|check\s*out|visit|inspect|open|switch\s+to|go\s+to)\s+(?:the\s+)?(?:old\s+)?commit\s+(?P<r>{GIT_HASH}|\S+)", t)
    if m and is_ref(m.group("r")):
        return plan(f"git switch --detach {ref(m.group('r'))}", [f"look at {m.group('r')} (detached; 'switch back' returns)"])
    m = re.fullmatch(rf"(?:go|roll|move|reset|revert|return|jump|set\s+(?:the\s+)?branch)\s+(?:back\s+)?(?:to|onto)\s+(?:the\s+)?"
                     rf"(?:commit\s+|tag\s+|version\s+)?(?P<r>{GIT_HASH}|\S+)|(?:go|roll|move|step)\s+back\s+{n_pat}\s+commits?", t)
    if m and m.group("r") and is_branch(m.group("r")) and not re.search(r"\b(?:roll|reset|revert)\b|\bcommit\b|\btag\b", t):
        m = None                          # "go to dev" switches to the branch (below), it never resets
    if m and (m.group("n") or is_ref(m.group("r") or "")) and not (m.group("r") or "").lower() in ("origin", "remote", "upstream"):
        target = f"HEAD~{_gnum(m.group('n'))}" if m.group("n") else ref(m.group("r"))
        return plan(f"git reset --hard {target}", [f"the branch and files back to {target}"], change=True,
                    preview=f"git log --oneline {target}..HEAD", warning="! deletes the commits listed above and every uncommitted change")
    if re.fullmatch(r"(?:roll|go|step)\s+back\s+(?:to\s+)?(?:the\s+)?(?:previous|last|prior|earlier)\s+commit|(?:go|step)\s+back\s+(?:one|a)\s+commit", t):
        return plan("git reset --hard HEAD~1", ["back to the commit before the last", "the last commit and uncommitted changes are thrown away"],
                    change=True, preview="git log --oneline -n 1", warning="! deletes the last commit and every uncommitted change")
    if re.search(r"\b(?:reset|match|matches|same\s+as|exactly\s+like|identical\s+to)\b.*\b(?:origin|remote|upstream|server|github)\b"
                 r"(?!\s+\S+\s+(?:url|branch))|\b(?:throw\s+away|discard|drop|delete|get\s+rid\s+of)\s+(?:my\s+|all\s+)?(?:local|unpushed)\s+commits", t) \
            and "url" not in t and not re.search(r"\bremote\s+branch", t):
        return plan("git fetch && git reset --hard @{u}", ["make this branch exactly like its remote branch"], change=True,
                    preview="git fetch -q && git log --oneline @{u}..HEAD; git status --short",
                    warning="! throws away local commits (listed above) and every uncommitted change")
    m = re.fullmatch(r"(?:reset|restore|revert|clean)\s+(?:everything|all|the\s+(?:repo|working\s+tree|working\s+copy))\s+(?:to|back\s+to)\s+(?:the\s+)?(?:last|latest)\s+commit|"
                     r"(?:reset|undo)\s+(?:hard|everything)", t)
    if m:
        return plan("git reset --hard HEAD", "every file back to the last commit", change=True, preview="git status --short",
                    warning="! throws away every uncommitted change, staged or not")
    m = re.fullmatch(r"(?:discard|throw\s+away|undo|drop|lose|remove|delete|get\s+rid\s+of|reset|revert|cancel|forget)\s+(?:all\s+(?:of\s+)?)?(?:the\s+|my\s+)?"
                     r"(?:local\s+|uncommitted\s+|current\s+|unstaged\s+|unsaved\s+)?(?:changes|edits|modifications|work)(?:\s+(?:here|in\s+this\s+repo))?|"
                     r"(?:discard|throw\s+away|drop|lose)\s+everything(?:\s+(?:i\s+changed|uncommitted))?", t)
    if m:
        return plan("git restore -- .", "throw away the unstaged changes in every tracked file", change=True,
                    preview="git status --short", warning="! the changes listed above are lost for good")
    m = re.fullmatch(r"(?:discard|throw\s+away|undo|drop|lose|remove|reset|revert|cancel|forget)\s+(?:all\s+)?(?:the\s+|my\s+)?(?:local\s+|uncommitted\s+)?"
                     r"(?:changes|edits|modifications)\s+(?:in|to|of|on|for)\s+(?P<f>.+)|(?:reset|revert)\s+(?P<f2>\S+)", t)
    if m and files_in(m.group("f") or m.group("f2") or ""):
        fs = files_in(m.group("f") or m.group("f2"))
        return plan("git restore -- " + " ".join(q(f) for f in fs), f"{', '.join(fs)} back to the last commit", change=True,
                    preview="git diff --stat -- " + " ".join(q(f) for f in fs), warning="! its uncommitted changes are lost")
    m2 = re.fullmatch(r"(?:get|take|grab|copy|fetch|bring)\s+(?:the\s+)?(?:file\s+)?(?P<f>[\w./~@+-]+)\s+(?:from|out\s+of)\s+(?:the\s+)?(?:branch\s+|commit\s+|tag\s+)?(?P<r>[\w./~^-]+)(?:\s+branch)?", t)
    if m2 and is_ref(m2.group("r")) and not is_ref(m2.group("f")):
        f, r = orig(m2.group("f")), ref(m2.group("r"))
        return plan(f"git restore --source={r} -- {q(f)}", f"{f} as it is in {r}", change=os.path.exists(os.path.join(u.cwd, f)),
                    warning=f"! replaces the current {f}" if os.path.exists(os.path.join(u.cwd, f)) else None)
    m = re.fullmatch(rf"(?:restore|recover|get\s+back|bring\s+back|undelete)\s+(?:the\s+)?(?:deleted\s+|lost\s+|old\s+)?(?:file\s+)?(?P<f>[\w./~@+-]+)"
                     rf"(?:\s+(?:from|as\s+(?:it\s+was|of)\s+(?:in)?)\s+(?:the\s+)?(?:(?P<n>\d+|one|two|three|four|five)\s+commits?\s+ago|(?:last|latest)\s+commit|"
                     rf"commit\s+(?P<r>\S+)|(?P<r2>\S+)))?", t)
    if m and ("." in m.group("f") or "/" in m.group("f") or os.path.exists(os.path.join(u.cwd, m.group("f")))) and \
            not re.search(r"stash", t):
        f = orig(m.group("f"))
        src = f"HEAD~{_gnum(m.group('n'))}" if m.group("n") else (m.group("r") or m.group("r2"))
        if src and not m.group("n") and not is_ref(src):
            return None
        if src:
            return plan(f"git restore --source={ref(src)} -- {q(f)}", f"{f} as it was in {ref(src)}", change=True,
                        warning=f"! replaces the current {f}")
        if os.path.exists(os.path.join(u.cwd, f)):
            return plan(f"git restore -- {q(f)}", f"{f} back to the last commit", change=True, warning="! its uncommitted changes are lost")
        return plan(f"git restore -- {q(f)} 2>/dev/null || git checkout \"$(git rev-list -n 1 HEAD -- {q(f)})~1\" -- {q(f)}",
                    f"bring back the deleted {f} from the last commit that had it")

    # -- staging
    m = re.fullmatch(r"(?:stage|add|track|git\s+add)\s+(?:all|everything|all\s+(?:the\s+|my\s+)?(?:changes|files|changed\s+files|modified\s+files|new\s+files))"
                     r"(?:\s+(?:to\s+(?:git|the\s+(?:index|stage|staging\s+area|commit))|for\s+(?:the\s+)?(?:next\s+)?commit))?", t)
    m = m or re.fullmatch(r"(?:stage|add|track)\s+(?:the\s+|my\s+)?(?:new|untracked|changed|modified|edited)?\s*(?:files|changes|work)", t)
    if m and not re.search(r"\b(?:zip|tar|archive)\b", t):
        return plan("git add -A", "stage every change, new files too")
    m = re.fullmatch(r"(?P<v>stage|track|add)\s+(?P<f>.+?)(?P<s>\s+(?:to\s+(?:git|the\s+(?:index|stage|staging\s+area|repo|repository)|version\s+control)|for\s+(?:the\s+)?(?:next\s+)?commit))?", t)
    if m and (m.group("v") != "add" or m.group("s") or low.startswith("git ")) and files_in(m.group("f")) \
            and not re.search(r"\b(?:last|previous)\s+commit\b", t):
        fs = files_in(m.group("f"))
        return plan("git add -- " + " ".join(q(f) for f in fs), f"stage {', '.join(fs)}")

    # -- tags (before push: "push the tags")
    if re.search(r"\bpush\b.*\btags\b|\bpush\s+all\s+(?:the\s+)?tags\b", t):
        return plan(f"git push {remote} --tags", "push every tag")
    m = re.fullmatch(r"push\s+(?:the\s+)?tag\s+(?P<t>\S+)", t)
    if m:
        return plan(f"git push {remote} {q(m.group('t'))}", f"push the tag {m.group('t')}")
    if re.search(r"\b(?:list|show|what|which|all)\b.*\btags\b|^tags$", t):
        return plan("git tag --list --sort=-creatordate", "tags, newest first")
    m = re.fullmatch(r"(?:delete|remove|drop)\s+(?:the\s+)?tag\s+(?P<t>\S+)", t)
    if m:
        return plan(f"git tag -d {q(m.group('t'))}", f"delete the tag {m.group('t')} here (not on the remote)", change=True)
    m = re.fullmatch(r"(?:create|make|add|new|set)\s+(?:a\s+)?(?:new\s+)?(?:release\s+)?tag\s+(?:called\s+|named\s+)?(?P<t>[\w./-]+)(?P<rest>.*)|"
                     r"tag\s+(?:this|the\s+(?:current|last|latest)|current|head|it)\s*(?:commit|version|release)?\s+(?:as|with)\s+(?P<t2>[\w./-]+)(?P<rest2>.*)|"
                     r"tag\s+(?P<t3>v?\d[\w./-]*)(?P<rest3>.*)|(?:mark|release)\s+(?:this\s+)?(?:as\s+|version\s+)?(?:version\s+)?(?P<t4>v?\d[\w./-]*)(?P<rest4>.*)", t)
    if m:
        tag = m.group("t") or m.group("t2") or m.group("t3") or m.group("t4")
        rest = m.group("rest") or m.group("rest2") or m.group("rest3") or m.group("rest4") or ""
        mm = re.search(r"\"([^\"]+)\"|'([^']+)'", traw) or re.search(r"\b(?:message|msg|saying|note)\s+(.+)$", traw, re.I)
        msg = next((g for g in mm.groups() if g), None) if mm and re.search(r"message|msg|saying|note|\"|'", rest) else None
        rtag = orig(tag)
        return plan(f"git tag -a {q(rtag)} -m {q(msg)}" if msg else f"git tag {q(rtag)}",
                    f"tag the current commit as {rtag}" + (f": “{msg}”" if msg else ""))

    # -- cherry-pick
    m = re.fullmatch(rf"(?:cherry[- ]?pick|pick|copy|apply|take|bring\s+over|grab)\s+(?:the\s+)?(?:commit\s+)?(?P<r>{GIT_HASH})(?:\s+(?:to|onto|into|on|here|over).*)?", t)
    if m:
        return plan(f"git cherry-pick {m.group('r')}", f"copy commit {m.group('r')} onto {current}")


    # -- about the last commit
    if re.fullmatch(r"(?:who|when)\s+(?:made|did|wrote|authored|pushed)\s+(?:the\s+)?(?:last|latest|previous)\s+commit", t):
        return plan("git log -1 --format='%an <%ae>, %ar: %s'", "who made the last commit, and when")
    if re.fullmatch(r"what\s+(?:did|does)\s+(?:the\s+)?(?:last|latest|previous)\s+commit\s+(?:do|change|contain)|"
                    r"(?:show\s+(?:me\s+)?)?what\s+(?:the\s+)?(?:last|latest|previous)\s+commit\s+(?:changed|did|contains)", t):
        return plan("git show --stat HEAD", "the last commit: message and the files it changed")
    if re.search(r"\babout\s+to\s+commit\b|\bstaged\s+for\s+(?:the\s+)?commit\b", t):
        return plan("git diff --cached", "what is staged for the next commit")
    if re.fullmatch(r"is\s+everything\s+committed|(?:have|did)\s+i\s+commit(?:ted)?\s+everything|is\s+there\s+anything\s+(?:left\s+)?to\s+commit", t):
        return plan("git status --short && git diff --stat", "anything not committed yet")
    # -- commit
    m = re.search(r"\b(?:change|fix|edit|update|reword|correct|rename|rewrite)\s+(?:the\s+)?(?:last\s+|previous\s+|latest\s+)?commit(?:'s)?\s+message\b|"
                  r"\breword\s+(?:the\s+)?(?:last\s+|previous\s+|latest\s+)?commit\b", t)
    if m:
        mm = re.search(r"\"([^\"]+)\"|'([^']+)'|“([^”]+)”", raw) or re.search(r"\b(?:message|commit)\s+to\s+(.+)$", raw, re.I)
        msg = next((g for g in mm.groups() if g), None) if mm else None
        return plan(f"git commit --amend -m {q(msg)}" if msg else "git commit --amend",
                    "change the last commit's message" + (f" to “{msg}”" if msg else " (opens the editor)"), change=True,
                    warning="! rewrites the last commit: push with --force-with-lease if it was already pushed")
    m = re.fullmatch(r"(?:add|put|include)\s+(?P<f>.+?)\s+(?:to|in|into)\s+(?:the\s+)?(?:last|previous|latest)\s+commit|"
                     r"i\s+forgot\s+(?:to\s+(?:add|include)\s+)?(?P<f2>.+?)\s+(?:in|from)\s+(?:the\s+)?(?:last|previous|latest)\s+commit", t)
    if m and not m.group("f"):
        m = re.fullmatch(r"i\s+forgot\s+(?:to\s+(?:add|include)\s+)?(?P<f>.+?)\s+(?:in|from)\s+(?:the\s+)?(?:last|previous|latest)\s+commit", t)
    if m and files_in(m.group("f")):
        fs = files_in(m.group("f"))
        return plan("git add -- " + " ".join(q(f) for f in fs) + " && git commit --amend --no-edit",
                    f"add {', '.join(fs)} to the last commit", change=True, warning="! rewrites the last commit")
    if re.search(r"\bamend\b", t):
        return plan("git commit --amend --no-edit", ["add the staged changes to the last commit",
                    "to change its message: 'change the last commit message to …'"], change=True,
                    warning="! rewrites the last commit: push with --force-with-lease if it was already pushed")
    if re.search(r"\b(?:commit|check\s*in)\b", t) and not re.search(
            r"\b(?:last|latest|previous|recent|undo|revert|show|squash|history|log|graph|by|since|search|which|what|cherry|"
            r"pushed|unpushed|blame|amend|tag|apply|pick|copy|look|check\s*out|go|reset|mention|mentions|find|"
            r"about\s+to|everything\s+committed|made|did|do)\b|\bcommits\b|\b[0-9a-f]{7,40}\b", t) \
            or re.match(r"(?:save|snapshot|record)\s+(?:my\s+|the\s+|all\s+(?:my\s+)?)?(?:work|progress|changes)\b", t):
        msg = message()
        if msg and re.fullmatch(r"(?:everything|all|all\s+(?:the\s+)?changes|my\s+(?:work|changes))", msg, re.I):
            msg = None
        every = re.search(r"\b(?:everything|all|all\s+(?:my\s+|the\s+)?(?:changes|files|work)|my\s+(?:work|progress)|the\s+work|"
                          r"these|those|them|these\s+(?:changes|files))\b", re.sub(r"\"[^\"]*\"|'[^']*'|“[^”]*”", "", t)) or \
            re.match(r"(?:save|snapshot|record)\b", t)
        fs = [f for f in files_in(re.sub(r"\"[^\"]*\"|'[^']*'", "", t)) if not msg or f not in msg]
        msg_part = f" -m {q(msg)}" if msg else ""
        if fs:
            return plan("git add -- " + " ".join(q(f) for f in fs) + f" && git commit{msg_part} -- " + " ".join(q(f) for f in fs),
                        f"commit {', '.join(fs)}" + (f": “{msg}”" if msg else ""))
        if every:
            return plan(f"git add -A && git commit{msg_part}", "commit every change, new files too" + (f": “{msg}”" if msg else ""))
        if not msg and re.search(r"\bmy\s+changes\b", t):
            return plan("git commit -a", "commit the changes to tracked files (opens the editor for the message)")
        return plan(f"git commit{msg_part}", "commit what is staged" + (f": “{msg}”" if msg else " (opens the editor for the message)"))

    # -- remotes (before push/pull: "add remote", "remove remote")
    m = re.fullmatch(r"add\s+(?:a\s+)?(?:new\s+)?remote\s+(?:called\s+|named\s+)?(?P<n>[\w.-]+)\s+(?:with\s+(?:the\s+)?url\s+|at\s+|=\s*|pointing\s+to\s+|as\s+)?(?P<url>\S+)", t)
    if m:
        url = traw[low.find(m.group("url")):][:len(m.group("url"))]
        return plan(f"git remote add {m.group('n')} {q(url)}", f"add the remote {m.group('n')}")
    m = re.fullmatch(r"(?:change|set|update|point|switch)\s+(?:the\s+)?(?:(?P<n>[\w.-]+)\s+)?(?:remote\s+)?url(?:\s+of\s+(?:the\s+)?(?P<n2>[\w.-]+))?\s+to\s+(?P<url>\S+)|"
                     r"(?:point|set)\s+(?P<n3>[\w.-]+)\s+(?:remote\s+)?to\s+(?P<url2>\S+://\S+|\S+@\S+:\S+)", t)
    if m:
        n = m.group("n") or m.group("n2") or m.group("n3")
        n = n if n and n in remotes else remote
        u_ = m.group("url") or m.group("url2")
        url = traw[low.find(u_):][:len(u_)]
        return plan(f"git remote set-url {n} {q(url)}", f"{n} → {url}", change=True)
    m = re.fullmatch(r"(?:remove|delete|drop)\s+(?:the\s+)?remote\s+(?P<n>[\w.-]+)", t)
    if m:
        return plan(f"git remote remove {m.group('n')}", f"remove the remote {m.group('n')} (the repository there is untouched)", change=True)
    m = re.fullmatch(r"rename\s+(?:the\s+)?remote\s+(?P<a>[\w.-]+)\s+to\s+(?P<b>[\w.-]+)", t)
    if m:
        return plan(f"git remote rename {m.group('a')} {m.group('b')}", f"rename the remote {m.group('a')} to {m.group('b')}")
    if re.search(r"\b(?:list|show|what|which|my)\b.*\bremotes?\b(?!\s+branch)|^remotes?$|\bwhere\s+(?:does\s+(?:this|it)\s+(?:repo\s+)?push|is\s+(?:the\s+)?(?:origin|remote))\b|"
                 r"\b(?:origin|remote)\s+url\b|\burl\s+of\s+(?:the\s+)?(?:origin|remote|repo)\b", t) and not re.search(r"\bbranch", t):
        return plan("git remote -v", "remotes and their addresses")

    # -- branches
    m = re.search(r"\b(?:delete|remove|drop|get\s+rid\s+of)\s+(?:the\s+)?(?:remote\s+branch\s+(?P<b>[\w./-]+)|(?P<b2>[\w./-]+)\s+(?:branch\s+)?(?:on|from)\s+(?:the\s+)?(?:remote|origin|github|gitlab|server))", t)
    if m:
        b = m.group("b") or m.group("b2")
        b = b.split("/", 1)[1] if "/" in b and b.split("/", 1)[0] in remotes else b
        return plan(f"git push {remote} --delete {q(b)}", f"delete the branch {b} on {remote}", change=True,
                    warning=f"! deletes {b} on {remote} for everyone")
    m = re.fullmatch(r"(?:force\s+)?(?:delete|remove|drop|get\s+rid\s+of|kill|nuke|destroy|trash)\s+(?:the\s+)?(?:local\s+)?(?:branch\s+(?P<b>[\w./-]+)|(?P<b2>[\w./-]+)\s+branch)(?P<rest>.*)", t)
    if m:
        b = orig(m.group("b") or m.group("b2"))
        force = re.search(r"\bforce\b|\banyway\b|\beven\s+if\b|\bunmerged\b|-d\b", t)
        if b == current:
            return plan("git branch", f"{b} is the current branch: a switch to another branch is required first", conf=0.9)
        return plan(f"git branch {'-D' if force else '-d'} {q(b)}", f"delete the branch {b}" +
                    ("" if force else " (refused if it is not merged; say 'force delete' to delete anyway)"), change=True)
    m = re.fullmatch(r"rename\s+(?:this|the\s+current|my|current)\s+branch\s+(?:to|as|into)\s+(?P<b2>[\w./-]+)|"
                     r"rename\s+(?:the\s+)?(?:branch\s+)?(?P<a>[\w./-]+?)(?:\s+branch)?\s+(?:to|as|into)\s+(?P<b>[\w./-]+)", t)
    if m:
        if m.group("b2"):
            return plan(f"git branch -m {q(m.group('b2'))}", f"rename {current} to {m.group('b2')}")
        if is_branch(m.group("a")):
            return plan(f"git branch -m {q(m.group('a'))} {q(m.group('b'))}", f"rename {m.group('a')} to {m.group('b')}")
    mb = re.fullmatch(r"branch\s+off\s+(?:of\s+)?(?:the\s+)?(?P<base>[\w./-]+)\s+(?:as|called|named|into)\s+(?P<n>[\w./-]+)", t)
    if mb and is_ref(mb.group("base")):
        return plan(f"git switch -c {q(orig(mb.group('n')))} {q(orig(mb.group('base')))}", f"create {mb.group('n')} from {mb.group('base')} and switch to it")
    m = re.search(r"\b(?:create|make|start|new|open|branch\s+off|add)\s+(?:a\s+)?(?:new\s+)?branch\s+(?:called\s+|named\s+)?(?P<n>[\w./-]+)"
                  r"(?:\s+(?:from|off(?:\s+of)?|based\s+on|on\s+top\s+of|out\s+of)\s+(?:the\s+)?(?:branch\s+)?(?P<base>[\w./-]+))?", t) or \
        re.fullmatch(r"(?:new|create)\s+(?P<n>[\w./-]+)\s+branch(?:\s+(?:from|off)\s+(?P<base>[\w./-]+))?", t)
    if m and m.group("n") not in ("called", "named", "and", "from"):
        base = m.group("base")
        if base and not is_ref(base):
            return None
        stay = re.search(r"\b(?:but\s+)?(?:stay|don'?t\s+switch|without\s+switching|keep\s+(?:me\s+)?on)\b", t)
        if stay:
            return plan(f"git branch {q(m.group('n'))}" + (f" {q(base)}" if base else ""), f"create {m.group('n')}, stay on {current}")
        return plan(f"git switch -c {q(m.group('n'))}" + (f" {q(base)}" if base else ""),
                    f"create {m.group('n')}" + (f" from {base}" if base else "") + " and switch to it")
    if re.search(r"\b(?:which|what)\s+branch\b|\bcurrent\s+branch\b|\bbranch\s+(?:am\s+i|are\s+we)\s+on\b|\bon\s+which\s+branch\b|"
                 r"\bwhat\s+is\s+this\s+branch\b|\bwhere\s+am\s+i\s+in\s+git\b", t) and not re.search(r"\bbranches\b", t):
        return plan("git branch --show-current", "the current branch")
    if re.search(r"\bbranches\b", t) and re.search(r"\b(?:list|show|see|view|what|which|all|my|every|are)\b|^branches$", t + " ") \
            or re.fullmatch(r"(?:the\s+)?branches", t):
        if re.search(r"\b(?:not|un)[- ]?merged\b", t):
            return plan("git branch --no-merged", "branches not merged into this one")
        if re.search(r"\bmerged\b", t):
            return plan("git branch --merged", "branches already merged into this one")
        if re.search(r"\b(?:remote|origin|server|github|gitlab)\b", t) and not re.search(r"\blocal\b|\bincluding\b", t):
            return plan("git branch -r", "branches on the remote")
        if re.search(r"\b(?:all|every|including\s+remote|local\s+and\s+remote)\b", t):
            return plan("git branch -a", "every branch, local and remote")
        return plan("git branch -a", "every branch, local and remote")
    if re.fullmatch(r"(?:switch|change|jump|hop)\s+back(?:\s+to\s+(?:the\s+)?(?:previous|last|other|old|former)\s+branch)?|"
                    r"(?:go|move|get)\s+back\s+to\s+(?:the\s+)?(?:previous|last|other|old|former)\s+branch|"
                    r"(?:switch|go|change|move)\s+to\s+(?:the\s+)?(?:previous|last|other|former)\s+branch|(?:the\s+)?previous\s+branch", t):
        return plan("git switch -", "back to the previous branch")
    m = re.fullmatch(r"(?:switch|go|change|move|jump|hop|checkout|check\s+out|get\s+on|work\s+on)\s+(?:over\s+|back\s+)?(?:to|onto|into|on)?\s*(?:the\s+)?"
                     r"(?:branch\s+)?(?P<b>[\w./-]+?)(?:\s+branch)?", t)
    if m and (is_branch(m.group("b")) or re.search(r"\bbranch\b", t)) and m.group("b") not in ("back", "previous", "the"):
        b = m.group("b")
        if not is_branch(b):
            return plan("git branch -a", f"there is no branch {b}: say 'create branch {b}' to make it", conf=0.9)
        b = b.split("/", 1)[1] if "/" in b and b.split("/", 1)[0] in remotes and b.split("/", 1)[1] not in branches else b
        b = orig(b)
        return plan(f"git switch {q(b)}", f"switch to {b}")

    # -- merge, rebase, cherry-pick
    m = re.search(r"\bsquash[- ]?merge\s+(?:the\s+)?(?:branch\s+)?(?P<b>[\w./-]+)|\bmerge\s+(?:the\s+)?(?:branch\s+)?(?P<b2>[\w./-]+?)(?:\s+branch)?\s+(?:as|with)\s+(?:a\s+)?squash", t)
    if m and is_ref(m.group("b") or m.group("b2")):
        b = m.group("b") or m.group("b2")
        return plan(f"git merge --squash {q(b)}", [f"{b}'s changes as one set, staged here", "then commit them"])
    m = re.fullmatch(r"merge\s+(?:in\s+)?(?:the\s+)?(?:branch\s+)?(?P<a>[\w./-]+?)(?:\s+branch)?\s+(?:into|to|onto|in|with)\s+(?:the\s+)?(?:branch\s+)?(?P<b>[\w./-]+?)(?:\s+branch)?|"
                     r"(?:bring|put)\s+(?:the\s+)?(?:changes\s+(?:from|of)\s+)?(?:branch\s+)?(?P<a2>[\w./-]+?)(?:\s+branch)?\s+into\s+(?:the\s+)?(?:branch\s+)?(?P<b2>[\w./-]+?)(?:\s+branch)?", t)
    if m:
        a, b = m.group("a") or m.group("a2"), m.group("b") or m.group("b2")
        if is_ref(a) and (b in ("this", "here", "current", "mine", current) or is_branch(b)):
            if b in ("this", "here", "current", "mine", current):
                return plan(f"git merge {q(a)}", f"merge {a} into {current}")
            return plan(f"git switch {q(b)} && git merge {q(a)}", f"switch to {b} and merge {a} into it")
    m = re.fullmatch(r"merge\s+(?:in\s+)?(?:the\s+)?(?:latest\s+)?(?:changes\s+from\s+)?(?:branch\s+)?(?P<a>[\w./-]+?)(?:\s+branch)?"
                     r"(?:\s+(?:in|here|into\s+(?:this|the\s+current|my)(?:\s+branch)?|into\s+mine))?|"
                     r"(?:update|sync|refresh)\s+(?:my\s+|this\s+)?(?:branch\s+)?(?:with|from)\s+(?:the\s+)?(?:latest\s+)?(?:branch\s+)?(?P<a2>[\w./-]+?)(?:\s+branch)?|"
                     r"(?:get|bring\s+in|pull\s+in)\s+(?:the\s+)?(?:latest\s+)?changes\s+from\s+(?:the\s+)?(?:branch\s+)?(?P<a3>[\w./-]+?)(?:\s+branch)?", t)
    if m:
        a = m.group("a") or m.group("a2") or m.group("a3")
        if a in remotes or a in ("remote", "upstream", "server", "github"):
            pass                                   # "sync with origin" is a pull, below
        elif is_ref(a):
            return plan(f"git merge {q(a)}", f"merge {a} into {current}")
    mr = re.fullmatch(r"(?:put|move|replay|place)\s+(?:my|these|this\s+branch'?s?)\s+(?:commits|changes|work)\s+on\s+top\s+of\s+(?:the\s+)?(?:branch\s+)?(?P<b>[\w./-]+)", t)
    if mr and is_ref(mr.group("b")):
        b = orig(mr.group("b"))
        return plan(f"git rebase {q(b)}", f"replay {current}'s commits on top of {b}", change=True,
                    warning="! rewrites this branch's commits: don't rebase commits others already have")
    m = re.fullmatch(r"rebase(?:\s+(?:this|my|the\s+current|current)(?:\s+branch)?)?(?:\s+(?:on|onto|on\s+top\s+of|against|over|with))?\s*(?:the\s+)?(?:latest\s+)?(?:branch\s+)?(?P<b>[\w./-]+?)?(?:\s+branch)?", t)
    if m and (not m.group("b") or is_ref(m.group("b"))):
        b = m.group("b")
        return plan(f"git rebase {q(b)}" if b else "git rebase",
                    f"replay {current}'s commits on top of {b or 'its upstream'}", change=True,
                    warning="! rewrites this branch's commits: don't rebase commits others already have")
    m = re.search(rf"\b(?:interactive(?:ly)?\s+rebase|rebase\s+interactive(?:ly)?|clean\s+up|tidy\s+up|reorder|edit)\s+(?:the\s+)?(?:last\s+)?{n_pat}\s+commits", t)
    if m:
        n = _gnum(m.group("n"))
        return plan(f"git rebase -i HEAD~{n}", f"edit, squash or reorder the last {n} commits in the editor", change=True,
                    warning="! rewrites those commits")
    # -- push
    if re.search(r"\bforce[- ]?push\b|\bpush\b.*\b(?:force(?:fully)?|--force|-f|overwrite\s+(?:the\s+)?remote)\b", t):
        return plan(f"git push --force-with-lease", ["overwrite the remote branch with the local one",
                    "refused if someone else pushed meanwhile"], change=True, warning="! replaces the remote branch's history")
    if re.search(r"\b(?:push|publish|share|upload|send)\s+(?:this|my|the\s+current|current|the\s+new|my\s+new)\s+(?:new\s+)?branch\b|\bpublish\b|"
                 r"\bset\s+(?:the\s+)?upstream\b|\bpush\b.*\b(?:upstream|first\s+time|for\s+the\s+first\s+time|-u)\b|\btrack\s+(?:the\s+)?remote\b", t):
        return plan(f"git push -u {remote} {q(current) if current else 'HEAD'}", f"push {current} to {remote} and track it")
    m = re.fullmatch(r"(?:push|upload|send)\s+(?:the\s+)?(?:branch\s+)?(?P<b>[\w./-]+?)(?:\s+branch)?(?:\s+(?:to|up\s+to)\s+(?:the\s+)?(?P<r>[\w.-]+))?", t)
    if m and is_branch(m.group("b")) and m.group("b") not in remotes:
        r = m.group("r") if m.group("r") in remotes else remote
        return plan(f"git push -u {r} {q(m.group('b'))}", f"push {m.group('b')} to {r}")
    m = re.fullmatch(r"(?:push|upload|send)(?:\s+(?:all\s+)?(?:my|the|all|everything|it|this|these|what\s+i\s+have))*(?:\s+(?:local\s+)?(?:changes|commits|work|code|stuff|branch))?"
                     r"(?:\s+(?:up|out|online))?(?:\s+(?:to|up\s+to|into)\s+(?:the\s+)?(?P<r>[\w.-]+)(?:\s+(?:repo|repository|remote|server))?)?", t)
    if m and not re.fullmatch(r"(?:push|upload|send)\s+\S+\.\w+", t):
        r = m.group("r")
        if r and r in remotes:
            return plan(f"git push {r}", f"push to {r}")
        if r and r not in ("remote", "server", "github", "gitlab", "bitbucket", "cloud", "origin", "repo", "repository", "web", "internet"):
            return None
        return plan("git push", f"push {current} to its remote branch")

    # -- pull / fetch
    m = re.fullmatch(r"fetch\s+(?P<all>everything|all|all\s+remotes|from\s+all\s+remotes|every\s+remote)|"
                     r"fetch(?:\s+(?:the\s+)?(?:latest|changes|updates|commits|new\s+commits))?(?:\s+(?:from\s+)?(?:the\s+)?(?P<r>[\w.-]+))?", t)
    if m:
        if m.group("all"):
            return plan("git fetch --all --prune", "fetch every remote (working files stay unchanged)")
        r = m.group("r")
        return plan(f"git fetch {r}" if r in remotes else "git fetch", f"fetch {r if r in remotes else 'the remote'} (working files stay unchanged)")
    if re.search(r"\bpull\b.*\brebase\b", t):
        return plan("git pull --rebase", "pull, with local commits placed on top of the new ones")
    m = re.fullmatch(r"pull(?:\s+(?:the\s+)?(?:latest|newest|recent|changes|updates|code|commits|everything|down|in|it))*(?:\s+(?:from|off)\s+(?:the\s+)?(?P<r>[\w.-]+)(?:\s+(?P<b>[\w./-]+))?)?", t)
    m2 = re.fullmatch(r"(?:bring|get)\s+(?:my\s+|this\s+|the\s+)?(?:branch|repo|repository|code|checkout)\s+up\s+to\s+date|"
                      r"(?:get|grab|download|fetch\s+and\s+merge|bring\s+in|receive)\s+(?:the\s+)?(?:latest|newest|new|recent|remote)?\s*(?:changes|code|commits|updates|version|work)"
                      r"(?:\s+from\s+(?:the\s+)?(?P<r>[\w.-]+))?|(?:update|sync|synchroni[sz]e|refresh)\s+(?:my\s+|this\s+|the\s+)?(?:repo|repository|code|branch|checkout|working\s+copy|local\s+copy)?"
                      r"\s*(?:from|with)\s+(?:the\s+)?(?P<r2>remote|origin|server|github|gitlab|upstream|[\w.-]+)|(?:update|sync|refresh)\s+(?:the\s+|my\s+|this\s+)(?:repo|repository|code|checkout|working\s+copy)", t)
    if m or m2:
        r = (m.group("r") if m else None) or (m2.group("r") or m2.group("r2") if m2 else None)
        b = m.group("b") if m else None
        if r and r not in remotes and r not in ("remote", "server", "github", "gitlab", "upstream", "origin", "the"):
            if is_branch(r):
                return plan(f"git pull {remote} {q(r)}", f"pull {r} from {remote} into {current}")
            return None
        if r in remotes and b:
            return plan(f"git pull {r} {q(b)}", f"pull {b} from {r}")
        return plan(f"git pull {r}" if r in remotes else "git pull", f"pull the latest commits into {current}")

    # -- status and diffs
    m = re.fullmatch(r"(?:compare|diff|difference(?:s)?|changes|what\s+changed|what(?:'s|\s+is)\s+different)\s+(?:between\s+)?(?:the\s+)?(?:branch(?:es)?\s+)?(?P<a>[\w./~^-]+)"
                     r"(?:\s+branch)?\s+(?:and|with|to|vs\.?|versus|against|from)\s+(?:the\s+)?(?:branch\s+)?(?P<b>[\w./~^-]+)(?:\s+branch)?", t)
    if m and is_ref(m.group("a")) and is_ref(m.group("b")):
        return plan(f"git diff {ref(m.group('a'))} {ref(m.group('b'))}", f"what differs between {m.group('a')} and {m.group('b')}")
    if re.search(r"\b(?:staged|cached|indexed)\s+(?:changes|diff|files)\b|\bwhat(?:'s|\s+is|\s+have\s+i)\s+staged\b|\bwhat\s+will\s+(?:be|i)\s+commit|"
                 r"\bdiff\s+(?:of\s+)?(?:the\s+)?(?:staged|index|stage)\b", t):
        return plan("git diff --cached", "what is staged for the next commit")
    if re.search(r"\b(?:changes|changed|diff)\s+since\s+(?:the\s+)?(?:last|latest)\s+commit\b", t):
        return plan("git diff HEAD", "every change since the last commit, staged or not")
    m = re.fullmatch(r"(?:what(?:'s|\s+has|\s+is)?\s+changed|what\s+did\s+i\s+change|(?:show\s+(?:me\s+)?)?(?:the\s+)?(?:changes|diff|differences))\s+(?:in|to|of|for|on)\s+(?P<f>.+)|"
                     r"(?:diff|changes)\s+(?P<f2>\S+\.\S+)", t)
    if m and files_in(m.group("f") or m.group("f2")):
        fs = files_in(m.group("f") or m.group("f2"))
        return plan("git diff -- " + " ".join(q(f) for f in fs), f"uncommitted changes in {', '.join(fs)}")
    if re.fullmatch(r"(?:show|view|see|display|print|list)?\s*(?:me\s+)?(?:the\s+|my\s+|all\s+(?:my\s+)?)?(?:current\s+|local\s+|unstaged\s+|uncommitted\s+|working\s+)?"
                    r"(?:diff|changes|differences|edits|modifications)(?:\s+(?:i\s+made|so\s+far|here))?", t):
        return plan("git diff", "uncommitted changes")
    if re.fullmatch(r"(?:what(?:'s|\s+has|\s+is)?\s+changed|what\s+did\s+i\s+change|(?:repo|git|repository)\s+status|status|"
                    r"is\s+(?:my|the|this)\s+(?:repo|repository|working\s+(?:tree|copy|directory)|branch|checkout)\s+(?:clean|dirty)|"
                    r"(?:are\s+there\s+|do\s+i\s+have\s+|any\s+)(?:any\s+)?(?:uncommitted|unsaved|pending|local|unpushed\s+or\s+uncommitted)\s+changes|"
                    r"(?:anything|something)\s+to\s+commit|(?:show|list|what\s+are)\s+(?:the\s+|my\s+)?(?:modified|changed|uncommitted|dirty|edited|untracked|new)\s+files|"
                    r"what\s+files\s+(?:have\s+i|did\s+i|have|were|are)\s+(?:changed|modified|touched|edited)|(?:which|what)\s+files\s+(?:are|were)\s+(?:modified|changed))", t):
        return plan("git status --short && git diff --stat", "what changed since the last commit")

    # -- history
    if re.search(r"\b(?:graph|tree)\b", t) and re.search(r"\b(?:commit|history|log|branch|git)", t):
        return plan("git log --oneline --graph --all --decorate -n 40", "the commit graph of every branch")
    m = re.search(r"\b(?:changes|commits|work)\s+(?:that\s+)?(?:i\s+)?(?:haven'?t|have\s+not|did\s+not|didn'?t|not)\s+(?:yet\s+)?pushed\b|"
                  r"\b(?:unpushed|not\s+(?:yet\s+)?pushed|local\s+only|outgoing)\s+commits\b|\bcommits\s+(?:i\s+)?(?:have(?:n'?t|\s+not)|that\s+are\s+not|not)\s+(?:yet\s+)?pushed\b|"
                  r"\bwhat\s+(?:will|would|am\s+i\s+going\s+to)\s+(?:i\s+|be\s+)?push", t)
    if m:
        return plan("git log --oneline @{u}..", "local commits not yet on the remote")
    if re.search(r"\b(?:incoming|new|remote|upstream)\s+(?:changes|commits)\b|\bwhat(?:'s|\s+is)\s+new\s+(?:on|in)\s+(?:the\s+)?(?:remote|origin|server|upstream)\b|"
                 r"\bwhat\s+(?:would|will)\s+(?:i\s+get|a\s+pull\s+bring|pull\s+bring)", t):
        return plan("git fetch -q && git log --oneline ..@{u}", "remote commits not yet local (fetched, not merged)")
    if re.search(r"\b(?:am\s+i|are\s+we|is\s+(?:my|this|the)\s+(?:branch|repo|code|checkout))\s+(?:behind|ahead|up\s+to\s+date|in\s+sync|current|synced)\b|"
                 r"\bhow\s+far\s+(?:behind|ahead)\b|\bup\s+to\s+date\s+with\s+(?:the\s+)?(?:remote|origin|upstream)\b|\bbehind\s+(?:the\s+)?(?:remote|origin)\b", t):
        return plan("git fetch -q && git status -sb | head -n 1", "ahead or behind the remote, after fetching")
    m = re.fullmatch(r"(?:who|when|which\s+commit)\s+(?:wrote|changed|edited|last\s+changed|touched|added|modified)\s+lines?\s+(?P<a>\d+)"
