def h_pkg_search(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:search|look|find)\s+(?:for\s+)?(?:an?\s+|the\s+)?(?:package|program|app|software)s?\s+"
               r"(?:called\s+|named\s+|for\s+)?(\S+)\s*$")
    pm = pkg_manager()
    if not m or not pm:
        return None
    u.text = " " * len(u.text)
    name = shlex.quote(u.lit(u.o(m, 1)))
    verb = {"apt": "apt search", "dnf": "dnf search", "pacman": "pacman -Ss", "zypper": "zypper search",
            "apk": "apk search", "brew": "brew search"}[pm]
    return Plan(f"{verb} {name}", "packages", [f"search {pm} for {u.lit(u.o(m, 1))}"])


def h_compare(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:compare|diff|(?:the\s+)?differences?\s+between|what\s+changed\s+between)\s+(\S+)\s+"
               r"(?:and|with|to|vs\.?|versus|against)\s+(\S+)\s*$")
    if not m:
        return None
    a, b = resolve(u.lit(u.o(m, 1)), u.cwd), resolve(u.lit(u.o(m, 2)), u.cwd)
    if not a or not b:
        return None
    u.text = " " * len(u.text)
    rec = os.path.isdir(os.path.join(u.cwd, os.path.expanduser(a)))
    return Plan(f"diff -u{'r' if rec else ''} -- {qpath(a)} {qpath(b)}", "compare", [f"{a} vs {b}"])


def sed_escape(text: str, replacement: bool = False) -> str:
    chars = "\\/&\n" if replacement else "\\/.*[]^$\n"
    return "".join("\\" + c if c in chars else c for c in text).replace("\\\n", "\\n")


def h_replace(u: Utterance) -> Plan | None:
    m = u.peek(r"\b(?:replace|substitute|change|swap)\s+(?:all\s+|every\s+)?(?:the\s+(?:word|text|string)\s+)?(\S+)\s+"
               r"(?:with|by|to|into|for)\s+(\S+)\s+(?:in|inside|within|across|throughout)\s+(.+)$")
    if not m:
        return None
    old, new = u.lit(u.o(m, 1)), u.lit(u.o(m, 2))
    if not old:
        return None
    expr = shlex.quote(f"s/{sed_escape(old)}/{sed_escape(new, True)}/g")
    target = u.lit(u.o(m, 3).strip())
    u.text = " " * len(u.text)
    file = resolve(target, u.cwd, "file")
    why = [f'"{old}" → "{new}"', "every occurrence"]
    if file:
        return Plan(f"sed -i {expr} -- {qpath(file)}", "replace", why + [file], destructive=True,
                    preview=f"grep -nF -- {shlex.quote(old)} {qpath(file)}",
                    warning=f"! changes {file} in place")
    sub = Utterance(u.o(m, 3), u.cwd, u.literals)
    spec = FindSpec()
    parse_filters(sub, spec)
    if not spec.exts and not spec.names:
        return None   # never rewrite every file under here from a vague target
    spec.ftype = "f"
    spec.content.append(("content", old, f'"{old}"', old))
    cmd = render_find(spec, f"exec:sed -i {expr}")
    plan = Plan(cmd, "replace", why + [where_label(spec, True)] + spec.why, destructive=True,
                preview=render_find(spec), warning="! changes the files listed above in place")
    return finish(sub, plan, 0, spec)


def h_calc(u: Utterance) -> Plan | None:
    text = " ".join(u.lit(t) for t in u.orig.split())
    m = re.match(r"^\s*(?:what\s+is|what's|calculate|compute|how\s+much\s+is|evaluate|solve)?\s*"
                 r"([\d\s.+\-*/()%^x×÷]+?)\s*\??\s*$", text, re.I)
    if not m or not re.search(r"\d", m.group(1)) or not re.search(r"\d\s*[-+*/%^x×÷]\s*[\d(]", m.group(1)):
        return None
    if re.fullmatch(r"\s*[\d\s]+\s*", m.group(1)):
        return None
    expr = re.sub(r"\s+", "", m.group(1)).replace("^", "**").replace("×", "*").replace("x", "*").replace("÷", "/")
    try:
        compile(expr, "<calc>", "eval")
    except SyntaxError:
        return None
    u.text = " " * len(u.text)
    return Plan(f"python3 -c {shlex.quote(f'print({expr})')}", "calculate", [expr])


# ---- recipes: everyday requests with a fixed shape ---------------------------------
# One table instead of a handler each. A recipe has patterns (on the masked,
# lower-case text; named groups are slots), slot types, and a command: a
# template, a list of (tool, template) alternatives, or a function. Slot
# values are resolved and quoted before they reach the template.

WEB_DOMAIN = (r"[\w-]+(?:\.[\w-]+)*\.(?:com|org|net|io|fi|dev|ai|edu|gov|de|uk|eu|se|no|dk|co|me|info|app|tv|"
              r"xyz|ly|gg|so|to|sh|us|ca|au|nl|fr|it|es|ch|at|be|pl|ru|jp|in|br)(?:/\S*)?")
GUI = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
UNITS_S = {"s": 1, "sec": 1, "second": 1, "m": 60, "min": 60, "minute": 60, "h": 3600, "hr": 3600,
           "hour": 3600, "d": 86400, "day": 86400}
APPS = {  # what people call it -> command
    "firefox": "firefox", "browser": "x-www-browser", "chrome": "google-chrome", "chromium": "chromium",
    "vs code": "code", "vscode": "code", "code": "code", "text editor": "gnome-text-editor", "gedit": "gedit",
    "files": "nautilus", "file manager": "nautilus", "nautilus": "nautilus", "terminal": "x-terminal-emulator",
    "calculator": "gnome-calculator", "settings": "gnome-control-center", "system monitor": "gnome-system-monitor",
    "thunderbird": "thunderbird", "libreoffice": "libreoffice", "gimp": "gimp", "vlc": "vlc", "spotify": "spotify",
    "steam": "steam", "discord": "discord", "slack": "slack", "telegram": "telegram-desktop", "obs": "obs",
}


def _seconds(n: str, unit: str) -> int:
    u = re.sub(r"s$", "", unit.lower())
    return int(float(n) * UNITS_S.get(u, UNITS_S.get(u[:3], 60)))


def _tz(city: str) -> str | None:
    want = re.sub(r"\s+", "_", city.strip().lower()).split("/")[-1]
    for root, _, files in os.walk("/usr/share/zoneinfo"):
        if "/posix" in root or "/right" in root:
            continue
        for f in files:
            if f.lower() == want:
                return os.path.relpath(os.path.join(root, f), "/usr/share/zoneinfo")
    return None


def _archive_list(v, u):
    f, low = v["file"], v["file"].lower()
    if re.search(r"\.(zip|jar|whl|apk)'?$", low):
        return first_available([("unzip", f"unzip -l {f}"), (None, f"python3 -m zipfile -l {f}")])
    if re.search(r"\.(tar(\.(gz|bz2|xz|zst))?|tgz|tbz2|txz)'?$", low):
        return f"tar -tvf {f}"
    if low.rstrip("'").endswith(".deb"):
        return f"dpkg -c {f}"
    if low.rstrip("'").endswith(".7z"):
        return f"7z l {f}"
    return None


def _owner_pkg(v, u):
    p = u.lit(v["_raw_path"])
    if "/" in p:
        return f"dpkg -S -- {qpath(p)}"
    if shutil.which(p):
        return f'dpkg -S -- "$(readlink -f "$(command -v {shlex.quote(p)})")"'
    return None


def _date_math(v, u):
    n, unit = v["n"], re.sub(r"s$", "", v["unit"])
    sign = "-" if "ago" in v["when"] else "+"
    return f"date -d '{sign}{n} {unit}' '+%A %d %B %Y'"


def _websearch(v, u):
    q = urllib.parse.quote_plus(" ".join(u.lit(w) for w in v["_raw_text"].split()))
    url = shlex.quote(f"https://duckduckgo.com/?q={q}")
    return f"xdg-open {url}" if GUI and shutil.which("xdg-open") else f"echo {url}"


def _app(v, u):
    name = APPS.get(re.sub(r"\s+", " ", v["_raw_app"].lower()))
    if not name or not GUI or not shutil.which(name):
        return None
    return f"nohup {name} >/dev/null 2>&1 &"


def _volume(v, u):
    if not shutil.which("pactl"):
        return None
    how = v.get("_raw_how", "").lower()
    if v.get("n"):
        return f"pactl set-sink-volume @DEFAULT_SINK@ {v['n']}%"
    if "unmute" in how:
        return "pactl set-sink-mute @DEFAULT_SINK@ 0"
    if "mute" in how:
        return "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    step = "+10%" if re.search(r"up|louder|raise|increase", how) else "-10%"
    return f"pactl set-sink-volume @DEFAULT_SINK@ {step}"


def _clone(v, u):
    url = u.lit(v["_raw_url"])
    if re.fullmatch(r"[\w.-]+/[\w.-]+", url):
        url = f"https://github.com/{url}"
    return f"git clone -- {shlex.quote(url)}"


def _alias(v, u):
    name, body = v["word"], " ".join(u.lit(w) for w in v["_raw_cmdtext"].split())
    if not re.fullmatch(r"[\w.-]+", name):
        return None
    line = f"alias {name}={shlex.quote(body)}"
    return f"{line} && printf '%s\\n' {shlex.quote(line)} >> {qpath(AISHARC)}"


def _path_add(v, u):
    d = v["dir"]
    line = f'export PATH="$PATH:{d}"' if not d.startswith("'") else f"export PATH=\"$PATH\":{d}"
    return f"{line} && printf '%s\\n' {shlex.quote(line)} >> {qpath(AISHARC)}"


BINARY_EXT = (r"\.(?:zip|tar|t?gz|tgz|bz2|xz|7z|rar|zst|pdf|png|jpe?g|gif|webp|mp[34]|mkv|avi|mov|iso|img|"
              r"exe|so|o|a|db|sqlite3?|docx?|xlsx?|pptx?|odt|ods|deb|rpm|jar|class|pyc)$")


def split_alternatives(p: str) -> list[str]:
    """Top-level a|b|c of a regex."""
    parts, depth, cur, esc, in_class = [], 0, "", False, False
    for c in p:
        if esc:
            esc = False
        elif c == "\\":
            esc = True
        elif in_class:
            in_class = c != "]"
        elif c == "[":
            in_class = True
        elif c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
        elif c == "|" and depth == 0:
            parts.append(cur)
            cur = ""
            continue
        cur += c
    return parts + [cur]


class Recipe:
    def __init__(self, label, patterns, cmd, *, slots=None, defaults=None, destructive=False, warning=None,
                 needs=(), git=False, gui=False, runs_on_question=False, preview=None, text_into=False):
        self.label, self.cmd, self.slots, self.preview = label, cmd, slots or {}, preview
        self.text_into = text_into      # writes {text} into {newfile}: never a file name, never an archive
        self.patterns = []
        for p in [patterns] if isinstance(patterns, str) else patterns:
            try:
                self.patterns.append(re.compile(p))
            except re.error:             # a slot named in two alternatives: one pattern each
                self.patterns += [re.compile(alt) for alt in split_alternatives(p)]
        self.defaults, self.destructive, self.warning = defaults or {}, destructive, warning
        self.needs, self.git, self.gui, self.runs_on_question = needs, git, gui, runs_on_question


SLOT_TYPES = {"file": "file", "path": "path", "dir": "dir", "newfile": "newfile", "host": "host", "url": "url",
              "n": "n", "m": "n", "word": "word", "user": "word", "pkg": "word", "var": "var", "text": "text",
              "cmdtext": "cmdtext", "remote": "remote", "city": "city", "algo": "algo", "unit": "raw",
              "when": "raw", "how": "raw", "app": "raw", "dest": "dest"}


def _slot(kind: str, raw: str, u: Utterance):
    tok = u.lit(raw.strip())
    if kind == "raw":
        return raw.strip()
    if kind in ("file", "path"):
        p = resolve(tok, u.cwd, "file" if kind == "file" else None)
        if not p and "/" not in tok:
            hits = find_below(tok, u.cwd)
            p = hits[0] if len(hits) == 1 else None
        return qpath(p) if p else None
    if kind == "dir":
        p = home_alias(tok, u.cwd) or resolve(tok, u.cwd, "dir")
        return qpath(p) if p else None
    if kind == "newfile":
        return qpath(tok) if (raw.startswith("qlit") or is_pathlike(tok)) else None
    if kind == "host":
        tok = re.sub(r"^\w+://", "", tok).split("/")[0]
        ok = (re.fullmatch(r"[A-Za-z0-9][\w-]*(?:\.[\w-]+)*\.[A-Za-z]{2,}", tok)
              or re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", tok) or tok == "localhost")
        return tok if ok and not os.path.exists(os.path.join(u.cwd, tok)) else None
    if kind == "url":
        if os.path.exists(os.path.join(u.cwd, os.path.expanduser(tok))):
            return None                  # README.md is a file, not a website
        if re.match(r"(?:https?|ftp)://\S+", tok) or re.fullmatch(WEB_DOMAIN, tok):
            return shlex.quote(tok if "://" in tok else "https://" + tok)
        return None
    if kind == "dest":
        return qpath(tok)
    if kind == "n":
        n = num(raw)
        return str(int(n)) if n is not None else None
    if kind == "word":
        return shlex.quote(tok) if re.fullmatch(r"[\w.@+/:-]+", tok) and raw.lower() not in (
            "the", "a", "an", "my", "this", "that", "it", "me") else None
    if kind == "var":
        return tok if re.fullmatch(r"[A-Za-z_]\w*", tok) else None
    if kind == "text":
        return shlex.quote(" ".join(u.lit(w) for w in raw.split()))
    if kind == "cmdtext":
        return " ".join(u.lit(w) for w in raw.split())
    if kind == "remote":
        return shlex.quote(tok) if re.fullmatch(r"(?:[\w.-]+@)?[\w.-]+:\S*|[\w.-]+@[\w.-]+", tok) else None
    if kind == "city":
        return _tz(tok)
    if kind == "algo":
        return {"md5": "md5sum", "sha1": "sha1sum", "sha512": "sha512sum"}.get(tok.lower(), "sha256sum")
    return None


def _apply_recipe(r: Recipe, u: Utterance) -> Plan | None:
    if any(not shutil.which(t) for t in r.needs):
        return None
    if r.git and not (shutil.which("git") and git_branch(u.cwd)):
        return None
    if r.gui and not GUI:
        return None
    for pat in r.patterns:
        m = pat.search(u.text)
        if not m:
            continue
        vals: dict = {}
        ok = True
        for name, raw in m.groupdict().items():
            base = re.sub(r"\d+$", "", name)
            if raw is None:
                continue
            raw_orig = u.o(m, name)
            vals["_raw_" + base] = raw_orig
            kind = r.slots.get(base, SLOT_TYPES.get(base, "raw"))
            v = _slot(kind, raw_orig, u)
            if v is None:
                ok = False
                break
            vals[base] = v
        if not ok:
            continue
        if r.text_into:
            text_lit = u.lit(vals.get("_raw_text", "").strip())
            target = u.lit(vals.get("_raw_newfile", "").strip()).lower()
            if (os.path.isfile(os.path.join(u.cwd, os.path.expanduser(text_lit))) or find_below(text_lit, u.cwd)
                    or re.search(BINARY_EXT, target)):
                continue                 # "put notes.txt into backup.zip" adds a file, it is not text
        for k, d in r.defaults.items():
            vals.setdefault(k, d)
        vals.setdefault("su", sudo())
        if callable(r.cmd):
            cmd = r.cmd(vals, u)
        else:
            tmpl = first_available(r.cmd) if isinstance(r.cmd, list) else r.cmd
            try:
                cmd = tmpl.format(**vals)
            except (KeyError, IndexError):
                cmd = None
        if not cmd:
            continue
        u.blank(m.start(), m.end())
        if isinstance(cmd, Plan):          # the recipe made the whole plan (uninstall: the nearest match)
            return cmd
        u.take(r"^\s*(?:please\s+)?(?:find|search\s+for|search|locate|look\s+for|hunt\s+for|list|show(?:\s+me)?|"
               r"get(?:\s+me)?|give\s+me|print|display|view|tell\s+me)\b")
        u.take(r"\b(?:find|list|show|search)\s*$")
        shown = [f"{k} {re.sub(r'qlit\d+', lambda q: u.lit(q.group(0)), v) if isinstance(v, str) else v}"
                 for k, v in vals.items()
                 if not k.startswith("_") and k in m.groupdict() and m.group(k)]
        preview = r.preview(vals, u) if callable(r.preview) else (r.preview.format(**vals) if r.preview else None)
        return Plan(cmd, r.label, shown, destructive=r.destructive, warning=r.warning,
                    runs_on_question=r.runs_on_question, preview=preview)
    return None


