SORT_FILE_WORDS = re.compile(r"\b(?:sort(?:ed|ing)?|alphabeti[sz]e|order|arrange)\b|\balphabetical(?:ly)?\b")


def h_sort_file(u: Utterance) -> Plan | None:
    """The lines of one file, sorted, in any wording and any mix of options:
    "sort nums.txt numerically descending", "put names.txt in alphabetical order"."""
    if not SORT_FILE_WORDS.search(u.low) or re.search(r"\b(?:column|field)s?\b", u.low):
        return None
    path = None
    for low, orig, start in u.remaining():
        tok = u.lit(orig)
        if os.path.isfile(os.path.join(u.cwd, os.path.expanduser(tok))):
            path = tok
            u.blank(start, start + len(orig))
            break
    if not path:
        return None
    why = []
    numeric = human = rev = uniq = fold = False
    if u.take(r"\bhuman[- ]?(?:readable)?(?:\s+(?:numbers|sizes|values))?\b"):
        human = True
    if u.take(r"\b(?:in\s+)?(?:an?\s+)?numeric(?:al)?(?:ly)?(?:\s+order)?\b|\bby\s+(?:the\s+)?(?:numbers?|value)\b|"
              r"\bas\s+numbers\b|\b(?:the\s+)?numbers\s+(?:in|of)\b"):
        numeric = True
    m = u.take(r"\b(?:from\s+)?(?:the\s+)?(largest|biggest|highest|smallest|lowest)\s+(?:first|to\s+(?:the\s+)?(?:smallest|lowest|largest|biggest|highest))\b")
    if m:
        numeric = numeric or not human
        rev = m.group(1) in ("largest", "biggest", "highest")
    if u.take(r"\b(?:in\s+)?(?:reversed?|backwards?|descending|inverse)(?:\s+(?:alphabetical|alphabetic))?(?:\s+order)?\b|"
              r"\b(?:from\s+)?z\s*(?:to|-|→)\s*a\b"):
        rev = True
    u.take(r"\b(?:in\s+)?(?:ascending)(?:\s+order)?\b")
    if u.take(r"\b(?:and\s+)?(?:remove|drop|without|no|delete|strip|skip)\s+(?:the\s+)?(?:duplicates?|doubles|repeats)(?:\s+lines)?\b|"
              r"\bunique\b|\bdistinct\b|\bdedup(?:licated?)?\b"):
        uniq = True
    if u.take(r"\b(?:ignoring|ignore|regardless\s+of|without\s+regard\s+to)\s+(?:the\s+)?(?:upper\s+and\s+lower\s+)?case\b|"
              r"\bcase[- ]?insensitive(?:ly)?\b"):
        fold = True
    u.take(r"\b(?:in\s+)?(?:an?\s+)?alphabetical(?:ly)?(?:\s+order)?\b|\balphabeti[sz]e\b|\b(?:from\s+)?a\s*(?:to|-|→)\s*z\b|"
           r"\bin\s+abc\s+order\b")
    u.take(r"\b(?:sort(?:ed)?|put|arrange|order|reverse)\b")
    u.take(r"\b(?:the\s+)?(?:lines|contents?|rows|entries)\s*(?:of|in|from)?\b")
    flags = ("f" if fold else "") + ("h" if human else "n" if numeric else "") + ("r" if rev else "") + ("u" if uniq else "")
    if fold:
        why.append("ignoring case")
    if human or numeric:
        why.append("as human-readable numbers" if human else "as numbers")
    why.append("descending" if rev else "ascending")
    if uniq:
        why.append("without duplicates")
    cmd = f"sort -{flags} -- {qpath(path)}" if flags else f"sort -- {qpath(path)}"
    return finish(u, Plan(cmd, "sort", [path] + why))


