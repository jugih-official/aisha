    m = re.fullmatch(r"(?:ignore|gitignore|git\s+ignore)\s+(?:the\s+|all\s+)?(?:file\s+|folder\s+|directory\s+)?(?P<f>\S+)(?:\s+(?:folder|directory|dir|file|files))?(?:\s+in\s+git)?|"
