# How ls lists by default: one per line with only size (K, M, G), last modified time and name, folders first,
# then files, each newest first, in color (folders blue, programs green, links cyan: ls's own
# colors, or LS_COLORS). -1, -C, -x or -m still pick another layout, and into a pipe or a file it
# gives names only, as ls does ('ls | wc -l', '$(ls)'). Loaded before the files above, so an ls
# alias or function there (or 'unset -f ls') wins. ll/la/l are Debian's, through the same ls.
LS_STYLE = "--color=auto --group-directories-first -t"
DEFAULT_ALIASES = (
    # on screen: ls -ogh (no owner, no group) without the permissions and link count in front
    "ls() { local __a __l=1; [ -t 1 ] || __l=; for __a; do case $__a in --) break ;; --*) ;; "
    "-*[1Cxm]*) __l= ;; esac; done\n"
    "  if [ -n \"$__l\" ]; then command ls -ogh " + LS_STYLE.replace("auto", "always") + " \"$@\" "
    "| sed -E '/^total [0-9]/d; s/^[^ ]+ +[0-9]+ //'; return ${PIPESTATUS[0]}; fi\n"
    "  command ls " + LS_STYLE + " \"$@\"; }\n"
    "dir() { ls \"$@\"; }\n"
    "alias ll='ls -alF' la='ls -A' l='ls -CF'")


class ExitShell(Exception):
    def __init__(self, code: int = 0):
