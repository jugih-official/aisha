# Folded together only when comparing with the bank (too loose for the rules).
MODEL_SYNONYMS = dict(SYNONYMS, make="create", new="create", touch="create", remove="delete", rm="delete",
                      view="show", print="show", see="show", ram="memory", storage="space", room="space",
                      programs="processes", program="process", apps="processes", largest="big", biggest="big",
