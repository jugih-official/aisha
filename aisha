_FULL_VOCAB: set | None = None


def fix_typos(text: str) -> tuple[str, list[str]]:
    """Replace whole plain words (never file names or quotes) one typo off a known word."""
    global _FULL_VOCAB
    if _FULL_VOCAB is None:
        _FULL_VOCAB = (VOCAB | harvest_vocab()) - COMMON
    vocab = _FULL_VOCAB
    fixes, out, quoted = [], [], False
    for tok in text.split(" "):
        opens = tok[:1] in ("'", '"')
        closes = len(tok) > 1 and tok[-1:] in ("'", '"')
        if opens and not closes:
            quoted = True
        w = tok.lower()
        if (not quoted and not opens and len(w) >= 4 and w.isalpha() and w not in vocab and w not in FILLER
                and w not in TIMEISH and w not in GENERIC and w not in COMMON):
            cands = sorted(v for v in vocab if one_edit_apart(w, v))
            if any(w.startswith(c) for c in cands):   # "deleted", "removed": real words
                cands = []
            if len(cands) == 1:
                fixes.append(f"{w}→{cands[0]}")
                tok = cands[0]
        if quoted and closes and not opens:
            quoted = False
        elif opens and closes:
            pass
        out.append(tok)
    return " ".join(out), fixes


# Words around a request that carry no meaning: "could you ... for me, thanks".
POLITE_HEAD = re.compile(
    r"^\s*(?:(?:hey|hi|hello|ok|okay|so|um+|uh+|well|yo|right|alright|now)\b[,!.:]*\s+|"
    r"(?:please|pls|plz|kindly|just|quickly)\s+|(?:can|could|would|will)\s+you\s+(?:please\s+|kindly\s+)?|"
    r"(?:i(?:\s+want|\s+wanna|\s+need|\s+would\s+like|'d\s+like|\s+d\s+like|\s+am\s+trying|'m\s+trying|\s+have)\s+to\s+|i\s+wanna\s+)|"
    r"help\s+me\s+(?:to\s+)?|go\s+ahead\s+and\s+|let'?s\s+|try\s+(?:to|and)\s+|be\s+so\s+kind\s+and\s+)+", re.I)
POLITE_TAIL = re.compile(
    r"(?:(?<!from)(?<!until)(?<!till)[\s,]+(?:please|pls|plz|thanks|thank\s+you|thx|ty|for\s+me|now|asap|quickly|right\s+now|if\s+you\s+can|"
    r"if\s+possible|kindly)\b)+[\s!.?]*$", re.I)


def strip_politeness(text: str) -> str:
    out = POLITE_TAIL.sub("", POLITE_HEAD.sub("", text)).strip()
    return out if out else text.strip()


# "how do I ...": show the command, don't run it.
QUESTION_RE = re.compile(
    r"^\s*(?:(?:hey|hi|hello|ok|okay|so|um|well|please|quick\s+question)[,!.:]*\s+)*"
    r"(?:(?:how|what)\s+(?:do|can|would|should)\s+(?:i|you|one|we)\s+(?:use\s+to\s+)?|how\s+to\s+|"
    r"what(?:'s|\s+is)\s+(?:the\s+)?(?:bash\s+|shell\s+|linux\s+)?command\s+(?:to|for)\s+|"
    r"which\s+command\s+(?:do\s+i\s+use\s+to\s+|to\s+use\s+to\s+|)?)", re.I)


def interpret(text: str, cwd: str) -> Plan | None:
    """Best deterministic plan for a sentence. "how do I ..." plans are only shown."""
    text = strip_politeness(text)
    q = QUESTION_RE.match(text)
    if q and text[q.end():].strip():
        plan = _interpret_fixing(text[q.end():].rstrip(" ?"), cwd)
        if plan and not plan.runs_on_question:
            plan.show_only = True
            plan.why.append("shown, not run: question form")
    else:
        plan = _interpret_fixing(text, cwd)
    if plan and not plan.destructive and not plan.checked and needs_care(plan.command):
        plan.destructive = True      # whatever built it: changing things always asks
    return plan


def _interpret_fixing(text: str, cwd: str) -> Plan | None:
    """Best plan, retrying once with typos fixed."""
    best = _interpret(text, cwd)
    if best is not None and best.confidence >= 0.999:
        return best
    m = re.match(r"^(.+?)\s+(create|make|delete|remove|erase|show|open|edit|find|list|copy|move|rename|extract|"
                 r"compress|zip|unzip|unpack|count|search|kill|stop|display|print|sort)(?:\s+(?:it|them|please|pls|now))*\s*[?!.]?$", text, re.I)
    if m and not re.match(r"^\s*(?:create|make|delete|remove|show|open|edit|find|list|copy|move|rename|how|what|which)\b",
                          text, re.I):
        again = _interpret(f"{m.group(2)} {m.group(1)}", cwd)
        if again and (best is None or again.confidence > best.confidence):
            again.why.append(f"read as: {m.group(2)} {m.group(1)}")
            best = again
            if best.confidence >= 0.999:
                return best
    syn, swaps = apply_synonyms(text)
    if swaps:
        again = _interpret(syn, cwd)
        if again and (best is None or again.confidence > best.confidence):
            again.why.append("read " + ", ".join(swaps))
            best = again
            if best.confidence >= 0.999:
                return best
        text = syn
    fixed, fixes = fix_typos(text)
    if fixes:
        fixed, more = apply_synonyms(fixed)
        fixes += more
        again = _interpret(fixed, cwd)
        targets = {f.split("→")[1] for f in fixes}
        used_as_keyword = any(stem(t) in again.keywords or t in again.keywords for t in targets) if again else True
        if again and not used_as_keyword and (best is None or again.confidence > best.confidence):
            again.why.append("read " + ", ".join(fixes))
            return again
    return best


def _interpret(text: str, cwd: str) -> Plan | None:
    best = None
    for handler in HANDLERS:
        try:
            plan = handler(Utterance(text, cwd))
        except (ValueError, IndexError, KeyError, re.error):
            continue
        if plan and (best is None or plan.confidence > best.confidence):
            best = plan
    return best


