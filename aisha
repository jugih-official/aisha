class LLMError(Exception):
    pass


class LLM:
    def __init__(self, cfg: dict):
        self.cfg = cfg

    @property
    def enabled(self) -> bool:
        return str(self.cfg["llm"]).lower() not in ("off", "0", "no", "false", "none")

    @property
    def label(self) -> str:
        return f"{self.cfg['llm_model']} at {self.cfg['llm_url']}"

    def _post(self, messages: list[dict]) -> str:
        url = self.cfg["llm_url"].rstrip("/") + "/chat/completions"
        body = json.dumps({"model": self.cfg["llm_model"], "messages": messages,
                           "temperature": 0, "max_tokens": 256, "stream": False}).encode()
        headers = {"Content-Type": "application/json"}
        if self.cfg.get("llm_key"):
            headers["Authorization"] = f"Bearer {self.cfg['llm_key']}"
        req = urllib.request.Request(url, data=body, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=self.cfg["llm_timeout"]) as r:
                data = json.load(r)
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            if e.code == 404 and "model" in detail.lower():
                raise LLMError(f"model {self.cfg['llm_model']} is not installed "
                               f"(try: ollama pull {self.cfg['llm_model']})") from None
            raise LLMError(f"LLM server returned HTTP {e.code}: {detail}") from None
        except (urllib.error.URLError, ConnectionError, TimeoutError, OSError) as e:
            reason = getattr(e, "reason", e)
            raise LLMError(f"no LLM reachable at {self.cfg['llm_url']} ({reason}). "
                           f"Start one with: ollama serve & ollama pull {self.cfg['llm_model']}") from None
        try:
            return data["choices"][0]["message"]["content"] or ""
        except (KeyError, IndexError, TypeError):
            raise LLMError(f"unexpected reply from LLM server: {str(data)[:200]}") from None

    def command_for(self, request: str, cwd: str, hints: str) -> str | None:
        try:
            entries = sorted(os.listdir(cwd))
        except OSError:
            entries = []
        shown = [e + ("/" if os.path.isdir(os.path.join(cwd, e)) else "") for e in entries[:60]]
        more = f" (+{len(entries) - 60} more)" if len(entries) > 60 else ""
        context = (f"Current directory: {cwd}\n"
                   f"Entries here: {', '.join(shown) or '(empty)'}{more}\n")
        if hints:
            context += f"Partial parse by the rule engine (may be wrong): {hints}\n"
        messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        for q, a in FEWSHOT:
            messages += [{"role": "user", "content": q}, {"role": "assistant", "content": a}]
        messages.append({"role": "user", "content": f"{context}Request: {request}"})
        for attempt in range(2):
            raw = self._post(messages)
            cmd = clean_llm_command(raw)
            if cmd is None:
                return None
            problem = validate_command(cmd)
            if not problem:
                return cmd
            messages += [{"role": "assistant", "content": raw},
                         {"role": "user", "content": f"That is not a valid command ({problem}). "
                                                     "Reply with one bash command only."}]
        raise LLMError(f"the model did not produce a valid command (last try: {cmd})")


def clean_llm_command(text: str) -> str | None:
    text = text.strip()
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.S).strip()
    m = re.search(r"```(?:bash|sh|shell|console)?\s*\n?(.*?)```", text, re.S)
    if m:
        text = m.group(1).strip()
    lines = [l.rstrip() for l in text.splitlines() if l.strip()]
    if not lines:
        return None
    joined, buf = [], ""
    for line in lines:
        if line.endswith("\\"):
            buf += line[:-1].strip() + " "
            continue
        joined.append((buf + line.strip()).strip())
        buf = ""
    cmd = joined[0]
    cmd = re.sub(r"^(?:\$|>|#)\s+", "", cmd)
    cmd = re.sub(r"^(?:command|bash)\s*:\s*", "", cmd, flags=re.I)
    cmd = cmd.strip("`").strip()
    if cmd.upper().rstrip(".") == "NONE" or not cmd:
        return None
    return cmd


def validate_command(cmd: str) -> str | None:
    r = subprocess.run(["bash", "-n", "-c", cmd], capture_output=True, text=True)
    if r.returncode != 0:
        return (r.stderr.strip().splitlines() or ["syntax error"])[-1]
    try:
        first = shlex.split(cmd)[0]
    except (ValueError, IndexError):
        return "cannot parse"
    if "=" in first or first in SHELL_BUILTINS or first.startswith(("./", "/", "~", "$")) \
            or first in ("for", "while", "if", "{", "(") or shutil.which(first):
        return None
    return f"'{first}' is not an installed command"


# ---- memory of approved LLM answers -----------------------------------------------

class Memory:
    def __init__(self, path: str):
        self.path = path
        try:
            with open(path) as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}

    @staticmethod
    def key(phrase: str) -> str:
        return " ".join(re.sub(r"[^\w\s./~*'\"-]", " ", phrase.lower()).split())

    def get(self, phrase: str) -> str | None:
        hit = self.data.get(self.key(phrase))
        return hit["command"] if hit else None

    def remember(self, phrase: str, command: str) -> None:
        k = self.key(phrase)
        entry = self.data.get(k, {"uses": 0})
        entry.update(command=command, saved=time.strftime("%Y-%m-%d %H:%M"))
        entry["uses"] = entry.get("uses", 0) + 1
        self.data[k] = entry
        self._save()

    def forget(self, phrase: str) -> bool:
        if self.data.pop(self.key(phrase), None) is None:
            return False
        self._save()
        return True

    def _save(self) -> None:
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.data, f, indent=2, sort_keys=True)
        os.replace(tmp, self.path)


# ---- the shell --------------------------------------------------------------------

HELP = """aisha — type bash, or say what you want.

  find pdfs bigger than 10mb in downloads
  show the 5 newest files here
  which files mention "invoice"
  what's eating my disk
  how much ram is free
  copy notes.txt to backup
  !ls -la            force plain bash
  ?<request>         skip the rules and ask the LLM
  explain <request>  show what would run, run nothing
  learned            phrases remembered from the LLM
  forget <request>   drop a remembered phrase
  llm                check the local LLM
  exit               leave (or Ctrl-D)
"""


class Shell:
    def __init__(self, cfg: dict, dry_run: bool = False):
        self.cfg = cfg
        self.dry_run = dry_run
        self.cwd = os.getcwd()
        self.env = dict(os.environ)
        self.env["AISHA"] = VERSION
        self.rc = 0
        self.memory = Memory(LEARNED_FILE)
        self.llm = LLM(cfg)

    # -- entry point for one line
    def handle(self, line: str) -> int:
        line = line.strip()
        if not line or line.startswith("#"):
            return self.rc
        word = line.split()[0]
        if line in ("exit", "quit", "logout", "bye"):
            raise EOFError
        if line in ("help", "?"):
            say(HELP)
            return 0
        if line == "learned":
            for k, v in sorted(self.memory.data.items()):
                say(f"{cyan(k)}\n  $ {v['command']}  {dim('(used %d×)' % v.get('uses', 1))}")
            if not self.memory.data:
                say(dim("nothing learned yet"))
            return 0
        if word == "forget":
            say("forgotten" if self.memory.forget(line[6:].strip()) else dim("not in memory"))
            return 0
        if line == "llm":
            return self.llm_status()
        if line == "history":
            return self.show_history()
        if word == "explain":
            saved, self.dry_run = self.dry_run, True
            try:
                return self.natural(line[7:].strip())
            finally:
                self.dry_run = saved
        if line.startswith("!"):
            self.rc = self.run(line[1:].strip())
            return self.rc
        if line.startswith("?"):
            self.rc = self.via_llm(line[1:].strip(), interpret(line[1:].strip(), self.cwd))
            return self.rc
        if looks_like_shell(line, self.env.get("PATH"), self.cwd, self.cfg["threshold"]):
            self.rc = self.run(line)
            return self.rc
        self.rc = self.natural(line)
        return self.rc

    def natural(self, line: str) -> int:
        remembered = self.memory.get(line)
        if remembered:
            plan = Plan(remembered, "remembered", ["you approved this before"], source="learned",
                        destructive=looks_destructive(remembered))
            return self.execute(plan)
        plan = interpret(line, self.cwd)
        if plan and plan.confidence >= self.cfg["threshold"]:
            return self.execute(plan)
        if self.llm.enabled:
            return self.via_llm(line, plan)
        if plan:
            say(yellow("not sure I understood — best guess:"))
            plan.source = "guess"
            return self.execute(plan)
        say(yellow("I don't know how to do that yet.") + dim(" (no LLM configured: aisha --setup)"))
        return 1

    def via_llm(self, line: str, partial: Plan | None) -> int:
        if not self.llm.enabled:
            say(red("the LLM is turned off (AISHA_LLM=off)"))
            return 1
        hints = ""
        if partial:
            hints = f"{partial.rationale()}; draft command: {partial.command}"
            if partial.unknown:
                hints += f"; words the rules could not place: {' '.join(partial.unknown)}"
        say(dim(f"… rules not sure, asking {self.cfg['llm_model']}"))
        t0 = time.time()
        try:
            cmd = self.llm.command_for(line, self.cwd, hints)
        except LLMError as e:
            say(red(f"LLM: {e}"))
            if partial:
                say(yellow("falling back to the rules' best guess:"))
                partial.source = "guess"
                return self.execute(partial)
            return 1
        if not cmd:
            say(yellow("that does not look like something a shell command can do."))
            return 1
        plan = Plan(cmd, "llm", [f"{self.cfg['llm_model']}, {time.time() - t0:.1f}s"], source="llm",
                    destructive=looks_destructive(cmd))
        rc = self.execute(plan, phrase=line)
        return rc

    # -- showing and running a plan
    def execute(self, plan: Plan, phrase: str | None = None) -> int:
        say(dim("→ " + plan.rationale()))
        say(bold("$ ") + plan.command)
        if self.dry_run:
            return 0
        need = plan.destructive or self.cfg["confirm"] == "always" or \
            (self.cfg["confirm"] == "llm" and plan.source in ("llm", "guess"))
        if plan.destructive and plan.preview:
            self.show_preview(plan.preview)
        if need:
            if plan.destructive:
                say(yellow(plan.warning or "! this deletes or changes things"))
                ans = ask("run? [y/N] ")
                ok = ans is not None and ans.strip().lower() in ("y", "yes")
            else:
                ans = ask("run? [Y/n] ")
                ok = ans is not None and ans.strip().lower() in ("", "y", "yes")
            if not ok:
                say(dim("skipped"))
                return 1
        rc = self.run(plan.command)
        if plan.source == "llm" and phrase and rc == 0:
            self.memory.remember(phrase, plan.command)
            say(dim("(remembered — next time this runs without the LLM)"))
        return rc

    def show_preview(self, cmd: str) -> None:
        r = subprocess.run(["bash", "-c", cmd], cwd=self.cwd, env=self.env,
                           capture_output=True, text=True)
        lines = r.stdout.splitlines()
        if not lines:
            say(dim("(nothing matches)"))
            return
        say(dim(f"{len(lines)} match{'es' if len(lines) != 1 else ''}:"))
        for l in lines[:10]:
            say(dim("  " + l))
        if len(lines) > 10:
            say(dim(f"  … and {len(lines) - 10} more"))

    def run(self, cmd: str) -> int:
        """Run in bash; keep cd and export effects for the next line."""
        fd, state = tempfile.mkstemp(prefix="aisha-state-")
        os.close(fd)
        script = ("__aisha_save() { local rc=$?; { printf '%s\\0' \"$PWD\"; env -0; } "
                  "> \"$__AISHA_STATE\" 2>/dev/null; exit $rc; }\n"
                  "trap __aisha_save EXIT\n"
                  "shopt -s globstar extglob 2>/dev/null\n"
                  f"{cmd}\n")
        env = dict(self.env, __AISHA_STATE=state, PWD=self.cwd)
        old = signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            r = subprocess.run(["bash", "-c", script], cwd=self.cwd, env=env,
                               preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))
            rc = r.returncode
        except FileNotFoundError:
            say(red("bash not found"))
            return 127
        finally:
            signal.signal(signal.SIGINT, old)
        try:
            with open(state, "rb") as f:
                raw = f.read()
        except OSError:
            raw = b""
        finally:
            try:
                os.unlink(state)
            except OSError:
                pass
        if raw:
            parts = raw.split(b"\0")
            new_cwd = parts[0].decode(errors="replace")
            new_env = {}
            for item in parts[1:]:
                if b"=" in item:
                    k, v = item.split(b"=", 1)
                    new_env[k.decode(errors="replace")] = v.decode(errors="replace")
            for k in ("__AISHA_STATE", "_", "SHLVL", "BASHOPTS", "SHELLOPTS"):
                new_env.pop(k, None)
            if new_env:
                self.env = new_env
            if new_cwd and os.path.isdir(new_cwd) and new_cwd != self.cwd:
                self.env["OLDPWD"] = self.cwd
                self.cwd = new_cwd
        if rc < 0:
            rc = 128 - rc
        return rc

    def llm_status(self) -> int:
        if not self.llm.enabled:
            say("LLM: off")
            return 1
        say(f"LLM: {self.llm.label}")
        try:
            t0 = time.time()
            cmd = self.llm.command_for("list the files here", self.cwd, "")
            say(green(f"ok ({time.time() - t0:.1f}s): ") + str(cmd))
            return 0
        except LLMError as e:
            say(red(str(e)))
            return 1

    def show_history(self) -> int:
        try:
            import readline
            n = readline.get_current_history_length()
            for i in range(max(1, n - 50), n + 1):
                item = readline.get_history_item(i)
                if item:
                    print(f"{i:5}  {item}")
        except ImportError:
            pass
        return 0

    # -- interactive loop
    def prompt(self) -> str:
        home = os.path.expanduser("~")
        where = "~" + self.cwd[len(home):] if self.cwd == home or self.cwd.startswith(home + "/") else self.cwd
        if len(where) > 40:
            where = "…/" + "/".join(where.rstrip("/").split("/")[-2:])
        mark = "❯" if self.rc == 0 else "✗"
        if not (sys.stdout.isatty() and not os.environ.get("NO_COLOR")):
            return f"aisha {where} {mark} "
        # \001..\002 tell readline the escapes take no width
        c = lambda code, s: f"\001\033[{code}m\002{s}\001\033[0m\002"
        return f"{c('36', 'aisha')} {c('34', where)} {c('32' if self.rc == 0 else '31', mark)} "

    def repl(self) -> int:
        try:
            import readline
            os.makedirs(CFG_DIR, exist_ok=True)
            try:
                readline.read_history_file(HISTORY_FILE)
            except OSError:
                pass
            readline.set_history_length(5000)
            readline.set_completer_delims(" \t\n;|&><")
            readline.set_completer(self.complete)
            readline.parse_and_bind("tab: complete")
        except ImportError:
            readline = None
        llm = self.llm.label if self.llm.enabled else "off"
        say(dim(f"aisha {VERSION} — type bash or plain words. 'help' for examples. LLM fallback: {llm}"))
        while True:
            try:
                line = input(self.prompt())
            except EOFError:
                say()
                break
            except KeyboardInterrupt:
                say("^C")
                continue
            try:
                self.handle(line)
            except EOFError:
                break
            except KeyboardInterrupt:
                say("^C")
        if readline:
            try:
                readline.write_history_file(HISTORY_FILE)
            except OSError:
                pass
        return self.rc

    def complete(self, text: str, state: int):
        base = os.path.expanduser(text)
        pattern = (base if os.path.isabs(base) else os.path.join(self.cwd, base)) + "*"
        matches = []
        for m in sorted(globmod.glob(pattern)):
            shown = m if os.path.isabs(base) else os.path.relpath(m, self.cwd)
            if text.startswith("~"):
                shown = "~" + m[len(os.path.expanduser("~")):]
            matches.append(shown + ("/" if os.path.isdir(m) else ""))
        return matches[state] if state < len(matches) else None


# ---- setup helper ------------------------------------------------------------------

def setup() -> int:
    cfg = load_config()
    say(bold("aisha LLM fallback setup"))
    say(f"current: {cfg['llm_model']} at {cfg['llm_url']}")
    if not shutil.which("ollama"):
        say("\nThe easiest local backend is Ollama:")
        say("  curl -fsSL https://ollama.com/install.sh | sh")
        say(f"  ollama pull {cfg['llm_model']}")
        say("\nAny OpenAI-compatible server works too (llama.cpp's llama-server, LM Studio):")
        say(f"  set llm_url / llm_model in {CFG_FILE}, or AISHA_LLM_URL / AISHA_LLM_MODEL")
        return 1
    ans = ask(f"Pull {cfg['llm_model']} with ollama now? [Y/n] ")
    if ans is not None and ans.strip().lower() in ("", "y", "yes"):
        rc = subprocess.call(["ollama", "pull", cfg["llm_model"]])
        if rc != 0:
            return rc
    os.makedirs(CFG_DIR, exist_ok=True)
    if not os.path.exists(CFG_FILE):
        with open(CFG_FILE, "w") as f:
            json.dump({k: v for k, v in DEFAULTS.items()}, f, indent=2)
        say(dim(f"wrote {CFG_FILE}"))
    return Shell(cfg).llm_status()


USAGE = """usage: aisha                      interactive shell
       aisha <request or command>  run one line and exit
       aisha -c '<line>'           same, bash-style
       aisha -n <request>          show what would run, run nothing
       aisha --setup               set up the local LLM fallback
       aisha --version
"""


def main(argv: list[str]) -> int:
    cfg = load_config()
    dry = False
    args = list(argv)
    if args and args[0] in ("-h", "--help"):
        print(USAGE + "\n" + HELP)
        return 0
    if args and args[0] == "--version":
        print(f"aisha {VERSION}")
        return 0
    if args and args[0] == "--setup":
        return setup()
    if args and args[0] == "-n":
        dry, args = True, args[1:]
    if args and args[0] == "-c":
        args = args[1:]
    shell = Shell(cfg, dry_run=dry)
    if args:
        try:
            return shell.handle(" ".join(args))
        except EOFError:
            return 0
    if not sys.stdin.isatty():
        rc = 0
        for line in sys.stdin:
            try:
                rc = shell.handle(line)
            except EOFError:
                break
        return rc
    return shell.repl()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
