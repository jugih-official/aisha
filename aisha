_COLOR = sys.stderr.isatty() and not os.environ.get("NO_COLOR")


def _paint(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _COLOR else s


def dim(s):    return _paint("2", s)
def bold(s):   return _paint("1", s)
def red(s):    return _paint("1;31", s)
def green(s):  return _paint("1;32", s)
def yellow(s): return _paint("1;33", s)
def cyan(s):   return _paint("36", s)


def say(s: str = "") -> None:
    print(s, file=sys.stderr, flush=True)


def ask(prompt: str) -> str | None:
    """Read one answer, from the terminal even when stdin is a pipe.

    None means nobody can answer (no terminal at all): callers treat it as no.
    """
    if sys.stdin.isatty():
        try:
            return input(prompt)
        except EOFError:
            return None
    try:
        with open("/dev/tty") as tty:
            sys.stderr.write(prompt)
            sys.stderr.flush()
            return tty.readline().strip()
    except OSError:
        sys.stderr.write(prompt + "(no terminal to answer — not running)\n")
        return None


