def http_json(url: str):
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/vnd.github+json"})
    with url_open(req, timeout=30) as r:
        return json.load(r)


def download(url: str, dest: str, label: str) -> str:
    """Download with a progress line, resuming a partial .part file when the
    server confirms it is still the same file (If-Range)."""
    import urllib.request
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part, tagfile = dest + ".part", dest + ".part.tag"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    tag = ""
    if have and os.path.exists(tagfile):
        with open(tagfile) as f:
            tag = f.read().strip()
    if have and not tag:
        have = 0                          # cannot prove it is the same file: start over
    headers = {"User-Agent": USER_AGENT}
    if have:
        headers["Range"] = f"bytes={have}-"
        headers["If-Range"] = tag
    try:
        r = url_open(urllib.request.Request(url, headers=headers), timeout=60)
    except urllib.error.HTTPError as e:
        if e.code != 416:
            raise
        for f in (part, tagfile):          # stale partial file: start over
            if os.path.exists(f):
                os.unlink(f)
        return download(url, dest, label)
    with r:
        if have and r.status != 206:       # the file changed, or no range support
            have = 0
        new_tag = r.headers.get("ETag") or r.headers.get("Last-Modified") or ""
        with open(tagfile, "w") as f:
            f.write(new_tag)
        total = int(r.headers.get("Content-Length") or 0) + have
        done, last = have, 0.0
        with open(part, "ab" if have else "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if time.time() - last > 0.25 or done == total:
                    last = time.time()
                    pct = f"{100 * done / total:5.1f}%" if total else ""
                    sys.stderr.write(f"\r  {label}: {done / 1e6:8.1f} MB {pct}")
                    sys.stderr.flush()
    sys.stderr.write("\n")
    if total and os.path.getsize(part) != total:
        raise OSError(f"download incomplete ({os.path.getsize(part)} of {total} bytes); run setup again to resume")
    os.replace(part, dest)
    if os.path.exists(tagfile):
        os.unlink(tagfile)
    return dest


def pick_llama_asset(assets: list, machine: str | None = None) -> dict | None:
    """The plain CPU Linux build for this machine from a llama.cpp release."""
    machine = (machine or platform.machine()).lower()
    arch = {"x86_64": "x64", "amd64": "x64", "aarch64": "arm64", "arm64": "arm64"}.get(machine)
    if not arch:
        return None
    for a in assets:
        if re.search(rf"-bin-ubuntu-{arch}\.(?:zip|tar\.gz|tgz)$", a.get("name", "")):
            return a
    return None


def extract_archive(path: str, dest: str) -> None:
    """Unpack a .zip or .tar.gz into dest. Nothing is ever written outside dest:
    every file's real parent folder is checked just before it is written, so
    neither ../ names nor chains of symlinks can escape. Hard links become copies."""
    os.makedirs(dest, exist_ok=True)
    root = os.path.realpath(dest)

    def inside(p: str) -> bool:
        return p == root or p.startswith(root + os.sep)

    def target_for(name: str) -> str:
        name = name.lstrip("/")
        lexical = os.path.normpath(os.path.join(root, name))
        if not inside(lexical):
            raise OSError(f"unsafe path in archive: {name}")
        parent = os.path.dirname(lexical)
        os.makedirs(parent, exist_ok=True)
        if not inside(os.path.realpath(parent)):
            raise OSError(f"archive path escapes through a link: {name}")
        return lexical

    def write(name: str, data_stream, mode: int) -> None:
        target = target_for(name)
        if os.path.islink(target):
            os.unlink(target)
        with open(target, "wb") as out:
            shutil.copyfileobj(data_stream, out)
        os.chmod(target, (mode & 0o777) or 0o644)

    if path.endswith(".zip"):
        import zipfile
        with zipfile.ZipFile(path) as z:
            for info in z.infolist():
                if info.is_dir():
                    os.makedirs(target_for(info.filename.rstrip("/") + "/x")[:-2], exist_ok=True)
                    continue
                with z.open(info) as src:
                    write(info.filename, src, (info.external_attr >> 16) or 0o644)
        return
    import tarfile
    with tarfile.open(path) as t:
        members = t.getmembers()
        by_name = {m.name: m for m in members}
        for m in members:
            if m.isdir():
                d = target_for(m.name.rstrip("/") + "/x")[:-2]
                os.makedirs(d, exist_ok=True)
            elif m.isfile():
                write(m.name, t.extractfile(m), m.mode)
            elif m.islnk():                      # hard link: copy the file it points to
                src = by_name.get(m.linkname)
                if src is not None and src.isfile():
                    write(m.name, t.extractfile(src), src.mode)
            elif m.issym():
                link = target_for(m.name)
                if os.path.isabs(m.linkname):
                    raise OSError(f"absolute symlink in archive: {m.name}")
                if not inside(os.path.normpath(os.path.join(os.path.dirname(link), m.linkname))):
                    raise OSError(f"symlink points outside the archive: {m.name}")
                if os.path.lexists(link):
                    os.unlink(link)
                os.symlink(m.linkname, link)
            # devices, fifos and the like are skipped


def find_server(root: str) -> str | None:
    for dirpath, _, files in os.walk(root):
        if "llama-server" in files:
            path = os.path.join(dirpath, "llama-server")
            os.chmod(path, os.stat(path).st_mode | 0o755)
            return path
    return None


def check_server(server: str) -> tuple[bool, str]:
    try:
        r = subprocess.run([server, "--version"], capture_output=True, text=True, timeout=30,
                           env=server_env(server))
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)
    out = (r.stdout + r.stderr).strip()
    if r.returncode != 0:
        if "GLIBC" in out:
            out += ("\nThis prebuilt llama.cpp needs a newer C library than this system has. "
                    "Use a newer Debian, or install Ollama and run 'aisha --setup' again.")
        return False, out
    return True, out.splitlines()[-1] if out else "ok"


def install_llama_runtime() -> str:
    say("  asking GitHub for the latest llama.cpp release …")
    rel = http_json(LLAMA_RELEASES)
    asset = pick_llama_asset(rel.get("assets", []))
    if not asset:
        raise OSError(f"no prebuilt llama.cpp for {platform.machine()} in release {rel.get('tag_name')}")
    tag = rel.get("tag_name", "latest")
    archive = download(asset["browser_download_url"], os.path.join(DATA_DIR, "downloads", asset["name"]),
                       asset["name"])
    dest = os.path.join(DATA_DIR, "llama", tag)
    extract_archive(archive, dest)
    os.unlink(archive)
    server = find_server(dest)
    if not server:
        raise OSError(f"{asset['name']} has no llama-server in it")
    return server


def server_answers(url: str) -> bool:
    try:
        with url_open(url.rstrip("/") + "/models", timeout=3) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError, ValueError):
        return False


def confirm(question: str, yes: bool) -> bool:
    if yes:
        say(question + " yes")
        return True
    ans = ask(question + " [Y/n] ")
    return ans is not None and ans.strip().lower() in ("", "y", "yes")


def setup(args: list[str]) -> int:
    cfg = load_config()
    yes = "--yes" in args or "-y" in args
    size = next((a for a in args if a in MODELS), "1.5b")
    if "remove" in args:
        shutil.rmtree(DATA_DIR, ignore_errors=True)
        save_config({"llm_server": None, "llm_model_file": None, "llm_url": None, "llm_model": None})
        say(f"removed {DATA_DIR} and the local model settings")
        return 0
    say(bold("aisha: local LLM setup"))
    say(dim("The rules work without a model; the model only helps with requests they don't understand."))
    managed = bool(cfg.get("llm_server"))
    if not managed and "--download" not in args and server_answers(cfg["llm_url"]):
        say(f"An LLM server is already answering at {cfg['llm_url']}; using it.")
        return Shell(load_config()).llm_status()
    if not managed and "--download" not in args and shutil.which("ollama"):
        model = f"qwen2.5-coder:{size}"
        say(f"Ollama is installed: aisha can use it with {model}.")
        if confirm(f"Pull {model} with ollama now?", yes):
            rc = subprocess.call(["ollama", "pull", model])
            if rc != 0:
                return rc
            save_config({"llm_url": "http://127.0.0.1:11434/v1", "llm_model": model,
                         "llm_server": None, "llm_model_file": None})
            return Shell(load_config()).llm_status()
        return 1
    try:
        server = cfg.get("llm_server") if cfg.get("llm_server") and os.path.isfile(cfg["llm_server"]) else None
        server = server or shutil.which("llama-server") or find_server(os.path.join(DATA_DIR, "llama"))
        if not server:
            if not confirm("Download llama.cpp's llama-server (about 30 MB, MIT license) from GitHub?", yes):
                return 1
            server = install_llama_runtime()
        ok, msg = check_server(server)
        if not ok:
            say(red(f"llama-server does not run here:\n{msg}"))
            return 1
        say(f"  runtime: {server} ({msg})")
        repo, name, approx = MODELS[size]
        model = os.path.join(DATA_DIR, "models", name)
        if not os.path.isfile(model):
            if not confirm(f"Download {name} ({approx}, Apache-2.0) from Hugging Face?", yes):
                return 1
            download(f"https://huggingface.co/{repo}/resolve/main/{name}", model, name)
        say(f"  model:   {model}")
    except (OSError, urllib.error.URLError, ValueError) as e:
        say(red(f"setup failed: {e}"))
        return 1
    save_config({"llm_url": f"http://127.0.0.1:{MANAGED_PORT}/v1", "llm_model": f"qwen2.5-coder-{size}",
                 "llm_server": server, "llm_model_file": model})
    say(dim(f"saved to {CFG_FILE}"))
    return Shell(load_config()).llm_status()


def doctor() -> int:
    """Check what aisha relies on and what it will fall back to."""
    cfg = load_config()
    ok = True

    def line(good: bool | None, what: str, note: str = "") -> None:
        mark = green("ok ") if good else (yellow("-- ") if good is None else red("!! "))
        say(f"  {mark} {what}" + (dim(f"  {note}") if note else ""))

    say(bold(f"aisha {VERSION} doctor"))
    py = sys.version_info
    line(py >= (3, 9), f"Python {py.major}.{py.minor}.{py.micro}", "3.9 or newer needed")
    ok &= py >= (3, 9)
    bash = shutil.which("bash")
    line(bool(bash), f"bash: {bash or 'missing'}")
    ok &= bool(bash)
    try:
        import readline
        backend = "libedit" if "libedit" in (readline.__doc__ or "") else "GNU readline"
        line(True, f"line editing: {backend}")
    except ImportError:
        line(None, "line editing: none", "no history or Tab completion")
    say(bold("tools"))
    for tool, fallback in [("find", None), ("grep", None), ("du", None), ("numfmt", None),
                           ("sensible-editor", "$EDITOR or nano"), ("less", "cat"),
                           ("ps", "process questions will not work"), ("free", "/proc/meminfo"),
                           ("ip", "hostname -I"), ("ss", "/proc/net/tcp"), ("zip", "python3 -m zipfile"),
                           ("unzip", "python3 -m zipfile"), ("curl", "wget or Python urllib"),
                           ("xdg-open", "lists the file instead of opening it")]:
        here = shutil.which(tool)
        if not here and fallback is None:
            ok = False
        line(True if here else (None if fallback else False), tool,
             "" if here else f"missing → {fallback}" if fallback else "missing — needed")
    say(bold("settings"))
    line(True, f"config: {CFG_FILE}", "exists" if os.path.exists(CFG_FILE) else "defaults (no file yet)")
    rc = [f for f in RC_FILES if os.path.isfile(os.path.expanduser(f))]
    line(True, "startup files: " + (", ".join(rc) if rc else "none"), "aliases, functions, exports")
    line(True, f"remembered phrases: {len(Memory(LEARNED_FILE).data)}")
    say(bold("local model"))
    llm = LLM(cfg)
    if not llm.enabled:
        line(None, "off (AISHA_LLM=off)")
    elif llm.runtime.configured:
        good, msg = check_server(cfg["llm_server"])
        line(good, f"llama-server: {cfg['llm_server']}", msg)
        size = os.path.getsize(cfg["llm_model_file"]) / 1e9
        line(True, f"model: {os.path.basename(cfg['llm_model_file'])} ({size:.1f} GB)", "starts when needed")
    elif server_answers(cfg["llm_url"]):
        line(True, f"server answering at {cfg['llm_url']}", cfg["llm_model"])
    else:
        line(None, "none set up", "the rules still work; 'aisha --setup' adds a model")
    say(green("all good") if ok else red("something aisha needs is missing"))
    return 0 if ok else 1


# ---- entry point ------------------------------------------------------------------

USAGE = """usage: aisha                        interactive shell
       aisha <request or command>    run one line and exit
       aisha -n <request>            show what would run, run nothing
       aisha -c '<line>' [args]      like bash -c (plain words still work)
       aisha script.sh [args]        run a script with bash
       aisha --lines < file          handle stdin line by line, words included
       aisha --setup [0.5b|1.5b|3b] [--yes] [--download]
                                     set up the local LLM fallback
       aisha --setup remove          delete the downloaded runtime and model
       aisha --doctor                check what aisha relies on
       aisha --version
"""


def login_env() -> dict:
    """The environment a bash login shell would have (/etc/profile, ~/.profile)."""
    try:
        r = subprocess.run(["bash", "-l", "-c", "env -0"], capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    env = {}
    for item in r.stdout.split(b"\0"):
        if b"=" in item:
            k, v = item.split(b"=", 1)
            env[k.decode(errors="replace")] = v.decode(errors="replace")
    return env


def join_args(args: list[str]) -> str:
    """`aisha rm -f "build output"` must keep its quoting; `aisha what's here?` must not gain any."""
    if len(args) == 1:
        return args[0]
    if any(not a or re.search(r"""[\s;&|<>$`(){}*\[\]\\"]""", a.rstrip("?!.")) for a in args):
        return shlex.join(args)
    return " ".join(args)


def is_script(path: str) -> bool:
    if not os.path.isfile(path):
        return False
    if path.endswith((".sh", ".bash")):
        return True
    try:
        with open(path, "rb") as f:
            return f.read(2) == b"#!"
    except OSError:
        return False


def main(argv: list[str]) -> int:
    args = list(argv)
    login = os.path.basename(sys.argv[0]).startswith("-")
    while args and args[0] in ("-l", "--login", "-i"):
        login = login or args[0] != "-i"
        args = args[1:]
    if args and args[0] in ("-h", "--help"):
        print(USAGE + "\n" + HELP)
        return 0
    if args and args[0] == "--version":
        print(f"aisha {VERSION}")
        return 0
    if args and args[0] == "--setup":
        return setup(args[1:])
    if args and args[0] == "--doctor":
        return doctor()
    bash = ["bash", "-l"] if login else ["bash"]
    if args and args[0] == "-c":
        # ssh, scp, rsync and editors call $SHELL -c: real commands go straight
        # to bash, so aisha is safe as a login shell.
        if len(args) < 2:
            print("aisha: -c: option requires an argument", file=sys.stderr)
            return 2
        line, rest = args[1], args[2:]
        if ("\n" in line.strip() or line.lstrip().startswith("#") or not line.strip()
                or _looks_like_shell(line)):
            os.execvp("bash", bash + ["-c", line] + rest)
        args = [line]
    if args and args[0] == "--lines":
        lines = sys.stdin.read().splitlines()   # all of it now, so commands can't eat the rest
        try:
            fd = os.open("/dev/tty", os.O_RDWR)
        except OSError:
            fd = os.open(os.devnull, os.O_RDONLY)
        shell, rc = Shell(load_config()), 0
        shell.child_stdin = fd
        for line in lines:
            try:
                rc = shell.handle(line)
            except ExitShell as e:
                return e.code
        return rc
    dry = False
    if args and args[0] == "-n":
        dry, args = True, args[1:]
        if not args:
            print("aisha: -n needs a request, e.g. aisha -n delete old logs", file=sys.stderr)
            return 2
    if args and not dry and is_script(args[0]):
        os.execvp("bash", bash + args)
    cfg = load_config()
    if args:
        try:
            return Shell(cfg, dry_run=dry).handle(join_args(args))
        except ExitShell as e:
            return e.code
    if not sys.stdin.isatty():
        os.execvp("bash", bash + ["-s"])   # a script on stdin: plain bash semantics
    # A login shell started through a script launcher loses the leading "-" of
    # argv[0]; a session leader on a terminal with no arguments is one too.
    login = login or (os.getsid(0) == os.getpid() and not argv)
    shell = Shell(cfg, interactive=True)
    if login:
        shell.env.update(login_env())
        shell.env["AISHA"] = VERSION
    return shell.repl()


def _terminate(signum, _frame):
    raise ExitShell(128 + signum)


def cli() -> None:
    """Entry point for the installed launcher (/usr/bin/aisha imports this module)."""
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, _terminate)
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except ExitShell as e:      # SIGHUP/SIGTERM outside the prompt loop
        sys.exit(e.code)


if __name__ == "__main__":
    cli()
