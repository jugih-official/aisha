# Same idea as `ai`: anything that meaningfully deletes or overwrites data.

DESTRUCTIVE_RE = re.compile(
    r"""
    \b( rm | rmdir | shred | unlink | truncate | wipefs | fdisk | parted | sfdisk
      | mkfs(\.[a-z0-9]+)? )\b
    | \bfind\b[^|;&]*\s-delete\b
    | \bfind\b[^|;&]*-exec\s+rm\b
    | \bdd\b[^|;&]*\bof=/dev/
    | >\s*/dev/(sd|nvme|hd|mmc|loop)
    | \bgit\s+(reset\s+--hard|clean\s+-[a-z]*f)
    """,
    re.VERBOSE,
)


def looks_destructive(cmd: str) -> bool:
    return bool(DESTRUCTIVE_RE.search(cmd))


