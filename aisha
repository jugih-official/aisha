              r"exe|so|o|a|db|sqlite3?|docx?|xlsx?|pptx?|odt|ods|deb|rpm|jar|class|pyc)$")


def split_alternatives(p: str) -> list[str]:
    """Top-level a|b|c of a regex."""
    parts, depth, cur, esc, in_class = [], 0, "", False, False
    for c in p:
        if esc:
            esc = False
        elif c == "\\":
            esc = True
        elif in_class:
            in_class = c != "]"
        elif c == "[":
            in_class = True
        elif c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
        elif c == "|" and depth == 0:
            parts.append(cur)
            cur = ""
            continue
        cur += c
    return parts + [cur]


class Recipe:
    def __init__(self, label, patterns, cmd, *, slots=None, defaults=None, destructive=False, warning=None,
                 needs=(), git=False, gui=False, runs_on_question=False, preview=None, text_into=False):
        self.label, self.cmd, self.slots, self.preview = label, cmd, slots or {}, preview
        self.text_into = text_into      # writes {text} into {newfile}: never a file name, never an archive
        self.patterns = []
        for p in [patterns] if isinstance(patterns, str) else patterns:
            try:
                self.patterns.append(re.compile(p))
            except re.error:             # a slot named in two alternatives: one pattern each
                self.patterns += [re.compile(alt) for alt in split_alternatives(p)]
        self.defaults, self.destructive, self.warning = defaults or {}, destructive, warning
        self.needs, self.git, self.gui, self.runs_on_question = needs, git, gui, runs_on_question


SLOT_TYPES = {"file": "file", "path": "path", "dir": "dir", "newfile": "newfile", "host": "host", "url": "url",
              "n": "n", "m": "n", "word": "word", "user": "word", "pkg": "word", "var": "var", "text": "text",
              "cmdtext": "cmdtext", "remote": "remote", "city": "city", "algo": "algo", "unit": "raw",
              "when": "raw", "how": "raw", "app": "raw", "dest": "dest"}


def _slot(kind: str, raw: str, u: Utterance):
    tok = u.lit(raw.strip())
    if kind == "raw":
        return raw.strip()
    if kind in ("file", "path"):
        p = resolve(tok, u.cwd, "file" if kind == "file" else None)
        if not p and "/" not in tok:
            hits = find_below(tok, u.cwd)
            p = hits[0] if len(hits) == 1 else None
        return qpath(p) if p else None
    if kind == "dir":
        p = home_alias(tok, u.cwd) or resolve(tok, u.cwd, "dir")
        return qpath(p) if p else None
    if kind == "newfile":
        return qpath(tok) if (raw.startswith("qlit") or is_pathlike(tok)) else None
    if kind == "host":
        tok = re.sub(r"^\w+://", "", tok).split("/")[0]
        ok = (re.fullmatch(r"[A-Za-z0-9][\w-]*(?:\.[\w-]+)*\.[A-Za-z]{2,}", tok)
              or re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", tok) or tok == "localhost")
        return tok if ok and not os.path.exists(os.path.join(u.cwd, tok)) else None
    if kind == "url":
        if os.path.exists(os.path.join(u.cwd, os.path.expanduser(tok))):
            return None                  # README.md is a file, not a website
        if re.match(r"(?:https?|ftp)://\S+", tok) or re.fullmatch(WEB_DOMAIN, tok):
            return shlex.quote(tok if "://" in tok else "https://" + tok)
        return None
    if kind == "dest":
        return qpath(tok)
    if kind == "n":
        n = num(raw)
        return str(int(n)) if n is not None else None
    if kind == "word":
        return shlex.quote(tok) if re.fullmatch(r"[\w.@+/:-]+", tok) and raw.lower() not in (
            "the", "a", "an", "my", "this", "that", "it", "me") else None
    if kind == "var":
        return tok if re.fullmatch(r"[A-Za-z_]\w*", tok) else None
    if kind == "text":
        return shlex.quote(" ".join(u.lit(w) for w in raw.split()))
    if kind == "cmdtext":
        return " ".join(u.lit(w) for w in raw.split())
    if kind == "remote":
        return shlex.quote(tok) if re.fullmatch(r"(?:[\w.-]+@)?[\w.-]+:\S*|[\w.-]+@[\w.-]+", tok) else None
    if kind == "city":
        return _tz(tok)
    if kind == "algo":
        return {"md5": "md5sum", "sha1": "sha1sum", "sha512": "sha512sum"}.get(tok.lower(), "sha256sum")
    return None


def _apply_recipe(r: Recipe, u: Utterance) -> Plan | None:
    if any(not shutil.which(t) for t in r.needs):
        return None
    if r.git and not (shutil.which("git") and git_branch(u.cwd)):
        return None
    if r.gui and not GUI:
        return None
    for pat in r.patterns:
        m = pat.search(u.text)
        if not m:
            continue
        vals: dict = {}
        ok = True
        for name, raw in m.groupdict().items():
            base = re.sub(r"\d+$", "", name)
            if raw is None:
                continue
            raw_orig = u.o(m, name)
            vals["_raw_" + base] = raw_orig
            kind = r.slots.get(base, SLOT_TYPES.get(base, "raw"))
            v = _slot(kind, raw_orig, u)
            if v is None:
                ok = False
                break
            vals[base] = v
        if not ok:
            continue
        if r.text_into:
            text_lit = u.lit(vals.get("_raw_text", "").strip())
            target = u.lit(vals.get("_raw_newfile", "").strip()).lower()
            if (os.path.isfile(os.path.join(u.cwd, os.path.expanduser(text_lit))) or find_below(text_lit, u.cwd)
                    or re.search(BINARY_EXT, target)):
                continue                 # "put notes.txt into backup.zip" adds a file, it is not text
        for k, d in r.defaults.items():
            vals.setdefault(k, d)
        vals.setdefault("su", sudo())
        if callable(r.cmd):
            cmd = r.cmd(vals, u)
        else:
            tmpl = first_available(r.cmd) if isinstance(r.cmd, list) else r.cmd
            try:
                cmd = tmpl.format(**vals)
            except (KeyError, IndexError):
                cmd = None
        if not cmd:
            continue
        u.blank(m.start(), m.end())
        u.take(r"^\s*(?:please\s+)?(?:find|search\s+for|search|locate|look\s+for|hunt\s+for|list|show(?:\s+me)?|"
               r"get(?:\s+me)?|give\s+me|print|display|view|tell\s+me)\b")
        u.take(r"\b(?:find|list|show|search)\s*$")
        shown = [f"{k} {re.sub(r'qlit\d+', lambda q: u.lit(q.group(0)), v) if isinstance(v, str) else v}"
                 for k, v in vals.items()
                 if not k.startswith("_") and k in m.groupdict() and m.group(k)]
        preview = r.preview(vals, u) if callable(r.preview) else (r.preview.format(**vals) if r.preview else None)
        return Plan(cmd, r.label, shown, destructive=r.destructive, warning=r.warning,
                    runs_on_question=r.runs_on_question, preview=preview)
    return None


