def _seconds(n: str, unit: str) -> int:
    u = re.sub(r"s$", "", unit.lower())
    return int(float(n) * UNITS_S.get(u, UNITS_S.get(u[:3], 60)))


def _tz(city: str) -> str | None:
    want = re.sub(r"\s+", "_", city.strip().lower()).split("/")[-1]
    for root, _, files in os.walk("/usr/share/zoneinfo"):
        if "/posix" in root or "/right" in root:
            continue
        for f in files:
            if f.lower() == want:
                return os.path.relpath(os.path.join(root, f), "/usr/share/zoneinfo")
    return None


def _archive_list(v, u):
    f, low = v["file"], v["file"].lower()
    if re.search(r"\.(zip|jar|whl|apk)'?$", low):
        return first_available([("unzip", f"unzip -l {f}"), (None, f"python3 -m zipfile -l {f}")])
    if re.search(r"\.(tar(\.(gz|bz2|xz|zst))?|tgz|tbz2|txz)'?$", low):
        return f"tar -tvf {f}"
    if low.rstrip("'").endswith(".deb"):
        return f"dpkg -c {f}"
    if low.rstrip("'").endswith(".7z"):
        return f"7z l {f}"
    return None


def _owner_pkg(v, u):
    p = u.lit(v["_raw_path"])
    if "/" in p:
        return f"dpkg -S -- {qpath(p)}"
    if shutil.which(p):
        return f'dpkg -S -- "$(readlink -f "$(command -v {shlex.quote(p)})")"'
    return None


def _date_math(v, u):
    n, unit = v["n"], re.sub(r"s$", "", v["unit"])
    sign = "-" if "ago" in v["when"] else "+"
    return f"date -d '{sign}{n} {unit}' '+%A %d %B %Y'"


def _websearch(v, u):
    q = urllib.parse.quote_plus(" ".join(u.lit(w) for w in v["_raw_text"].split()))
    url = shlex.quote(f"https://duckduckgo.com/?q={q}")
    return f"xdg-open {url}" if GUI and shutil.which("xdg-open") else f"echo {url}"


def _app(v, u):
    name = APPS.get(re.sub(r"\s+", " ", v["_raw_app"].lower()))
    if not name or not GUI or not shutil.which(name):
        return None
    return f"nohup {name} >/dev/null 2>&1 &"


def _volume(v, u):
    if not shutil.which("pactl"):
        return None
    how = v.get("_raw_how", "").lower()
    if v.get("n"):
        return f"pactl set-sink-volume @DEFAULT_SINK@ {v['n']}%"
    if "unmute" in how:
        return "pactl set-sink-mute @DEFAULT_SINK@ 0"
    if "mute" in how:
        return "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    step = "+10%" if re.search(r"up|louder|raise|increase", how) else "-10%"
    return f"pactl set-sink-volume @DEFAULT_SINK@ {step}"


def _clone(v, u):
    url = u.lit(v["_raw_url"])
    if re.fullmatch(r"[\w.-]+/[\w.-]+", url):
        url = f"https://github.com/{url}"
    return f"git clone -- {shlex.quote(url)}"


def _alias(v, u):
    name, body = v["word"], " ".join(u.lit(w) for w in v["_raw_cmdtext"].split())
    if not re.fullmatch(r"[\w.-]+", name):
        return None
    line = f"alias {name}={shlex.quote(body)}"
    return f"{line} && printf '%s\\n' {shlex.quote(line)} >> {qpath(AISHARC)}"


def _path_add(v, u):
    d = v["dir"]
    line = f'export PATH="$PATH:{d}"' if not d.startswith("'") else f"export PATH=\"$PATH\":{d}"
    return f"{line} && printf '%s\\n' {shlex.quote(line)} >> {qpath(AISHARC)}"


class Recipe:
    def __init__(self, label, patterns, cmd, *, slots=None, defaults=None, destructive=False, warning=None,
                 needs=(), git=False, gui=False, runs_on_question=False):
        self.label, self.cmd, self.slots = label, cmd, slots or {}
        self.patterns = [re.compile(p) for p in ([patterns] if isinstance(patterns, str) else patterns)]
        self.defaults, self.destructive, self.warning = defaults or {}, destructive, warning
        self.needs, self.git, self.gui, self.runs_on_question = needs, git, gui, runs_on_question


SLOT_TYPES = {"file": "file", "path": "path", "dir": "dir", "newfile": "newfile", "host": "host", "url": "url",
              "n": "n", "m": "n", "word": "word", "user": "word", "pkg": "word", "var": "var", "text": "text",
              "cmdtext": "cmdtext", "remote": "remote", "city": "city", "algo": "algo", "unit": "raw",
              "when": "raw", "how": "raw", "app": "raw", "dest": "dest"}


def _slot(kind: str, raw: str, u: Utterance):
    tok = u.lit(raw.strip())
    if kind == "raw":
        return raw.strip()
    if kind in ("file", "path"):
        p = resolve(tok, u.cwd, "file" if kind == "file" else None)
        if not p and "/" not in tok:
            hits = find_below(tok, u.cwd)
            p = hits[0] if len(hits) == 1 else None
        return qpath(p) if p else None
    if kind == "dir":
        p = home_alias(tok, u.cwd) or resolve(tok, u.cwd, "dir")
        return qpath(p) if p else None
    if kind == "newfile":
        return qpath(tok) if (raw.startswith("qlit") or is_pathlike(tok)) else None
    if kind == "host":
        tok = re.sub(r"^\w+://", "", tok).split("/")[0]
        ok = (re.fullmatch(r"[A-Za-z0-9][\w-]*(?:\.[\w-]+)*\.[A-Za-z]{2,}", tok)
              or re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", tok) or tok == "localhost")
        return tok if ok and not os.path.exists(os.path.join(u.cwd, tok)) else None
    if kind == "url":
        if os.path.exists(os.path.join(u.cwd, os.path.expanduser(tok))):
            return None                  # README.md is a file, not a website
        if re.match(r"(?:https?|ftp)://\S+", tok) or re.fullmatch(WEB_DOMAIN, tok):
            return shlex.quote(tok if "://" in tok else "https://" + tok)
        return None
    if kind == "dest":
        return qpath(tok)
    if kind == "n":
        n = num(raw)
        return str(int(n)) if n is not None else None
    if kind == "word":
        return shlex.quote(tok) if re.fullmatch(r"[\w.@+/:-]+", tok) and raw.lower() not in (
            "the", "a", "an", "my", "this", "that", "it", "me") else None
    if kind == "var":
        return tok if re.fullmatch(r"[A-Za-z_]\w*", tok) else None
    if kind == "text":
        return shlex.quote(" ".join(u.lit(w) for w in raw.split()))
    if kind == "cmdtext":
        return " ".join(u.lit(w) for w in raw.split())
    if kind == "remote":
        return shlex.quote(tok) if re.fullmatch(r"(?:[\w.-]+@)?[\w.-]+:\S*|[\w.-]+@[\w.-]+", tok) else None
    if kind == "city":
        return _tz(tok)
    if kind == "algo":
        return {"md5": "md5sum", "sha1": "sha1sum", "sha512": "sha512sum"}.get(tok.lower(), "sha256sum")
    return None


def _apply_recipe(r: Recipe, u: Utterance) -> Plan | None:
    if any(not shutil.which(t) for t in r.needs):
        return None
    if r.git and not (shutil.which("git") and git_branch(u.cwd)):
        return None
    if r.gui and not GUI:
        return None
    for pat in r.patterns:
        m = pat.search(u.text)
        if not m:
            continue
        vals: dict = {}
        ok = True
        for name, raw in m.groupdict().items():
            base = re.sub(r"\d+$", "", name)
            if raw is None:
                continue
            raw_orig = u.o(m, name)
            vals["_raw_" + base] = raw_orig
            kind = r.slots.get(base, SLOT_TYPES.get(base, "raw"))
            v = _slot(kind, raw_orig, u)
            if v is None:
                ok = False
                break
            vals[base] = v
        if not ok:
            continue
        for k, d in r.defaults.items():
            vals.setdefault(k, d)
        if callable(r.cmd):
            cmd = r.cmd(vals, u)
        else:
            tmpl = first_available(r.cmd) if isinstance(r.cmd, list) else r.cmd
            try:
                cmd = tmpl.format(**vals)
            except (KeyError, IndexError):
                cmd = None
        if not cmd:
            continue
        u.blank(m.start(), m.end())
        shown = [f"{k} {u.lit(v) if isinstance(v, str) else v}" for k, v in vals.items()
                 if not k.startswith("_") and k in m.groupdict() and m.group(k)]
        return Plan(cmd, r.label, shown, destructive=r.destructive, warning=r.warning,
                    runs_on_question=r.runs_on_question)
    return None


