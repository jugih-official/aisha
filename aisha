def h_recipe(u: Utterance) -> Plan | None:
    best = None
    text = Utterance(u.raw, u.cwd).text
    for r in RECIPES:
        if not any(p.search(text) for p in r.patterns):
            continue                     # cheap pre-check; most recipes stop here
        uu = Utterance(u.raw, u.cwd)
        try:
            plan = _apply_recipe(r, uu)
        except (ValueError, KeyError, IndexError, re.error, OSError):
            continue
        if plan:
            plan = finish(uu, plan)
            if best is None or plan.confidence > best.confidence:
                best = plan
    return best


# ---- USB drives --------------------------------------------------------------------
# aisha looks at the drives itself (lsblk) so commands name the real device.
# Only drives whose transport is USB are touched, never the disk you boot from.

def usb_drives() -> list[dict]:
    """[{dev, size, model, label, parts: [{dev, fstype, label, mount, size}]}] for USB disks."""
    try:
        r = subprocess.run(["lsblk", "-J", "-o", "NAME,PATH,SIZE,TRAN,TYPE,MOUNTPOINT,FSTYPE,LABEL,MODEL"],
                           capture_output=True, text=True, timeout=10)
        data = json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []
    for d in data.get("blockdevices", []):
        if d.get("type") != "disk" or (d.get("tran") or "").lower() != "usb":
            continue
        parts = [{"dev": c.get("path") or "/dev/" + c["name"], "fstype": c.get("fstype") or "",
                  "label": c.get("label") or "", "mount": c.get("mountpoint") or "", "size": c.get("size") or ""}
                 for c in d.get("children") or [] if c.get("type") == "part"]
        if any(p["mount"] in ("/", "/boot", "/boot/efi", "/usr", "/home") for p in parts) or \
                d.get("mountpoint") in ("/", "/boot", "/usr", "/home"):
            continue                     # the system lives here: never offer it
        out.append({"dev": d.get("path") or "/dev/" + d["name"], "size": d.get("size") or "",
                    "model": (d.get("model") or "USB drive").strip(), "label": d.get("label") or "",
                    "parts": parts, "mount": d.get("mountpoint") or "", "fstype": d.get("fstype") or ""})
    return out


USB_LIST = ("lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,MODEL $(lsblk -dno PATH,TRAN | awk '$2==\"usb\"{print $1}') "
            "2>/dev/null | grep . || echo 'no USB drives connected'")
USB_WORD = (r"(?:usb|thumb\s*drive|flash\s*drive|pen\s*drive|memory\s+stick|usb\s+(?:stick|drive|disk|key)|"
            r"external\s+(?:drive|disk)|stick)")
FS_TYPES = {  # wording -> (mkfs command, Debian package, label option)
    "ntfs": ("mkfs.ntfs -f", "ntfs-3g", "-L"), "fat32": ("mkfs.vfat -F 32", "dosfstools", "-n"),
    "vfat": ("mkfs.vfat -F 32", "dosfstools", "-n"), "fat": ("mkfs.vfat -F 32", "dosfstools", "-n"),
    "exfat": ("mkfs.exfat", "exfatprogs", "-n"), "ext4": ("mkfs.ext4 -F", "e2fsprogs", "-L"),
    "linux": ("mkfs.ext4 -F", "e2fsprogs", "-L"), "windows": ("mkfs.ntfs -f", "ntfs-3g", "-L"),
}


def pick_usb(u: Utterance, drives: list[dict]) -> tuple[dict | None, str]:
    """The drive the user means: named by device or label, or the only one."""
    for d in drives:
        names = {os.path.basename(d["dev"]).lower(), d["dev"].lower(), d["label"].lower()}
        names |= {os.path.basename(p["dev"]).lower() for p in d["parts"]}
        names |= {p["label"].lower() for p in d["parts"] if p["label"]}
        names.discard("")
        for low, orig, _ in u.remaining():
            if u.lit(orig).lower() in names:
                return d, ""
    if len(drives) == 1:
        return drives[0], ""
    if not drives:
        return None, "no USB drive is connected"
    return None, "several USB drives: say which (" + ", ".join(
        f"{os.path.basename(d['dev'])} {d['model']} {d['size']}" for d in drives) + ")"


def h_usb(u: Utterance) -> Plan | None:
    if not shutil.which("lsblk"):
        return None
    if not u.peek(rf"\b{USB_WORD}s?\b"):
        # "eject KINGSTON", "format sdb1 to ntfs": a USB drive named by label or device
        if not u.peek(r"\b(?:eject|unmount|umount|unmoun|dismount|mount|format|reformat|safely\s+remove)\b"):
            return None
        drives = usb_drives()
        if not drives or pick_usb(u, drives)[0] is None or (len(drives) == 1 and not any(
                u.lit(o).lower() in ({os.path.basename(drives[0]["dev"]), drives[0]["label"].lower()}
                                     | {os.path.basename(x["dev"]) for x in drives[0]["parts"]}
                                     | {x["label"].lower() for x in drives[0]["parts"]}) for _, o, _ in u.remaining())):
            return None
    text = u.text
    action = None
    if re.search(r"\b(?:format|reformat|initiali[sz]e|wipe|erase)\b", text):
        action = "format"
    elif re.search(r"\b(?:eject|safely\s+remove|remove\s+safely|unplug|power\s+off|disconnect)\b", text):
        action = "eject"
    elif re.search(r"\b(?:unmount|umount|unmoun|dismount)\b", text):
        action = "unmount"
    elif re.search(r"\bmount\b", text):
        action = "mount"
    elif re.search(r"\b(?:free|space|left|full|usage|capacity|room)\b", text):
        action = "space"
    elif re.search(r"\b(?:list|show|connected|plugged|attached|which|what|all|any|detect|see|devices?|drives?|sticks?|info)\b", text):
        action = "list"
    if not action:
        return None
    if action == "list":
        u.text = " " * len(u.text)
        cmd = USB_LIST + "; echo; " + first_available([("lsusb", "lsusb"),
                                                       (None, "cat /sys/bus/usb/devices/*/product 2>/dev/null")])
        return Plan(cmd, "usb", ["USB drives, then all USB devices"])
    drives = usb_drives()
    d, problem = pick_usb(u, drives)
    u.text = " " * len(u.text)
    if not d:
        return Plan(USB_LIST, "usb", [problem])
    name = f"{os.path.basename(d['dev'])} ({d['model']}, {d['size']})"
    parts = d["parts"] or [{"dev": d["dev"], "fstype": d["fstype"], "label": d["label"], "mount": d["mount"],
                            "size": d["size"]}]
    mounted = [p for p in parts if p["mount"]]
    udisks = shutil.which("udisksctl")
    show = f"lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT {d['dev']}"
    if action == "space":
        if not mounted:
            return Plan(show, "usb", [name, "not mounted: say 'mount the usb' first"])
        return Plan("df -h " + " ".join(shlex.quote(p["mount"]) for p in mounted), "usb", [f"free space on {name}"])
    if action == "mount":
        todo = [p for p in parts if not p["mount"] and p["fstype"]]
        if not todo:
            return Plan(show, "usb", [name, "already mounted"])
        cmd = " && ".join((f"udisksctl mount -b {p['dev']}" if udisks else
                           f"sudo mkdir -p /media/$USER/{os.path.basename(p['dev'])} && "
                           f"sudo mount {p['dev']} /media/$USER/{os.path.basename(p['dev'])}") for p in todo)
        return Plan(cmd, "usb", [f"mount {name}"])
    unmount = [(f"udisksctl unmount -b {p['dev']}" if udisks else f"sudo umount {p['dev']}") for p in mounted]
    if action == "unmount":
        if not unmount:
            return Plan(show, "usb", [name, "nothing is mounted"])
        return Plan(" && ".join(unmount), "usb", [f"unmount {name}"])
    if action == "eject":
        power = f"udisksctl power-off -b {d['dev']}" if udisks else f"echo 'you can unplug {name} now'"
        return Plan(" && ".join(unmount + ["sync", power]), "usb", [f"unmount and power off {name}"],
                    destructive=True, warning=f"! ejects {name}; close files on it first")
    fs = next(((w, spec) for w, spec in FS_TYPES.items() if re.search(rf"\b{w}\b", u.low)), None)
    if not fs:
        return Plan(show, "usb", [name, "format to what? say ntfs, fat32, exfat or ext4"], confidence=0.9)
    word, (mkfs, pkg, label_opt) = fs
    if len(parts) != 1:
        return Plan(show, "usb", [name, f"has {len(parts)} partitions; aisha only formats a drive with one"],
                    confidence=0.9)
    target = parts[0]["dev"]
    label = ""
    lab = re.search(r"\b(?:called|named|label(?:led)?|with\s+(?:the\s+)?(?:name|label))\s+(\S+)", u.low)
    if lab:
        raw = u.lit(u.orig[lab.start(1):lab.end(1)])
        label = f" {label_opt} {shlex.quote(raw[:11] if 'vfat' in mkfs else raw[:32])}"
    steps = [(f"udisksctl unmount -b {p['dev']}" if udisks else f"sudo umount {p['dev']}") for p in mounted]
    steps.append(f"sudo {mkfs}{label} {target}")
    plan = Plan(" && ".join(steps), "format usb", [f"{target} on {name}", f"as {word.upper()}"], destructive=True,
                warning=f"! ERASES EVERYTHING on {target} ({d['model']}, {d['size']}) and makes it {word.upper()}")
    return require(plan, [(mkfs.split()[0], pkg)])


