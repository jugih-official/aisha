GLUE_SUBS = {
    "git": "pull push status log diff add commit checkout switch branch merge rebase fetch clone stash init show reset "
           "restore tag remote blame cherry-pick revert grep mv rm bisect describe",
    "apt": "update upgrade install remove purge search show list autoremove full-upgrade",
    "systemctl": "status start stop restart reload enable disable list-units daemon-reload is-active is-enabled",
    "docker": "ps images run exec logs pull push build stop start rm rmi compose",
    "npm": "install run test start ci update", "pip": "install uninstall list show freeze", "pip3": "install uninstall list show freeze",
}


def unglue(line: str) -> str | None:
    """'gitpull' -> 'git pull', 'gti status' -> 'git status', 'sudoapt update' -> 'sudo apt update'."""
    toks = line.split()
    if not toks or shutil.which(toks[0]) or toks[0] in SHELL_BUILTINS or not re.fullmatch(r"[a-z][a-z0-9-]*", toks[0]):
        return None
    w, rest = toks[0], toks[1:]
    for cmd, subs in GLUE_SUBS.items():
        if not shutil.which(cmd):
            continue
        subs = subs.split()
        if w.startswith(cmd) and w[len(cmd):] in subs:                       # gitpull
            return " ".join([cmd, w[len(cmd):]] + rest)
        if rest and one_edit_apart(w, cmd) and rest[0] in subs:              # gti pull
            return " ".join([cmd] + rest)
    if w.startswith("sudo") and len(w) > 5 and shutil.which("sudo") and shutil.which(w[4:]):   # sudoapt update
        return " ".join(["sudo", w[4:]] + rest)
    return None


def h_unglue(u: Utterance) -> Plan | None:
    fixed = unglue(u.raw.strip())
    if not fixed:
        return None
    u.text = " " * len(u.text)
    return Plan(fixed, "typo", [f"read '{u.raw.strip()}' as '{fixed}'"], confidence=0.95, source="guess")


