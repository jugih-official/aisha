def _extract_one(vals, u):
    arc, member = vals["file"], vals["member"]
    if _lit(vals, "file", u).lower().endswith(".zip"):
        return f"unzip -n {arc} {member}"
    return f"tar --keep-old-files -xf {arc} {member}"


def _extract_delete(vals, u):
    arc = vals["file"]
    if _lit(vals, "file", u).lower().endswith(".zip"):
        return f"unzip -n {arc} && rm -i -- {arc}"
    return f"tar --keep-old-files -xf {arc} && rm -i -- {arc}"


def _add_to_archive(vals, u):
    arc, name = vals["arc"], _lit(vals, "arc", u).lower()
    if name.endswith(".zip"):
        return f"zip -j {arc} {vals['path']}"
    if name.endswith(".tar"):
        return f"tar -rf {arc} {vals['path']}"
