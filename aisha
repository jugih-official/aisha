DESTRUCTIVE_RE = re.compile(
    r"""
    \b( rm | rmdir | shred | unlink | truncate | wipefs | fdisk | parted | sfdisk
      | mkfs(\.[a-z0-9]+)? )\b
    | \bfind\b(?:[^|;&]|\\;)*\s-delete\b
