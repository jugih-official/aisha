def looks_like_shell(line: str, path_env: str | None = None, cwd: str | None = None,
                     threshold: float = DEFAULTS["threshold"], known: set | None = None) -> bool:
    """known: alias and function names, which count as commands."""
    if not _looks_like_shell(line, path_env, known or set()):
        return False
    # A command word followed by plain words: let the rules have a go first.
    try:
        toks = shlex.split(line)
    except ValueError:
        return True
    rest = toks[1:]
    if (cwd and toks[0] in PREFER_RULES and rest and not any(t.startswith("-") for t in rest)
            and not re.search(r"[|&;<>`$]", line)):
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    # words, not numbers, %jobs or paths that exist here ("kill 1234" and "kill %1" stay bash)
    plain = [t for t in rest if not re.fullmatch(r"[%+-]?\d+|%\S*", t)
             and not os.path.exists(os.path.join(cwd or ".", os.path.expanduser(t)))]
    english = len(rest) > 1 and rest[0].lower() in ("a", "an", "the", "my", "me", "all", "every", "some", "how")
    if (cwd and toks[0] in AMBIGUOUS_FIRST and plain
            and (english or not any(t.startswith("-") for t in rest))
            and not re.search(r"[|&;<>`$]", line)
            and not all(os.path.exists(os.path.join(cwd, os.path.expanduser(t))) for t in rest)):
        plan = interpret(line, cwd)
        if plan and plan.confidence >= threshold:
            return False
    return True


SHELL_KEYWORDS = {"for", "while", "until", "if", "case", "select", "function", "time", "coproc", "!"}
# Pipes, lists, substitutions and redirections, but not "files > 10mb".
SHELL_OPERATORS = re.compile(
    r"\|\||&&|[|;`]|\$\(|>>|\d?>&|(?<![<>])[<>]\s*(?!\d+(?:\.\d+)?\s*(?:[kmgt]i?b?|bytes?)\b)\S", re.I)

SHELL_SYNTAX = re.compile(
    r"""^\s*(?: function\s+[\w.:-]+      # function f
              | [\w.:-]+\s*\(\)\s*\{?  # f() {
              | [({]\s                   # ( subshell ) / { group; }
              | \[\[?\s                  # [ test ] / [[ test ]]
              | [A-Za-z_]\w*(?:\[[^]]*\])?\+?=  # FOO=bar, arr[1]=x, PATH+=:x
              )""", re.VERBOSE)


def _looks_like_shell(line: str, path_env: str | None = None, known: set = frozenset()) -> bool:
    if SHELL_SYNTAX.match(line):
        return True
    try:
        toks = shlex.split(line)
    except ValueError:
        try:   # "touch f # don't": the apostrophe is inside a comment
            toks = shlex.split(line, comments=True)
        except ValueError:
            toks = None
    if not toks:
        return False
    first = toks[0]
    if first.startswith(("./", "/", "~/", "../")):
        return True
    if first == "time" and len(toks) > 1 and toks[1].lower() in ("how", "it", "the"):
        return False                     # "time how long make takes"
    if first in known or first in SHELL_KEYWORDS:
        return True
    if first not in SHELL_BUILTINS and not shutil.which(first, path=path_env):
        return False
    if first in TEXT_COMMANDS or SHELL_OPERATORS.search(line):
        return True
        return True
    rest = toks[1:]
    if not rest:
        return True
    if any(t.startswith("-") for t in rest):
        return True
    nl = sum(1 for t in rest if t.lower() in NL_WORDS)
    paths = sum(1 for t in rest if os.path.exists(os.path.expanduser(t)) or re.search(r"[*?/]", t))
    if nl == 0:
        return True
    return paths > nl


