def request_values(text: str, cwd: str) -> tuple[str, list[tuple[str, str]]]:
    """'create testi.md file' -> ('create {file} file', [('{file}', 'testi.md')])."""
    u = Utterance(text, cwd)
    words, vals = [], []
    for low, orig, _ in u.remaining():
        lit = u.lit(orig)
        kind = None
        if low.startswith("qlit") or re.fullmatch(r"\d+(?:\.\d+)?", low) or "/" in lit:
            if re.match(r"(?:https?|ftp)://", lit):
                kind = "{url}"
            elif re.fullmatch(r"\d+(?:\.\d+)?", lit):
                kind = "{n}"
            elif re.fullmatch(r"[A-Za-z0-9][\w-]*(?:\.[\w-]+)*\.(?:com|org|net|io|fi|dev|de|uk|eu)|\d{1,3}(?:\.\d{1,3}){3}", lit) \
                    and not os.path.exists(os.path.join(cwd, lit)):
                kind = "{host}"
            elif os.path.isdir(os.path.join(cwd, os.path.expanduser(lit))) or lit.endswith("/"):
                kind = "{dir}"
            elif is_pathlike(lit) or os.path.isfile(os.path.join(cwd, os.path.expanduser(lit))):
                kind = "{file}"
            else:
                kind = "{text}"
        elif low not in FILLER and resolve(lit, cwd):
            kind = "{dir}" if os.path.isdir(os.path.join(cwd, lit)) else "{file}"
        if kind:
            words.append(kind)
            vals.append((kind, lit))
        else:
            words.append(low)
    return " ".join(words), vals


SLOT_FITS = {"{file}": ("{file}", "{text}", "{dir}"), "{dir}": ("{dir}", "{text}", "{file}"), "{n}": ("{n}",),
             "{text}": ("{text}", "{file}", "{host}", "{dir}", "{n}"), "{url}": ("{url}", "{host}"), "{host}": ("{host}", "{url}")}


def fill_template(template: str, vals: list[tuple[str, str]]) -> tuple[str, int] | None:
    """Put the request's values into a template's slots, by type. -> (text, values left unused)."""
    used = [False] * len(vals)
    out = []
    for tok in template.split():
        if tok not in SLOT_FITS:
            out.append(tok)
            continue
        pick = None
        for fit in SLOT_FITS[tok]:
            for i, (kind, _) in enumerate(vals):
                if not used[i] and kind == fit:
                    pick = i
                    break
            if pick is not None:
                break
        if pick is None:
            return None
        used[pick] = True
        v = vals[pick][1]
        if tok == "{text}" or re.search(r"\s", v):
            v = '"' + v.replace('"', "") + '"' if '"' in v or "'" not in v else "'" + v + "'"
        out.append(v)
    return " ".join(out), used.count(False)


SUGGEST_MIN = 0.3
STRONG_SUGGESTION = 0.6   # below this, a set-up language model is asked before the list is shown


POWER_RE = re.compile(r"\b(?:reboot|poweroff|shutdown|halt|suspend|hibernate)\b")


def suggest(text: str, cwd: str, threshold: float = DEFAULTS["threshold"], limit: int = 3) -> list[tuple[str, Plan, float]]:
    """Closest requests aisha knows, filled with this request's values, that the rules are sure of."""
    masked, vals = request_values(text, cwd)
    out, seen = [], set()
    for score, template in intent_model().rank(masked, k=12):
        if score < SUGGEST_MIN:
            break
        filled = fill_template(template, vals)
        if not filled:
            continue
        phrase, unused = filled
        plan = _interpret_fixing(phrase, cwd)
        if not plan or plan.confidence < threshold or plan.command in seen:
            continue
        if POWER_RE.search(plan.command) and not re.search(
                r"\b(?:computer|pc|laptop|machine|system|reboot|shut\s*down|power|suspend|sleep|hibernate)\b", text, re.I):
            continue                     # never guess "restart the computer" for "restart the wlan thing"
        seen.add(plan.command)
        out.append((phrase, plan, score * (0.8 ** unused)))
        if len(out) >= limit:
            break
    # a guess that deletes, reboots or rewrites never comes first
    return sorted(out, key=lambda x: (x[1].destructive or needs_care(x[1].command), -x[2]))


def apply_synonyms(text: str) -> tuple[str, list[str]]:
    changed, out = [], []
    for tok in text.split(" "):
        low = tok.lower()
        if low in SYNONYMS and not low.startswith(("dir",)):
            out.append(SYNONYMS[low])
            changed.append(f"{low}→{SYNONYMS[low]}")
        else:
            out.append(tok)
    return " ".join(out), changed


# ---- teaching: phrase templates learned from examples ---------------------------------

def _clean_phrase(phrase: str) -> str:
    return " ".join(phrase.strip().rstrip("?!.").split())


def _is_slot_value(v: str, quoted: bool) -> bool:
    if quoted or re.search(r"[./~@:\d]", v):
        return True
    low = v.lower()
    return v.isidentifier() and low not in FILLER and low not in VOCAB and low not in ACTION_WORDS and \
        low not in MODEL_STOP and len(v) > 1


def make_template(phrase: str, command: str) -> tuple[str, str]:
    """('frobnicate notes.md', 'touch notes.md') -> ('frobnicate {1}', 'touch {1}')."""
    ptoks = re.findall(r'"[^"]*"|\'[^\']*\'|\S+', _clean_phrase(phrase))
    try:
        ctoks = shlex.split(command)
    except ValueError:
        ctoks = command.split()
    slots: dict = {}
    out = []
    for t in ptoks:
        quoted = t[:1] in "\"'" and len(t) > 1
        v = t[1:-1] if quoted else t.rstrip(",;")
        if v and v in ctoks and _is_slot_value(v, quoted):
            out.append("{%d}" % slots.setdefault(v, len(slots) + 1))
        else:
            out.append(t.lower())
    template = command
    for v, n in sorted(slots.items(), key=lambda kv: -len(kv[0])):
        template = re.sub(r"""(['"]?)(?<![\w./-])""" + re.escape(v) + r"""(?![\w./-])\1""", "{%d}" % n, template)
    return " ".join(out), template


def template_regex(pattern: str):
    parts = [r"""("[^"]*"|'[^']*'|\S+)""" if re.fullmatch(r"\{\d+\}", t) else re.escape(t) for t in pattern.split()]
    return re.compile(r"\s+".join(parts), re.I)


def fill_command(template: str, pattern: str, values: tuple) -> str | None:
    order = [int(n) for n in re.findall(r"\{(\d+)\}", pattern)]
    got: dict = {}
    for n, v in zip(order, values):
        v = v[1:-1] if v[:1] in "\"'" and len(v) > 1 else v
        if got.setdefault(n, v) != v:
            return None
    try:
        return re.sub(r"\{(\d+)\}", lambda m: shlex.quote(got[int(m.group(1))]), template)
    except KeyError:
        return None


