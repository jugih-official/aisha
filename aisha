def harvest_vocab() -> set:
    """Every word the rules, recipes and the built-in model use: typos of these get fixed."""
    texts = [INTENT_BANK, " ".join(TYPE_WORDS), " ".join(SYNONYMS), " ".join(SYNONYMS.values())]
    texts += [pat for pat, *_ in SYSTEM]
    texts += [p.pattern for r in RECIPES for p in r.patterns]
    texts += [pat for pat, *_ in LS_KEYS] + [SUNIT, TUNIT, " ".join(FILLER), "megabytes gigabytes kilobytes username mount unmount umount eject format usb stick flash drive ntfs fat32 exfat",
              "tonight midnight later minutes hours reboot restart shutdown schedule status enabled starts kernel package "
              "docker spaces newest recent permissions writable afterwards before after remove corrupted encrypted column "
              "containing threads failed undoes"]
    words = set()
    for t in texts:
        words.update(re.findall(r"[a-z]{4,}", re.sub(r"\\[a-zA-Z]", " ", t)))
    return words


def one_edit_apart(a: str, b: str) -> bool:
    """Levenshtein distance 1, or one swap of neighbours."""
    if a == b or abs(len(a) - len(b)) > 1:
        return False
    if len(a) == len(b):
        diff = [i for i in range(len(a)) if a[i] != b[i]]
        return len(diff) == 1 or (len(diff) == 2 and diff[1] == diff[0] + 1
                                  and a[diff[0]] == b[diff[1]] and a[diff[1]] == b[diff[0]])
    if len(a) > len(b):
        a, b = b, a
    return any(b[:i] + b[i + 1:] == a for i in range(len(b)))


# Real words one letter away from VOCAB words; never "corrected".
COMMON = set("""
